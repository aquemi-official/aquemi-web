  /* the accordion (PhoneKit on the list): head = tab chip and term, 48 px */
  .aq-clause-tabs__list[data-pk-on] .aq-clause-tabs__ph { display: block; grid-column: 1 / -1; order: -1; }
  .aq-clause-tabs__list[data-pk-on] [data-pk-item] { padding: 0 0 var(--space-2); }
  .aq-clause-tabs__list[data-pk-on] .aq-clause-tabs__hb { min-height: 48px; gap: 0; padding: var(--space-1) 0; font: 400 17px/24px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
  .aq-clause-tabs__hn { flex: none; display: inline-flex; align-items: center; justify-content: center; width: var(--space-8); height: var(--space-6); margin-right: var(--space-2); box-sizing: border-box;
