  .aq-joint-tag__tag { padding-bottom: var(--space-4); }
}

/* pass 12 round C fix round: the stencilled joint number is the drawing's main mark, so on phones (drawing at about
   0.54 scale) it is drawn 1.3 x (about 13 px); the plain seam's number pin sits higher to clear it. */
@container (max-width: 600px) {
  .aq-joint-tag--plain .aq-joint-tag__sten { transform: scale(1.3); transform-box: view-box; transform-origin: 810px 119px; }
}
/* tablets (601-860): a gentler crop (140 %, about 0.86 scale), smaller pins and the fields two to a row */
@container (min-width: 601px) and (max-width: 860px) {
  .aq-joint-tag__pipe { width: 140%; margin: 0 0 0 -30%; }
  .aq-joint-tag__eye { left: 54.47%; }
  .aq-joint-tag__pin circle { r: 18px; }
  .aq-joint-tag__pin text { font-size: 15px; }
  .aq-joint-tag__fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .aq-joint-tag__field:nth-child(-n+2) { border-top: 1px solid var(--line); }
  .aq-joint-tag__field, .aq-fold:not(.is-open) .aq-joint-tag__field.aq-fold-x { align-content: start; }
}
/* dark: the pins and cut marks off the pipe sit on the dark page, so the disc ring and the marks take light ink */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .aq-joint-tag__pin circle { stroke: var(--on-navy-muted); }
  :root:not([data-theme="light"]) .aq-joint-tag__cutm { stroke: var(--ink-muted); }
}
:root[data-theme="dark"] .aq-joint-tag__pin circle { stroke: var(--on-navy-muted); }
:root[data-theme="dark"] .aq-joint-tag__cutm { stroke: var(--ink-muted); }

/* ---------- LayerStack: a system's layers as an exploded isometric stack of plates (look "layer-stack") ---------- */
/* One svg spans the figure (the stack in the middle, room for labels both sides); labels sit over it at the
   percentages the renderer computed from each plate's corner, alternating right and left. Plates are tonal solids
   (top raised, front and side shaded from line tokens); the key plate is navy. Phones: the svg is zoomed to the stack
   (--ls-zoom, --ls-shift) and the labels list under it. */
.aq-layer-stack { position: relative; }
.aq-layer-stack__fig { position: relative; }
.aq-layer-stack__svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-layer-stack__top { fill: var(--surface-raised); stroke: var(--line-strong); stroke-width: 1; }
.aq-layer-stack__front { fill: color-mix(in srgb, var(--line) 70%, var(--surface-raised)); stroke: var(--line-strong); stroke-width: 1; }
.aq-layer-stack__side { fill: color-mix(in srgb, var(--line-strong) 45%, var(--surface-raised)); stroke: var(--line-strong); stroke-width: 1; }
.aq-layer-stack__inset { fill: none; stroke: var(--line); stroke-width: 1; }
.aq-layer-stack__hole { fill: var(--surface-sunken); stroke: var(--line-strong); stroke-width: 1; }
/* the key plate: navy, its equipment in on-navy lines */
.aq-layer-stack__plate.is-key .aq-layer-stack__top { fill: var(--navy); stroke: var(--navy); }
.aq-layer-stack__plate.is-key .aq-layer-stack__front { fill: color-mix(in srgb, var(--navy) 80%, var(--ink)); stroke: var(--navy); }
.aq-layer-stack__plate.is-key .aq-layer-stack__side { fill: color-mix(in srgb, var(--navy) 62%, var(--ink)); stroke: var(--navy); }
.aq-layer-stack__plate.is-key .aq-layer-stack__inset { stroke: color-mix(in srgb, var(--on-navy-muted) 40%, transparent); }
.aq-layer-stack__plate.is-key .aq-layer-stack__hole { fill: var(--navy); stroke: var(--on-navy-muted); }
.aq-layer-stack__plate.is-key + .aq-layer-stack__eqp .aq-iso__eq { fill: var(--navy); stroke: var(--on-navy-muted); }
.aq-layer-stack__plate.is-key + .aq-layer-stack__eqp .aq-iso__eq--alt { fill: color-mix(in srgb, var(--navy) 85%, var(--on-navy)); }
.aq-layer-stack__plate.is-key + .aq-layer-stack__eqp .aq-iso__eq--glass { fill: color-mix(in srgb, var(--navy) 78%, var(--on-navy)); }
.aq-layer-stack__plate.is-key + .aq-layer-stack__eqp .aq-iso__thin { stroke: var(--on-navy-muted); }
.aq-layer-stack__plate.is-key + .aq-layer-stack__eqp .aq-iso__acc { stroke: color-mix(in srgb, var(--flow) 40%, var(--on-navy)); }
/* signal: the riser between plates, the trace across each plate, the packet that rides them */
.aq-layer-stack__riser { fill: none; stroke: var(--flow); stroke-width: 1.5; stroke-dasharray: 3 3; }
.aq-layer-stack__trace { fill: none; stroke: var(--flow); stroke-width: 1.25; opacity: 0.55; }
.aq-layer-stack__plate.is-key ~ .aq-layer-stack__trace { stroke: color-mix(in srgb, var(--flow) 40%, var(--on-navy)); opacity: 1; }
.aq-layer-stack__route { fill: none; stroke: none; }
.aq-layer-stack__packet { fill: var(--flow); stroke: var(--surface); stroke-width: 2; opacity: 0; }
.aq-layer-stack__axis { fill: none; stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 14 4 2 4; opacity: 0.7; }
.aq-layer-stack__dmz { stroke: var(--flow); stroke-dasharray: 5 3; }
.aq-layer-stack__dmz-t { fill: var(--flow); font-size: 9px; }
.aq-layer-stack__lead path { fill: none; stroke: var(--line-strong); stroke-width: 1; }
.aq-layer-stack__lead circle { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.5; }
.aq-layer-stack__lead.is-hot path, .aq-layer-stack__lead.is-on path { stroke: var(--flow); }
.aq-layer-stack__lead.is-hot circle, .aq-layer-stack__lead.is-on circle { stroke: var(--flow); fill: var(--flow); }
.aq-layer-stack__layer.is-hot .aq-layer-stack__plate:not(.is-key) .aq-layer-stack__top { fill: var(--flow-tint); }
.aq-layer-stack__layer.is-hot .aq-layer-stack__top, .aq-layer-stack__layer.is-hot .aq-layer-stack__front, .aq-layer-stack__layer.is-hot .aq-layer-stack__side { stroke: var(--flow); }
.aq-layer-stack__layer .aq-layer-stack__top { transition: fill 200ms ease, stroke 200ms ease; }

/* labels over the figure */
.aq-layer-stack__list { list-style: none; margin: 0; padding: 0; }
.aq-layer-stack__item {
  position: absolute; width: var(--ls-w, 30%); padding-top: var(--space-3); border-top: 1px solid var(--line-strong);
  display: grid; grid-template-columns: auto 1fr; column-gap: var(--space-3); align-items: baseline;
  transition: border-color 200ms ease;
}
.aq-layer-stack__item--l { text-align: right; grid-template-columns: 1fr auto; }
.aq-layer-stack__item--l .aq-index { order: 2; }
.aq-layer-stack__item .aq-index { font: 400 12px/16px var(--font-mono); color: var(--ink-muted); transition: color 200ms ease; }
.aq-layer-stack__t { margin: 0; font: 400 24px/30px var(--font-sans); letter-spacing: -0.015em; color: var(--ink); text-wrap: balance; }
.aq-layer-stack .aq-layer-stack__d { grid-column: 1 / -1; margin: var(--space-2) 0 0; font: 400 15px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
.aq-layer-stack__item.is-hot, .aq-layer-stack__item.is-on { border-top-color: var(--flow); }
.aq-layer-stack__item.is-hot .aq-index, .aq-layer-stack__item.is-on .aq-index { color: var(--flow); }
.aq-layer-stack__item.is-key .aq-layer-stack__t { font-weight: 500; }

@container (max-width: 860px) {
  .aq-layer-stack__fig { overflow: hidden; }
  .aq-layer-stack__svg { width: calc(var(--ls-zoom, 1) * 100%); max-width: none; margin-left: var(--ls-shift, 0%); }
  .aq-layer-stack__lead { display: none; }
  .aq-layer-stack__list { display: flex; flex-direction: column; gap: var(--space-6); margin-top: var(--space-6); }
  .aq-layer-stack__item, .aq-layer-stack__item--l { position: static; width: auto; text-align: left; grid-template-columns: auto 1fr; }
  .aq-layer-stack__item--l .aq-index { order: 0; }
  .aq-layer-stack__t { font-size: 20px; line-height: 26px; }
}
.aq-layer-stack__item--l .aq-layer-stack__t { grid-row: 1; grid-column: 1; }
.aq-layer-stack__item--l .aq-index { grid-row: 1; grid-column: 2; }
@container (max-width: 860px) {
  .aq-layer-stack__item--l .aq-layer-stack__t { grid-column: 2; }
  .aq-layer-stack__item--l .aq-index { grid-column: 1; }
}
.aq-layer-stack-sec { position: relative; }
.aq-layer-stack__gap, .aq-layer-stack__water, .aq-layer-stack__wire { pointer-events: none; }

/* pass 9b, concept sys-monitoring.0: a navy field with the title huge and light, cropped by a limestone sheet that
   holds the stack and runs off the right and bottom edges. The title's second line keeps a navy box over the sheet's
   corner (inline background, one box per line). The sheet is data-theme light, so the stack draws as on paper. */
.aq-section.aq-layer-stack-sec { padding-bottom: 0; }
.aq-layer-stack__spread { --ls-fs: clamp(56px, 9.4vw, 136px); position: relative; }
.aq-layer-stack__spread > .aq-sec-head { position: relative; z-index: 1; display: block; font-size: var(--ls-fs, 120px); max-width: 7.6em; }
.aq-layer-stack__spread > .aq-sec-head .aq-h1 {
  display: inline; font-size: 1em; line-height: 0.98; font-weight: 300; letter-spacing: -0.04em; color: var(--on-navy);
  background: var(--navy); -webkit-box-decoration-break: clone; box-decoration-break: clone; padding: 0 0.18em 0.12em 0;
}
.aq-layer-stack__spread > .aq-sec-head::after { content: ""; display: block; }
.aq-layer-stack__sheet {
  position: relative; margin: calc(-1.05 * var(--ls-fs, 120px)) calc(50% - 50vw) 0 18%;
  padding: calc(1.05 * var(--ls-fs, 120px) + var(--space-4)) var(--space-12) var(--space-16);
  background: var(--limestone); color: var(--on-limestone); --surface: var(--limestone);
}
.aq-layer-stack__sheet > .aq-layer-stack { max-width: calc(var(--content-max) * 0.82); }
.aq-layer-stack__layer { transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1); }
.aq-layer-stack__layer.is-hot { transform: translateY(-8px); }
@media (prefers-reduced-motion: reduce) { .aq-layer-stack__layer { transition: none; } .aq-layer-stack__layer.is-hot { transform: none; } }
/* Desktop (pass 12 C): the section has no bottom padding and the sheet's foot was measured to the drawing, so the 01
   label that hangs below it ended 12 px from the edge; a deeper foot leaves 68 px under the last label at 1280 */
@container (min-width: 861px) {
  .aq-layer-stack__sheet { padding-bottom: calc(var(--space-16) + var(--space-12) + var(--space-2)); }
}
@container (max-width: 860px) {
  .aq-layer-stack__spread { --ls-fs: 52px; }
  .aq-layer-stack__spread > .aq-sec-head .aq-h1 { line-height: 1.02; }
  .aq-layer-stack__sheet { margin: var(--space-8) calc(50% - 50vw) 0; padding: var(--space-8) var(--space-4) var(--space-12); }
}

/* pass 12 phone (audit S10, sys-monitoring.0): the leaders are gone on phones, so each plate carries its stage number
   as a tag on its free corner (svg units: 15 r and 18 type render about 23 px and 13.5 px at 343 px), and the list
   runs top plate first (column-reverse) so list and drawing read in the same order. Pointing at a row lights its
   plate and tag (the hover set above). Hidden on desktop, where the leaders carry the link. */
.aq-layer-stack__tag { display: none; }
@container (max-width: 860px) {
  .aq-layer-stack__tag { display: inline; pointer-events: none; }
  .aq-layer-stack__tag circle { fill: var(--surface); stroke: var(--ink); stroke-width: 1.5; }
  .aq-layer-stack__tag text { font: 500 18px/1 var(--font-mono); fill: var(--ink); letter-spacing: 0.02em; }
  .aq-layer-stack__tag.is-key circle { fill: var(--on-navy); stroke: var(--on-navy); }
  .aq-layer-stack__tag.is-key text { fill: var(--navy); }
  .aq-layer-stack__tag.is-hot circle { fill: var(--flow); stroke: var(--flow); }
  .aq-layer-stack__tag.is-hot text { fill: var(--on-navy); }
  .aq-layer-stack__list { flex-direction: column-reverse; gap: var(--space-5, 20px); }
  .aq-layer-stack__item .aq-index { font-size: 13px; color: var(--ink); min-width: 28px; }
  .aq-layer-stack__item.is-key .aq-index { color: var(--navy); font-weight: 600; }
}
@container (max-width: 860px) { .aq-layer-stack__dmz-t { font-size: 14.5px; } }
/* verify V4: on tablets (600-860) the tags are svg units and grow with the figure; the figure is capped so they stay
   about 18 px and the drawing about 650 px tall. */
@container (min-width: 600px) and (max-width: 860px) { .aq-layer-stack__fig { max-width: 460px; margin-inline: auto; } }

/* ---------- LimitBento: limits as a bento, one oversized numeral per tile, a navy water column through the middle
   (look "limit-bento"). Desktop: three columns, heading and the first tile left, the column through both rows in the
   middle, the other tiles right. Tiles alternate surface-raised and limestone (is-paper). In the dark theme the paper tiles take the raised
   dark surface too (round C), so the cards read as one theme beside the navy column. ---------- */
.aq-limit-bento {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr) minmax(0, 1fr);
  grid-auto-rows: minmax(0, auto); gap: var(--space-4);
}
.aq-limit-bento__head { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; justify-content: flex-start; gap: var(--space-4); padding: var(--space-2) var(--space-4) var(--space-6) 0; }
.aq-limit-bento__head .aq-h1 { font-size: 48px; line-height: 52px; max-width: 12ch; }
.aq-limit-bento__chip { align-self: flex-start; margin: 0; padding: var(--space-1) var(--space-3); background: var(--navy); color: var(--on-navy); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
.aq-limit-bento__tiles { display: contents; list-style: none; margin: 0; padding: 0; }

/* Tile */
.aq-limit-bento__tile {
  position: relative; display: flex; flex-direction: column; gap: var(--space-2); min-height: 0;
  padding: var(--space-6); background: var(--surface-raised); color: var(--ink); border: 1px solid var(--line);
}
.aq-limit-bento__tile.is-paper { background: var(--limestone); color: var(--on-limestone); border-color: transparent; }
.aq-limit-bento__tile:nth-child(1) { grid-column: 1; grid-row: 2; }
.aq-limit-bento__tile:nth-child(2) { grid-column: 3; grid-row: 1; }
.aq-limit-bento__tile:nth-child(3) { grid-column: 3; grid-row: 2; }
.aq-limit-bento__tile:nth-child(n+4) { grid-column: auto; grid-row: auto; }
/* corner crosses, as on a cut sheet */
.aq-limit-bento__tile::before, .aq-limit-bento__tile::after { content: ""; position: absolute; top: var(--space-3); right: var(--space-3); width: var(--space-3); height: 1px; background: var(--line-strong); }
.aq-limit-bento__tile::after { width: 1px; height: var(--space-3); right: calc(var(--space-3) + var(--space-3) / 2); }
.aq-limit-bento__tile::before { top: calc(var(--space-3) + var(--space-3) / 2); }
.aq-limit-bento__top { display: flex; align-items: baseline; gap: var(--space-3); padding-right: var(--space-8); }
.aq-limit-bento__p { margin: 0; font: 500 13px/20px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
.aq-limit-bento__ic { position: absolute; right: var(--space-6); top: var(--space-12); width: var(--space-8); height: var(--space-8); background: var(--line-strong); }
.aq-limit-bento__lvl { align-self: flex-start; margin: 0; padding: 0 var(--space-2); border: 1px solid currentColor; font: 500 12px/20px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
.aq-limit-bento__v { margin: var(--space-6) 0 0; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-2); font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.aq-limit-bento__c { font: 300 48px/1 var(--font-mono); color: var(--flow); }
.aq-limit-bento__tile.is-paper .aq-limit-bento__c { color: var(--navy); }
.aq-limit-bento__n { font: 300 72px/1 var(--font-mono); letter-spacing: -0.04em; }
.aq-limit-bento__u { font: 400 24px/1.2 var(--font-mono); }
.aq-limit-bento__q { margin: 0; font: 400 14px/20px var(--font-sans); color: var(--ink-muted); }
.aq-limit-bento__tile.is-paper .aq-limit-bento__q { color: var(--on-limestone-muted); }
.aq-limit-bento__m { margin: auto 0 0; padding-top: var(--space-4); border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font: 400 13px/20px var(--font-mono); color: var(--ink-muted); }
.aq-limit-bento__tile.is-paper .aq-limit-bento__m { border-top-color: color-mix(in srgb, var(--on-limestone) 18%, transparent); }
.aq-limit-bento__m .aq-limit-gauges__mt { color: inherit; }
.aq-limit-bento__tile .aq-limit-gauges__go { margin: 0; }

/* Water column: navy, a glass tank with a scale, filled to the limit, the looser value dashed above */
.aq-limit-bento__col {
  grid-column: 2; grid-row: 1 / span 2; position: relative; margin: 0; display: flex; flex-direction: column;
  min-height: calc(var(--space-32) * 4.6); padding: var(--space-6); background: var(--navy); color: var(--on-navy); overflow: hidden;
}
.aq-limit-bento__cap { display: flex; flex-direction: column; gap: var(--space-1); }
.aq-limit-bento__cap-p { font: 500 13px/20px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
.aq-limit-bento__cap-q { font: 400 13px/20px var(--font-mono); color: var(--on-navy-muted); }
.aq-limit-bento__tank { position: relative; flex: 1; margin: var(--space-6) 0 0 var(--space-8); border-left: 1px solid color-mix(in srgb, var(--on-navy-muted) 50%, transparent); }
.aq-limit-bento__scale { position: absolute; inset: 0 auto 0 calc(-1 * var(--space-8)); width: var(--space-8); list-style: none; margin: 0; padding: 0; }
.aq-limit-bento__scale li { position: absolute; right: 0; width: var(--space-3); height: 1px; background: var(--on-navy-muted); }
.aq-limit-bento__scale li.is-minor { width: var(--space-2); opacity: 0.6; }
.aq-limit-bento__scale span { position: absolute; right: calc(100% + var(--space-1)); top: calc(-1 * var(--space-2)); font: 400 12px/16px var(--font-mono); color: var(--on-navy-muted); }
.aq-limit-bento__water { position: absolute; left: 0; right: calc(-1 * var(--space-6)); bottom: 0; height: calc(var(--lim, 0) * 100%); background: color-mix(in srgb, var(--flow) 55%, var(--navy)); }
.aq-limit-bento__wave { position: absolute; left: 0; bottom: calc(100% - var(--space-3)); width: 100%; height: var(--space-6); overflow: visible; }
.aq-limit-bento__wbody { fill: color-mix(in srgb, var(--flow) 55%, var(--navy)); }
.aq-limit-bento__wline { fill: none; stroke: var(--on-navy); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
.aq-limit-bento__mark { position: absolute; left: var(--space-4); right: 0; display: flex; flex-direction: column; }
.aq-limit-bento__mark::before { content: ""; position: absolute; left: calc(-1 * var(--space-4)); right: calc(-1 * var(--space-6)); }
.aq-limit-bento__mark--alt { bottom: calc(var(--alt, 0) * 100%); padding-bottom: var(--space-2); }
.aq-limit-bento__mark--alt::before { bottom: 0; border-top: 1px dashed var(--on-navy-muted); }
.aq-limit-bento__mark--lim { bottom: calc(var(--lim, 0) * 100% + var(--space-6)); padding-bottom: var(--space-2); }
.aq-limit-bento__mv { margin: 0; font: 400 15px/20px var(--font-mono); color: var(--on-navy-muted); }
.aq-limit-bento__mv span { font-variant-numeric: tabular-nums; }
.aq-limit-bento__mm { margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
.aq-limit-bento__mark--lim .aq-limit-bento__mv { color: var(--on-navy); font-size: 28px; line-height: 34px; font-weight: 300; }
.aq-limit-bento__mark--lim .aq-limit-bento__mm { color: var(--on-navy); }
.aq-limit-bento-sec .aq-limit-bento + .aq-small { margin-top: var(--space-6); max-width: var(--text-max); }

/* the distance between the two values: a dimension line with arrow ends, right of the marks */
.aq-limit-bento__gap { position: absolute; right: var(--space-2); bottom: calc(var(--lim, 0) * 100% + var(--space-2)); height: calc((var(--alt, 0) - var(--lim, 0)) * 100% - var(--space-2)); width: 1px; background: color-mix(in srgb, var(--on-navy-muted) 60%, transparent); }
.aq-limit-bento__gap::before, .aq-limit-bento__gap::after { content: ""; position: absolute; left: calc(-1 * var(--space-1)); width: var(--space-2); height: var(--space-2); border: solid var(--on-navy-muted); border-width: 1px 0 0 1px; transform: rotate(45deg); }
.aq-limit-bento__gap::before { top: 0; }
.aq-limit-bento__gap::after { bottom: 0; transform: rotate(225deg); }

/* No column: three tiles across under the heading */
.aq-limit-bento.is-plain .aq-limit-bento__head { grid-column: 1 / -1; }
.aq-limit-bento.is-plain .aq-limit-bento__tile { grid-column: auto; grid-row: auto; }

.aq-limit-bento .aq-num { font-variant-numeric: tabular-nums; }

/* motion slides parts in from the side; never let them widen the page */
.aq-section.aq-limit-bento-sec { overflow-x: clip; }

@container (max-width: 860px) {
  .aq-limit-bento { grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  .aq-limit-bento__head, .aq-limit-bento__col, .aq-limit-bento__tile:nth-child(n) { grid-column: 1; grid-row: auto; }
  .aq-limit-bento__head { padding: 0 0 var(--space-4); }
  .aq-limit-bento__head .aq-h1 { font-size: 34px; line-height: 40px; }
  .aq-limit-bento__col { min-height: calc(var(--space-32) * 2.6); padding: var(--space-4); }
  .aq-limit-bento__tank { margin-top: var(--space-4); }
  .aq-limit-bento__tile { padding: var(--space-4); }
  .aq-limit-bento__v { margin-top: var(--space-3); }
  .aq-limit-bento__c { font-size: 36px; }
  .aq-limit-bento__n { font-size: 56px; }
  .aq-limit-bento__u { font-size: 20px; }
  .aq-limit-bento__ic { top: var(--space-4); right: var(--space-4); width: var(--space-6); height: var(--space-6); }
  .aq-limit-bento__tile::before, .aq-limit-bento__tile::after { display: none; }
  /* pass 12: the column's own row is not repeated as a tile under it */
  .aq-limit-bento__tile.is-col { display: none; }
}

/* round C, dark theme: the paper tiles take the raised dark surface of the others (both dark scopes) */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .aq-limit-bento__tile.is-paper { background: var(--surface-raised); color: var(--ink); border-color: var(--line); }
  :root:not([data-theme="light"]) .aq-limit-bento__tile.is-paper .aq-limit-bento__c { color: var(--flow); }
  :root:not([data-theme="light"]) .aq-limit-bento__tile.is-paper .aq-limit-bento__q { color: var(--ink-muted); }
  :root:not([data-theme="light"]) .aq-limit-bento__tile.is-paper .aq-limit-bento__m { border-top-color: var(--line); }
}
[data-theme="dark"] .aq-limit-bento__tile.is-paper { background: var(--surface-raised); color: var(--ink); border-color: var(--line); }
[data-theme="dark"] .aq-limit-bento__tile.is-paper .aq-limit-bento__c { color: var(--flow); }
[data-theme="dark"] .aq-limit-bento__tile.is-paper .aq-limit-bento__q { color: var(--ink-muted); }
[data-theme="dark"] .aq-limit-bento__tile.is-paper .aq-limit-bento__m { border-top-color: var(--line); }

/* ---------- LimitPlan: what the site provides, as a battery-limits plan (look "limit-plan"). An IsoKit drawing of the
   package footprint inside a dashed battery-limit line, numbered square nodes on each connection, keyed to the rows
   beside it. Pointing at a row or a node lights both, the matching parts turn flow and a ring glides to the node. ---------- */
.aq-limit-plan-sec { position: relative; }
.aq-limit-plan { display: grid; grid-template-columns: minmax(0, 11fr) minmax(0, 13fr); column-gap: var(--space-12); align-items: start; }

/* the plan: framed like a sheet, held in view while the rows pass */
.aq-limit-plan__fig { position: sticky; top: var(--space-24); margin: 0; padding: var(--space-6) var(--space-4); border: 1px solid var(--line-strong); background: var(--surface); }
.aq-limit-plan__plan { position: relative; }
.aq-limit-plan__svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-limit-plan__floor { fill: var(--flow-tint); stroke: none; }
.aq-limit-plan__line { fill: none; stroke: var(--flow); stroke-width: 2; stroke-dasharray: 16 5 3 5; vector-effect: non-scaling-stroke; transition: stroke-width 180ms cubic-bezier(0.2, 0, 0, 1); }
.aq-limit-plan__cable { fill: none; stroke: var(--line-strong); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
.aq-limit-plan__plate { fill: var(--flow-tint); stroke: var(--flow); stroke-width: 1; vector-effect: non-scaling-stroke; }
.aq-limit-plan__lead { fill: none; stroke: var(--ink-subtle); stroke-width: 1; vector-effect: non-scaling-stroke; }
.aq-limit-plan__dot { fill: var(--ink-subtle); }
.aq-limit-plan__header .aq-iso__pipe-body { fill: var(--surface-sunken); }

/* the lit connection: its parts, cable, leader and line turn flow */
.aq-limit-plan__g.is-on .aq-iso__eq, .aq-limit-plan__g.is-on .aq-iso__ln, .aq-limit-plan__g.is-on .aq-iso__thin, .aq-limit-plan__g.is-on .aq-iso__hid,
.aq-limit-plan__g.is-on .aq-iso__pipe-wall, .aq-limit-plan__g.is-on .aq-iso__dim-line, .aq-limit-plan__g.is-on .aq-limit-plan__cable,
.aq-limit-plan__lead.is-on { stroke: var(--flow); }
.aq-limit-plan__dot.is-on { fill: var(--flow); }
.aq-limit-plan__g.is-on .aq-limit-plan__line { stroke-width: 3; }
/* pipes are flow at rest, so a lit pipe thickens and fills: rows 03 and 06 answer in the drawing too */
.aq-limit-plan__g.is-on .aq-iso__pipe-wall { stroke-width: 2.5; }
.aq-limit-plan__g.is-on .aq-iso__pipe-body { fill: var(--flow-tint); }
.aq-limit-plan__g .aq-iso__eq, .aq-limit-plan__g .aq-iso__hid, .aq-limit-plan__g .aq-iso__dim-line, .aq-limit-plan__g .aq-iso__pipe-wall, .aq-limit-plan__g .aq-iso__pipe-body,
.aq-limit-plan__cable, .aq-limit-plan__lead { transition: stroke 180ms cubic-bezier(0.2, 0, 0, 1), stroke-width 180ms cubic-bezier(0.2, 0, 0, 1), fill 180ms cubic-bezier(0.2, 0, 0, 1); }

/* numbered nodes (HTML over the drawing, so they stay legible at any size) */
.aq-limit-plan__node, .aq-limit-plan__no {
  display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: var(--radius-sm);
  background: var(--action); color: var(--on-action); font: 500 12px/1 var(--font-mono); letter-spacing: 0.02em; font-variant-numeric: tabular-nums;
  transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
}
.aq-limit-plan__node { position: absolute; z-index: 2; translate: -50% -50%; cursor: default; }
.aq-limit-plan__node.is-on { background: var(--flow); color: var(--ink-inverse); transform: scale(1.12); }
.aq-limit-plan__no.is-plain { background: none; color: var(--ink-subtle); }
.aq-limit-plan__row.is-on .aq-limit-plan__no { background: var(--flow); color: var(--ink-inverse); }
/* the ring that glides to the lit node: a zero-size point that travels, its circle drawn by ::after */
.aq-limit-plan__ring {
  position: absolute; z-index: 1; left: 50%; top: 50%; width: 0; height: 0; pointer-events: none;
  transition: left 250ms cubic-bezier(0.2, 0.8, 0.2, 1), top 250ms cubic-bezier(0.2, 0.8, 0.2, 1);
}
.aq-limit-plan__ring::after {
  content: ""; position: absolute; left: 0; top: 0; width: 44px; height: 44px; border: 1.5px solid var(--flow); border-radius: 50%;
  opacity: 0; translate: -50% -50%; transform: scale(0.6); transition: opacity 180ms ease, transform 180ms ease;
}
.aq-limit-plan__ring.is-on::after { opacity: 1; transform: none; }

/* the rows */
.aq-limit-plan__table { min-width: 0; }
.aq-limit-plan__head, .aq-limit-plan__row { display: grid; grid-template-columns: var(--space-12) minmax(0, 5fr) minmax(0, 7fr); }
.aq-limit-plan__head { border-bottom: 1.5px solid var(--action); }
.aq-limit-plan__head span { padding: 0 var(--space-4) var(--space-3) 0; font: 400 15px/24px var(--font-sans); color: var(--ink); }
.aq-limit-plan__head span:first-child { grid-column: 2; }
.aq-limit-plan__list { list-style: none; margin: 0; padding: 0; }
.aq-limit-plan__row { padding: var(--space-4) 0; border-bottom: 1px solid var(--line-strong); }
.aq-limit-plan__no { margin-top: 1px; }
.aq-limit-plan__t { min-width: 0; padding-right: var(--space-4); }
.aq-limit-plan__p { margin: 0; font: 300 20px/26px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); text-wrap: balance; }
.aq-limit-plan__c { min-width: 0; }
.aq-limit-plan__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; margin: 0; }
.aq-limit-plan__v { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-1); }
.aq-limit-plan__v li { position: relative; padding-left: var(--space-4); font: 400 15px/23px var(--font-sans); color: var(--ink); }
.aq-limit-plan__v li::before { content: ""; position: absolute; left: 0; top: calc(var(--space-3) - 1px); width: var(--space-2); border-top: 1.5px solid var(--flow); }
.aq-limit-plan__m { margin: var(--space-2) 0 0; padding-left: var(--space-4); font: 400 14px/21px var(--font-sans); color: var(--ink-muted); }
.aq-limit-plan__go { margin: var(--space-2) 0 0; padding-left: var(--space-4); font: 400 15px/23px var(--font-sans); }

@media (prefers-reduced-motion: reduce) {
  .aq-limit-plan__ring, .aq-limit-plan__ring::after, .aq-limit-plan__node, .aq-limit-plan__no, .aq-limit-plan__line,
  .aq-limit-plan__g .aq-iso__eq, .aq-limit-plan__g .aq-iso__hid, .aq-limit-plan__g .aq-iso__dim-line, .aq-limit-plan__g .aq-iso__pipe-wall, .aq-limit-plan__g .aq-iso__pipe-body,
  .aq-limit-plan__cable, .aq-limit-plan__lead { transition: none; }
}

/* Tablets: the plan on top, full width, then the rows */
@container (max-width: 1080px) {
  .aq-limit-plan { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-8); }
  .aq-limit-plan__fig { position: relative; top: auto; max-width: 720px; }
}

/* Phones: a PhoneKit sticky compact figure (S8). The plan becomes a 200 px strip held under the section bar, panned and
   zoomed to the node of the row on the reading line; every row stays open under it (number and item, the typical
   value, the note, the link). Without script: the whole plan at full gutter width, then every row open. */
@container (max-width: 860px) {
  .aq-limit-plan { row-gap: var(--space-6); }
  .aq-limit-plan__fig { max-width: none; padding: var(--space-3) var(--space-2); }
  .aq-limit-plan__node { width: 24px; height: 24px; font-size: 12px; }
  .aq-limit-plan__ring::after { width: 40px; height: 40px; }
  .aq-limit-plan__head { display: none; }
  .aq-limit-plan__list { border-top: 1.5px solid var(--action); }
  .aq-limit-plan__row { grid-template-columns: calc(var(--space-8) + var(--space-2)) minmax(0, 1fr); padding: var(--space-3) 0; }
  .aq-limit-plan__no { width: 24px; height: 24px; }
  .aq-limit-plan__t { padding: 0; }
  .aq-limit-plan__p { font-size: 18px; line-height: 24px; }
  .aq-limit-plan__c { grid-column: 2; padding-top: var(--space-2); }
  .aq-limit-plan__v li { font-size: 15px; line-height: 22px; }
  .aq-limit-plan__v li::before { top: calc(var(--space-3) - 2px); }
  .aq-limit-plan__m { font-size: 14px; line-height: 21px; }
  .aq-limit-plan__go a { display: inline-flex; align-items: center; min-height: var(--aq-hit); }
  .aq-limit-plan__go { margin-top: 0; }

  /* the strip: PhoneKit holds it (sticky, 200 px, its own rule underneath); the plan fits its height, centred, and is
     the layer PhoneKit pans and zooms; nodes and ring keep their size against the zoom so numbers read at 12 px */
  .aq-limit-plan[data-pk-on] { row-gap: var(--space-2); }
  .aq-limit-plan[data-pk-on] .aq-limit-plan__fig { padding: 0; border: 0; border-bottom: 1px solid var(--line-strong); }
  .aq-limit-plan[data-pk-on] .aq-limit-plan__plan { width: min(100%, calc(var(--pk-h, 200px) * var(--lp-r, 1.6))); aspect-ratio: var(--lp-ar, 8 / 5); margin: 0 auto; }
  .aq-limit-plan[data-pk-on] .aq-limit-plan__svg { width: 100%; height: 100%; }
  .aq-limit-plan[data-pk-on] .aq-limit-plan__node { width: calc(24px / var(--pk-s, 1)); height: calc(24px / var(--pk-s, 1)); font-size: calc(12px / var(--pk-s, 1)); border-radius: calc(var(--radius-sm) / var(--pk-s, 1)); }
  .aq-limit-plan[data-pk-on] .aq-limit-plan__ring::after { width: calc(40px / var(--pk-s, 1)); height: calc(40px / var(--pk-s, 1)); border-width: calc(1.5px / var(--pk-s, 1)); }
  .aq-limit-plan[data-pk-on] .aq-limit-plan__list { border-top: 0; }
}

/* ---------- LimitWriters: the same package, a different limit-writer ---------- */
/* The drawing: the package (IsoKit, its outlet run up to the drawing's mid height and level to the right edge), then the header pipe
   (a stretched SVG: trunk in at mid height, a riser, one tee per sheet), then the sheets, one per equal row so each
   tee meets its sheet's middle. Pipes are twin-wall: a 12 px line-strong stroke, a 10 px ground stroke over it, a
   2 px flow stroke in the middle (all non-scaling), the same in the stub and the header. */
.aq-limit-writers { display: grid; gap: var(--space-12); }
.aq-limit-writers__fig { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 1.2fr) minmax(0, 3.8fr); align-items: stretch; min-height: 400px; }
.aq-limit-writers__skid { display: flex; align-items: center; min-width: 0; }
.aq-limit-writers__skid .aq-limit-writers__iso { display: block; width: 100%; height: auto; max-height: 360px; overflow: visible; }
.aq-limit-writers__pipe { display: block; width: 100%; height: 100%; overflow: visible; }
.aq-limit-writers__w1, .aq-limit-writers__w2, .aq-limit-writers__w3 { fill: none; vector-effect: non-scaling-stroke; stroke-linecap: butt; stroke-linejoin: miter; }
.aq-limit-writers__w1 { stroke: var(--line-strong); stroke-width: 12px; }
.aq-limit-writers__w2 { stroke: var(--surface); stroke-width: 10px; }
.aq-limit-writers__w3 { stroke: var(--flow); stroke-width: 2px; }

.aq-limit-writers__sheets { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-rows: minmax(0, 1fr); }
.aq-limit-writers__sh { display: flex; align-items: center; padding-block: var(--space-2); min-width: 0; }
.aq-limit-writers__sheet { position: relative; flex: 1 1 auto; display: flex; align-items: baseline; gap: var(--space-4); min-height: var(--space-12); box-sizing: border-box;
  padding: var(--space-3) var(--space-8) var(--space-3) var(--space-4); background: var(--surface-raised); border: 1px solid var(--line-strong);
  clip-path: polygon(0 0, calc(100% - var(--space-4)) 0, 100% var(--space-4), 100% 100%, 0 100%); transition: transform 200ms cubic-bezier(0.2, 0, 0, 1), border-color 200ms; }
/* the folded corner */
.aq-limit-writers__sheet::after { content: ""; position: absolute; right: 0; top: 0; width: var(--space-4); height: var(--space-4); box-sizing: border-box;
  background: linear-gradient(225deg, transparent 50%, var(--surface-sunken) 50%); border-left: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }
.aq-limit-writers__sheet > .aq-index { flex: none; font: 400 13px/20px var(--font-mono); letter-spacing: 0.06em; color: var(--flow); }
.aq-limit-writers__name { margin: 0; min-width: 0; font: 400 17px/24px var(--font-sans); color: var(--ink); }
.aq-limit-writers__sh:hover .aq-limit-writers__sheet { transform: translateX(var(--space-1)); border-color: var(--flow); }

/* the two lists: what stays the same, what changes */
.aq-limit-writers__lists { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--space-12); row-gap: var(--space-8); }
.aq-limit-writers__ch { margin: 0 0 var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid var(--line-strong); font: 400 20px/28px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
.aq-limit-writers__col--chg .aq-limit-writers__ch { border-bottom-color: var(--flow); }
.aq-limit-writers__rows { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-8); }
.aq-limit-writers__col--chg .aq-limit-writers__rows { grid-template-columns: minmax(0, 1fr); }
.aq-limit-writers__row { display: grid; grid-template-columns: var(--space-8) minmax(0, 1fr); column-gap: var(--space-2); row-gap: var(--space-1); align-content: start; }
.aq-limit-writers__row > * { grid-column: 2; }
.aq-limit-writers__row > .aq-index, .aq-limit-writers__bm { grid-column: 1; grid-row: 1; font: 400 13px/24px var(--font-mono); color: var(--ink-subtle); }
.aq-limit-writers__col--chg .aq-limit-writers__row > .aq-index { color: var(--flow); }
.aq-limit-writers__t { margin: 0; font: 500 16px/24px var(--font-sans); color: var(--ink); }
.aq-limit-writers__t a { color: inherit; text-decoration: none; }
.aq-limit-writers__t a::after { content: "\00a0\2192"; color: var(--flow); display: inline-block; transition: transform 200ms; }
.aq-limit-writers__t a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; text-decoration-color: var(--flow); }
.aq-limit-writers__t a:hover::after { transform: translateX(var(--space-1)); }
.aq-limit-writers__t a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-limit-writers__d { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--ink-muted); }
.aq-limit-writers__row--base { padding-top: var(--space-4); border-top: 1px dashed var(--line-strong); }
.aq-limit-writers__bm { align-self: center; width: var(--space-3); height: var(--space-3); margin-top: 0; border: 2px solid var(--flow); border-radius: var(--radius-pill); box-sizing: border-box; }
.aq-limit-writers__row--base .aq-limit-writers__t { font: 500 12px/20px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
.aq-limit-writers__note { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--ink-muted); }

@container (max-width: 1100px) {
  .aq-limit-writers__lists { column-gap: var(--space-8); }
  .aq-limit-writers__rows { grid-template-columns: minmax(0, 1fr); }
  .aq-limit-writers__name { font-size: 16px; }
}

/* Tablets and phones: the lists stacked; the drawing keeps its desktop form down to 600 px */
@container (max-width: 860px) {
  .aq-limit-writers { gap: var(--space-8); }
  .aq-limit-writers__lists { grid-template-columns: minmax(0, 1fr); }
  .aq-limit-writers__rows { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .aq-limit-writers__ch { font-size: 18px; line-height: 25px; }
  .aq-limit-writers__d { font-size: var(--aq-read-phone, 14px); line-height: 21px; }
  .aq-limit-writers__t { display: flex; align-items: center; min-height: var(--aq-hit, 44px); line-height: 22px; }
  .aq-limit-writers__t a { display: inline-flex; align-items: center; min-height: var(--aq-hit, 44px); }
  .aq-limit-writers__row > .aq-index, .aq-limit-writers__bm { line-height: 44px; }
  .aq-limit-writers__bm { align-self: center; }
  .aq-limit-writers__row { row-gap: 0; }
  /* the monitoring line is a sentence with a destination, so it reads at 14 px sans, not as a mono label */
  .aq-limit-writers__row--base .aq-limit-writers__t { display: block; padding-block: var(--space-2); font: 500 14px/21px var(--font-sans); letter-spacing: 0; text-transform: none; }
  .aq-limit-writers__row--base .aq-limit-writers__t a { display: inline; }
}

/* Phones: the package on top; its outlet run drops down the right edge into a riser, with the sheets branching off it
   on short tees to the left, so one pipe runs from the tank to every limit-writer */
@container (max-width: 600px) {
  .aq-limit-writers__fig { grid-template-columns: minmax(0, 1fr); min-height: 0; }
  .aq-limit-writers__skid { position: relative; margin-bottom: calc(-1 * var(--space-2)); }
  .aq-limit-writers__skid .aq-limit-writers__iso { max-height: 220px; }
  .aq-limit-writers__stub { display: inline; }
  /* IsoKit rounds every iso path's ends; the run must stop square at the elbow */
  .aq-limit-writers__iso .aq-limit-writers__stub path { stroke-linecap: butt; }
  /* the drop: an elbow at the outlet run's end (the drawing's right edge, mid height), then down to the riser. Walls and
     water are drawn as gradients so the elbow stays open where the run comes in from the left */
  .aq-limit-writers__skid::after { content: ""; position: absolute; right: 0; top: calc(50% - var(--space-3) / 2); bottom: calc(-1 * var(--space-2)); width: var(--space-3);
    background: linear-gradient(var(--flow), var(--flow)) 50% 5px / 2px 100% no-repeat, linear-gradient(var(--flow), var(--flow)) 0 5px / 50% 2px no-repeat,
      linear-gradient(var(--line-strong), var(--line-strong)) 0 0 / 100% 1px no-repeat, linear-gradient(var(--line-strong), var(--line-strong)) 100% 0 / 1px 100% no-repeat,
      linear-gradient(var(--line-strong), var(--line-strong)) 0 11px / 1px 100% no-repeat, var(--surface); }
  .aq-limit-writers__pipe { display: none; }
  .aq-limit-writers__sheets { position: relative; padding-right: calc(var(--space-3) + var(--space-6)); }
  .aq-limit-writers__sheets::before { content: ""; position: absolute; right: 0; top: 0; bottom: calc(100% / var(--n, 5) / 2 - 6px); width: var(--space-3); box-sizing: border-box;
    border: 1px solid var(--line-strong); border-top: 0; background: linear-gradient(var(--flow), var(--flow)) 50% 0 / 2px calc(100% - 5px) no-repeat var(--surface); }
  .aq-limit-writers__sh { position: relative; padding-block: var(--space-1); }
  /* each tee runs into the riser to its water line, so the riser's wall opens where the tee joins */
  .aq-limit-writers__sh::before { content: ""; position: absolute; right: calc(-1 * var(--space-6) - 7px); top: 50%; width: calc(var(--space-6) + 7px); height: var(--space-3);
    margin-top: calc(var(--space-3) / -2); background: linear-gradient(var(--flow), var(--flow)) 0 50% / 100% 2px no-repeat,
      linear-gradient(var(--line-strong), var(--line-strong)) 0 0 / var(--space-6) 1px no-repeat, linear-gradient(var(--line-strong), var(--line-strong)) 0 100% / var(--space-6) 1px no-repeat, var(--surface); }
  .aq-limit-writers__sheet { min-height: 48px; padding: var(--space-2) var(--space-6) var(--space-2) var(--space-3); gap: var(--space-3); }
  .aq-limit-writers__name { font-size: 15px; line-height: 21px; }
  /* the stage lists (pass 12 round C): the number inline before the title, no 40 px gutter, the text full width under
     both, 8 px between items; a title without a link drops the 44 px target height */
  .aq-limit-writers__rows { gap: var(--space-2); }
  .aq-limit-writers__row { grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-2); }
  .aq-limit-writers__row > .aq-limit-writers__d { grid-column: 1 / -1; }
  .aq-limit-writers__row > .aq-index { align-self: center; line-height: 22px; }
  /* the title line is 30 px; a linked title keeps its 44 px target as padding that reaches into the space round it */
  .aq-limit-writers__t { min-height: 0; padding-block: var(--space-1); }
  .aq-limit-writers__t a { min-height: 0; padding-block: 11px; margin-block: -11px; }
  .aq-limit-writers__row--base .aq-limit-writers__t { padding-block: var(--space-3) var(--space-1); }
}

/* ---------- LinkGrid: choices (usually pages) as rows of the shared list grammar ---------- */
/* Built on .aq-rows (base.css): index | title (-> when it links) | one line and an optional tag, with the linked page's
   drawing or the row's icon at the row end on desktop. `line` hairlines between rows are the only structure. LinkGrid
   sets the titles at h3 size and gives the row-end drawing room to read. */
.aq-linkgrid .aq-rows__row { align-items: start; padding-block: var(--space-6); }
.aq-linkgrid .aq-rows__row > .aq-index { line-height: 28px; }
.aq-linkgrid .aq-rows__t { font: 500 20px/28px var(--font-sans); letter-spacing: -0.005em; transition: color 200ms; }
.aq-linkgrid .aq-rows__d { padding-top: var(--space-1); }
/* Row-end drawing: 96 px in ink-muted, flow on hover (base.css) */
.aq-linkgrid:has(.aq-rows__art) .aq-rows__row { grid-template-columns: var(--space-12) minmax(0, 4fr) minmax(0, 7fr) var(--space-12); }
.aq-linkgrid .aq-rows__art { transition: background-color 200ms; }
@media (prefers-reduced-motion: reduce) { .aq-linkgrid .aq-rows__art, .aq-linkgrid .aq-rows__t { transition: none; } }

@container (max-width: 860px) {
  .aq-linkgrid .aq-rows__row, .aq-linkgrid:has(.aq-rows__art) .aq-rows__row { grid-template-columns: var(--space-8) minmax(0, 1fr); column-gap: var(--space-3); padding-block: var(--space-4); }
  .aq-linkgrid .aq-rows__row > .aq-index { line-height: 26px; }
  .aq-linkgrid .aq-rows__t { font-size: 18px; line-height: 26px; }
}

/* ---------- LoopCircuit: the loop as one blueprint P&ID strip on a navy band, a station over each caption ---------- */
/* The section carries data-theme="dark", so flow is the light water blue and ink the light line colour. */
.aq-loop-circuit-sec .aq-sec-head .aq-h1 { font: 300 72px/76px var(--font-sans); letter-spacing: -0.03em; max-width: none; color: var(--on-navy); }
.aq-loop-circuit { display: flex; flex-direction: column; gap: 0; --col: calc(100% / var(--n, 7)); }
.aq-loop-circuit__strip { position: relative; border-top: 1px solid var(--line); padding-top: var(--space-8); }
.aq-loop-circuit__svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-loop-circuit__svg path, .aq-loop-circuit__svg circle { fill: none; stroke-linecap: round; stroke-linejoin: round; }
.aq-loop-circuit__col { stroke: var(--on-navy-muted); stroke-width: 1; opacity: 0.22; }
.aq-loop-circuit__pipe { stroke: var(--line-strong); stroke-width: 7; }
.aq-loop-circuit__flow { stroke: var(--flow); stroke-width: 2; }
.aq-loop-circuit__route { stroke: none; }
.aq-loop-circuit__chev { stroke: var(--navy); stroke-width: 2.5; }
.aq-loop-circuit__svg .aq-loop-circuit__eq { fill: var(--navy); stroke: var(--on-navy-muted); stroke-width: 1.5; }
.aq-loop-circuit__svg .aq-loop-circuit__det { fill: var(--navy); stroke: var(--on-navy-muted); stroke-width: 1; stroke-dasharray: 3 4; }
.aq-loop-circuit__svg .aq-loop-circuit__pt { fill: var(--on-navy-muted); stroke: none; }
.aq-loop-circuit__eq.is-opt { stroke-dasharray: 5 4; }
.aq-loop-circuit__ln { stroke: var(--on-navy-muted); stroke-width: 1.5; }
.aq-loop-circuit__thin { stroke: var(--on-navy-muted); stroke-width: 1; opacity: 0.7; }
.aq-loop-circuit__hid { stroke: var(--on-navy-muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
.aq-loop-circuit__level { stroke: var(--flow); stroke-width: 1.5; }
.aq-loop-circuit__hatch { stroke: var(--flow); stroke-width: 1; opacity: 0.4; }
.aq-loop-circuit__jet { stroke: var(--flow); stroke-width: 1.2; stroke-dasharray: 2 5; }
.aq-loop-circuit__drop { stroke: var(--flow); stroke-width: 1.5; }
.aq-loop-circuit__tx { fill: var(--on-navy); font: 400 11px/1 var(--font-mono); text-anchor: middle; }
.aq-loop-circuit__svg .aq-loop-circuit__mk { fill: var(--navy); stroke: var(--flow); stroke-width: 2; }
.aq-loop-circuit__svg .aq-loop-circuit__mk-dot { fill: var(--flow); stroke: none; }
.aq-loop-circuit__node.is-hot .aq-loop-circuit__eq, .aq-loop-circuit__node.is-hot .aq-loop-circuit__ln,
.aq-loop-circuit__node.is-on .aq-loop-circuit__eq { stroke: var(--flow); }
.aq-loop-circuit__svg * { transition: stroke 200ms cubic-bezier(0.2, 0, 0, 1), fill 200ms cubic-bezier(0.2, 0, 0, 1); }

/* Captions: one column per station, the rule continues the strip's column lines */
.aq-loop-circuit__stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 7), minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--line-strong); }
.aq-loop-circuit__stage { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-4) var(--space-4) 0; border-left: 1px solid var(--line); position: relative; }
.aq-loop-circuit__stage:first-child { border-left: 0; padding-left: 0; }
.aq-loop-circuit__stage::before { content: ""; position: absolute; left: 0; right: 0; top: -1px; border-top: 2px solid var(--flow); transform: scaleX(0); transform-origin: 0 50%; transition: transform 300ms cubic-bezier(0.2, 0, 0, 1); }
.aq-loop-circuit__stage.is-hot::before, .aq-loop-circuit__stage.is-on::before { transform: scaleX(1); }
.aq-loop-circuit__mark { display: none; }
.aq-loop-circuit__no { margin: 0; font: 400 14px/20px var(--font-mono); color: var(--on-navy-muted); font-variant-numeric: tabular-nums; transition: color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-loop-circuit__stage.is-on .aq-loop-circuit__no, .aq-loop-circuit__stage.is-hot .aq-loop-circuit__no { color: var(--flow); }
.aq-loop-circuit__t { margin: 0; font: 500 16px/22px var(--font-sans); color: var(--on-navy); }
.aq-loop-circuit__d { margin: 0; font: 400 14px/22px var(--font-sans); color: var(--on-navy-muted); }

.aq-loop-circuit-sec { overflow: hidden; }
.aq-loop-circuit__spray, .aq-loop-circuit__water { pointer-events: none; }

@container (max-width: 1100px) {
  .aq-loop-circuit-sec .aq-sec-head .aq-h1 { font-size: 56px; line-height: 60px; }
  .aq-loop-circuit__stage { padding-left: var(--space-3); padding-right: var(--space-2); }
  .aq-loop-circuit__d { font-size: 13px; line-height: 20px; }
}
.aq-loop-circuit__sp, .aq-loop-circuit__rp, .aq-loop-circuit__tt, .aq-loop-circuit__ts, .aq-loop-circuit__bt { display: none; }

/* Phones (pass 12, S10): a vertical circuit. Supply down the left edge through each station's marker (stations 01-06),
   a turn at the foot, the return up the right edge past the spray ball's marker (07) and over into the tank head.
   The stop text sits between the pipes. Pipes are twin walls (on-navy-muted) with the water down the middle (flow);
   chevrons give the direction. */
@container (max-width: 860px) {
  .aq-loop-circuit-sec .aq-sec-head .aq-h1 { font-size: 44px; line-height: 50px; }
  .aq-loop-circuit__strip { display: none; }
  .aq-loop-circuit__stages { position: relative; grid-template-columns: minmax(0, 1fr); gap: 0; padding: var(--space-6) 0 0 var(--space-16); border-top: 0; }
  .aq-loop-circuit__stage, .aq-loop-circuit__stage:first-child { position: relative; border-left: 0; padding: 0 var(--space-8) var(--space-6) 0; }
  .aq-loop-circuit__stage[data-node="spray"] { padding-right: var(--space-16); }
  .aq-loop-circuit__stage::before { display: none; }
  .aq-loop-circuit__mark { display: grid; place-items: center; position: absolute; z-index: 1; left: calc(-1 * var(--space-16)); top: 0; width: calc(var(--space-8) + var(--space-2)); height: calc(var(--space-8) + var(--space-2));
    box-sizing: border-box; background: var(--navy); border: 1.5px solid var(--flow); }
  .aq-loop-circuit__stage[data-node="spray"] .aq-loop-circuit__mark { left: auto; right: 0; }
  .aq-loop-circuit__glyph.aq-spot { width: var(--space-6); height: var(--space-6); }
  .aq-loop-circuit__no { font-size: 13px; }
  .aq-loop-circuit__d { font-size: 15px; line-height: 23px; }

  /* the pipes (positions from the li: the left pipe's centre 44 px left of the text, the right pipe's 20 px in from the edge) */
  .aq-loop-circuit__sp, .aq-loop-circuit__rp, .aq-loop-circuit__ts, .aq-loop-circuit__tt, .aq-loop-circuit__bt { display: block; position: absolute; box-sizing: border-box; border: 0 solid var(--on-navy-muted); }
  .aq-loop-circuit__sp, .aq-loop-circuit__rp, .aq-loop-circuit__ts { width: 10px; border-inline-width: 1px; background: linear-gradient(var(--flow), var(--flow)) 50% 0 / 2px 100% no-repeat; }
  .aq-loop-circuit__tt, .aq-loop-circuit__bt { height: 10px; border-block-width: 1px; background: linear-gradient(var(--flow), var(--flow)) 0 50% / 100% 2px no-repeat; }
  .aq-loop-circuit__sp { left: calc(-1 * var(--space-16) + 15px); top: 0; bottom: 0; }
  .aq-loop-circuit__stage:first-child .aq-loop-circuit__sp { top: var(--space-4); }
  .aq-loop-circuit__stage[data-node="spray"] .aq-loop-circuit__sp { display: none; }
  .aq-loop-circuit__rp { right: 15px; top: 0; bottom: 0; }
  .aq-loop-circuit__stage:first-child .aq-loop-circuit__rp { display: none; }
  .aq-loop-circuit__stage[data-node="tank"] .aq-loop-circuit__rp { top: -17px; }
  /* the return into the tank head: across the gap above the tank, then down into its marker beside the supply */
  .aq-loop-circuit__tt { left: calc(-1 * var(--space-16) + 29px); right: 15px; top: -17px; border-right-width: 1px; }
  .aq-loop-circuit__ts { left: calc(-1 * var(--space-16) + 29px); top: -17px; height: 18px; border-top-width: 1px; }
  /* the turn at the foot: supply over to the return (the last row's pipes stop at it) */
  .aq-loop-circuit__stage:last-child .aq-loop-circuit__sp, .aq-loop-circuit__stage:last-child .aq-loop-circuit__rp { bottom: var(--space-2); }
  .aq-loop-circuit__stage:last-child[data-node="spray"] .aq-loop-circuit__sp { display: block; }
  .aq-loop-circuit__stage:last-child[data-node="spray"] .aq-loop-circuit__rp { top: var(--space-8); }
  .aq-loop-circuit__bt { left: calc(-1 * var(--space-16) + 15px); right: 15px; bottom: var(--space-2); border-inline-width: 1px; }
  /* direction: a chevron on each straight run (down on the supply, up on the return) */
  .aq-loop-circuit__sp::after, .aq-loop-circuit__rp::after { content: ""; position: absolute; left: 50%; top: 55%; width: 6px; height: 6px; margin: -4px 0 0 -4px;
    border: solid var(--flow); border-width: 0 2px 2px 0; transform: rotate(45deg); background: var(--navy); }
  .aq-loop-circuit__rp::after { transform: rotate(225deg); top: 45%; }
  .aq-loop-circuit__stage:first-child .aq-loop-circuit__sp::after { display: none; }
}
.aq-loop-circuit__flow--feed, .aq-loop-circuit__flow--loop { fill: none; }

/* ---------- LoopDock: options on one isometric loop drawn on a navy band, leaders down to captions on limestone ---------- */
.aq-loop-dock-sec .aq-sec-head .aq-h1 { font: 300 72px/76px var(--font-sans); letter-spacing: -0.03em; }
.aq-loop-dock { display: flex; flex-direction: column; gap: 0; }
.aq-loop-dock__band { position: relative; background: var(--navy); }
.aq-loop-dock__plane { position: relative; aspect-ratio: 1200 / 560; }
.aq-loop-dock__zoom { position: absolute; inset: 0; }
.aq-loop-dock__svg, .aq-loop-dock__leads { position: absolute; inset: 0; width: 100%; height: 100%; }
.aq-loop-dock__leads { overflow: visible; pointer-events: none; }
.aq-loop-dock__lead { fill: none; stroke: var(--on-navy-muted); stroke-width: 1; vector-effect: non-scaling-stroke; transition: stroke 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-loop-dock__dot { fill: var(--on-navy); stroke: none; transition: fill 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-loop-dock__lead.is-on { stroke: var(--flow); stroke-width: 2; }
.aq-loop-dock__dot.is-on { fill: var(--flow); }
.aq-loop-dock__mk { position: absolute; z-index: 1; display: grid; place-items: center; width: var(--space-8); height: var(--space-8); translate: -50% -130%;
  background: var(--limestone); color: var(--on-limestone); font: 500 12px/1 var(--font-mono); transition: translate 200ms cubic-bezier(0.2, 0, 0, 1), background-color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-loop-dock__mk::after { content: ""; position: absolute; left: 50%; top: 100%; height: var(--space-3); border-left: 1px solid var(--limestone); }
.aq-loop-dock__mk.is-on { background: var(--flow); color: var(--navy); translate: -50% -150%; }
.aq-loop-dock__mk.is-on::after { border-color: var(--flow); }
/* The base's name left of the tank: glyph over the words, both set flush right against the tank */
.aq-loop-dock__base { position: absolute; display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-2); translate: calc(-100% - var(--space-6)) -50%; width: max-content; max-width: calc(var(--space-32) + var(--space-8)); text-align: right;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
.aq-loop-dock__bic.aq-spot { width: var(--space-6); height: var(--space-6); }

/* Captions on the limestone below, one column each; the leader lands on each column's top-left */
.aq-loop-dock__cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); gap: 0; }
.aq-loop-dock__card { display: flex; }
.aq-loop-dock__body { flex: 1; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-6) var(--space-8) 0 var(--space-6); color: var(--on-limestone); text-decoration: none;
  border-left: 1px solid var(--on-limestone-muted); transition: border-color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-loop-dock__card.is-on .aq-loop-dock__body { border-left-color: var(--flow); }
/* pass 12 C: a space-4 foot under each caption on desktop, so a closing placeholder chip does not sit on the edge
   (phones keep their own padding, below) */
.aq-loop-dock__body { padding-bottom: var(--space-4); }
.aq-loop-dock__no { margin: 0; display: flex; align-items: center; justify-content: space-between; font: 400 24px/1 var(--font-mono); color: var(--on-limestone-muted); }
.aq-loop-dock__card.is-on .aq-loop-dock__no span { color: var(--flow); }
.aq-loop-dock__glyph.aq-spot { width: var(--space-6); height: var(--space-6); background-color: var(--on-limestone-muted); }
.aq-loop-dock__t { margin: var(--space-2) 0 0; font: 400 24px/30px var(--font-sans); letter-spacing: -0.01em; }
.aq-loop-dock__d { margin: 0; font: 400 15px/23px var(--font-sans); color: var(--on-limestone-muted); max-width: 36ch; }
a.aq-loop-dock__body:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* Desktop shows every option; the fold is for phones */
.aq-fold:not(.is-open) .aq-loop-dock__card.aq-fold-x { display: flex; }
.aq-fold:has(> .aq-loop-dock) > .aq-fold__btn { display: none; }

.aq-loop-dock-sec { overflow: hidden; }

@container (max-width: 1100px) {
  .aq-loop-dock-sec .aq-sec-head .aq-h1 { font-size: 56px; line-height: 60px; }
}
@container (max-width: 860px) {
  .aq-loop-dock-sec .aq-sec-head .aq-h1 { font-size: 44px; line-height: 50px; }
  .aq-loop-dock__band { margin-inline: calc(-1 * var(--space-4)); padding: var(--space-6) 0 var(--space-4); }
  .aq-loop-dock__leads { display: none; }
  /* the plate crops to the drawing (--ca, --cl, --ct, --cw, --ch from the renderer): about twice the size at 375 px */
  .aq-loop-dock__plane { aspect-ratio: var(--ca, 1200 / 560); overflow: hidden; }
  .aq-loop-dock__zoom { inset: auto; left: calc(-1 * var(--cl, 0%)); top: calc(-1 * var(--ct, 0%)); width: var(--cw, 100%); height: var(--ch, 100%); }
  .aq-loop-dock__mk { width: calc(var(--space-6) + var(--space-1)); height: calc(var(--space-6) + var(--space-1)); font-size: 14px; }
  .aq-loop-dock__base { font-size: 13px; }
  .aq-loop-dock__base { position: static; translate: none; white-space: normal; margin: var(--space-2) var(--space-4) 0; flex-direction: row; align-items: center; width: auto; max-width: none; text-align: left; }
  .aq-loop-dock__cards { grid-template-columns: minmax(0, 1fr); }
  .aq-loop-dock__body { padding: var(--space-6) 0 0 var(--space-4); }
  .aq-fold:not(.is-open) .aq-loop-dock__card.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-loop-dock) > .aq-fold__btn { display: flex; }
}

/* ---------- MacroLeaders: a table read off a macro drawing (look "macro-leaders") ----------
   Desktop: the macro (membrane leaves over a PP pipe and weld bead, flat tonal fills, no gradients) bleeds off the left
   page edge; the table sits right. Each row's name cell carries a leader that runs left over the drawing to a numbered
   marker; leader lengths follow an arc (--k, 0 to 1, from the renderer) so the markers stand on a curve.
   Phones: the macro is a band above the table; rows are records on a rail of markers. */
.aq-macro-leaders-sec { overflow-x: clip; }
.aq-macro-leaders { position: relative; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: var(--space-8); align-items: stretch; }
.aq-macro-leaders__fig { margin: 0; }
/* the drawing is placed against the whole component (the fig stays static) so it can bleed to the viewport's left edge */
.aq-macro-leaders__svg { position: absolute; top: calc(-1 * var(--space-8)); bottom: calc(-1 * var(--space-8)); left: calc(50% - 50vw); width: calc(50vw - 50% + (100% - var(--space-8)) / 3); height: calc(100% + 2 * var(--space-8)); }
.aq-macro-leaders__svg path, .aq-macro-leaders__svg ellipse { vector-effect: non-scaling-stroke; stroke-linejoin: round; stroke-linecap: round; }
.aq-macro-leaders__layer, .aq-macro-leaders__pipe, .aq-macro-leaders__bead { pointer-events: none; }
.aq-macro-leaders__leaf { fill: var(--surface-raised); stroke: var(--line-strong); stroke-width: 1; }
.aq-macro-leaders__leaf--spacer { fill: var(--flow-tint); }
.aq-macro-leaders__edge { fill: var(--surface-sunken); stroke: var(--line-strong); stroke-width: 1; }
.aq-macro-leaders__tex { stroke: none; opacity: 0.55; }
.aq-macro-leaders__hatch { fill: none; stroke: var(--line); stroke-width: 1; }
.aq-macro-leaders__leaf--spacer + .aq-macro-leaders__tex { opacity: 0.8; }
.aq-macro-leaders__water { fill: none; stroke: var(--flow); stroke-width: 1.5; opacity: 0.7; }
.aq-macro-leaders__pp { fill: var(--surface-sunken); stroke: none; }
.aq-macro-leaders__hi { fill: var(--surface-raised); stroke: none; }
.aq-macro-leaders__lo { fill: color-mix(in srgb, var(--surface-sunken) 82%, var(--ink)); stroke: none; }
.aq-macro-leaders__ol { fill: none; stroke: var(--line-strong); stroke-width: 1.5; }
ellipse.aq-macro-leaders__pp.aq-macro-leaders__ol { fill: var(--surface-sunken); }
.aq-macro-leaders__seam { fill: none; stroke: var(--line-strong); stroke-width: 1; }
.aq-macro-leaders__lbl { font: 500 11px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; fill: var(--ink-muted); }

/* Table */
.aq-macro-leaders__table { position: relative; z-index: 1; width: 100%; border-collapse: collapse; table-layout: fixed; }
.aq-macro-leaders__table thead th { padding: 0 var(--space-3) var(--space-3) 0; text-align: left; vertical-align: bottom; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); border-bottom: 1px solid var(--line-strong); }
.aq-macro-leaders__table thead th:first-child { width: 29%; }
.aq-macro-leaders__table thead th:nth-child(2) { width: 25%; }
.aq-macro-leaders__table thead th:nth-child(3) { width: 22%; }
.aq-macro-leaders__table tbody tr { border-bottom: 1px solid var(--line); transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-macro-leaders__table tbody th, .aq-macro-leaders__table td { padding: var(--space-4) var(--space-3) var(--space-4) 0; text-align: left; vertical-align: top; }
.aq-macro-leaders__table td { font: 400 14px/22px var(--font-sans); color: var(--ink-muted); overflow-wrap: break-word; }
.aq-macro-leaders__table td:nth-child(2) { color: var(--ink); }
.aq-macro-leaders__ind { position: relative; padding-left: var(--space-3) !important; }
.aq-macro-leaders__name { display: block; font: 300 24px/30px var(--font-sans); letter-spacing: -0.015em; color: var(--ink); text-wrap: balance; }
.aq-macro-leaders__name a { color: var(--ink); text-decoration: none; }
.aq-macro-leaders__name a::after { content: "\a0\2192"; font-size: 0.7em; color: var(--flow); }
.aq-macro-leaders__name a:hover { color: var(--flow); }
.aq-macro-leaders__name a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-macro-leaders__k { display: none; }

/* Leader and marker: from the left edge of the name cell, back over the drawing */
.aq-macro-leaders__lead {
  position: absolute; right: 100%; top: calc(var(--space-4) + 15px); height: 1px;
  width: calc(var(--space-12) + var(--k, 0) * var(--space-24)); background: var(--ink-muted); transform-origin: 0% 50%;
}
.aq-macro-leaders__lead::after { content: ""; position: absolute; right: 0; top: -2px; width: 5px; height: 5px; border-radius: var(--radius-pill); background: var(--ink-muted); }
.aq-macro-leaders__mk {
  position: absolute; left: 0; top: 50%; display: grid; place-items: center; width: var(--space-8); height: var(--space-8); margin: calc(-1 * var(--space-4)) 0 0 calc(-1 * var(--space-4));
  border: 1.5px solid var(--flow); border-radius: var(--radius-pill); background: var(--surface); box-sizing: border-box;
  font: 500 12px/1 var(--font-mono); color: var(--flow); font-variant-numeric: tabular-nums;
}
.aq-macro-leaders__table tbody tr:hover, .aq-macro-leaders__table tbody tr:focus-within { background: var(--flow-tint); }
.aq-macro-leaders__table tbody tr:hover .aq-macro-leaders__lead, .aq-macro-leaders__table tbody tr:focus-within .aq-macro-leaders__lead,
.aq-macro-leaders__table tbody tr:hover .aq-macro-leaders__lead::after, .aq-macro-leaders__table tbody tr:focus-within .aq-macro-leaders__lead::after { background: var(--flow); }
.aq-macro-leaders__table tbody tr:hover .aq-macro-leaders__mk, .aq-macro-leaders__table tbody tr:focus-within .aq-macro-leaders__mk { background: var(--flow); color: var(--surface); }
@media (prefers-reduced-motion: no-preference) {
  .aq-macro-leaders__mk { transition: background-color 200ms, color 200ms, transform 200ms cubic-bezier(0.2, 0, 0, 1); }
  .aq-macro-leaders__table tbody tr:hover .aq-macro-leaders__mk { transform: scale(1.12); }
}

/* Crosshair (motion only, ported from Subframe Motion "Chart crosshair"): a row rule and a column rule snap to the cell
   under the pointer; the column head lights and the cell takes the flow tint */
.aq-macro-leaders__xh, .aq-macro-leaders__xv { position: absolute; left: 0; top: 0; z-index: 2; pointer-events: none; display: none; opacity: 0; visibility: hidden; background: var(--flow); }
.aq-macro-leaders__xh { height: 1px; }
.aq-macro-leaders__xv { width: 1px; }
.aq-macro-leaders__table thead th { transition: color 150ms; }
.aq-macro-leaders__table thead th.is-col { color: var(--flow); }
.aq-macro-leaders__table .is-cell { background: color-mix(in srgb, var(--flow-tint) 60%, transparent); }

@container (max-width: 1180px) {
  .aq-macro-leaders { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); column-gap: var(--space-6); }
  .aq-macro-leaders__svg { width: calc(50vw - 50% + (100% - var(--space-6)) / 4); }
  .aq-macro-leaders__name { font-size: 20px; line-height: 26px; }
}

@container (max-width: 860px) {
  .aq-macro-leaders { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); }
  .aq-macro-leaders__fig { position: relative; height: calc(var(--space-32) + var(--space-16)); margin-inline: calc(-1 * var(--space-4)); overflow: hidden; }
  .aq-macro-leaders__svg { inset: 0; width: 100%; height: 100%; }
  .aq-macro-leaders__table, .aq-macro-leaders__table tbody, .aq-macro-leaders__table tr, .aq-macro-leaders__table th, .aq-macro-leaders__table td { display: block; width: auto !important; }
  .aq-macro-leaders__table thead { display: none; }
  .aq-macro-leaders__table tbody { position: relative; }
  .aq-macro-leaders__table tbody::before { content: ""; position: absolute; left: calc(var(--space-4) - 0.5px); top: var(--space-6); bottom: var(--space-6); width: 1px; background: var(--line-strong); }
  .aq-macro-leaders__table tbody tr { position: relative; padding: var(--space-4) 0 var(--space-4) var(--space-12); }
  .aq-macro-leaders__table tbody th, .aq-macro-leaders__table td { padding: 0; }
  .aq-macro-leaders__ind { position: static; padding-left: 0 !important; margin-bottom: var(--space-2); }
  .aq-macro-leaders__name { font-size: 22px; line-height: 28px; }
  .aq-macro-leaders__lead { right: auto; left: var(--space-4); top: calc(var(--space-4) + 14px); width: var(--space-6); }
  .aq-macro-leaders__lead::after { display: none; }
  .aq-macro-leaders__mk { left: 0; }
  /* pass 12: no macro crop; one legend; each value a colour-coded line */
  .aq-macro-leaders__fig { display: none; }
  .aq-macro-leaders__legend { display: flex; flex-direction: column; gap: var(--space-2); margin: 0; padding: var(--space-3) 0; border-bottom: 1px solid var(--line-strong); }
  .aq-macro-leaders__legend span { display: flex; align-items: center; gap: var(--space-2); font: 500 14px/20px var(--font-sans); color: var(--ink); }
  .aq-macro-leaders__legend span::before { content: ""; flex: none; width: 3px; height: 18px; background: var(--ml-c, var(--flow)); }
  .aq-macro-leaders__table td { padding: var(--space-1) 0 var(--space-1) var(--space-3); margin-top: var(--space-1); border-left: 3px solid var(--ml-c, var(--flow)); font-size: 15px; line-height: 22px; color: var(--ink); }
  .aq-macro-leaders [data-c="1"] { --ml-c: var(--flow); }
  .aq-macro-leaders [data-c="2"] { --ml-c: var(--ink); }
  .aq-macro-leaders [data-c="3"] { --ml-c: var(--caution); }
  .aq-macro-leaders [data-c="4"] { --ml-c: var(--line-strong); }
  .aq-macro-leaders__table td:nth-child(2) { color: var(--ink); }
  .aq-macro-leaders__k { display: none; }
}
.aq-macro-leaders__legend { display: none; }
@container (max-width: 860px) { .aq-macro-leaders__legend { display: flex; } }
.aq-macro-leaders__v { min-width: 0; }
/* Phones (pass 12, F8): the second value's code is a dashed ink rule (in the key and in the rows), so the two codes
   differ by pattern as well as hue (flow and ink read close on paper) */
@container (max-width: 860px) {
  .aq-macro-leaders td[data-c="2"] { border-left-style: dashed; }
  .aq-macro-leaders__legend span[data-c="2"]::before { background: repeating-linear-gradient(to bottom, var(--ink) 0 4px, transparent 4px 7px); }
}
/* Pass 12 round C, macro "pipe-pair" (.aq-macro-leaders--pair): two cut sections (thick-wall natural PP over thin-wall
   316L) and the 0-80 °C band of natural PP between them. The stubs run off the page to the left (overflow visible,
   clipped by the section). */
.aq-macro-leaders--pair .aq-macro-leaders__svg, .aq-macro-leaders__svg--pair { overflow: visible; }
.aq-macro-leaders__sec, .aq-macro-leaders__temp { pointer-events: none; }
.aq-macro-leaders__face { fill: var(--surface-raised); stroke: none; }
.aq-macro-leaders__face-ol { fill: none; }
.aq-macro-leaders__bore { fill: var(--flow-tint); stroke: var(--line-strong); stroke-width: 1; }
.aq-macro-leaders--pair .aq-macro-leaders__tex { opacity: 1; }
.aq-macro-leaders--pair .aq-macro-leaders__hatch { stroke: var(--line-strong); }
