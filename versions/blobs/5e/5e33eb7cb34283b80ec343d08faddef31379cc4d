  .aq-joint-tag__pipe { width: 190%; margin: 0 0 0 -55.8%; }
  .aq-joint-tag__eye { left: 58.8%; }
  /* pins sized for the thumb-width drawing (about 0.6 of desktop scale) */
  .aq-joint-tag__pin circle { r: 24px; }
  .aq-joint-tag__pin text { font-size: 20px; }
  .aq-joint-tag__tag { padding: var(--space-12) var(--space-4) var(--space-6); clip-path: polygon(var(--space-6) 0, calc(100% - var(--space-6)) 0, 100% var(--space-6), 100% 100%, 0 100%, 0 var(--space-6)); }
  .aq-joint-tag__fields { grid-template-columns: minmax(0, 1fr); }
  .aq-joint-tag__th .aq-joint-tag__lg { display: none; }
  .aq-joint-tag__k--sr { position: static; width: auto; height: auto; overflow: visible; clip-path: none; white-space: normal; }
  .aq-joint-tag__field:nth-child(-n+2) { border-top: 0; }
  .aq-joint-tag__field:first-child { border-top: 1px solid var(--line); }
  .aq-fold:not(.is-open) .aq-joint-tag__field.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-joint-tag__fields) > .aq-fold__btn { display: flex; }
}

/* pass 12 round C, seam "plain" (method-neutral, FD-18): one continuous length; the joint is a hairline girth line,
   bowed a little so it reads round the pipe, with the stencilled joint number beside it. */
.aq-joint-tag--plain .aq-joint-tag__girth { fill: none; stroke: var(--on-limestone); stroke-width: 1.5; }

/* pass 12 round C phone (audit S7: never fold a field a pin points at): every field shows, each a compact row, the
   number beside the name and what it proves and the record under the name; the tag's legend names the proves column
   once, so the per-field label goes back to screen readers only. */
@container (max-width: 860px) {
  .aq-fold:not(.is-open) .aq-joint-tag__field.aq-fold-x { display: grid; }
  .aq-fold:has(> .aq-joint-tag__fields) > .aq-fold__btn { display: none; }
  .aq-joint-tag__th span:last-child { white-space: nowrap; }
  .aq-joint-tag__field, .aq-fold:not(.is-open) .aq-joint-tag__field.aq-fold-x {
    display: grid; grid-template-columns: var(--space-8) minmax(0, 1fr); column-gap: 0; row-gap: var(--space-1); padding: var(--space-3) var(--space-4) var(--space-4) var(--space-3);
  }
  .aq-joint-tag__field > .aq-index { grid-column: 1; grid-row: 1; align-self: baseline; margin: 0; }
  .aq-joint-tag__name { grid-column: 2; grid-row: 1; }
  .aq-joint-tag__proves, .aq-joint-tag__rec { grid-column: 2; }
  .aq-joint-tag__k--sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .aq-joint-tag__rec { margin-top: var(--space-2); padding-top: 0; }
  .aq-joint-tag__rec .aq-joint-tag__k { margin-bottom: 0; }
