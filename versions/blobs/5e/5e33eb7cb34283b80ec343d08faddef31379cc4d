/* A micro sign inside uppercase labels stays µ (µS/cm), never M */
.aq-unit { text-transform: none; }

/* ---------- Phone floor (pass 12, visual-audit §2 S4, S5, S6, S13, S14) ----------
   Tokens (tokens.json, family "phone"; looks read them as var(--name, fallback) so they never wait on this file):
   --aq-read-phone 14px  the floor for every reading line on phones (notes, basis lines, list detail, captions);
                         mono labels and eyebrows may stay 11-12 px
   --aq-faq-phone  15px  FAQ answers and other answer text
   --aq-chip-phone 13px  a [placeholder] chip set in 15 px body
   --aq-num-phone  44px  a big numeral set inline to the left of its title (40-48 px), never 76-100 px above it
   --aq-hit        44px  the minimum tap target
   --aq-sheet-rail 6px   a drawing-sheet strip or frame on phones under 600 px
   Rules every look follows in its own CSS: below 600 px, step indents and stair offsets drop to zero (S13). A look that
   sets a plain (class-less) link in its text to flex, inline-flex or inline-block, or pads it itself, lists that link's
   parent in the hit-padding reset below or gives the link a class: the automatic inline hit padding is for inline
   links only. */

/* .aq-hit (S6): a 44 px hit box on a small link or control with no visual change. An invisible ::after, centred on the
   element and at least --aq-hit square, takes the tap; the element is its containing block. Put it on inline "→" links,
   step-title links and chips whose ::after is free (a look that already draws with ::after uses .aq-hit--before). */
.aq-hit, .aq-hit--before { position: relative; }
.aq-hit::after, .aq-hit--before::before {
  content: ""; position: absolute; left: 50%; top: 50%; width: max(100%, var(--aq-hit)); height: max(100%, var(--aq-hit));
  transform: translate(-50%, -50%); background: none; pointer-events: auto;
}
/* Plain links in running text inside a section (no class: the links a look writes into a sentence or a note) reach
   44 px the inline way: block padding on an inline box widens what takes the tap without moving a line or a pixel of
   ink, so no pseudo-element and no counter-margin are needed and a look's own ::after arrow is left alone. A look's
   own padding for its links still wins (base loads first). */
:where(.aq-section, .aq-hero) :where(p, li, dd, td, th, span, small, figcaption, h3, h4) > a:not([class]) {
  --aq-hit-pad: max(0px, calc((var(--aq-hit) - 1.1em) / 2));
  padding-block: var(--aq-hit-pad, 0px);
}
/* Looks that lay their plain links out as boxes (flex / inline-flex / inline-block, or a min-height of their own) keep
   their own sizing: the inline hit padding would grow them. A look that does this adds its link's parent here or gives
   the link a class (and .aq-hit where it is under 44 px). */
:where(.aq-strata-run__base, .aq-standard-wires__chip, .aq-source-skid__go, .aq-site-tiles__go,
       .aq-cert-readout__go, .aq-pipe-collage__go, .aq-request-menu__got) > a:not([class]) { --aq-hit-pad: 0px; }

/* .aq-sheetframe (S14): a drawing-sheet frame (outer border, inner frame, A-D zone gutters, a colophon strip) that
   gives its whole width back to the drawing on phones. Hooks: the frame itself, __inner (the inner frame), __zones
   (zone number or letter gutters and rulers), __strip (the colophon or title strip down one edge). Desktop: nothing
   changes. Below 600 px: no inner frame, no zone gutters, and the strip becomes a --aq-sheet-rail edge rail (its
   text kept for screen readers). */
@container (max-width: 600px) {
  .aq-sheetframe { padding: 0; border-width: 0; outline: 0; }
  .aq-sheetframe .aq-sheetframe__inner { margin: 0; padding: 0; border: 0; outline: 0; box-shadow: none; }
  .aq-sheetframe .aq-sheetframe__zones { display: none; }
  .aq-sheetframe .aq-sheetframe__strip {
    flex: none; width: var(--aq-sheet-rail); min-width: 0; max-width: var(--aq-sheet-rail); padding: 0; overflow: hidden;
    color: transparent; font-size: 0; line-height: 0; writing-mode: horizontal-tb;
  }
  .aq-sheetframe .aq-sheetframe__strip > * { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
}

@container (max-width: 860px) {
  /* S5: placeholders between 13 px and 16 px on phones, whatever the size of the text around them */
  .aq-ph { font-size: max(var(--aq-chip-phone), min(0.86em, 16px)); }
  /* S6: the fold control as a full-width 44 px button with a 24 px key and 14 px words */
  .aq-fold > .aq-fold__btn { min-height: var(--aq-hit); padding-block: var(--space-2); font-size: 14px; }
  .aq-fold > .aq-fold__btn::before { width: var(--space-6); height: var(--space-6); flex: none; }
}

/* ---------- FxCaustics ---------- */
/* The 'caustics' layer's default strength (FxShader rules: faint). A placement sets its own --fx-amt in its component;
   :where keeps this default at zero specificity, so the placement always wins. */
:where(.aq-fx-shader[data-gl="caustics"]) { --fx-amt: 0.3; }

/* ---------- FxContour ---------- */
/* The 'contour' layer's default strength (FxShader rules: faint). A placement sets its own --fx-amt in its component;
   :where keeps this default at zero specificity, so the placement always wins. */
:where(.aq-fx-shader[data-gl="contour"]) { --fx-amt: 0.3; }

/* ---------- FxCutaway ---------- */
/* The 'cutaway' layer's default strength (FxShader rules: faint). A placement sets its own --fx-amt in its component;
   :where keeps this default at zero specificity, so the placement always wins. */
:where(.aq-fx-shader[data-gl="cutaway"]) { --fx-amt: 0.3; }

/* ---------- FxGuilloche ---------- */
/* The 'guilloche' layer's default strength (FxShader rules: faint). A placement sets its own --fx-amt in its component;
   :where keeps this default at zero specificity, so the placement always wins. */
:where(.aq-fx-shader[data-gl="guilloche"]) { --fx-amt: 0.3; }

/* ---------- FxPhosphor ---------- */
/* The 'phosphor' layer's default strength (FxShader rules: faint). A placement sets its own --fx-amt in its component;
   :where keeps this default at zero specificity, so the placement always wins. */
:where(.aq-fx-shader[data-gl="phosphor"]) { --fx-amt: 0.3; }

/* ---------- FxRipple ---------- */
/* The 'ripple' layer's default strength (FxShader rules: faint). A placement sets its own --fx-amt in its component;
   :where keeps this default at zero specificity, so the placement always wins. */
:where(.aq-fx-shader[data-gl="ripple"]) { --fx-amt: 0.3; }

/* ---------- FxShader ---------- */
/* An ambient WebGL layer (assets/src/motion/gl.js) filling its positioned parent, under the content. Empty and
   invisible until a shader has drawn a frame, so the section's own ground shows without WebGL or JS. */
.aq-fx-shader { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; z-index: -1; opacity: 0; transition: opacity 1.2s cubic-bezier(0.2, 0, 0, 1); }
.aq-fx-shader.is-on { opacity: 1; }
.aq-fx-host { position: relative; isolation: isolate; overflow: hidden; }   /* z-index -1 in an isolated host: above its ground, below its content */

@container (max-width: 860px) {
  .aq-fx-shader.is-on { opacity: 0.85; }
}

/* ---------- FxTruchet ---------- */
/* The 'truchet' layer's default strength (FxShader rules: faint). A placement sets its own --fx-amt in its component;
   :where keeps this default at zero specificity, so the placement always wins. */
:where(.aq-fx-shader[data-gl="truchet"]) { --fx-amt: 0.3; }

/* ---------- Icon: a Lucide-style line icon (assets/icons/<name>.svg) painted with a colour token through a mask ---------- */
/* 24 px, 1.5 px stroke at every size (the files keep a non-scaling stroke), coloured ink-muted by default. */
/* The file comes in through an inline mask-image so its URL resolves against the page, not this stylesheet. */
.aq-icon {
  display: inline-block; flex: none; width: var(--space-6); height: var(--space-6);
  background-color: var(--ink-muted);
  -webkit-mask-position: center; mask-position: center; -webkit-mask-size: contain; mask-size: contain;
  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
}
.aq-icon--ink { background-color: var(--ink); }
.aq-icon--flow { background-color: var(--flow); }
.aq-icon--on-navy { background-color: var(--on-navy-muted); }

/* In a row (core.js wRow, item field icon): the icon takes the index column, as tall as the title's 24 px line. */
.aq-rows__lead { display: flex; align-items: center; gap: var(--space-2); align-self: start; }
.aq-rows__lead .aq-index { line-height: var(--space-6); }
/* Ordered steps keep their number beside the icon, so the index column widens. */
.aq-rows:has(.aq-rows__lead--n) .aq-rows__row { grid-template-columns: var(--space-16) minmax(0, 4fr) minmax(0, 7fr); }
a.aq-rows__row .aq-icon { transition: background-color 120ms; }
a.aq-rows__row:hover .aq-icon { background-color: var(--flow); }
@media (prefers-reduced-motion: reduce) { a.aq-rows__row .aq-icon { transition: none; } }

/* Phones: the same 24 px icon; the index column narrows. */
@container (max-width: 860px) {
  .aq-rows__lead { gap: var(--space-1); }
  .aq-rows:has(.aq-rows__lead--n) .aq-rows__row { grid-template-columns: var(--space-12) minmax(0, 1fr); }
}

/* ---------- Illustration: line art painted with a colour token through a mask ---------- */
.aq-illustration { display: block; width: 100%; aspect-ratio: var(--ratio, 1); background-color: var(--ink-muted); -webkit-mask-position: center; mask-position: center; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; }
/* The drawing comes in through an inline mask-image so its URL resolves against the page, not this stylesheet. */
.aq-illustration--ink { background-color: var(--ink); }
.aq-illustration--flow { background-color: var(--flow); }
.aq-illustration--on-navy { background-color: var(--on-navy-muted); }

@container (max-width: 860px) {
  .aq-illustration { max-width: 480px; margin-inline: auto; }
}

/* Pass 12 round C (audit G4): in the dark theme a hero drawing paints in `ink`, not `ink-muted`: thin washer and skid
   lines on the near-black page fell to about 3.5:1. Light mode is unchanged. */
[data-theme="dark"] .aq-hero__art .aq-illustration { background-color: var(--ink); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .aq-hero__art .aq-illustration { background-color: var(--ink); } }

/* ---------- IsoKit: shared isometric line drawing (equipment, pipes, water, sheet furniture) ---------- */
/* Lines stay 1.5 px at any size (non-scaling strokes); details 1 px. Every solid is filled with the ground colour so
   what stands in front hides what is behind. One modifier on the svg re-grounds the whole drawing (colour rules below). */
.aq-iso { display: block; width: 100%; height: auto; overflow: visible; }
.aq-iso * { vector-effect: non-scaling-stroke; }
.aq-iso path, .aq-iso circle { stroke-linecap: round; stroke-linejoin: round; }

/* Equipment: filled solids and lines */
.aq-iso__eq { stroke-width: 1.5; }
.aq-iso__eq--glass { stroke-width: 1; }
.aq-iso__ln { fill: none; stroke-width: 1.5; }
.aq-iso__thin { fill: none; stroke-width: 1; }
.aq-iso__hid { fill: none; stroke-width: 1; stroke-dasharray: 4 3; }
.aq-iso__acc, .aq-iso__trace { fill: none; stroke-width: 1.5; }
.aq-iso__needle { stroke-width: 1.5; }
.aq-iso__flange { stroke-width: 1.25; }
/* PP joints (isoPipe flanges): a socket-fusion collar over a pipe end, a fusion bead ring after a bend */
.aq-iso__collar { stroke-width: 1.25; }
.aq-iso__bead { stroke-width: 1; }

/* Pipes: twin wall over a ground-coloured body, or one centre line; water rides on top */
.aq-iso__pipe-body { stroke: none; }
.aq-iso__pipe-wall, .aq-iso__pipe-line { fill: none; stroke-width: 1.5; }
.aq-iso__flow { fill: none; stroke-width: 1.5; }
.aq-iso__flow--line { stroke-width: 2; }
.aq-iso__flow--drop { stroke-width: 2; stroke-dasharray: 2 3; }
.aq-iso__arrow { fill: none; stroke-width: 1.5; }
.aq-iso__drop { stroke: none; }

/* Annotation: dimensions and leaders in thin ink, short drawing labels in mono */
.aq-iso__dim-line, .aq-iso__leader-line { fill: none; stroke-width: 1; }
.aq-iso__leader-dot { stroke: none; }
.aq-iso__label, .aq-iso__sheet-t { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.06em; stroke: none; }

/* Drawing-sheet furniture: the quietest layer */
.aq-iso__sheet, .aq-iso__dim, .aq-iso__leader { pointer-events: none; }
.aq-iso__sheet-line { fill: none; stroke-width: 1; }
.aq-iso__sheet-mark { stroke: none; }
.aq-iso__grid { fill: none; stroke-width: 0.75; stroke-dasharray: 1 5; }

/* A stage the water has reached turns flow (motion adds is-lit; looks may keep it) */
.aq-iso__part .aq-iso__eq, .aq-iso__part .aq-iso__ln, .aq-iso__part .aq-iso__thin, .aq-iso__pipe-wall { transition: stroke 400ms cubic-bezier(0.2, 0, 0, 1); }

/* Colours per ground. Equipment line-strong, furniture line, water and highlights flow; fills surface, limestone or navy */
/* Default: a light sheet */
.aq-iso .aq-iso__eq, .aq-iso .aq-iso__ln, .aq-iso .aq-iso__thin, .aq-iso .aq-iso__hid, .aq-iso .aq-iso__pipe-wall, .aq-iso .aq-iso__pipe-line, .aq-iso .aq-iso__dim-line, .aq-iso .aq-iso__leader-line { stroke: var(--line-strong); }
.aq-iso .aq-iso__leader-dot { fill: var(--line-strong); }
.aq-iso .aq-iso__eq, .aq-iso .aq-iso__pipe-body { fill: var(--surface); }
.aq-iso .aq-iso__eq--alt { fill: var(--surface-sunken); }
.aq-iso .aq-iso__eq--glass { fill: var(--surface-sunken); }
.aq-iso .aq-iso__eq--sheet { fill: var(--surface-raised); }
.aq-iso .aq-iso__flow, .aq-iso .aq-iso__acc, .aq-iso .aq-iso__trace, .aq-iso .aq-iso__arrow { stroke: var(--flow); }
.aq-iso .aq-iso__drop { fill: var(--flow); }
.aq-iso .aq-iso__sheet-line, .aq-iso .aq-iso__grid { stroke: var(--line); }
.aq-iso .aq-iso__sheet-mark { fill: var(--line); }
.aq-iso .aq-iso__label, .aq-iso .aq-iso__sheet-t { fill: var(--ink-subtle); }
.aq-iso .aq-iso__part.is-lit .aq-iso__eq, .aq-iso .aq-iso__part.is-lit .aq-iso__ln, .aq-iso .aq-iso__part.is-lit .aq-iso__thin, .aq-iso .aq-iso__pipe.is-lit .aq-iso__pipe-wall { stroke: var(--flow); }
/* On surface-raised */
