ring" cx="560" cy="216"/><text class="aq-building-loop__num" x="560" y="216">03</text></g><g class="aq-building-loop__stop" data-bl="3"><path class="aq-building-loop__fl" d="M222 228V180M238 228V180"/><path class="aq-building-loop__fx" d="M210 228h40v24h-40Z"/><path class="aq-building-loop__fl" d="M218 240h24"/><path class="aq-building-loop__fl" d="M230 252v8"/><path class="aq-building-loop__drop" d="M230 196V228"/><path class="aq-building-loop__lead" d="M214 212H60"/><path class="aq-building-loop__tick" d="M56 208h8v8h-8Z"/><circle class="aq-building-loop__ring" cx="230" cy="212"/><text class="aq-building-loop__num" x="230" y="212">04</text></g><g class="aq-building-loop__stop" data-bl="4"><path class="aq-building-loop__fx" d="M552 378h56M556 378V400M604 378V400"/><path class="aq-building-loop__fx" d="M552 378V326h56V378M552 356L560 334h48"/><path class="aq-building-loop__drop" d="M580 306V326"/><path class="aq-building-loop__lead" d="M596 316H700"/><path class="aq-building-loop__tick" d="M696 312h8v8h-8Z"/><circle class="aq-building-loop__ring" cx="580" cy="316"/><text class="aq-building-loop__num" x="580" y="316">05</text></g></svg></div><div class="aq-building-loop__margin aq-building-loop__margin--r" aria-hidden="true"><span class="aq-building-loop__label" data-bl="1" style="--y:0.2364"><span class="aq-building-loop__lt">Analyzer feed</span> <span class="aq-building-loop__ln">[02]</span></span><span class="aq-building-loop__label" data-bl="2" style="--y:0.4909"><span class="aq-building-loop__lt">Reagent and buffer preparation</span> <span class="aq-building-loop__ln">[03]</span></span><span class="aq-building-loop__label" data-bl="4" style="--y:0.7182"><span class="aq-building-loop__lt">Cell culture and molecular work</span> <span class="aq-building-loop__ln">[05]</span></span></div></div><ol class="aq-building-loop__caps" role="list"><li class="aq-building-loop__cap" data-bl="0"><span class="aq-building-loop__no" aria-hidden="true">01</span><h3 class="aq-building-loop__t">Glassware washers and autoclaves</h3><p class="aq-building-loop__d">They draw in batches, so storage is sized to carry the peak.</p></li><li class="aq-building-loop__cap" data-bl="1"><span class="aq-building-loop__no" aria-hidden="true">02</span><h3 class="aq-building-loop__t">Analyzer feed</h3><p class="aq-building-loop__d">To the analyzer maker&#39;s specification, which governs.</p></li><li class="aq-building-loop__cap" data-bl="2"><span class="aq-building-loop__no" aria-hidden="true">03</span><h3 class="aq-building-loop__t">Reagent and buffer preparation</h3><p class="aq-building-loop__d">ASTM D1193-24 Type II or III at bench taps, or clinical laboratory reagent water.</p></li><li class="aq-building-loop__cap" data-bl="3"><span class="aq-building-loop__no" aria-hidden="true">04</span><h3 class="aq-building-loop__t">Humidifiers</h3><p class="aq-building-loop__d">Fed from the loop, to the humidifier maker&#39;s specification.</p></li><li class="aq-building-loop__cap" data-bl="4"><span class="aq-building-loop__no" aria-hidden="true">05</span><h3 class="aq-building-loop__t">Cell culture and molecular work</h3><p class="aq-building-loop__d">Type I water from a point-of-use polisher at the bench, from its own maker. The loop feeds it to that maker&#39;s specification.</p></li></ol></div></div></section></div>
