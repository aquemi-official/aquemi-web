/* ---------- ModulePlinth: options as modules standing on one plinth, a riser to each from one header ---------- */
/* Desktop: the drawing runs the full width (no sheet, no frame), the base named under the header, then one caption card
   per module in as many columns as there are modules. Phones: a vertical header line down the left, each option
   branching off it with its own small drawing over its card. */
.aq-module-plinth-sec .aq-sec-head .aq-h1 { color: var(--on-navy); }
.aq-module-plinth-sec { overflow: clip; }
.aq-module-plinth { margin-top: var(--space-6); color: var(--on-navy); }
.aq-module-plinth__fig { position: relative; max-width: 1040px; margin: var(--space-8) auto 0; }
.aq-module-plinth__fig > svg { display: block; }
.aq-module-plinth__svg { display: block; width: 100%; height: auto; }
.aq-module-plinth__blk { transition: transform 400ms cubic-bezier(0.2, 0, 0, 1); }
.aq-module-plinth__blk.is-hot { transform: translateY(-6px); }
.aq-module-plinth__mk { position: absolute; z-index: 1; transform: translate(-50%, -100%); display: grid; place-items: center; min-width: var(--space-8); height: var(--space-6); padding: 0 var(--space-1);
  background: var(--navy); border: 1px solid var(--on-navy-muted); color: var(--on-navy); font: 500 13px/1 var(--font-mono);
  transition: background-color 300ms cubic-bezier(0.2, 0, 0, 1), color 300ms cubic-bezier(0.2, 0, 0, 1), border-color 300ms cubic-bezier(0.2, 0, 0, 1); }
.aq-module-plinth__mk.is-hot { background: var(--limestone); color: var(--navy); border-color: var(--limestone); }
.aq-module-plinth__base { display: flex; align-items: center; gap: var(--space-3); max-width: 1040px; margin: var(--space-2) auto var(--space-8);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
.aq-module-plinth__base::before { content: ""; flex: none; width: var(--space-8); height: 0; border-top: 3px double var(--on-navy-muted); }

.aq-module-plinth__cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); gap: var(--space-8);
  border-top: 1px solid color-mix(in srgb, var(--on-navy-muted) 40%, transparent); }
.aq-fold:not(.is-open) .aq-module-plinth__card.aq-fold-x { display: flex; }
.aq-module-plinth__list .aq-fold__btn { display: none; color: var(--limestone); border-bottom-color: color-mix(in srgb, var(--on-navy-muted) 35%, transparent); }
.aq-module-plinth__card { position: relative; display: flex; flex-direction: column; gap: var(--space-2); padding-top: var(--space-6); color: var(--on-navy); }
.aq-module-plinth__card::before { content: ""; position: absolute; left: 0; top: -1px; width: var(--space-12); height: 2px; background: var(--on-navy-muted); transition: background-color 300ms cubic-bezier(0.2, 0, 0, 1), width 300ms cubic-bezier(0.2, 0, 0, 1); }
.aq-module-plinth__card.is-hot::before { background: var(--limestone); width: 100%; }
.aq-module-plinth__mini { display: none; }
.aq-module-plinth__n { font: 400 28px/32px var(--font-mono); color: var(--on-navy-muted); transition: color 300ms cubic-bezier(0.2, 0, 0, 1); }
.aq-module-plinth__card.is-hot .aq-module-plinth__n { color: var(--limestone); }
.aq-module-plinth__t { margin: 0; font: 400 21px/28px var(--font-sans); letter-spacing: -0.01em; }
.aq-module-plinth__t a { color: inherit; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--flow) 45%, var(--on-navy)); text-underline-offset: 4px; display: inline-flex; align-items: center; min-height: 44px;
  margin-block: calc(-1 * var(--space-2)); } /* 44 px target, title box stays 28 px so linked and plain titles line up */
.aq-module-plinth__t a::after { content: "\2192"; margin-left: var(--space-2); color: var(--limestone); text-decoration: none; }
.aq-module-plinth__t a:focus-visible { outline: 2px solid var(--limestone); outline-offset: 2px; }
.aq-module-plinth__d { margin: 0; font: 400 15px/23px var(--font-sans); color: var(--on-navy-muted); }

/* Phones: the header as a vertical line down the left; each option branches off it with its small drawing */
@container (max-width: 860px) {
  .aq-module-plinth { margin-top: var(--space-4); }
  .aq-module-plinth__fig { display: none; }
  .aq-module-plinth__base { margin: 0 0 var(--space-2); padding-left: var(--space-6); }
  .aq-module-plinth__base::before { display: none; }
  .aq-module-plinth__cards { position: relative; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); border-top: 0; padding-left: var(--space-6); }
  .aq-module-plinth__cards::before { content: ""; position: absolute; left: 4px; top: 0; bottom: var(--space-12); width: 6px; box-sizing: border-box;
    border: 1.5px solid var(--on-navy-muted); border-block: 0; }
  .aq-module-plinth__card { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-3); row-gap: var(--space-1); padding-top: 0; }
  .aq-module-plinth__card::before { display: none; }
  /* the branch: from the header line to the mini drawing's own header, at its height (--hy, set by the renderer) */
  .aq-module-plinth__mini { position: relative; display: block; grid-column: 1 / -1; width: min(100%, 200px); margin-bottom: var(--space-1); }
  .aq-module-plinth__mini::before { content: ""; position: absolute; right: 100%; top: var(--hy, 80%); width: calc(var(--space-6) - 10px); border-top: 4px double var(--on-navy-muted); transform: translateY(-50%); }
  .aq-module-plinth__card.is-hot .aq-module-plinth__mini::before { border-top-color: var(--limestone); }
  .aq-module-plinth__mini svg { display: block; width: 100%; height: auto; }
  .aq-module-plinth__n { grid-column: 1; font-size: 15px; line-height: 24px; }
  .aq-module-plinth__t { grid-column: 2; font-size: 18px; line-height: 24px; }
  .aq-module-plinth__t a { min-height: 44px; margin-block: -10px; }
  .aq-module-plinth__d { grid-column: 2; }
  .aq-fold:not(.is-open) .aq-module-plinth__card.aq-fold-x { display: none; }
  .aq-module-plinth__list .aq-fold__btn { display: flex; }
}
@media (prefers-reduced-motion: reduce) {
  .aq-module-plinth__blk, .aq-module-plinth__mk, .aq-module-plinth__card::before, .aq-module-plinth__n { transition: none; }
}
