/* ---------- LevellingSheet: quotes levelled on the same ruled lines (look "levelling-sheet", pass 12 D). On the
   limestone (alt) ground: the lines and their questions on the left; three raised sheets (Quote A, Quote B, ours) on the
   same rules; gaps on A and B hatched, written lines as two grey strokes; ours ticked in flow with the link to where we
   state it; a navy straightedge across the line in hand. Phones: one checklist, A and B as small boxes. ---------- */
.aq-levelling-sheet { position: relative; display: grid; grid-template-columns: minmax(0, 4.2fr) minmax(0, 1.45fr) minmax(0, 1.45fr) minmax(0, 2.7fr);
  grid-template-rows: auto repeat(var(--ls-n, 8), auto) var(--space-6); column-gap: var(--space-6); }
.aq-levelling-sheet-sec { position: relative; }

/* the three sheets: raised paper behind their column, from the head to below the last rule */
.aq-levelling-sheet__paper { grid-row: 1 / -1; background: var(--surface-raised); box-shadow: var(--shadow-overlay); border-radius: var(--radius-sm); }
.aq-levelling-sheet__paper.is-a, .aq-levelling-sheet__h.is-a { grid-column: 2; }
.aq-levelling-sheet__paper.is-b, .aq-levelling-sheet__h.is-b { grid-column: 3; }
.aq-levelling-sheet__paper.is-ours, .aq-levelling-sheet__h.is-ours { grid-column: 4; }
.aq-levelling-sheet__h { grid-row: 1; z-index: 1; margin: 0; padding: var(--space-6) var(--space-4) var(--space-3); border-bottom: 1.5px solid var(--ink);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-levelling-sheet__h.is-line { grid-column: 1; align-self: end; padding-left: 0; color: var(--ink-subtle); }
.aq-levelling-sheet__h.is-line span { display: block; }
.aq-levelling-sheet__h.is-line span + span { color: var(--ink-muted); }
.aq-levelling-sheet__h.is-ours { color: var(--ink); }

/* the rows: one subgrid row per line, ruled across the whole sheet (gaps between the sheets included) */
.aq-levelling-sheet__rows { grid-column: 1 / -1; grid-row: 2 / span var(--ls-n, 8); display: grid; grid-template-columns: subgrid; grid-template-rows: subgrid; list-style: none; margin: 0; padding: 0; z-index: 1; }
.aq-levelling-sheet__row { position: relative; grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; grid-template-rows: auto 1fr; border-bottom: 1px solid var(--line-strong); }
.aq-levelling-sheet__line { grid-column: 1; grid-row: 1; display: flex; align-items: baseline; gap: var(--space-3); padding-top: var(--space-4); }
.aq-levelling-sheet__line .aq-index { transition: color 150ms cubic-bezier(0.2, 0, 0, 1); }
.aq-levelling-sheet__row.is-on .aq-levelling-sheet__line .aq-index { color: var(--flow); }
.aq-levelling-sheet__t { margin: 0; font: 400 19px/26px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
.aq-levelling-sheet__ask { grid-column: 1; grid-row: 2; margin: var(--space-1) 0 0; padding: 0 0 var(--space-4) calc(var(--space-6) + var(--space-3)); font: 400 15px/22px var(--font-sans); color: var(--ink-muted); }
.aq-levelling-sheet__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

/* a quote's cell: written (two strokes) or a gap (hatched blank) */
.aq-levelling-sheet__c { grid-row: 1 / span 2; position: relative; display: flex; flex-direction: column; justify-content: center; gap: var(--space-2); padding: var(--space-4); min-width: 0; }
.aq-levelling-sheet__q { display: none; }
.aq-levelling-sheet__c i { display: block; height: 2px; border-radius: var(--radius-pill); background: color-mix(in srgb, var(--line-strong) 70%, transparent); }
.aq-levelling-sheet__c i:first-of-type { width: 78%; }
.aq-levelling-sheet__c i:last-of-type { width: 48%; }
.aq-levelling-sheet__c.is-gap i { display: none; }
.aq-levelling-sheet__c.is-gap::before { content: ""; position: absolute; inset: var(--space-3) var(--space-3); border: 1px solid color-mix(in srgb, var(--line-strong) 60%, transparent);
  background: repeating-linear-gradient(-45deg, color-mix(in srgb, var(--line-strong) 55%, transparent) 0 1px, transparent 1px 7px); }
/* ours: a flow tick and the link to where we state it */
.aq-levelling-sheet__c.is-ours { flex-direction: row; align-items: center; justify-content: flex-start; gap: var(--space-3); }
.aq-levelling-sheet__tick { position: relative; flex: none; width: var(--space-4); height: var(--space-4); border: 1.5px solid var(--flow); border-radius: var(--radius-sm); box-sizing: border-box; }
.aq-levelling-sheet__tick::after { content: ""; position: absolute; left: 4px; top: 1px; width: 4px; height: 8px; border-right: 1.5px solid var(--flow); border-bottom: 1.5px solid var(--flow); transform: rotate(45deg); }
.aq-levelling-sheet__go { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--ink); text-decoration: none; }
a.aq-levelling-sheet__go .aq-levelling-sheet__gt { background-image: linear-gradient(currentColor, currentColor); background-size: 0 1px; background-position: 0 100%; background-repeat: no-repeat; transition: background-size 200ms cubic-bezier(0.2, 0, 0, 1); }
a.aq-levelling-sheet__go::after { content: "\2192"; margin-left: var(--space-2); color: var(--flow); }
a.aq-levelling-sheet__go:hover .aq-levelling-sheet__gt, a.aq-levelling-sheet__go:focus-visible .aq-levelling-sheet__gt { background-size: 100% 1px; }
/* the whole cell is the target (the whole row on phones) */
.aq-levelling-sheet__c.is-ours { position: relative; }
a.aq-levelling-sheet__go::before { content: ""; position: absolute; inset: 0; z-index: 1; }
a.aq-levelling-sheet__go:focus-visible { outline: none; }
a.aq-levelling-sheet__go:focus-visible::before { outline: 2px solid var(--focus); outline-offset: -2px; }

/* the straightedge: across the three sheets, its foot on the rule of the line in hand */
.aq-levelling-sheet__edge { position: absolute; z-index: 2; grid-column: 2 / -1; grid-row: 1 / -1; top: 0; left: calc(-1 * var(--space-6)); right: calc(-1 * var(--space-3)); height: calc(var(--space-3) + 2px);
  transform: translateY(calc(var(--ls-y, -100px) - 50%)); background: var(--navy); border-radius: var(--radius-sm); box-shadow: 0 0 0 1px color-mix(in srgb, var(--on-navy) 22%, transparent), var(--shadow-overlay); pointer-events: none;
  transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.aq-levelling-sheet__edge::before { content: ""; position: absolute; left: var(--space-2); right: var(--space-2); top: 0; height: 5px;
  background: repeating-linear-gradient(90deg, var(--on-navy-muted) 0 1px, transparent 1px 8px); opacity: 0.8; }
.aq-levelling-sheet__edge::after { content: ""; position: absolute; left: var(--space-2); right: var(--space-2); top: 0; height: 8px;
  background: repeating-linear-gradient(90deg, var(--on-navy) 0 1px, transparent 1px 40px); opacity: 0.8; }
.aq-levelling-sheet__edge.is-jump { transition: none; }
.aq-levelling-sheet:not([data-on]) .aq-levelling-sheet__edge { visibility: hidden; }

@media (prefers-reduced-motion: reduce) {
  .aq-levelling-sheet__edge, .aq-levelling-sheet__line .aq-index, a.aq-levelling-sheet__go .aq-levelling-sheet__gt { transition: none; }
}

/* Tablet: narrower sheets */
@container (max-width: 1080px) {
  .aq-levelling-sheet { grid-template-columns: minmax(0, 3.6fr) minmax(0, 1.1fr) minmax(0, 1.1fr) minmax(0, 2.6fr); column-gap: var(--space-4); }
  .aq-levelling-sheet__h { padding-left: var(--space-3); padding-right: var(--space-3); }
}

/* Phones (700 and under; tablets in portrait keep the three sheets): one checklist (number and line, A and B boxes at
   the right, the ask, ours as the row's link) */
@container (max-width: 700px) {
  .aq-levelling-sheet { display: block; }
  .aq-levelling-sheet__paper, .aq-levelling-sheet__h, .aq-levelling-sheet__edge { display: none !important; }
  .aq-levelling-sheet__rows { display: block; border-top: 1.5px solid var(--ink); }
  .aq-levelling-sheet__row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; grid-template-rows: auto; column-gap: var(--space-2); padding: var(--space-2) 0 var(--space-3); }
  .aq-levelling-sheet__line { grid-column: 1; grid-row: 1; align-items: center; gap: var(--space-2); padding: 0; min-width: 0; }
  .aq-levelling-sheet__t { font-size: 17px; line-height: 24px; }
  .aq-levelling-sheet__ask { grid-column: 1 / -1; grid-row: 2; margin: var(--space-1) 0 0; padding: 0; font-size: 14px; line-height: 20px; }
  .aq-levelling-sheet__c { grid-row: 1; padding: 0; }
  .aq-levelling-sheet__c.is-a { grid-column: 2; }
  .aq-levelling-sheet__c.is-b { grid-column: 3; }
  .aq-levelling-sheet__c.is-a, .aq-levelling-sheet__c.is-b { flex-direction: row; align-items: center; justify-content: flex-start; gap: 0; width: calc(var(--space-8) + var(--space-3)); height: var(--space-6); box-sizing: border-box;
    padding-left: var(--space-1); border: 1px solid var(--line-strong); background: var(--surface-raised); }
  .aq-levelling-sheet__q { display: block; font: 500 12px/1 var(--font-mono); color: var(--ink-muted); }
  .aq-levelling-sheet__c i { display: none; }
  .aq-levelling-sheet__c.is-gap::before { inset: 3px 3px 3px calc(var(--space-4) + 2px); border: 0; }
  .aq-levelling-sheet__c.is-said::after { content: ""; position: absolute; left: calc(var(--space-6) - 2px); top: 4px; width: 5px; height: 10px; border-right: 1.5px solid var(--ink-muted); border-bottom: 1.5px solid var(--ink-muted); transform: rotate(45deg); }
  .aq-levelling-sheet__c.is-ours { grid-column: 1 / -1; grid-row: 3; position: static; margin-top: var(--space-1); gap: var(--space-2); }
  .aq-levelling-sheet__tick { width: calc(var(--space-4) + 2px); height: calc(var(--space-4) + 2px); }
  .aq-levelling-sheet__go { font-size: 15px; line-height: 22px; font-weight: 500; }
  /* the whole row is the link (well over 44 px): the cell is static here, so the target stretches to the row */
}
