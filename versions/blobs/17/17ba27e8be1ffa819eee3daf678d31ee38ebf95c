/* ---------- GradeCrosswalk: water types as navy blocks, two families of standards wired to them (look "grade-crosswalk") ---------- */
/* Five tracks: chips | wires | navy blocks | wires | chips. The blocks share equal heights (grid-auto-rows 1fr), so
   block i's centre is at (i + 0.5) / N of the column; each chip sits at its own --p (the look computes it), so the
   wires (a stretched svg, non-scaling strokes) need no measuring. Phones: blocks with their citation rows under them. */
.aq-grade-crosswalk {
  display: grid; grid-template-columns: minmax(0, 2.3fr) minmax(var(--space-12), 1.2fr) minmax(0, 6.5fr) minmax(var(--space-12), 1.2fr) minmax(0, 2.3fr);
  grid-template-rows: auto 1fr; column-gap: 0; row-gap: var(--space-4);
}
.aq-grade-crosswalk__head { grid-row: 1; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); padding-bottom: var(--space-3); border-bottom: 1px solid var(--line-strong); align-self: end; }
.aq-grade-crosswalk__head--a { grid-column: 1; text-align: end; }
.aq-grade-crosswalk__head--b { grid-column: 5; }
.aq-grade-crosswalk__head--m { grid-column: 3; display: grid; grid-template-columns: var(--space-8) minmax(0, 0.7fr) minmax(0, 1.3fr); column-gap: var(--space-6); padding-left: var(--space-6); padding-right: var(--space-6); }
.aq-grade-crosswalk__head--m span:first-child { grid-column: 2; }
.aq-grade-crosswalk__rail, .aq-grade-crosswalk__wires, .aq-grade-crosswalk__rows { grid-row: 2; }
.aq-grade-crosswalk__rail { position: relative; min-width: 0; }
.aq-grade-crosswalk__rail--a { grid-column: 1; }
.aq-grade-crosswalk__rail--b { grid-column: 5; }
.aq-grade-crosswalk__nodes { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; }
.aq-grade-crosswalk__node {
  position: absolute; top: calc(var(--p, 0.5) * 100%); transform: translateY(-50%); display: inline-flex; align-items: stretch; max-width: 100%;
  border: 1px solid var(--line-strong); background: var(--surface-raised); color: var(--ink); cursor: default;
  transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
}
.aq-grade-crosswalk__rail--a .aq-grade-crosswalk__node { right: 0; }
.aq-grade-crosswalk__rail--b .aq-grade-crosswalk__node { left: 0; }
.aq-grade-crosswalk__std { padding: var(--space-2) var(--space-3); font: 500 14px/20px var(--font-sans); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.aq-grade-crosswalk__ed { padding: var(--space-2) var(--space-3); border-left: 1px solid var(--line-strong); font: 400 12px/20px var(--font-mono); color: var(--ink-muted); white-space: nowrap; transition: color 200ms ease, border-color 200ms ease; }
.aq-grade-crosswalk__sep { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.aq-grade-crosswalk__wires { grid-column: 2; display: block; width: 100%; height: 100%; overflow: visible; }
.aq-grade-crosswalk__wires--b { grid-column: 4; }
.aq-grade-crosswalk__wire { fill: none; stroke: var(--line-strong); stroke-width: 1; vector-effect: non-scaling-stroke; transition: stroke 200ms ease, opacity 200ms ease; }
.aq-grade-crosswalk__rows { grid-column: 3; list-style: none; margin: 0; padding: 0; display: grid; grid-auto-rows: 1fr; min-width: 0; }
.aq-grade-crosswalk__row { padding: var(--space-1) 0; display: flex; position: relative; }
.aq-grade-crosswalk__block {
  flex: 1; display: grid; grid-template-columns: var(--space-8) minmax(0, 0.7fr) minmax(0, 1.3fr); column-gap: var(--space-6); row-gap: var(--space-2); align-items: center; align-content: center;
  padding: var(--space-4) var(--space-6); background: var(--navy); color: var(--on-navy); position: relative; transition: box-shadow 200ms ease;
}
.aq-grade-crosswalk__block .aq-index { font: 400 12px/16px var(--font-mono); color: var(--on-navy-muted); align-self: start; padding-top: var(--space-1); }
.aq-grade-crosswalk__t { margin: 0; font: 300 24px/28px var(--font-sans); letter-spacing: -0.01em; color: var(--on-navy); text-wrap: balance; }
.aq-grade-crosswalk__how { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--on-navy-muted); text-wrap: pretty; }
.aq-grade-crosswalk__note { grid-column: 3; margin: 0; font: 400 12px/16px var(--font-mono); color: var(--on-navy-muted); }
.aq-grade-crosswalk__note::before { content: "\2192\00a0"; color: var(--flow); }
/* the citations as text: hidden on desktop (the chips and wires show them), the rows under each block on phones */
.aq-grade-crosswalk__also { display: none; }
.aq-grade-crosswalk__refs { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; margin: 0; padding: 0; list-style: none; }
/* hover */
.aq-grade-crosswalk.has-hot .aq-grade-crosswalk__wire { opacity: 0.25; }
.aq-grade-crosswalk.has-hot .aq-grade-crosswalk__wire.is-hot { opacity: 1; stroke: var(--flow); stroke-width: 1.5; }
.aq-grade-crosswalk__row.is-hot .aq-grade-crosswalk__block { box-shadow: inset 4px 0 0 var(--flow), inset -4px 0 0 var(--flow); }
.aq-grade-crosswalk__node.is-hot { border-color: var(--flow); background: var(--flow); color: var(--surface); }
.aq-grade-crosswalk__node.is-hot .aq-grade-crosswalk__ed { color: var(--surface); border-color: var(--surface); }
.aq-grade-crosswalk-sec { position: relative; }

@container (max-width: 1100px) {
  .aq-grade-crosswalk__block { grid-template-columns: var(--space-8) minmax(0, 1fr); }
  .aq-grade-crosswalk__how, .aq-grade-crosswalk__note { grid-column: 2; }
  .aq-grade-crosswalk__head--m { grid-template-columns: var(--space-8) minmax(0, 1fr); }
  .aq-grade-crosswalk__head--m span:last-child { display: none; }
  .aq-grade-crosswalk { grid-template-columns: minmax(0, 2.6fr) minmax(var(--space-8), 1fr) minmax(0, 6fr) minmax(var(--space-8), 1fr) minmax(0, 2.6fr); }
  .aq-grade-crosswalk__std { font-size: 14px; white-space: normal; overflow: visible; }
}
/* Phones: one navy block per water, its citation rows under it on hairlines; no rails, wires or heads */
@container (max-width: 860px) {
  .aq-grade-crosswalk { display: block; }
  .aq-grade-crosswalk__rail, .aq-grade-crosswalk__wires, .aq-grade-crosswalk__head { display: none; }
  .aq-grade-crosswalk__rows { display: flex; flex-direction: column; gap: calc(var(--space-4) + var(--space-1)); }
  .aq-grade-crosswalk__row { display: block; padding: 0; }
  .aq-grade-crosswalk__block { grid-template-columns: var(--space-8) minmax(0, 1fr); column-gap: var(--space-3); padding: var(--space-4); align-items: baseline; }
  .aq-grade-crosswalk__block .aq-index { padding-top: 0; align-self: baseline; }
  .aq-grade-crosswalk__t { font-size: 22px; line-height: 28px; }
  .aq-grade-crosswalk__how { grid-column: 1 / -1; font-size: var(--aq-read-phone, 14px); line-height: 22px; }
  .aq-grade-crosswalk__note { display: none; }
  .aq-grade-crosswalk__refs { position: static; width: auto; height: auto; clip-path: none; white-space: normal; display: flex; flex-direction: column; }
  .aq-grade-crosswalk__ref {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto; column-gap: var(--space-3); row-gap: var(--space-1); align-items: baseline;
    padding: var(--space-2) var(--space-4); min-height: var(--aq-hit, 44px); border: 1px solid var(--line-strong); border-top: 0; background: var(--surface-raised);
  }
  .aq-grade-crosswalk__ref.is-first { padding-top: var(--space-3); }
  .aq-grade-crosswalk__side { grid-column: 1 / -1; font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
  .aq-grade-crosswalk__cite { display: contents; }
  .aq-grade-crosswalk__cite .aq-grade-crosswalk__std { padding: 0; font: 500 15px/22px var(--font-sans); white-space: normal; color: var(--ink); }
  .aq-grade-crosswalk__cite .aq-grade-crosswalk__ed { padding: 0 var(--space-2); border: 1px solid var(--line-strong); font-size: 12px; line-height: 20px; color: var(--ink); }
  .aq-grade-crosswalk__cite .aq-grade-crosswalk__std { grid-column: 1; grid-row: var(--r, auto); }
  .aq-grade-crosswalk__cite .aq-grade-crosswalk__ed { grid-column: 3; grid-row: var(--r, auto); }
  /* the crosswalk in text: the other blocks citing the same standard, between the name and the edition */
  .aq-grade-crosswalk__also { display: block; grid-column: 2; grid-row: var(--r, auto); font: 400 12px/20px var(--font-mono); color: var(--ink-muted); white-space: nowrap; }
  .aq-grade-crosswalk__ref.is-first .aq-grade-crosswalk__std, .aq-grade-crosswalk__ref.is-first .aq-grade-crosswalk__ed, .aq-grade-crosswalk__ref.is-first .aq-grade-crosswalk__also { --r: 2; }
  .aq-grade-crosswalk__ref:not(.is-first) .aq-grade-crosswalk__std, .aq-grade-crosswalk__ref:not(.is-first) .aq-grade-crosswalk__ed, .aq-grade-crosswalk__ref:not(.is-first) .aq-grade-crosswalk__also { --r: 1; }
  .aq-grade-crosswalk__rnote { grid-column: 1 / -1; font: 400 12px/18px var(--font-mono); color: var(--ink-muted); }
  .aq-grade-crosswalk__rnote::before { content: "\2192\00a0"; color: var(--flow); }
}
