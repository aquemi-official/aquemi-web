/* ---------- NoteSheet: the notes register with its featured note previewed as a tall folded-corner drawing sheet
   (look "note-sheet", pass 12 E, concept 254). On the limestone band: the sheet at the left (the note's drawing, its
   question, title and standard), the topic line and numbered rows at the right; the featured row sits between two
   flow rules and one flow leader runs from it into the sheet. Phones: the sheet as a compact card above the list, the
   leader turning down the left edge to row 01. ---------- */
.aq-note-sheet { --ns-fold: 40px; --ns-th: calc(var(--aq-hit) + var(--space-2) + 2px);
