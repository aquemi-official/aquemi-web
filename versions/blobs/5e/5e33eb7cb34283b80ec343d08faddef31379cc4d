  .aq-limit-gauges__rule.is-text .aq-limit-gauges__rt { font-size: 14px; line-height: 22px; }
  .aq-limit-gauges__rule .aq-limit-gauges__mt { display: inline; }
}

/* ---------- PlanTiers: service plans compared in one table on a plate (table block as "plans") ----------
