.aq-spec:not(.aq-spec--compare) caption { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; padding: 0; }
.aq-spec:not(.aq-spec--compare) thead { display: block; background: var(--surface-sunken); border-bottom: 1px solid var(--line); }
.aq-spec:not(.aq-spec--compare) thead tr { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); padding: var(--space-3) var(--space-6); }
.aq-spec:not(.aq-spec--compare) thead th { padding: 0; border: 0; background: none; }
.aq-spec:not(.aq-spec--compare) thead th + th::before { content: "·"; content: "·" / ""; margin-right: var(--space-2); }
.aq-spec:not(.aq-spec--compare) tbody { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-12); padding-inline: var(--space-6); background: var(--surface-raised); border-bottom: 1px solid var(--line); }
.aq-spec:not(.aq-spec--compare) tbody tr {
  display: grid; grid-template-columns: minmax(0, 1fr) auto;
  grid-template-areas: "p s" "v v" "m m";
  row-gap: var(--space-1); column-gap: var(--space-4);
  padding-block: var(--space-4); border-top: 1px solid var(--line); margin-top: -1px;
}
.aq-spec:not(.aq-spec--compare) tbody tr > * { display: block; padding: 0; border: 0; background: none; }
.aq-spec:not(.aq-spec--compare) tbody th { grid-area: p; font: 400 16px/24px var(--font-sans); }
.aq-spec:not(.aq-spec--compare) .aq-spec__value { grid-area: v; }
/* Placeholders keep their style but at the row's text size */
.aq-spec .aq-spec__value .aq-ph { font-size: inherit; }
.aq-spec:not(.aq-spec--compare) .aq-spec__method { grid-area: m; }
.aq-spec:not(.aq-spec--compare) .aq-spec__method:empty { display: none; }
.aq-spec:not(.aq-spec--compare) .aq-spec__status { grid-area: s; }

/* Critical rows. Rows keep their source order. hl rows at the top (is-lead) span both columns, the parameter at h3 and
   the value one step larger. Only the first highlighted row is tinted (flow-tint, the brand's one highlight); any
   later highlight is marked with a 2 px flow line on its left instead. */
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead {
  grid-column: 1 / -1;
