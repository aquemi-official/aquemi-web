.aq-limit-gauges__rn { font: 400 13px/24px var(--font-mono); letter-spacing: 0.02em; font-variant-numeric: tabular-nums; color: var(--ink-subtle); }
.aq-limit-gauges__rule .aq-limit-gauges__p { padding: 0; }
.aq-limit-gauges__rv { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
.aq-limit-gauges__rt { margin: 0; font: 400 14px/20px var(--font-sans); color: var(--ink-muted); overflow-wrap: break-word; text-wrap: pretty; }
.aq-limit-gauges__rule.is-text .aq-limit-gauges__rt { padding: 0; font: 400 16px/24px var(--font-sans); color: var(--ink); }
