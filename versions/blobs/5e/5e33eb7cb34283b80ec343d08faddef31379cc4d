  background: none; border: 0; border-bottom: 2px solid transparent; font: 500 17px/24px var(--font-sans); color: var(--ink-muted); cursor: pointer;
  transition: color 150ms cubic-bezier(0.2, 0, 0, 1), border-color 150ms cubic-bezier(0.2, 0, 0, 1); }
