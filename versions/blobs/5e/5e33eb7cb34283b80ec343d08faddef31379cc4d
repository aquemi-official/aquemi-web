}
@container (max-width: 860px) {
  /* Phones: the plant on top, the zones strung down a vertical orbit line */
  .aq-standards-orbit__plant { margin: 0 calc(-1 * var(--space-2)) var(--space-6); max-width: none; }
  .aq-standards-orbit__zones { position: relative; display: flex; flex-direction: column; gap: var(--space-8); padding-left: var(--space-8); }
  .aq-standards-orbit__zones::before { content: ""; position: absolute; left: var(--space-2); top: var(--space-2); bottom: var(--space-2); width: 1px; background: color-mix(in srgb, var(--on-navy-muted) 45%, transparent); }
  .aq-standards-orbit__zone, .aq-standards-orbit__zone.is-l, .aq-standards-orbit__zone.is-r, .aq-standards-orbit__zone.is-b { padding-top: 0; border-top: 0; }
  .aq-standards-orbit__zone::before { content: ""; position: absolute; left: calc(-1 * var(--space-8) + var(--space-1)); top: var(--space-2); width: var(--space-2); height: var(--space-2); border-radius: var(--radius-pill); background: var(--on-navy); box-shadow: 0 0 0 4px var(--navy), 0 0 0 5px color-mix(in srgb, var(--on-navy-muted) 40%, transparent); }

  /* pass 12: numbered pins on the drawing, one per zone, on the part the zone governs */
  .aq-standards-orbit__pin { position: absolute; z-index: 2; display: grid; place-items: center; width: var(--space-6); height: var(--space-6); transform: translate(-50%, -50%);
    border: 1px solid var(--on-navy); background: var(--navy); color: var(--on-navy); font: 500 12px/1 var(--font-mono); font-variant-numeric: tabular-nums;
    transition: background-color 200ms, color 200ms, border-color 200ms, transform 200ms; }
  .aq-standards-orbit__pin.is-pk-active { background: var(--on-navy); color: var(--navy); transform: translate(-50%, -50%) scale(1.15); }
  /* the strip: the drawing fitted into 180 px, held under the header while the zones pass (PhoneKit) */
  .aq-standards-orbit[data-pk-on] .aq-standards-orbit__plant { top: var(--pk-top, 0px) !important; display: flex; justify-content: center; margin: 0 calc(-1 * var(--space-4)) var(--space-6); padding: 0;
    background: var(--navy); border-bottom-color: color-mix(in srgb, var(--on-navy-muted) 40%, transparent); }
  /* round C: the pan is the cropped window (--so-cy, --so-ch: the plant without the viewBox's empty top and foot); the
