/* ---------- PlanChecker: service plans as a checker of navy and limestone tiles (look "plan-checker") ----------
   Limestone band (data-theme light). One column per plan, columns alternate navy and a lighter limestone tile with a
   hairline edge; each column is a head tile (slash numeral 300 at up to 112 px, name, who it suits) and a terms tile
   whose rows line up across columns through subgrid. No table rules: tiles and gaps separate. Navy tiles remap the ink
   tokens to their on-navy values. Phones: a snap row of plan cards at 85 % under a strip of numeral tabs. */
.aq-plan-checker-sec .aq-sec-head .aq-h1 { font-weight: 300; letter-spacing: -0.03em; }
.aq-plan-checker__tabs { display: none; }
.aq-plan-checker__plans {
  list-style: none; margin: 0; padding: 0; display: grid; column-gap: var(--space-1);
  grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
  grid-template-rows: auto repeat(var(--rows, 3), auto) auto;
}
.aq-plan-checker__plan { grid-row: 1 / -1; display: grid; grid-template-rows: subgrid; min-width: 0; }
.aq-plan-checker .is-navy {
  background: var(--navy); color: var(--on-navy);
  --ink: var(--on-navy); --ink-muted: var(--on-navy-muted); --line-strong: color-mix(in srgb, var(--on-navy) 45%, transparent);
}
.aq-plan-checker .is-lime {
  background: color-mix(in srgb, var(--surface) 55%, var(--limestone)); color: var(--on-limestone);
  box-shadow: inset 1px 0 var(--line-strong), inset -1px 0 var(--line-strong);
}
.aq-plan-checker .is-navy .aq-ph { background: transparent; color: var(--on-navy); outline: 1px dashed var(--on-navy-muted); outline-offset: -1px; }

.aq-plan-checker__head { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6); margin-bottom: var(--space-1); min-height: 19rem; }
.aq-plan-checker__head.is-lime { box-shadow: inset 0 0 0 1px var(--line-strong); }
.aq-plan-checker__no { margin: 0 0 auto; font: 300 clamp(72px, 8.4vw, 112px)/0.9 var(--font-sans); letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
.aq-plan-checker__sl { opacity: 0.55; margin-left: 0.04em; }
.aq-plan-checker__mark { margin: 0; font: 500 12px/16px var(--font-mono); color: var(--flow); }
.aq-plan-checker__name { margin: var(--space-4) 0 0; font: 400 13px/20px var(--font-mono); }
.aq-plan-checker__suits { margin: 0; font: 300 20px/26px var(--font-sans); letter-spacing: -0.01em; }
.aq-plan-checker__sk { display: block; font: 400 12px/18px var(--font-mono); color: var(--on-limestone-muted); }
.is-navy .aq-plan-checker__sk { color: var(--on-navy-muted); }

.aq-plan-checker__term { padding: var(--space-3) var(--space-6); transition: background-color 160ms ease; }
.aq-plan-checker__term.is-first { padding-top: var(--space-6); }
.aq-plan-checker__term.is-first.is-lime { box-shadow: inset 1px 0 var(--line-strong), inset -1px 0 var(--line-strong), inset 0 1px var(--line-strong); }
.aq-plan-checker__v { margin: 0; font-size: 16px; line-height: 23px; overflow-wrap: anywhere; }
.aq-plan-checker__term.is-first .aq-plan-checker__v { font: 300 22px/28px var(--font-sans); letter-spacing: -0.01em; }
.aq-plan-checker__k { margin: var(--space-1) 0 0; font: 400 12px/17px var(--font-mono); color: var(--on-limestone-muted); }
.is-navy .aq-plan-checker__k { color: var(--on-navy-muted); }
.aq-plan-checker__term.is-lit.is-lime { background: var(--flow-tint); }
.aq-plan-checker__term.is-lit.is-navy { background: color-mix(in srgb, var(--on-navy) 12%, var(--navy)); }
.aq-plan-checker__act { padding: var(--space-4) var(--space-6) var(--space-6); }
.aq-plan-checker__act.is-lime { box-shadow: inset 1px 0 var(--line-strong), inset -1px 0 var(--line-strong), inset 0 -1px var(--line-strong); }
.aq-plan-checker__act .aq-btn { width: 100%; justify-content: center; text-align: center; }
.aq-plan-checker-sec .aq-fold__btn { margin-top: var(--space-6); }
.aq-fold:not(.is-open) .aq-plan-checker__term.aq-fold-x { display: none; }

/* Phones (pass 12, S11): the plans become a snap row of cards at 85 % width, the next one peeking; each card keeps
   its checker tiles (head, terms, button) in its own column. Over the row, a strip of numeral tabs (numerals only,
   still navy/limestone) jumps to a plan and follows the swipe (look JS, AQsnap). */
@container (max-width: 860px) {
  .aq-plan-checker__tabs { display: grid; grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); gap: var(--space-1); margin-bottom: var(--space-2); }
  .aq-plan-checker__tab {
    display: flex; align-items: center; justify-content: center; min-height: 48px; min-width: 0;
    padding: 0 var(--space-2); border: 0; border-radius: 0; font: inherit; cursor: pointer;
  }
  .aq-plan-checker__tabno { font: 300 24px/1 var(--font-sans); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  /* round C: every tab is a limestone tile; the selected one (the plan in view, aria-selected) is the one navy tile,
     so "on" reads once (the cards keep their own alternating checker) */
  .aq-plan-checker__tab {
    background: color-mix(in srgb, var(--surface) 55%, var(--limestone)); color: var(--on-limestone);
    box-shadow: inset 0 0 0 1px var(--line-strong); transition: background-color 160ms ease, color 160ms ease;
  }
  .aq-plan-checker__tab[aria-selected="true"] { background: var(--navy); color: var(--on-navy); box-shadow: none; }
  .aq-plan-checker__tab:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .aq-plan-checker__plans {
    display: flex; gap: var(--space-2); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
    scrollbar-width: none; padding-bottom: var(--space-1); }
  .aq-plan-checker__plans::-webkit-scrollbar { display: none; }
  .aq-plan-checker__plan { flex: 0 0 min(85%, 340px); display: flex; flex-direction: column; scroll-snap-align: start; }
  .aq-plan-checker__head { flex: 1 0 auto; min-height: 0; padding: var(--space-4); gap: var(--space-2); align-content: start;
    display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-3); align-items: center; }
  .aq-plan-checker__no { grid-row: 1 / span 2; margin: 0; font-size: var(--aq-num-phone, 44px); line-height: 1; }
  .aq-plan-checker__mark, .aq-plan-checker__name { grid-column: 2; margin: 0; font-size: 14px; }
  .aq-plan-checker__suits { grid-column: 1 / -1; margin-top: var(--space-2); font-size: 18px; line-height: 24px; }
  .aq-plan-checker__term { padding-inline: var(--space-4); }
  .aq-plan-checker__term.is-first { padding-top: var(--space-4); }
  .aq-plan-checker__term.is-first .aq-plan-checker__v { font-size: 18px; line-height: 25px; }
  .aq-plan-checker__v { font-size: 15px; line-height: 22px; }
  /* round C: the term lines (placeholders, mono) read at 14 px on a 1.5 line box; their labels stay 12 px */
  .aq-plan-checker__v .aq-ph, .aq-plan-checker__term.is-first .aq-plan-checker__v .aq-ph { font-size: 14px; line-height: 1.5; }
  .aq-plan-checker__term .aq-plan-checker__v { line-height: 1.5; }
  .aq-plan-checker__k .aq-ph { font-size: 12px; }
  .aq-plan-checker__k { font-size: 12px; line-height: 17px; }
  .aq-plan-checker__act { padding: var(--space-4); }
  .aq-plan-checker__act .aq-btn { min-height: 48px; }
  /* the base plan has no button: its last tile is a thin foot */
  .aq-plan-checker__plan.is-base .aq-plan-checker__act { padding: 0 0 var(--space-4); }
}
