:root[data-theme="dark"] .aq-binder-tabs__spine { background: color-mix(in srgb, var(--navy) 70%, var(--surface)); }
.aq-binder-tabs__stack { position: relative; background: var(--surface-sunken); padding: var(--space-6) 0 var(--space-8) var(--space-8); border: 1px solid var(--line); border-left: 0; }
.aq-binder-tabs__rings { position: absolute; left: calc(-1 * var(--space-6)); top: 0; bottom: 0; width: var(--space-16); pointer-events: none; z-index: 2; }
.aq-binder-tabs__rings i { position: absolute; left: 0; width: 100%; height: var(--space-8); margin-top: calc(-1 * var(--space-4)); border: 4px solid var(--line-strong); border-radius: var(--space-4); background: transparent; }
.aq-binder-tabs__rings i:nth-child(1) { top: 16%; } .aq-binder-tabs__rings i:nth-child(2) { top: 50%; } .aq-binder-tabs__rings i:nth-child(3) { top: 84%; }
.aq-binder-tabs__list { list-style: none; margin: 0; padding: 0; position: relative; }
.aq-binder-tabs__div { position: relative; display: grid; grid-template-columns: var(--space-8) var(--space-12) minmax(0, 1fr) var(--space-24); align-items: center; column-gap: var(--space-4);
  margin-left: calc(var(--i, 0) * var(--bt-step, var(--space-1))); margin-right: calc(var(--i, 0) * var(--bt-step, var(--space-1)) * -1); padding: var(--space-4) var(--space-6) var(--space-4) 0;
  background: var(--surface-raised); border: 1px solid var(--line); margin-top: -1px; }
.aq-binder-tabs__holes { justify-self: center; width: var(--space-3); height: var(--space-3); border-radius: 50%; background: var(--surface-sunken); border: 1px solid var(--line-strong); }
.aq-binder-tabs__n { font: 300 28px/32px var(--font-mono); letter-spacing: -0.03em; color: var(--ink-subtle); }
.aq-binder-tabs__t { margin: 0; font: 500 18px/26px var(--font-sans); color: var(--ink); }
.aq-binder-tabs__d { margin: var(--space-1) 0 0; font: 400 15px/24px var(--font-sans); color: var(--ink-muted); }
.aq-binder-tabs__sign { align-self: end; border-bottom: 1px solid var(--ink-muted); padding-bottom: var(--space-1); }
.aq-binder-tabs__sign svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-binder-tabs__sign path { fill: none; stroke: var(--flow); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.aq-binder-tabs__tab { position: absolute; top: -1px; bottom: -1px; left: 100%; width: calc(var(--bt-tab, var(--space-32)) - var(--space-4)); display: flex; align-items: center; justify-content: center;
  background: var(--limestone); color: var(--on-limestone); border: 1px solid color-mix(in srgb, var(--on-limestone) 30%, transparent); border-left: 0;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase; text-align: center; padding: 0 var(--space-2);
  transition: transform 200ms cubic-bezier(0.2, 0, 0, 1), background-color 200ms; transform-origin: 0 50%; }
.aq-binder-tabs__div:nth-child(even) .aq-binder-tabs__tab { background: color-mix(in srgb, var(--limestone) 70%, var(--surface-raised)); }
.aq-binder-tabs__div:hover .aq-binder-tabs__tab, .aq-binder-tabs__div:focus-within .aq-binder-tabs__tab { transform: translateX(var(--space-2)); background: var(--navy); color: var(--on-navy); }
.aq-binder-tabs__div:hover .aq-binder-tabs__n { color: var(--flow); }

@container (max-width: 860px) {
  .aq-binder-tabs { grid-template-columns: minmax(0, 1fr); padding-right: 0; }
  .aq-binder-tabs__cover { padding: var(--space-6) var(--space-4) var(--space-12); }
  .aq-binder-tabs__holder { padding: var(--space-4); }
  .aq-binder-tabs__spine { top: auto; left: 0; width: auto; height: var(--space-4); }
  .aq-binder-tabs__stack { padding: var(--space-8) var(--space-3) var(--space-4); border-left: 1px solid var(--line); border-top: 0; }
  .aq-binder-tabs__rings { left: 0; right: 0; top: calc(-1 * var(--space-6)); bottom: auto; width: auto; height: var(--space-12); }
  .aq-binder-tabs__rings i { width: var(--space-6); height: var(--space-12); margin: 0; top: 0 !important; border-radius: var(--space-3); }
  .aq-binder-tabs__rings i:nth-child(1) { left: 16%; } .aq-binder-tabs__rings i:nth-child(2) { left: calc(50% - var(--space-3)); } .aq-binder-tabs__rings i:nth-child(3) { left: auto; right: 16%; }
  .aq-binder-tabs__div { grid-template-columns: var(--space-8) minmax(0, 1fr); margin: -1px 0 0; padding: var(--space-4) var(--space-3) var(--space-4) var(--space-3); row-gap: var(--space-2); align-items: start; }
  .aq-binder-tabs__holes { display: none; }
  .aq-binder-tabs__n { font-size: 20px; line-height: 26px; }
  .aq-binder-tabs__n { grid-row: 1 / span 2; }
  .aq-binder-tabs__body { grid-column: 2; grid-row: 2; }
  .aq-binder-tabs__t { font-size: 17px; line-height: 24px; }
  .aq-binder-tabs__d { font-size: 14px; line-height: 22px; }
  .aq-binder-tabs__sign { grid-column: 2; grid-row: 3; width: var(--space-16); }
  .aq-binder-tabs__tab { position: static; grid-column: 2; grid-row: 1; justify-self: start; width: auto; padding: var(--space-1) var(--space-2); border-left: 1px solid color-mix(in srgb, var(--on-limestone) 30%, transparent); font-size: 12px; }
}

/* Phone-only parts of a long binder (the strip, the heads' one-line preview, the body's row link): out of the desktop */
.aq-binder-tabs__strip, .aq-binder-tabs__go { display: none; }
.aq-binder-tabs__list:not([data-pk-on]) .aq-binder-tabs__ph { display: none; }

/* Phones, every binder (pass 12): signed once, on the last divider; a linked divider is a link from edge to edge */
@container (max-width: 860px) {
  .aq-binder-tabs__div:not(:last-child) .aq-binder-tabs__sign { display: none; }
  .aq-binder-tabs__div.has-link .aq-binder-tabs__t a { position: static; }
  .aq-binder-tabs__div.has-link .aq-binder-tabs__t a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .aq-binder-tabs__div.has-link .aq-binder-tabs__t a:focus-visible { outline: none; }
  .aq-binder-tabs__div.has-link:has(.aq-binder-tabs__t a:focus-visible) { outline: 2px solid var(--focus); outline-offset: -2px; }
}

/* Phones, long binders (8+ dividers; pass 12, S11): the tab strip sticks under the header (PhoneKit sticky strip, set
   here to 60 px), lighting the divider being read; each divider is a head (number, name, one line, chevron) that
   opens the whole text (PhoneKit accordion). */
@container (max-width: 860px) {
  .aq-binder-tabs__stack[data-pk-sticky][data-pk-on] .aq-binder-tabs__strip[data-pk-fig] {
    display: block; height: 60px; margin: 0 calc(-1 * var(--space-3)) var(--space-2); padding: var(--space-2) 0; background: var(--surface-sunken); border-bottom: 1px solid var(--line-strong); }
  .aq-binder-tabs__strip-in { display: flex; gap: var(--space-1); height: 44px; padding: 0 var(--space-3); overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; overscroll-behavior-x: contain; }
  .aq-binder-tabs__strip-in::-webkit-scrollbar { display: none; }
  .aq-binder-tabs__sb { flex: none; min-width: 44px; height: 44px; padding: 0 var(--space-3); scroll-snap-align: start; border: 1px solid color-mix(in srgb, var(--on-limestone) 30%, transparent); border-radius: 0;
    background: var(--limestone); color: var(--on-limestone); font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap; cursor: pointer;
    transition: background-color 200ms, color 200ms; }
  .aq-binder-tabs__sb:nth-child(even) { background: color-mix(in srgb, var(--limestone) 70%, var(--surface-raised)); }
  .aq-binder-tabs__sb.is-pk-active, .aq-binder-tabs__sb.is-pk-active:nth-child(even) { background: var(--navy); color: var(--on-navy); border-color: var(--navy); }
  .aq-binder-tabs__sb:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .aq-binder-tabs__list[data-pk-on] .aq-binder-tabs__div { display: block; padding: 0 var(--space-3); }
  .aq-binder-tabs__list[data-pk-on] .aq-binder-tabs__hd { display: grid; grid-template-columns: var(--space-8) minmax(0, 1fr) 44px; column-gap: 0; row-gap: 2px; align-items: baseline;
    padding: var(--space-3) 0; min-height: 56px; }
  .aq-binder-tabs__hn { grid-row: 1; font: 300 16px/24px var(--font-mono); color: var(--ink-subtle); }
  .aq-binder-tabs__ht { grid-row: 1; font: 500 16px/24px var(--font-sans); color: var(--ink); }
  .aq-binder-tabs__hd .aq-phone-kit__chev { grid-column: 3; grid-row: 1 / span 2; align-self: center; margin: 0 -10px 0 0; color: var(--ink-muted); }
  .aq-binder-tabs__h1 { grid-column: 2; grid-row: 2; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font: 400 14px/20px var(--font-sans); color: var(--ink-muted); }
  .aq-binder-tabs__hd[aria-expanded="true"] .aq-binder-tabs__h1 { visibility: hidden; height: 0; }
  .aq-binder-tabs__hd[aria-expanded="true"] .aq-binder-tabs__hn { color: var(--flow); }
  .aq-binder-tabs__list[data-pk-on] .aq-binder-tabs__body { padding: 0 0 var(--space-4) var(--space-8); margin-top: calc(-1 * var(--space-2)); }
  .aq-binder-tabs__list[data-pk-on] .aq-binder-tabs__d { margin: 0; font-size: 14px; line-height: 22px; }
  .aq-binder-tabs__list[data-pk-on] .aq-binder-tabs__go { display: flex; margin: var(--space-2) 0 0; padding-inline: 0; color: var(--flow); font-size: 15px; }
  .aq-binder-tabs__list[data-pk-on] .aq-binder-tabs__div.has-link .aq-binder-tabs__t a::after { content: none; }
  .aq-binder-tabs__list[data-pk-on] .aq-binder-tabs__ph { display: block; margin: 0; font: inherit; letter-spacing: inherit; }
  .aq-binder-tabs__list[data-pk-on] .aq-binder-tabs__div:not(:last-child) .aq-binder-tabs__sign { display: none; }
  /* signed once, under the last divider (as the short binder) */
  .aq-binder-tabs__list[data-pk-on] .aq-binder-tabs__div:last-child .aq-binder-tabs__sign { display: block; position: static; width: var(--space-16); margin: var(--space-2) 0 var(--space-4) var(--space-8); }
}

/* section hook (the look marks its section) */
.aq-binder-tabs-sec { position: relative; }

/* Dark (pass 12 C): every tab and strip chip the same raised fill with ink text (was limestone alternating with a
   muddy limestone-over-navy mix); the active or hovered tab stays navy */
:root[data-theme="dark"] .aq-binder-tabs__tab, :root[data-theme="dark"] .aq-binder-tabs__div:nth-child(even) .aq-binder-tabs__tab,
:root[data-theme="dark"] .aq-binder-tabs__sb, :root[data-theme="dark"] .aq-binder-tabs__sb:nth-child(even) {
  background: var(--surface-raised); color: var(--ink); border-color: var(--line-strong); }
:root[data-theme="dark"] .aq-binder-tabs__div:hover .aq-binder-tabs__tab, :root[data-theme="dark"] .aq-binder-tabs__div:focus-within .aq-binder-tabs__tab,
:root[data-theme="dark"] .aq-binder-tabs__sb.is-pk-active, :root[data-theme="dark"] .aq-binder-tabs__sb.is-pk-active:nth-child(even) {
  background: var(--navy); color: var(--on-navy); border-color: var(--navy); box-shadow: inset 0 -2px 0 var(--flow); }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .aq-binder-tabs__tab, :root:not([data-theme="light"]) .aq-binder-tabs__div:nth-child(even) .aq-binder-tabs__tab,
  :root:not([data-theme="light"]) .aq-binder-tabs__sb, :root:not([data-theme="light"]) .aq-binder-tabs__sb:nth-child(even) {
    background: var(--surface-raised); color: var(--ink); border-color: var(--line-strong); }
  :root:not([data-theme="light"]) .aq-binder-tabs__div:hover .aq-binder-tabs__tab, :root:not([data-theme="light"]) .aq-binder-tabs__div:focus-within .aq-binder-tabs__tab,
  :root:not([data-theme="light"]) .aq-binder-tabs__sb.is-pk-active, :root:not([data-theme="light"]) .aq-binder-tabs__sb.is-pk-active:nth-child(even) {
    background: var(--navy); color: var(--on-navy); border-color: var(--navy); box-shadow: inset 0 -2px 0 var(--flow); }
}

/* ---------- BuildingLoop: a building section on a navy band, one pale loop threading the floors to numbered stops (look "building-loop") ---------- */
/* The figure is three tracks: margin names | drawing | margin names. The margins stretch to the drawing's height and
   each name sits at its stop's height (--y, a fraction the look computes), so nothing is measured. */
.aq-building-loop { display: flex; flex-direction: column; gap: var(--space-8); }
.aq-building-loop__fig { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3.4fr) minmax(0, 1fr); column-gap: var(--space-4); border-top: 1px solid color-mix(in srgb, var(--on-navy-muted) 30%, transparent); padding-top: var(--space-8); }
.aq-building-loop__draw { min-width: 0; }
.aq-building-loop__svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-building-loop__svg path, .aq-building-loop__svg circle { fill: none; stroke-linecap: round; stroke-linejoin: round; }
.aq-building-loop__gr { stroke: var(--on-navy-muted); stroke-width: 1.5; }
.aq-building-loop__wall { stroke: var(--on-navy-muted); stroke-width: 2; }
.aq-building-loop__slab { stroke: var(--on-navy-muted); stroke-width: 4; opacity: 0.55; }
.aq-building-loop__hair { stroke: var(--on-navy-muted); stroke-width: 1; opacity: 0.45; }
.aq-building-loop__win { stroke: var(--on-navy-muted); stroke-width: 3; opacity: 0.4; }
.aq-building-loop__svg .aq-building-loop__fx { fill: var(--navy); stroke: var(--on-navy); stroke-width: 1.4; }
.aq-building-loop__fl { stroke: var(--on-navy-muted); stroke-width: 1; }
.aq-building-loop__loop { stroke: var(--limestone); stroke-width: 3.5; }
.aq-building-loop__glint { stroke: none; }
.aq-building-loop__drop { stroke: var(--limestone); stroke-width: 2; }
.aq-building-loop__lead { stroke: var(--on-navy-muted); stroke-width: 1; stroke-dasharray: 3 4; }
.aq-building-loop__svg .aq-building-loop__tick { fill: var(--navy); stroke: var(--on-navy); stroke-width: 1.4; }
.aq-building-loop__svg .aq-building-loop__ring { r: 16px; fill: var(--navy); stroke: var(--limestone); stroke-width: 2; }
.aq-building-loop__num { fill: var(--on-navy); font: 500 15px/1 var(--font-mono); text-anchor: middle; dominant-baseline: central; }
.aq-building-loop__stop * { transition: stroke 200ms ease, fill 200ms ease; }
.aq-building-loop__stop.is-hot .aq-building-loop__ring, .aq-building-loop__stop.is-hot .aq-building-loop__tick { fill: var(--flow); stroke: var(--on-navy); }
.aq-building-loop__stop.is-hot .aq-building-loop__lead { stroke: var(--flow); stroke-dasharray: none; }
.aq-building-loop__stop.is-hot .aq-building-loop__fx { stroke: var(--flow); }
/* margin names, level with their stops */
.aq-building-loop__margin { position: relative; min-width: 0; }
.aq-building-loop__label {
  position: absolute; top: calc(var(--y, 0.5) * 100%); transform: translateY(-50%); left: 0; right: 0;
  font: 400 15px/20px var(--font-sans); color: var(--on-navy); text-wrap: balance; transition: color 200ms ease;
}
.aq-building-loop__margin--l .aq-building-loop__label { text-align: end; }
.aq-building-loop__ln { font: 500 12px/20px var(--font-mono); color: var(--on-navy-muted); white-space: nowrap; }
.aq-building-loop__label.is-hot, .aq-building-loop__label.is-hot .aq-building-loop__ln { color: var(--flow); }
/* captions: one column per stop on hairlines */
.aq-building-loop__caps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr)); border-top: 1px solid color-mix(in srgb, var(--on-navy-muted) 40%, transparent); }
.aq-building-loop__cap { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-3); row-gap: var(--space-2); align-content: start; padding: var(--space-4) var(--space-4) 0; border-left: 1px solid color-mix(in srgb, var(--on-navy-muted) 30%, transparent); position: relative; }
.aq-building-loop__cap:first-child { border-left: 0; padding-left: 0; }
.aq-building-loop__cap::before { content: ""; position: absolute; left: 0; right: 0; top: -1px; border-top: 2px solid var(--flow); transform: scaleX(0); transform-origin: 0 50%; transition: transform 300ms cubic-bezier(0.2, 0, 0, 1); }
.aq-building-loop__cap.is-hot::before { transform: scaleX(1); }
.aq-building-loop__no { display: grid; place-items: center; width: calc(var(--space-6) + var(--space-2)); height: calc(var(--space-6) + var(--space-2)); border: 1.5px solid var(--limestone); border-radius: var(--radius-pill); font: 500 12px/1 var(--font-mono); color: var(--on-navy); transition: background-color 200ms ease; }
.aq-building-loop__cap.is-hot .aq-building-loop__no { background: var(--flow); }
.aq-building-loop__t { margin: 0; align-self: center; font: 500 16px/22px var(--font-sans); color: var(--on-navy); text-wrap: balance; }
.aq-building-loop__d { grid-column: 2; margin: 0; font: 400 14px/22px var(--font-sans); color: var(--on-navy-muted); text-wrap: pretty; }
.aq-building-loop-sec { position: relative; }

@container (max-width: 1100px) {
  .aq-building-loop__fig { grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr) minmax(0, 1fr); }
  .aq-building-loop__label { font-size: 14px; line-height: 18px; }
  .aq-building-loop__cap { grid-template-columns: minmax(0, 1fr); padding-left: var(--space-3); }
  .aq-building-loop__d { grid-column: 1; }
  /* the drawing renders at ~420 px here: larger rings and numerals so they stay legible (phones override below) */
  .aq-building-loop__svg .aq-building-loop__ring { r: 20px; }
  .aq-building-loop__num { font-size: 20px; }
}
/* wide: one-line and two-line caption titles take the same height, so every body starts level */
@container (min-width: 1101px) {
  .aq-building-loop__t { min-height: 44px; display: flex; align-items: center; }
}
/* Phones: the drawing at full width with its numbered stops, then a riser: the pale loop down the left, a row per stop */
@container (max-width: 860px) {
  .aq-building-loop { gap: var(--space-6); }
  .aq-building-loop__fig { display: block; padding-top: var(--space-6); }
  .aq-building-loop__margin { display: none; }
  .aq-building-loop__svg .aq-building-loop__ring { r: 26px; stroke-width: 3; }
  .aq-building-loop__num { font-size: 28px; }
  .aq-building-loop__loop { stroke-width: 5; }
  .aq-building-loop__lead, .aq-building-loop__tick { display: none; }
  .aq-building-loop__caps { display: block; position: relative; border-top: 0; padding-left: calc(var(--space-12) + var(--space-2)); }
  .aq-building-loop__caps::before { content: ""; position: absolute; left: calc(var(--space-4) + var(--space-1) - 1px); top: var(--space-2); bottom: var(--space-6); border-left: 3px solid var(--limestone); border-radius: var(--radius-pill); }
  .aq-building-loop__cap, .aq-building-loop__cap:first-child { display: block; position: relative; border-left: 0; padding: 0 0 var(--space-6); }
  .aq-building-loop__cap::before { display: none; }
  .aq-building-loop__no { position: absolute; left: calc(-1 * (var(--space-12) + var(--space-2))); top: calc(-1 * var(--space-1)); width: calc(var(--space-8) + var(--space-1)); height: calc(var(--space-8) + var(--space-1)); background: var(--navy); border-width: 2px; }
  .aq-building-loop__t { font-size: 17px; line-height: 24px; }
  .aq-building-loop__d { margin-top: var(--space-1); font-size: var(--aq-read-phone, 14px); line-height: 22px; }
}

/* ---------- CalcPad: a grade table as working on a squared calculation pad ---------- */
/* The pad: a squared sheet (16 px squares), a double margin rule in flow with the line numbers left of it, and each
   line's work flowing to an equals sign with its answer boxed at the right. */
.aq-calc-pad { --pad-margin: var(--space-16); position: relative; padding: var(--space-8) var(--space-8) var(--space-8) calc(var(--pad-margin, var(--space-16)) + var(--space-6));
  border: 1px solid var(--line-strong); color: var(--ink);
  background-color: var(--surface-raised);
  background-image: linear-gradient(color-mix(in srgb, var(--line) 70%, transparent) 1px, transparent 1px),
    linear-gradient(90deg, color-mix(in srgb, var(--line) 70%, transparent) 1px, transparent 1px);
  background-size: var(--space-4) var(--space-4); background-position: -1px -1px; }
.aq-calc-pad::before { content: ""; position: absolute; top: 0; bottom: 0; left: var(--pad-margin, var(--space-16)); width: var(--space-1);
  border-left: 1px solid var(--flow); border-right: 1px solid var(--flow); pointer-events: none; }
.aq-calc-pad__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

/* The key line: the columns in the derivation's order */
.aq-calc-pad__key { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); margin: 0 0 var(--space-8);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-calc-pad__key .aq-calc-pad__op { padding: 0; font: 400 16px/16px var(--font-sans); color: var(--flow); }
.aq-calc-pad__keybox { padding: var(--space-1) var(--space-2); border: 1px solid var(--line-strong); }

.aq-calc-pad__lines { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--space-8); }
.aq-calc-pad__line { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 300px); column-gap: var(--space-6); align-items: start; cursor: default; }
.aq-calc-pad__no { position: absolute; top: 0; right: calc(100% + var(--space-6) + var(--space-4)); font: 500 15px/32px var(--font-mono); color: var(--ink-muted);
  transition: color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-calc-pad__line.is-on .aq-calc-pad__no { color: var(--flow); }
.aq-calc-pad__work { margin: 0; font: 300 24px/32px var(--font-sans); letter-spacing: -0.01em; }
.aq-calc-pad__class { color: var(--ink); }
.aq-calc-pad__sets { color: var(--ink-muted); }
.aq-calc-pad__op { display: inline-block; padding-inline: var(--space-1); font-weight: 400; color: var(--flow); }
.aq-calc-pad__code { font-family: var(--font-mono); font-size: 0.86em; font-weight: 400; letter-spacing: -0.01em; white-space: nowrap; }

/* The answer box: drawn in ink, lit steel blue on the chosen line */
.aq-calc-pad__ans { position: relative; margin: 0; padding: calc(var(--space-2) - 2px) var(--space-4); border: 2px solid var(--ink); background: var(--surface-raised);
  font: 400 18px/28px var(--font-sans); color: var(--ink);
  transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), border-color 200ms cubic-bezier(0.2, 0, 0, 1), color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-calc-pad__line.is-on .aq-calc-pad__ans { border-color: var(--flow); background: var(--flow); color: var(--surface); }
.aq-calc-pad__line.is-on .aq-calc-pad__ans .aq-ph { color: inherit; }

/* Phones: the margin narrows, each line wraps above a full-width answer box */
@container (max-width: 860px) {
  .aq-calc-pad { --pad-margin: var(--space-8); padding: var(--space-6) var(--space-4) var(--space-6) calc(var(--pad-margin, var(--space-16)) + var(--space-4)); }
  .aq-calc-pad__key { margin-bottom: var(--space-6); }
  .aq-calc-pad__lines { gap: var(--space-6); }
  .aq-calc-pad__line { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-2); }
  .aq-calc-pad__no { right: calc(100% + var(--space-4) + var(--space-2)); font-size: 13px; line-height: 28px; }
  .aq-calc-pad__work { font-size: 19px; line-height: 28px; }
  .aq-calc-pad__ans { font-size: 16px; line-height: 24px; padding-inline: var(--space-3); }
}
@container (max-width: 400px) {
  .aq-calc-pad { --pad-margin: var(--space-6); padding-right: var(--space-3); padding-left: calc(var(--pad-margin, var(--space-16)) + var(--space-3)); }
  .aq-calc-pad__no { right: calc(100% + var(--space-3) + var(--space-1)); font-size: 12px; }
  /* what sets it on its own line under the class, smaller, led by its arrow: the derivation order reads by position too */
  .aq-calc-pad__sets { display: block; font-size: 16px; line-height: 24px; }
  .aq-calc-pad__sets > .aq-calc-pad__op:first-child { padding-left: 0; }
  .aq-calc-pad__key { column-gap: var(--space-2); }
}

@media (prefers-reduced-motion: reduce) {
  .aq-calc-pad__ans, .aq-calc-pad__no { transition: none; }
}

/* ---------- CaseStudy: facts beside one large measured-outcome figure ---------- */
/* Cases stack, each opened by a line hairline. Desktop: Client, Problem and System delivered as hairline rows in the
   left column; the outcome on a surface-raised panel spanning their height on the right, its top edge a flow
   hairline and the figure set large in Geist Mono Light. No heavy boxes, no shadows. */
.aq-cases { counter-reset: aq-case; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-16); }
.aq-case {
  counter-increment: aq-case;
  display: flex; flex-direction: column; gap: var(--space-6);
  min-width: 0; padding-top: var(--space-8);
  border-top: 1px solid var(--line);
}

/* Header: "Case 01" eyebrow, then the title */
.aq-case__title { margin: 0; text-wrap: pretty; overflow-wrap: break-word; }
.aq-case__title::before {
  content: "Case " counter(aq-case, decimal-leading-zero);
  display: block; margin-bottom: var(--space-2);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  font-variant-numeric: tabular-nums; color: var(--ink-muted);
}

/* The dl is the grid; each dt/dd pair is a div (which dl allows) */
.aq-case__facts {
  margin: 0;
  display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  grid-auto-rows: auto; column-gap: var(--space-12); row-gap: 0;
}
.aq-case__fact, .aq-case__outcome { min-width: 0; display: flex; flex-direction: column; gap: var(--space-2); }
.aq-case__fact { grid-column: 1; padding: var(--space-4) 0; border-top: 1px solid var(--line); }
.aq-case__fact:first-child { border-top: 0; padding-top: 0; }
.aq-case__facts dt, .aq-case__entries dt, .aq-case__figures dt { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-case dd { margin: 0; overflow-wrap: break-word; }
.aq-case__fact dd { font: 400 16px/26px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* Outcome: spans the fact rows; the flow top hairline is the case's one accent */
.aq-case__outcome {
  grid-column: 2; grid-row: 1 / span 3; align-self: stretch;
  padding: var(--space-6) var(--space-8) var(--space-8);
  background: var(--surface-raised);
  border-top: 1px solid var(--flow);
}
.aq-case__facts:not(:has(> .aq-case__fact)) > .aq-case__outcome { grid-column: 1 / -1; grid-row: auto; }
.aq-case__outcome dd { flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-6); }
.aq-case__figure { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-3); row-gap: var(--space-2); min-width: 0; padding-top: var(--space-4); }
.aq-case__num {
  min-width: 0; overflow-wrap: anywhere;
  font: 300 clamp(64px, 9cqi, 128px)/1 var(--font-mono);
  letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
  color: var(--flow);
}
.aq-case__unit { font: 400 28px/34px var(--font-mono); letter-spacing: 0; color: var(--ink); }
/* A bracketed value inside the figure keeps the placeholder look, scaled to the slot */
.aq-case__num .aq-ph, .aq-case__unit .aq-ph { font-size: 0.4em; vertical-align: middle; }
.aq-case__result { max-width: var(--text-max); font: 400 18px/28px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* No figure supplied yet: a dashed placeholder slot the size of the figure, so the gap is obvious in review */
.aq-case__figure.is-empty {
  align-items: center; justify-content: center;
  min-height: clamp(96px, 9cqi, 128px);
  margin-top: var(--space-4); padding: var(--space-4);
  border: 1px dashed var(--caution);
  background: var(--caution-tint);
}
.aq-case__figure.is-empty .aq-ph { font-size: 18px; line-height: 24px; text-align: center; }
.is-clean .aq-case__figure.is-empty { border-color: var(--line); background: none; color: var(--ink-subtle); }

/* Outcome spans however many fact rows there are (three by default; Standard met makes four). Two-column widths only. */
@container (min-width: 861px) {
  .aq-case__facts:has(> .aq-case__fact:nth-child(4)) > .aq-case__outcome { grid-row: 1 / span 4; }
  .aq-case__facts:not(:has(> .aq-case__fact:nth-child(3))) > .aq-case__outcome { grid-row: 1 / span 2; }
  .aq-case__facts:not(:has(> .aq-case__fact:nth-child(2))) > .aq-case__outcome { grid-row: 1; }
}

/* How it was measured: a full-width hairline row under the facts and outcome, quieter than the facts */
.aq-case__method {
  grid-column: 1 / -1; min-width: 0;
  display: flex; flex-direction: column; gap: var(--space-2);
  margin-top: var(--space-6); padding-top: var(--space-4);
  border-top: 1px solid var(--line);
}
.aq-case__method dd { font: 400 15px/24px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

/* Status label: says the case is a template or awaiting client approval (a draft flag, like a placeholder) */
.aq-case__status {
  align-self: flex-start;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--caution); background: var(--caution-tint);
  padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm);
}

/* Project profile: the KeyFacts strip of headline KPIs, under the title, as KeyFacts draws it (between hairlines,
   on the page ground); the case's own dt/dd rules are scoped so they do not reach it */
.aq-case__profile { background: none; }

/* Motion hook (CaseStudy/motion.js): the timeline line runs out stop by stop through --aq-run; complete without script */
.aq-case__timeline li::before { transform: scaleX(var(--aq-run, 1)); transform-origin: left; }

@container (max-width: 860px) {
  /* Phones: one column. Facts and method are hairline rows (label above text); the outcome panel follows them,
     figure scaled to the screen. */
  .aq-cases { gap: var(--space-12); }
  .aq-case { padding-top: var(--space-6); gap: var(--space-4); }
  .aq-case__facts { grid-template-columns: minmax(0, 1fr); }
  .aq-case__fact, .aq-case__outcome { grid-column: 1; grid-row: auto; }
  .aq-case__fact { gap: var(--space-1); padding: var(--space-3) 0; }
  .aq-case__outcome { margin-block: var(--space-3) 0; padding: var(--space-4); }
  .aq-case__method { grid-column: 1; gap: var(--space-1); margin-top: var(--space-4); padding-top: var(--space-3); }
  .aq-case__fact dd { font-size: 15px; line-height: 24px; }
  .aq-case__outcome dd { gap: var(--space-4); }
  .aq-case__figure { padding-top: var(--space-2); }
  .aq-case__num { font-size: clamp(48px, 16cqi, 80px); }
  .aq-case__unit { font-size: 20px; line-height: 24px; }
  .aq-case__result { font-size: 16px; line-height: 26px; }
  .aq-case__figure.is-empty { min-height: var(--space-24); margin-top: var(--space-2); }
  .aq-case__figure.is-empty .aq-ph { font-size: 15px; }
}

/* ---------- Project record (.aq-case--record): the case told as a project record ----------
   Facts as hairline rows beside the system's equipment drawing with what changed marked on it, then the measured
   outcomes as large figures with the method beneath, then the order-to-release milestones on one hairline. */
.aq-case__label { margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-case__brief { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-12); align-items: start; }
.aq-case__brief.is-bare { grid-template-columns: minmax(0, 1fr); }
.aq-case__entries { margin: 0; display: flex; flex-direction: column; }
.aq-case__entry { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-3) 0; border-top: 1px solid var(--line); }
.aq-case__entry:first-child { border-top: 0; padding-top: 0; }
.aq-case__entry dd { font: 400 16px/26px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* Drawing: the page's equipment mask on a Plate (base.css: a line frame on surface-raised); numbered marks pin what changed */
.aq-case__drawing { margin: 0; display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
/* The inner box is the drawing's own square, so pin positions (% of the drawing) land on the equipment at any width */
.aq-case__plate { position: relative; width: min(100%, 26rem); margin-inline: auto; }
.aq-case__art .aq-illustration { max-width: none; }
.aq-case__mark {
  flex: none; display: inline-grid; place-items: center; box-sizing: border-box; width: var(--space-6); height: var(--space-6);
  border: 1px solid var(--flow); border-radius: var(--radius-sm); background: var(--surface-raised); color: var(--flow);
  font: 500 12px/1 var(--font-mono); font-variant-numeric: tabular-nums;
}
.aq-case__pin { position: absolute; transform: translate(-50%, -50%); display: flex; }
.aq-case__changes { display: flex; flex-direction: column; gap: var(--space-2); }
.aq-case__changes ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--space-2); }
.aq-case__changes li { display: flex; align-items: flex-start; gap: var(--space-3); font: 400 15px/24px var(--font-sans); color: var(--ink); text-wrap: pretty; }

/* Outcomes, the hero of the record: large mono figures with the unit, an eyebrow caption, and the method beneath;
   two per row on desktop, one per row on phones */
.aq-case__outcomes { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-6); border-top: 1px solid var(--line); }
.aq-case__outcomes > .aq-case__result { margin: 0; font-size: 16px; line-height: 26px; }
.aq-case__figures { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-12); row-gap: var(--space-8); }
.aq-case__fig { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; padding-top: var(--space-4); border-top: 1px solid var(--line); }
.aq-case__fig dt { order: 2; }
.aq-case__fig dd { display: contents; }
.aq-case__val { order: 1; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-3); row-gap: var(--space-1); min-width: 0; }
.aq-case__fig .aq-case__num { font: 300 clamp(48px, 5.4cqi, 64px)/1.05 var(--font-mono); letter-spacing: -0.04em; color: var(--ink); overflow-wrap: anywhere; }
.aq-case__fig .aq-case__num .aq-ph { font-size: 1em; padding: 0 var(--space-1); }
.aq-case__fig .aq-case__unit { font: 400 clamp(20px, 2.4cqi, 28px)/1.2 var(--font-mono); letter-spacing: 0; color: var(--ink); }
.aq-case__how { order: 3; font: 400 14px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; overflow-wrap: break-word; }

/* Timeline: order to release, milestones as small square stops on one hairline */
.aq-case__timeline { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-6); border-top: 1px solid var(--line); }
.aq-case__timeline ol { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(var(--n, 6), minmax(0, 1fr)); }
.aq-case__timeline li { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-1); padding-top: var(--space-8); text-align: center; min-width: 0; }
.aq-case__timeline li::before { content: ""; position: absolute; top: var(--space-2); left: 0; right: 0; border-top: 1px solid var(--line-strong); }
.aq-case__timeline li:first-child::before { left: 50%; }
.aq-case__timeline li:last-child::before { right: 50%; }
.aq-case__stop {
  position: absolute; top: calc(var(--space-2) - 4px); left: 50%; transform: translateX(-50%); box-sizing: border-box;
  width: 9px; height: 9px; border: 1px solid var(--flow); background: var(--surface);
}
.aq-case__timeline li:last-child .aq-case__stop { background: var(--flow); }
.aq-case__mt { font: 500 14px/20px var(--font-sans); color: var(--ink); overflow-wrap: break-word; }
.aq-case__when { font: 400 13px/20px var(--font-mono); color: var(--ink-muted); font-variant-numeric: tabular-nums; }

@container (max-width: 860px) {
  /* Phones: drawing first, then the facts, outcomes one per row, then a vertical timeline */
  .aq-case__brief { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .aq-case__drawing { order: -1; }
  .aq-case__plate { width: min(100%, 17.5rem); }
  .aq-case__entry { padding: var(--space-3) 0; }
  .aq-case__entry dd { font-size: 15px; line-height: 24px; }
  .aq-case__changes li { font-size: 14px; line-height: 22px; }
  .aq-case__outcomes, .aq-case__timeline { padding-top: var(--space-4); }
  .aq-case__figures { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); }
  .aq-case__fig .aq-case__num { font-size: clamp(40px, 13cqi, 52px); }
  .aq-case__fig .aq-case__unit { font-size: 20px; }
  .aq-case__how { font-size: 13px; line-height: 20px; }
  .aq-case__timeline ol { grid-template-columns: minmax(0, 1fr); }
  .aq-case__timeline li { flex-direction: row; flex-wrap: wrap; align-items: baseline; justify-content: space-between; column-gap: var(--space-3); padding: 0 0 var(--space-4) var(--space-8); text-align: left; }
  .aq-case__timeline li::before { top: var(--space-2); bottom: 0; left: 4px; right: auto; border-top: 0; border-left: 1px solid var(--line-strong); }
  .aq-case__timeline li:first-child::before { left: 4px; }
  .aq-case__timeline li:last-child::before { display: none; }
  .aq-case__timeline li:last-child { padding-bottom: 0; }
  .aq-case__stop { top: 6px; left: 0; transform: none; }
}
@container (max-width: 860px) { .aq-case__timeline li::before { transform: scaleY(var(--aq-run, 1)); transform-origin: top; } }

/* ---------- CertSeals: certification status as certificate tiles in a Swiss row (look "cert-seals"). Square tiles,
   no gaps but a hairline: the first navy (on-navy text), the rest limestone in two shades (on-limestone text). Each
   tile: a seal (ring of ticks, icon at its centre, flow on navy lightened), the tag large and light, title, status. ---------- */
.aq-cert-seals-sec { position: relative; }
.aq-cert-seals { position: relative; }
.aq-cert-seals__list {
  list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); gap: 1px;
  background: color-mix(in srgb, var(--on-limestone) 18%, transparent); border: 1px solid color-mix(in srgb, var(--on-limestone) 18%, transparent);
}
.aq-cert-seals__item { display: flex; }
.aq-cert-seals__tile {
  position: relative; flex: 1 1 auto; display: flex; flex-direction: column; gap: var(--space-3); min-height: calc(var(--space-32) * 3);
  padding: var(--space-8) var(--space-6) var(--space-8); background: var(--limestone); color: var(--on-limestone); text-decoration: none;
  transition: background 240ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-cert-seals__item:nth-child(odd) .aq-cert-seals__tile { background: color-mix(in srgb, var(--limestone) 88%, var(--on-limestone)); }
.aq-cert-seals__item:first-child .aq-cert-seals__tile { background: var(--navy); color: var(--on-navy); }
a.aq-cert-seals__tile:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; z-index: 1; }

/* the seal */
.aq-cert-seals__seal { position: relative; display: block; width: var(--space-24); height: var(--space-24); margin-bottom: var(--space-8); color: var(--on-limestone); }
.aq-cert-seals__item:first-child .aq-cert-seals__seal { color: var(--on-navy); }
.aq-cert-seals__seal svg { display: block; width: 100%; height: 100%; overflow: visible; }
.aq-cert-seals__ticks { fill: none; stroke: currentColor; stroke-width: 1; opacity: 0.7; vector-effect: non-scaling-stroke; }
.aq-cert-seals__ring { fill: none; stroke: currentColor; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
.aq-cert-seals__icon { position: absolute; left: 50%; top: 50%; width: var(--space-8); height: var(--space-8); transform: translate(-50%, -50%); background-color: currentColor; }

/* the words */
.aq-cert-seals__tag { margin: 0; font: 300 48px/52px var(--font-sans); letter-spacing: -0.03em; overflow-wrap: anywhere; }
.aq-cert-seals__tag.is-long { font-size: 20px; line-height: 28px; letter-spacing: -0.01em; }
.aq-cert-seals__t { margin: auto 0 0; padding-top: var(--space-4); border-top: 1px solid color-mix(in srgb, currentColor 30%, transparent); font: 500 17px/24px var(--font-sans); }
.aq-cert-seals__d { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--on-limestone-muted); }
.aq-cert-seals__item:first-child .aq-cert-seals__d { color: var(--on-navy-muted); }
/* where a linked tile goes (round C verify F4): the linked page's own label, under the status */
.aq-cert-seals__to { margin: 0; padding-top: var(--space-1); font: 400 14px/20px var(--font-sans); color: var(--on-limestone-muted); }
.aq-cert-seals__item:first-child .aq-cert-seals__to { color: var(--on-navy-muted); }
.aq-cert-seals__go { position: absolute; right: var(--space-6); top: var(--space-8); width: var(--space-4); height: var(--space-4); border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: rotate(45deg); transition: transform 240ms cubic-bezier(0.2, 0, 0, 1); }
a.aq-cert-seals__tile:hover .aq-cert-seals__go { transform: translateX(var(--space-1)) rotate(45deg); }
a.aq-cert-seals__tile:hover .aq-cert-seals__t { text-decoration: underline; text-underline-offset: 4px; }
a.aq-cert-seals__tile:hover .aq-cert-seals__seal svg { transform: rotate(10deg); transition: transform 400ms cubic-bezier(0.2, 0, 0, 1); }

@media (prefers-reduced-motion: reduce) { .aq-cert-seals__tile, .aq-cert-seals__go, a.aq-cert-seals__tile:hover .aq-cert-seals__seal svg { transition: none; } }

@container (max-width: 1100px) {
  .aq-cert-seals__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* round C verify F2: tiles take their content's height (rows still match), and an odd last tile spans the row as a
     wide row tile (seal left, words right), so five tiles leave no empty cell at 561 to 1100 px */
  .aq-cert-seals__tile { min-height: 0; }
}
@container (min-width: 561px) and (max-width: 1100px) {
  .aq-cert-seals__item:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .aq-cert-seals__item:last-child:nth-child(odd) .aq-cert-seals__tile { display: grid; grid-template-columns: var(--space-24) minmax(0, 1fr); column-gap: var(--space-6); row-gap: var(--space-2); align-content: start; }
  .aq-cert-seals__item:last-child:nth-child(odd) .aq-cert-seals__seal { grid-row: 1 / span 3; margin: 0; }
  .aq-cert-seals__item:last-child:nth-child(odd) .aq-cert-seals__t { margin: 0; }
  .aq-cert-seals__item:last-child:nth-child(odd) .aq-cert-seals__to { grid-column: 2; }
}
@container (max-width: 560px) {
  .aq-cert-seals__list { grid-template-columns: minmax(0, 1fr); }
  .aq-cert-seals__tile { min-height: 0; padding: var(--space-4) var(--space-8) var(--space-4) var(--space-4); display: grid; grid-template-columns: var(--space-16) minmax(0, 1fr); column-gap: var(--space-4); row-gap: var(--space-2); }
  .aq-cert-seals__seal { grid-row: 1 / span 3; width: var(--space-16); height: var(--space-16); margin: 0; }
  .aq-cert-seals__icon { width: var(--space-6); height: var(--space-6); }
  .aq-cert-seals__tag { font-size: 32px; line-height: 36px; }
  .aq-cert-seals__tag.is-long { font-size: 16px; line-height: 23px; } /* pass 12 round C: cmp-quality's placeholders, about 900 px for five tiles */
  .aq-cert-seals__t { margin: 0; padding-top: var(--space-2); }
  /* phones: the destination stays in the tile's accessible name but is not printed (it added about 160 px to five
     tiles already over the 900 px aim); the arrow marks the link */
  .aq-cert-seals__to { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .aq-cert-seals__go { top: var(--space-6); right: var(--space-4); width: var(--space-3); height: var(--space-3); }
}

/* Dark theme (round C verify F6): the paper tiles take the raised dark surface, as LimitBento's do, so the row reads
   navy plus one dark surface, not three themes; the alternate shade is a touch of ink over it. */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .aq-cert-seals__list { background: var(--line); border-color: var(--line); }
  :root:not([data-theme="light"]) .aq-cert-seals__item.is-paper .aq-cert-seals__tile { background: var(--surface-raised); color: var(--ink); }
  :root:not([data-theme="light"]) .aq-cert-seals__item.is-paper:nth-child(odd) .aq-cert-seals__tile { background: color-mix(in srgb, var(--surface-raised) 94%, var(--ink)); }
  :root:not([data-theme="light"]) .aq-cert-seals__item.is-paper .aq-cert-seals__seal { color: var(--ink); }
  :root:not([data-theme="light"]) .aq-cert-seals__item.is-paper .aq-cert-seals__d,
  :root:not([data-theme="light"]) .aq-cert-seals__item.is-paper .aq-cert-seals__to { color: var(--ink-muted); }
}
[data-theme="dark"] .aq-cert-seals__list { background: var(--line); border-color: var(--line); }
[data-theme="dark"] .aq-cert-seals__item.is-paper .aq-cert-seals__tile { background: var(--surface-raised); color: var(--ink); }
[data-theme="dark"] .aq-cert-seals__item.is-paper:nth-child(odd) .aq-cert-seals__tile { background: color-mix(in srgb, var(--surface-raised) 94%, var(--ink)); }
[data-theme="dark"] .aq-cert-seals__item.is-paper .aq-cert-seals__seal { color: var(--ink); }
[data-theme="dark"] .aq-cert-seals__item.is-paper .aq-cert-seals__d,
[data-theme="dark"] .aq-cert-seals__item.is-paper .aq-cert-seals__to { color: var(--ink-muted); }

/* Engraving (pass 9b): FxGuilloche's rosette on the navy tile, centred low and right so it sits behind the tag and
   lines as a certificate's security print; on-navy at a ninth, so the white type keeps its contrast. */
.aq-cert-seals__tile > .aq-fx-shader { --fx-amt: 0.11; --fx-x: 0.72; --fx-y: 0.42; --fx-size: 1.5; }

/* ---------- CheckLedger: checks before a case study, as a ledger of tiles (pass 9b) ---------- */
/* Wide: a schedule header over five tracks (numeral tile, route, what you check, what it does not prove, time). Each
   row is a strip of square tiles on hairlines; the numeral tile is navy with a light slash numeral. The crosshair
   (motion) lays a flow row rule and column rule over the grid and lights the column head. */
.aq-check-ledger-sec { }
.aq-check-ledger { position: relative; --cl-cols: var(--space-32) minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1.2fr) minmax(0, 1fr); margin-top: var(--space-4); }
.aq-check-ledger__head { display: grid; grid-template-columns: var(--cl-cols, 1fr); align-items: end; padding-bottom: var(--space-3); }
.aq-check-ledger__hc { padding-left: var(--space-4); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); transition: color 200ms; }
.aq-check-ledger__hc.is-col { color: var(--flow); }
.aq-check-ledger__hn { }
.aq-check-ledger__hi { color: var(--ink-subtle); }
.aq-check-ledger__rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
.aq-check-ledger__row { display: grid; grid-template-columns: var(--cl-cols, 1fr); border-bottom: 1px solid var(--line-strong); }
.aq-check-ledger__n { grid-column: 1; grid-row: 1; position: relative; display: flex; align-items: flex-start; padding: var(--space-3) var(--space-4); background: var(--navy); color: var(--on-navy);
  border-bottom: 1px solid color-mix(in srgb, var(--on-navy) 22%, var(--navy)); margin-bottom: -1px; }
.aq-check-ledger__nv { font: 300 64px/1 var(--font-sans); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; white-space: nowrap; }
.aq-check-ledger__c { position: relative; min-width: 0; padding: var(--space-4) var(--space-4) var(--space-6); border-left: 1px solid var(--line); background: var(--surface-raised); transition: background-color 200ms; }
.aq-check-ledger__c--go { grid-column: 2; grid-row: 1; }
.aq-check-ledger__c--t { grid-column: 3; grid-row: 1; }
.aq-check-ledger__c--no { grid-column: 4; grid-row: 1; }
.aq-check-ledger__c--time { grid-column: 5; grid-row: 1; background: var(--surface); }
.aq-check-ledger__c.is-cell { background: var(--flow-tint); }
.aq-check-ledger__k { display: block; margin-bottom: var(--space-2); font: 400 13px/18px var(--font-sans); color: var(--ink-muted); }
.aq-check-ledger__t { margin: 0; font: 300 22px/29px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); text-wrap: pretty; }
.aq-check-ledger__no { margin: 0; font: 300 20px/28px var(--font-sans); color: var(--ink); text-wrap: pretty; }
.aq-check-ledger__time { margin: 0; font: 400 14px/22px var(--font-mono); color: var(--ink); overflow-wrap: anywhere; }
.aq-check-ledger__time .aq-ph { font-size: 13px; }
/* The route: the row's action, a link set as the tile's title with an arrow that moves on hover */
.aq-check-ledger__go { display: inline-block; padding-block: var(--space-1) var(--space-3); color: var(--ink); text-decoration: none;
  font: 400 21px/28px var(--font-sans); letter-spacing: -0.01em; }
.aq-check-ledger__go span { box-shadow: inset 0 -1px 0 var(--line-strong); transition: box-shadow 200ms, color 200ms; }
a.aq-check-ledger__go::after { content: "→"; display: inline-block; margin-left: var(--space-2); color: var(--flow); transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); }
a.aq-check-ledger__go:hover span { color: var(--flow); box-shadow: inset 0 -2px 0 var(--flow); }
a.aq-check-ledger__go:hover::after { transform: translateX(var(--space-1)); }
.aq-check-ledger__go:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
/* Fitting tiles: a small navy blueprint square set into the tile's lower right corner */
.aq-check-ledger__c.has-fit { padding-right: calc(var(--space-16) + var(--space-8)); }
.aq-check-ledger__fit { position: absolute; right: 0; bottom: 0; top: 0; width: calc(var(--space-16) + var(--space-4)); display: grid; place-items: center; background: var(--navy); border-left: 1px solid var(--line); }
.aq-check-ledger__fit-svg { display: block; width: 76%; height: auto; }
/* Split-flap numeral (motion only): each glyph a cell whose leaf turns over the centre line */
.aq-check-ledger__sr { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
.aq-cl-flap { position: relative; display: inline-block; perspective: 500px; }
.aq-cl-flap__s { display: inline-block; visibility: hidden; }
.aq-cl-flap__leaf { position: absolute; inset: 0; transform-style: preserve-3d; transform-origin: 50% 50%; }
.aq-cl-flap__f, .aq-cl-flap__b { position: absolute; inset: 0; backface-visibility: hidden; background: var(--navy); color: var(--on-navy-muted); }
.aq-cl-flap__b { transform: rotateX(180deg); color: var(--on-navy); }
.aq-cl-flap__seam { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: color-mix(in srgb, var(--on-navy) 30%, transparent); pointer-events: none; }
/* Crosshair rules (motion only) */
.aq-check-ledger__xh, .aq-check-ledger__xv { position: absolute; left: 0; top: 0; display: none; pointer-events: none; background: var(--flow); opacity: 0; z-index: 2; }
.aq-check-ledger__xh { height: 2px; }
.aq-check-ledger__xv { width: 2px; }
.aq-check-ledger-sec .aq-fold__btn { margin-top: var(--space-4); }

@container (max-width: 1100px) {
  .aq-check-ledger { --cl-cols: var(--space-24) minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1.1fr) minmax(0, 1fr); }
  .aq-check-ledger__nv { font-size: 48px; }
  .aq-check-ledger__t { font-size: 19px; line-height: 26px; }
  .aq-check-ledger__no { font-size: 17px; line-height: 25px; }
  .aq-check-ledger__go { font-size: 18px; line-height: 25px; }
}
/* Phones: one card per check. The numeral tile and the route share the top strip; what you check, what it does not
   prove and the time stack under it, each tile naming its column. */
@container (max-width: 860px) {
  .aq-check-ledger__head { display: none; }
  .aq-check-ledger__rows { border-top: 0; display: grid; gap: var(--space-4); }
  .aq-check-ledger__row { grid-template-columns: var(--space-16) minmax(0, 1fr); border: 1px solid var(--line-strong); }
  .aq-check-ledger__n { grid-column: 1; grid-row: 1; padding: var(--space-3) var(--space-2); justify-content: center; margin-bottom: 0; }
  .aq-check-ledger__nv { font-size: 30px; }
  .aq-check-ledger__c { padding: var(--space-2) var(--space-4) var(--space-3); border-left: 0; border-top: 1px solid var(--line); }
  .aq-check-ledger__k { margin-bottom: var(--space-1); font-size: 12px; line-height: 16px; }
  .aq-check-ledger__c--go { grid-column: 2; grid-row: 1; border-top: 0; }
  .aq-check-ledger__c--t, .aq-check-ledger__c--no, .aq-check-ledger__c--time { grid-column: 1 / -1; grid-row: auto; }
  .aq-check-ledger__t { font-size: 20px; line-height: 27px; }
  .aq-check-ledger__no { font-size: 16px; line-height: 24px; }
  .aq-check-ledger__go { font-size: 17px; line-height: 24px; }
  .aq-check-ledger__c.has-fit { padding-right: calc(var(--space-12) + var(--space-6)); }
  .aq-check-ledger__fit { width: var(--space-16); }
}

/* Pass 12 round C (audit-c group-6 projects.3) */
/* phone-only parts out of the desktop render; the body's tiles are the row's grid items there */
.aq-check-ledger__ph, .aq-check-ledger__plinks { display: none; }
.aq-check-ledger__body { display: contents; }
/* wide: the header row names the columns, so the in-cell names are for screen readers only */
@container (min-width: 861px) {
  .aq-check-ledger__k { position: absolute; width: 1px; height: 1px; margin: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
}
/* phones: a PhoneKit accordion, the first check open. Head: the numeral tile and what you check; body: the route as a
   48 px row link, then what you receive and the time under 12 px mono eyebrows */
@container (max-width: 860px) {
  .aq-check-ledger__rows[data-pk-on] { display: block; border-top: 1px solid var(--line-strong); }
