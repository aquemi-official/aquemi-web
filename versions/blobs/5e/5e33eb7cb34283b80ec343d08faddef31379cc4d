/* ---------- RequestMenu: what each request returns, as a short menu on a limestone sheet (look request-menu) ----------
   The section title oversized across the top right; a packaged skid drawn in isometric line art at the left (sticky on
   desktop); the menu beside it as a real table: a numbered situation heads each group, then one line per returned item
   with its When (mono) and Cost (flow). The wrapper carries data-theme="light" so the sheet keeps light tokens on the
   limestone ground in both themes. */
.aq-request-menu-sec { overflow-x: clip; }
.aq-request-menu-wrap { display: flex; flex-direction: column; gap: var(--space-12); color: var(--on-limestone); }

/* The mast: the section title set oversized and light, starting at the third column, running to the right edge */
.aq-request-menu__mast { padding-left: 33%; }
.aq-request-menu__mast .aq-sec-head { max-width: none; }
.aq-request-menu__mast .aq-h1 { margin: 0; font-size: clamp(48px, 8.2cqi, 124px); line-height: 0.98; font-weight: 300; letter-spacing: -0.035em; color: var(--on-limestone); text-wrap: balance; }

.aq-request-menu { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 17fr); column-gap: var(--space-12); align-items: start; }
.aq-request-menu__fig { position: sticky; top: calc(var(--space-24) + var(--space-4)); margin: 0; }
.aq-request-menu__svg { display: block; width: 100%; height: auto; max-height: 72vh; }
.aq-request-menu__body { min-width: 0; }

/* The menu */
.aq-request-menu__table { width: 100%; border-collapse: collapse; table-layout: fixed; }
.aq-request-menu__h {
  padding: 0 var(--space-4) var(--space-3) 0; text-align: left; vertical-align: bottom; border-bottom: 1px solid var(--line-strong);
  font: 400 15px/20px var(--font-sans); color: var(--on-limestone-muted); position: relative;
}
.aq-request-menu__h[data-col="0"] { width: 28%; padding-left: var(--space-12); }
.aq-request-menu__h[data-col="1"] { width: 30%; }
.aq-request-menu__h[data-col="2"], .aq-request-menu__h[data-col="3"] { width: 21%; }
.aq-request-menu__h::after { content: ""; position: absolute; left: 0; right: var(--space-4); bottom: -1px; height: 2px; background: var(--flow); transform: scaleX(0); transform-origin: left center; }
.aq-request-menu__h[data-col="0"]::after { left: var(--space-12); }
.aq-request-menu__h.is-on { color: var(--on-limestone); }
.aq-request-menu__h.is-on::after { transform: scaleX(1); }
.aq-request-menu__ic { width: 14px; height: 14px; margin-right: var(--space-2); vertical-align: -2px; background-color: var(--on-limestone-muted); }

.aq-request-menu__set { border-bottom: 1px solid var(--line-strong); }
.aq-request-menu__line > * { padding: var(--space-3) var(--space-4) var(--space-3) 0; text-align: left; vertical-align: top; font: 400 16px/24px var(--font-sans); color: var(--on-limestone); overflow-wrap: break-word; }
.aq-request-menu__line:first-child > * { padding-top: var(--space-6); }
.aq-request-menu__line:last-child > * { padding-bottom: var(--space-6); }
.aq-request-menu__line + .aq-request-menu__line > td { border-top: 1px dashed var(--line-strong); }
.aq-request-menu__s { font-weight: 300; }
.aq-request-menu__no { float: left; width: var(--space-12); font: 400 14px/24px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--on-limestone-muted); }
.aq-request-menu__st { display: block; margin-left: var(--space-12); font: 300 22px/28px var(--font-sans); letter-spacing: -0.01em; text-wrap: balance; }
.aq-request-menu__st a, .aq-request-menu__got a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 4px; }
.aq-request-menu__got a { display: inline-block; min-height: var(--space-6); color: var(--flow); }
.aq-request-menu__got a:focus-visible, .aq-request-menu__st a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-request-menu__when .aq-request-menu__v { font: 400 14px/24px var(--font-mono); }
.aq-request-menu__cost .aq-request-menu__v { color: var(--flow); }
.aq-request-menu__v .aq-ph { font-size: 13px; }
.aq-request-menu__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

/* Crosshair: the pointed line takes a flow-tint band (snaps, no easing), its group's number lights */
.aq-request-menu__line:hover > td, .aq-request-menu__line:focus-within > td { background: var(--flow-tint); }
.aq-request-menu__set:hover .aq-request-menu__no, .aq-request-menu__set:focus-within .aq-request-menu__no { color: var(--flow); }

.aq-request-menu-sec .aq-fold__btn { color: var(--on-limestone-muted); }
.aq-request-menu-sec .aq-fold__btn:hover { color: var(--on-limestone); }

/* The phone accordion (pass 12): out of the desktop render */
.aq-request-menu__phone { display: none; }
.aq-request-menu__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

@container (max-width: 860px) {
  .aq-request-menu-wrap { gap: var(--space-8); }
  .aq-request-menu__mast { padding-left: 0; }
  .aq-request-menu__mast .aq-h1 { font-size: clamp(40px, 12cqi, 56px); }
  .aq-request-menu { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); }
  .aq-request-menu__fig { position: static; width: 72%; justify-self: center; }
  .aq-request-menu__svg { max-height: none; }
  .aq-request-menu__table, .aq-request-menu__table tbody, .aq-request-menu__line, .aq-request-menu__line > * { display: block; width: auto; }
  .aq-request-menu__table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .aq-fold:not(.is-open) .aq-request-menu__set.aq-fold-x { display: none; }
  .aq-request-menu__table tbody:first-of-type { border-top: 1px solid var(--line-strong); }
  .aq-request-menu__line { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-4); padding-bottom: var(--space-3); }
  .aq-request-menu__line > * { padding: 0; }
  .aq-request-menu__line:first-child > *, .aq-request-menu__line:last-child > * { padding-top: 0; padding-bottom: 0; }
  .aq-request-menu__line:first-child { padding-top: var(--space-6); }
  .aq-request-menu__line:last-child { padding-bottom: var(--space-6); }
  .aq-request-menu__line + .aq-request-menu__line { border-top: 1px dashed var(--line-strong); padding-top: var(--space-3); }
  .aq-request-menu__line + .aq-request-menu__line > td { border-top: 0; }
  .aq-request-menu__s, .aq-request-menu__got { grid-column: 1 / -1; }
  .aq-request-menu__line > .aq-request-menu__s { padding-bottom: var(--space-4); }
  .aq-request-menu__line > .aq-request-menu__got { padding-bottom: var(--space-2); }
  .aq-request-menu__no { width: var(--space-8); }
  .aq-request-menu__st { margin-left: var(--space-8); font-size: 20px; line-height: 26px; }
  .aq-request-menu__k { position: static; width: auto; height: auto; overflow: visible; clip-path: none; white-space: normal; display: block;
    font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
  .aq-request-menu__line:hover > td, .aq-request-menu__line:focus-within > td { background: none; }
}

/* Phones (pass 12, S11/S12/S18): no drawing, no table; the rows as an accordion of situations (PhoneKit), each body
   the returned items with When and Cost as chips; the column names once, as a key over the list */
@container (max-width: 860px) {
  .aq-request-menu__fig, .aq-request-menu__body > .aq-request-menu__table, .aq-request-menu__body > .aq-fold { display: none; }
  .aq-request-menu { row-gap: 0; }
  .aq-request-menu__phone { display: block; }
  .aq-request-menu__key { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-3);
    font: 400 14px/20px var(--font-sans); color: var(--on-limestone-muted); }
  .aq-request-menu__key > span:first-child { margin-right: var(--space-1); }
  .aq-request-menu__acc { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .aq-request-menu__item { border-bottom: 1px solid var(--line-strong); }
  .aq-request-menu__ah { margin: 0; font: inherit; }
  .aq-request-menu__acc[data-pk-on] .aq-request-menu__hb { min-height: 56px; gap: var(--space-3); padding: var(--space-2) 0; font: 400 18px/24px var(--font-sans); letter-spacing: -0.01em; color: var(--on-limestone); }
  .aq-request-menu__hb .aq-request-menu__no { float: none; flex: none; width: var(--space-6); font: 400 13px/24px var(--font-mono); }
  .aq-request-menu__hb[aria-expanded="true"] .aq-request-menu__no { color: var(--flow); }
  .aq-request-menu__at { min-width: 0; text-wrap: balance; }
  .aq-request-menu__ab { padding: 0 0 var(--space-4) calc(var(--space-6) + var(--space-3)); }
  .aq-request-menu__acc:not([data-pk-on]) .aq-request-menu__ab { padding-top: var(--space-4); }
  .aq-request-menu__gets { list-style: none; margin: 0; padding: 0; }
  .aq-request-menu__gets > li { padding: var(--space-3) 0; }
  .aq-request-menu__gets > li + li { border-top: 1px dashed var(--line-strong); }
  .aq-request-menu__gt { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--on-limestone); }
  .aq-request-menu__gt a { display: inline-flex; align-items: center; min-height: 44px; color: var(--flow); text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .aq-request-menu__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-2) 0 0; }
  .aq-request-menu__chip { display: inline-flex; align-items: center; gap: var(--space-1); max-width: 100%; box-sizing: border-box; padding: 2px var(--space-2);
    border: 1px solid var(--line-strong); border-radius: var(--radius-sm, 4px); font: 400 var(--aq-chip-phone, 13px)/20px var(--font-mono); color: var(--on-limestone); }
  .aq-request-menu__chip .aq-request-menu__ic { flex: none; margin: 0; width: 12px; height: 12px; }
  .aq-request-menu__chip--cost { border-color: var(--flow); color: var(--flow); }
  .aq-request-menu__chip .aq-ph { font-size: var(--aq-chip-phone, 13px); }
}
/* Pass 12 round C (audit-c group-7 contact-proposal.2, R1): wide, the head at the shared section-head size (aq-h1
   40/44) and the skid held 120 px under the top while the menu scrolls past it */
@container (min-width: 861px) {
  .aq-request-menu__mast .aq-h1 { font-size: 40px; line-height: 44px; letter-spacing: -0.02em; }
  .aq-request-menu__fig { position: sticky; top: calc(var(--space-24) + var(--space-6)); align-self: start; }
}

/* ---------- ResponseClock: fault steps read off a stopwatch dial (look "response-clock") ----------
   A navy band; inside it the ink tokens take their on-navy values. Grid 5/7: the dial (SVG, on-navy hairlines, the
   face a shade lighter than the band, stations as rings with mono numbers, the running arc dashed in a lightened
   flow, one hand turned by --a), then the steps as rows on hairlines with a huge light number. The start station
   (the step that starts the clock) and a pointed step fill. Phones: dial above the list at 70 % width. */
.aq-response-clock-sec {
  --ink: var(--on-navy); --ink-muted: var(--on-navy-muted); --ink-subtle: var(--on-navy-muted);
  --line: color-mix(in srgb, var(--on-navy) 18%, transparent); --line-strong: color-mix(in srgb, var(--on-navy) 45%, transparent);
  --rc-flow: color-mix(in srgb, var(--flow) 40%, var(--on-navy));
}
.aq-response-clock-sec .aq-sec-head .aq-h1 { font: 300 56px/60px var(--font-sans); letter-spacing: -0.03em; color: var(--on-navy); }
.aq-response-clock-sec .aq-ph { background: transparent; color: var(--on-navy); outline: 1px dashed var(--on-navy-muted); outline-offset: -1px; }
.aq-response-clock { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-16); align-items: start; }
.aq-response-clock__fig { position: sticky; top: var(--space-24); }
.aq-response-clock__dial { display: block; width: 100%; height: auto; overflow: visible; }
.aq-response-clock__case { fill: none; stroke: var(--line-strong); stroke-width: 1.5; }
.aq-response-clock__face { fill: color-mix(in srgb, var(--on-navy) 5%, transparent); stroke: var(--line); stroke-width: 1; }
.aq-response-clock__crown, .aq-response-clock__btn { fill: var(--navy); stroke: var(--line-strong); stroke-width: 1.5; stroke-linejoin: round; }
.aq-response-clock__ticks { fill: none; stroke: var(--on-navy-muted); stroke-width: 1; opacity: 0.7; }
.aq-response-clock__track { fill: none; stroke: var(--line); stroke-width: 1; }
.aq-response-clock__run { fill: none; stroke: var(--rc-flow, var(--flow)); stroke-width: 3; stroke-dasharray: 2 7; stroke-linecap: round; }
.aq-response-clock__st circle { fill: var(--navy); stroke: var(--on-navy-muted); stroke-width: 1.5; transition: fill 200ms ease, stroke 200ms ease; }
.aq-response-clock__st text { font: 500 11px/1 var(--font-mono); fill: var(--on-navy); text-anchor: middle; }
.aq-response-clock__st.is-start circle { stroke: var(--rc-flow, var(--flow)); stroke-width: 2.5; }
.aq-response-clock__st.is-on circle { fill: var(--limestone); stroke: var(--limestone); }
.aq-response-clock__st.is-on text { fill: var(--navy); }
.aq-response-clock__hand { transform-box: view-box; transform-origin: 200px 210px; transform: rotate(var(--a, 0deg)); transition: transform 500ms cubic-bezier(0.2, 0, 0, 1); }
.aq-response-clock__hand path { fill: none; stroke: var(--limestone); stroke-width: 2.5; stroke-linecap: round; }
.aq-response-clock__hand circle { fill: var(--limestone); }
.aq-response-clock__steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
.aq-response-clock__step { display: grid; grid-template-columns: calc(var(--space-16) + var(--space-8)) minmax(0, 1fr); gap: var(--space-4); padding: var(--space-6) 0; border-bottom: 1px solid var(--line); outline-offset: 4px; transition: background-color 200ms ease; }
.aq-response-clock__step:focus-visible { outline: 2px solid var(--focus); }
.aq-response-clock__n { font: 300 56px/56px var(--font-sans); letter-spacing: -0.04em; color: var(--on-navy-muted); transition: color 200ms ease; }
.aq-response-clock__step.is-start .aq-response-clock__n, .aq-response-clock__step.is-on .aq-response-clock__n { color: var(--on-navy); }
.aq-response-clock__t { margin: 0; font: 400 24px/30px var(--font-sans); letter-spacing: -0.01em; color: var(--on-navy); }
.aq-response-clock__go { color: inherit; text-decoration: none; }
.aq-response-clock__go::after { content: " →"; color: var(--rc-flow, var(--flow)); }
.aq-response-clock__go:hover { color: var(--rc-flow, var(--flow)); }
.aq-response-clock__d { margin: var(--space-2) 0 0; max-width: 48ch; font: 400 16px/24px var(--font-sans); color: var(--on-navy-muted); text-wrap: pretty; }

@container (max-width: 860px) {
  .aq-response-clock-sec .aq-sec-head .aq-h1 { font: 300 36px/42px var(--font-sans); }
  .aq-response-clock { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .aq-response-clock__fig { position: static; width: 72%; margin-inline: auto; }
  .aq-response-clock__step { grid-template-columns: var(--space-12) minmax(0, 1fr); gap: var(--space-3); padding: var(--space-4) 0; }
  .aq-response-clock__n { font-size: 36px; line-height: 40px; }
  .aq-response-clock__t { font-size: 20px; line-height: 26px; }
  /* pressed, a linking row tints */
  .aq-response-clock__step:has(.aq-response-clock__go):active { background: color-mix(in srgb, var(--on-navy) 6%, transparent); }
}
/* pass 12 (S6; round C at every width): a step that links is one target, the whole row (its name keeps the arrow,
   ::after); no visual change. */
.aq-response-clock__step { position: relative; }
.aq-response-clock__go::before { content: ""; position: absolute; inset: 0; z-index: 1; }
.aq-response-clock__go:focus-visible { outline: none; }
.aq-response-clock__go:focus-visible::before { outline: 2px solid var(--focus); outline-offset: -2px; }

/* ---------- RetrofitPlant: upgrades on the running plant, existing faint and new bold (look "retrofit-plant") ----------
   A navy band; the ink tokens take on-navy values inside. The sheet: IsoKit on navy (aq-iso--navy) with the existing
   plant dropped to 40 % and the picked upgrade's stages lit (is-lit, flow lines), a legend under it. Below, 5/7: the
   tab list (huge light index, upgrade name; the selected tab carries a limestone rule and full-strength text) and the
   panel (terms as a three-column definition list with mono keys, then where to start as a link). Phones (pass 12):
   the sheet cropped to the column at 552 px, the key plan moved into the crop, numbered chips, one panel. */
.aq-retrofit-plant-sec {
  --ink: var(--on-navy); --ink-muted: var(--on-navy-muted); --ink-subtle: var(--on-navy-muted);
  --line: color-mix(in srgb, var(--on-navy) 18%, transparent); --line-strong: color-mix(in srgb, var(--on-navy) 45%, transparent);
  --rp-flow: color-mix(in srgb, var(--flow) 40%, var(--on-navy));
}
.aq-retrofit-plant-sec .aq-sec-head .aq-h1 { font: 300 56px/60px var(--font-sans); letter-spacing: -0.03em; color: var(--on-navy); max-width: 20ch; }
.aq-retrofit-plant-sec .aq-ph { background: transparent; color: var(--on-navy); outline: 1px dashed var(--on-navy-muted); outline-offset: -1px; }
.aq-retrofit-plant { position: relative; }
.aq-retrofit-plant__sheet { position: relative; border: 1px solid var(--line); }
.aq-retrofit-plant__svg { display: block; width: 100%; height: auto; }
.aq-retrofit-plant__svg.is-retro .aq-iso__part, .aq-retrofit-plant__svg.is-retro .aq-iso__pipe { transition: opacity 400ms cubic-bezier(0.2, 0, 0, 1); }
.aq-retrofit-plant__svg.is-retro .aq-iso__part:not(.is-lit), .aq-retrofit-plant__svg.is-retro .aq-iso__pipe:not(.is-lit) { opacity: 0.28; }
.aq-retrofit-plant__svg .aq-iso__part.is-lit .aq-iso__eq, .aq-retrofit-plant__svg .aq-iso__part.is-lit .aq-iso__ln { stroke-width: 2; }
.aq-retrofit-plant__cam { transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1); }
.aq-retrofit-plant__kbox { fill: var(--navy); stroke: var(--line-strong); stroke-width: 1; vector-effect: non-scaling-stroke; }
.aq-retrofit-plant__kplant use { fill: var(--navy); stroke: var(--on-navy-muted); }
/* the clone does not match the navy-sheet rules (their ancestor is outside its shadow tree): it inherits these */
.aq-retrofit-plant__kwin { fill: color-mix(in srgb, var(--rp-flow, var(--flow)) 12%, transparent); stroke: var(--rp-flow, var(--flow)); stroke-width: 1.5; transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1); }
@media (prefers-reduced-motion: reduce) { .aq-retrofit-plant__cam, .aq-retrofit-plant__kwin { transition: none; } }
.aq-retrofit-plant__legend { position: absolute; right: 0; top: 100%; margin: var(--space-2) 0 0; display: flex; align-items: center; gap: var(--space-2); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
.aq-retrofit-plant__sw { display: inline-block; width: var(--space-6); border-top: 1.5px solid var(--on-navy-muted); opacity: 0.5; }
.aq-retrofit-plant__sw--new { border-top: 2px solid var(--rp-flow, var(--flow)); opacity: 1; margin-left: var(--space-4); }
.aq-retrofit-plant__pick { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-12); margin-top: var(--space-8); }
.aq-retrofit-plant__tabs { display: flex; flex-direction: column; border-top: 1px solid var(--line-strong); }
.aq-retrofit-plant__tab { display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr); align-items: baseline; gap: var(--space-3); min-height: 44px; padding: var(--space-4) var(--space-4) var(--space-4) 0; background: none; border: 0; border-bottom: 1px solid var(--line); border-left: 2px solid transparent; color: var(--on-navy-muted); text-align: left; cursor: pointer; transition: color 200ms ease, border-color 200ms ease, padding 200ms ease; }
.aq-retrofit-plant__tab:hover { color: var(--on-navy); }
.aq-retrofit-plant__tab:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
.aq-retrofit-plant__tab[aria-selected="true"] { color: var(--on-navy); border-left-color: var(--limestone); padding-left: var(--space-4); }
.aq-retrofit-plant__tn { font: 500 12px/16px var(--font-mono); color: var(--on-navy-muted); }
.aq-retrofit-plant__tt { font: 300 22px/28px var(--font-sans); letter-spacing: -0.01em; text-wrap: balance; }
.aq-retrofit-plant__panel { padding-top: var(--space-2); }
.aq-retrofit-plant__panel.is-off { display: none; }
.aq-retrofit-plant__mfig { display: none; }
.aq-retrofit-plant__pt { display: none; }
.aq-retrofit-plant__terms { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); border-top: 1px solid var(--line-strong); padding-top: var(--space-4); }
.aq-retrofit-plant__term dt { font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
.aq-retrofit-plant__term dd { margin: var(--space-2) 0 0; font: 400 16px/24px var(--font-sans); color: var(--on-navy); text-wrap: pretty; }
.aq-retrofit-plant__term--3 dd { font: 300 24px/30px var(--font-sans); letter-spacing: -0.01em; }
.aq-retrofit-plant .aq-retrofit-plant__go { margin: var(--space-8) 0 0; display: flex; flex-direction: column; gap: var(--space-2); }
.aq-retrofit-plant__gk { font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
.aq-retrofit-plant__go a { font: 300 28px/34px var(--font-sans); letter-spacing: -0.015em; color: var(--on-navy); text-decoration: none; }
.aq-retrofit-plant__go a::after { content: " →"; color: var(--rp-flow, var(--flow)); }
.aq-retrofit-plant__go a:hover { color: var(--rp-flow, var(--flow)); }

@container (max-width: 860px) {
  .aq-retrofit-plant-sec .aq-sec-head .aq-h1 { font: 300 36px/42px var(--font-sans); }
  /* pass 12 (audit svc-upgrades.1, S10): the blueprint stays. A 552 px wide render of the sheet cropped to the
     column (centred, where the camera puts the picked upgrade), the key plan moved into the crop; a row of numbered
     chips (the tabs, 44 px) under it; one panel, the picked upgrade's. */
  .aq-retrofit-plant__sheet { overflow: hidden; border-inline: 0; }
  .aq-retrofit-plant__svg { width: 552px; max-width: none; margin-left: calc((100% - 552px) / 2); }
  .aq-retrofit-plant__key { transform: translate(232px, calc(var(--ky, 300px) - 36px)) scale(1.3); }
  .aq-retrofit-plant__legend { position: static; justify-content: flex-end; margin: var(--space-2) 0 0; font-size: 12px; }
  .aq-retrofit-plant__pick { display: block; margin-top: var(--space-4); }
  .aq-retrofit-plant__tabs { display: grid; grid-template-columns: repeat(auto-fit, minmax(40px, 1fr)); gap: var(--space-1); border-top: 0; }
  .aq-retrofit-plant__tab {
    display: flex; justify-content: center; align-items: center; min-height: 44px; padding: 0; border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
    color: var(--on-navy-muted);
  }
  .aq-retrofit-plant__tab[aria-selected="true"] { padding: 0; border-color: var(--limestone); background: var(--limestone); color: var(--navy); }
  .aq-retrofit-plant__tab .aq-retrofit-plant__tn { font: 500 14px/1 var(--font-mono); color: inherit; }
  .aq-retrofit-plant__tab .aq-retrofit-plant__tt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .aq-retrofit-plant__panel { padding: var(--space-6) 0 0; }
  .aq-retrofit-plant__pt { display: flex; flex-direction: column; gap: var(--space-1); margin: 0; font: 300 22px/28px var(--font-sans); color: var(--on-navy); }
  .aq-retrofit-plant__pt .aq-retrofit-plant__tn { font-size: 13px; }
  .aq-retrofit-plant__terms { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); margin-top: var(--space-4); }
  .aq-retrofit-plant__term dt { font-size: 12px; }
  .aq-retrofit-plant__term dd { font-size: 15px; line-height: 22px; }
  .aq-retrofit-plant__term--3 dd { font-size: 20px; line-height: 26px; }
  .aq-retrofit-plant .aq-retrofit-plant__go { margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .aq-retrofit-plant__gk { font-size: 12px; }
  .aq-retrofit-plant__go a { display: inline-flex; align-items: center; min-height: 44px; font-size: 22px; line-height: 28px; }
  .aq-retrofit-plant__go a::after { content: "\2192"; margin-left: var(--space-2); }
}

/* Round C, phones (S14): the crop goes in about 1.2x on the picked module (the sheet rendered 662 px wide, cropped to
   the column round the camera's centre, and kept at the old 220 px strip height); the sheet's zone refs (1-9, A-C) are hidden; the key plan shrinks to an
   outline locator: the plant as a faint silhouette, the camera window over it, no "KEY PLAN" label. */
@container (max-width: 860px) {
  .aq-retrofit-plant__svg { width: max(662px, 100%); margin: -22px 0 -22px calc((100% - max(662px, 100%)) / 2); clip-path: inset(22px 0); }
  .aq-retrofit-plant__svg .aq-iso__sheet .aq-iso__sheet-t { display: none; }
  .aq-retrofit-plant__key { transform: translate(286px, calc(var(--ky, 300px) - 30px)); }
  .aq-retrofit-plant__key .aq-iso__sheet-t { display: none; }
  .aq-retrofit-plant__kplant { opacity: 0.45; }
}

/* ---------- ReviewReticles: assessment areas as a drawing register with one viewfinder (look "review-reticles") ----------
   A limestone band (data-theme="light" on the section: paper in both themes). The sheet: an outer navy hairline frame,
   a zone band with numbers (top, bottom) and letters (sides), an inner frame. Inside, the register (7 of 12) and the
   viewer (5 of 12) split by a hairline. Register rows: number and area code in mono, the name light 32 px (the
   control), the line 15 px; the picked row has a flow rule on its left and its number in flow. The viewer: a square
   viewfinder (navy corner brackets, faint crosshair, "01 / 06" in mono) whose window holds a vertical reel of the
   drawings, slid to the picked one (240 ms cubic-bezier(.2,.85,.25,1), instant for keyboard and reduced motion); in the sheet's
   bottom right corner a title block (Aquemi, the section's nav name, the area, its number). The scan line is a flow hairline the
   motion sweeps once. Phones: no zones and no viewer; each row has its own small square viewfinder. */
.aq-review-reticles-sec .aq-sec-head .aq-h1 { font: 300 56px/60px var(--font-sans); letter-spacing: -0.03em; }
.aq-review-reticles { --rr-line: color-mix(in srgb, var(--on-limestone) 45%, transparent); --rr-faint: color-mix(in srgb, var(--on-limestone-muted) 25%, transparent); position: relative; padding: var(--space-8); border: 1px solid var(--rr-line, var(--line-strong)); color: var(--on-limestone); }
.aq-review-reticles__z { position: absolute; display: flex; font: 500 11px/16px var(--font-mono); letter-spacing: 0.06em; color: var(--on-limestone-muted); }
.aq-review-reticles__z span { flex: 1; display: grid; place-items: center; }
.aq-review-reticles__z--t, .aq-review-reticles__z--b { left: var(--space-8); right: var(--space-8); height: var(--space-8); }
.aq-review-reticles__z--t { top: 0; }
.aq-review-reticles__z--b { bottom: 0; }
.aq-review-reticles__z--t span + span, .aq-review-reticles__z--b span + span { border-left: 1px solid var(--rr-line, var(--line-strong)); }
.aq-review-reticles__z--l, .aq-review-reticles__z--r { top: var(--space-8); bottom: var(--space-8); width: var(--space-8); flex-direction: column; }
.aq-review-reticles__z--l { left: 0; }
.aq-review-reticles__z--r { right: 0; }
.aq-review-reticles__z--l span + span, .aq-review-reticles__z--r span + span { border-top: 1px solid var(--rr-line, var(--line-strong)); }
.aq-review-reticles__sheet { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); border: 1px solid var(--rr-line, var(--line-strong)); }

/* the register */
.aq-review-reticles__reg { list-style: none; margin: 0; padding: var(--space-6) var(--space-8) var(--space-8); }
.aq-review-reticles__item { position: relative; display: grid; grid-template-columns: var(--space-12) var(--space-16) minmax(0, 1fr); column-gap: var(--space-2); padding: var(--space-4) 0; border-bottom: 1px solid var(--rr-faint, var(--line)); }
.aq-review-reticles__item::before { content: ""; position: absolute; left: calc(-1 * var(--space-8)); top: -1px; bottom: -1px; border-left: 3px solid var(--flow); transform: scaleY(0); transform-origin: 50% 0; transition: transform 240ms cubic-bezier(0.2, 0.85, 0.25, 1); }
.aq-review-reticles__item.is-on::before { transform: none; }
.aq-review-reticles__no2, .aq-review-reticles__code { grid-row: 1; padding-top: var(--space-3); font: 500 13px/16px var(--font-mono); letter-spacing: 0.04em; color: var(--on-limestone-muted); transition: color 160ms ease; }
.aq-review-reticles__no2 { grid-column: 1; }
.aq-review-reticles__code { grid-column: 2; font-size: 12px; letter-spacing: 0.08em; }
.aq-review-reticles__item.is-on .aq-review-reticles__no2, .aq-review-reticles__item.is-on .aq-review-reticles__code { color: var(--flow); }
.aq-review-reticles__t { grid-column: 3; grid-row: 1; margin: 0; font: 300 32px/40px var(--font-sans); letter-spacing: -0.02em; }
.aq-review-reticles__pick { display: block; width: 100%; min-height: var(--space-12); margin: 0; padding: 0; border: 0; background: none; font: inherit; letter-spacing: inherit; color: var(--on-limestone); text-align: left; text-decoration: none; cursor: pointer; }
.aq-review-reticles__pick:focus-visible { outline: 2px solid var(--flow); outline-offset: var(--space-1); }
a.aq-review-reticles__pick:hover { color: var(--flow); }
.aq-review-reticles__d { grid-column: 3; grid-row: 2; margin: 0; max-width: 46ch; font: 400 15px/22px var(--font-sans); color: var(--on-limestone-muted); text-wrap: pretty; }

/* viewfinders (the big one in the viewer, the small ones on phones) */
.aq-review-reticles__vf { --in: var(--space-3); position: relative; display: block; border: 1px solid var(--rr-faint, var(--line)); overflow: hidden; }
.aq-review-reticles__br { position: absolute; width: var(--space-8); height: var(--space-8); border: 0 solid var(--on-limestone); transition: transform 300ms cubic-bezier(0.2, 0, 0, 1); }
.aq-review-reticles__br--tl { left: var(--in, var(--space-3)); top: var(--in, var(--space-3)); border-left-width: 2px; border-top-width: 2px; }
.aq-review-reticles__br--tr { right: var(--in, var(--space-3)); top: var(--in, var(--space-3)); border-right-width: 2px; border-top-width: 2px; }
.aq-review-reticles__br--bl { left: var(--in, var(--space-3)); bottom: var(--in, var(--space-3)); border-left-width: 2px; border-bottom-width: 2px; }
.aq-review-reticles__br--br { right: var(--in, var(--space-3)); bottom: var(--in, var(--space-3)); border-right-width: 2px; border-bottom-width: 2px; }
.aq-review-reticles__sheet:hover .aq-review-reticles__big .aq-review-reticles__br--tl { transform: translate(var(--space-2), var(--space-2)); }
.aq-review-reticles__sheet:hover .aq-review-reticles__big .aq-review-reticles__br--tr { transform: translate(calc(-1 * var(--space-2)), var(--space-2)); }
.aq-review-reticles__sheet:hover .aq-review-reticles__big .aq-review-reticles__br--bl { transform: translate(var(--space-2), calc(-1 * var(--space-2))); }
.aq-review-reticles__sheet:hover .aq-review-reticles__big .aq-review-reticles__br--br { transform: translate(calc(-1 * var(--space-2)), calc(-1 * var(--space-2))); }
.aq-review-reticles__cross { position: absolute; inset: 0; }
.aq-review-reticles__cross::before, .aq-review-reticles__cross::after { content: ""; position: absolute; background: color-mix(in srgb, var(--on-limestone-muted) 22%, transparent); }
.aq-review-reticles__cross::before { left: 50%; top: var(--space-6); bottom: var(--space-6); width: 1px; }
.aq-review-reticles__cross::after { top: 50%; left: var(--space-6); right: var(--space-6); height: 1px; }
.aq-review-reticles__no { position: absolute; left: calc(var(--in, var(--space-3)) + var(--space-3)); top: calc(var(--in, var(--space-3)) + var(--space-2)); font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; color: var(--on-limestone-muted); }
.aq-review-reticles__sel { color: var(--flow); }
.aq-review-reticles__pic { position: absolute; inset: 0; display: grid; place-items: center; }
.aq-review-reticles__iso { display: block; width: 100%; height: 100%; }
.aq-review-reticles__ic { width: var(--space-16); height: var(--space-16); background: var(--navy); }
.aq-review-reticles__scan { position: absolute; left: 0; right: 0; top: 0; border-top: 1.5px solid var(--flow); opacity: 0; }

/* the viewer: the reel in the big viewfinder, the title block under it */
.aq-review-reticles__view { display: flex; flex-direction: column; gap: var(--space-8); padding: var(--space-8) var(--space-8) 0; border-left: 1px solid var(--rr-line, var(--line-strong)); }
.aq-review-reticles__big { aspect-ratio: 1 / 1; }
.aq-review-reticles__win { position: absolute; inset: var(--space-12) var(--space-16); overflow: hidden; }
.aq-review-reticles__reel { display: block; height: calc(var(--n, 1) * 100%); transform: translateY(calc(var(--sel, 0) * -100% / var(--n, 1))); transition: transform 240ms cubic-bezier(0.2, 0.85, 0.25, 1); }
.aq-review-reticles[data-still] .aq-review-reticles__reel, .aq-review-reticles[data-still] .aq-review-reticles__item::before { transition: none; }
.aq-review-reticles__still { position: relative; display: block; height: calc(100% / var(--n, 1)); }
.aq-review-reticles__tb { display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; margin: auto calc(-1 * var(--space-8)) 0; border-top: 1px solid var(--rr-line, var(--line-strong)); }
.aq-review-reticles__tb span { padding: var(--space-2) var(--space-3); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.aq-review-reticles__tb span + span { border-left: 1px solid var(--rr-line, var(--line-strong)); }
.aq-review-reticles__tb .aq-review-reticles__tbt { font: 400 13px/16px var(--font-sans); letter-spacing: 0; text-transform: none; color: var(--on-limestone); }
.aq-review-reticles__mini { display: none; }
@media (prefers-reduced-motion: reduce) { .aq-review-reticles__reel, .aq-review-reticles__item::before, .aq-review-reticles__br { transition: none; } }

@container (max-width: 1000px) { .aq-review-reticles__t { font-size: 26px; line-height: 32px; } .aq-review-reticles__win { inset: var(--space-12); } }
@container (max-width: 860px) {
  .aq-review-reticles-sec .aq-sec-head .aq-h1 { font: 300 36px/42px var(--font-sans); }
  /* phones: the register alone, a square viewfinder beside each area's name and line */
  .aq-review-reticles { padding: 0; border: 0; }
  .aq-review-reticles__z, .aq-review-reticles__view, .aq-review-reticles__item::before { display: none; }
  .aq-review-reticles__sheet { display: block; border: 0; }
  .aq-review-reticles__reg { padding: 0; border-top: 1px solid var(--rr-faint, var(--line)); }
  .aq-review-reticles__item { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); grid-template-rows: auto auto 1fr; column-gap: var(--space-4); row-gap: var(--space-1); }
  .aq-review-reticles__mini { --in: var(--space-1); display: block; grid-column: 1; grid-row: 1 / span 3; aspect-ratio: 1 / 1; }
  .aq-review-reticles__mini .aq-review-reticles__br { width: var(--space-4); height: var(--space-4); }
  .aq-review-reticles__mini .aq-review-reticles__pic { inset: var(--space-4) var(--space-3) var(--space-3); }
  .aq-review-reticles__mini .aq-review-reticles__cross::before { top: var(--space-3); bottom: var(--space-3); }
  .aq-review-reticles__mini .aq-review-reticles__cross::after { left: var(--space-3); right: var(--space-3); }
  .aq-review-reticles__no2, .aq-review-reticles__code { grid-column: 2; grid-row: 1; padding-top: 0; }
  .aq-review-reticles__code { margin-left: var(--space-8); }
  .aq-review-reticles__item.is-on .aq-review-reticles__no2, .aq-review-reticles__item.is-on .aq-review-reticles__code { color: var(--on-limestone-muted); }
  .aq-review-reticles__t { grid-column: 2; grid-row: 2; font-size: 22px; line-height: 28px; }
  .aq-review-reticles__pick { min-height: var(--space-12); }
  .aq-review-reticles__d { grid-column: 2; grid-row: 3; font-size: 14px; line-height: 20px; }
  /* pass 12 (minor): the viewfinder tiles at 96 px (were about 130), so the names and lines get the width */
  .aq-review-reticles__item { grid-template-columns: 96px minmax(0, 1fr); }
  .aq-review-reticles__mini .aq-review-reticles__br { width: var(--space-3); height: var(--space-3); }
  .aq-review-reticles__mini .aq-review-reticles__pic { inset: var(--space-3) var(--space-2) var(--space-2); }
}

/* Round C. Phones: the viewfinder tiles at 72 px and 16 px between areas (the section about 850 px). Desktop (861 px
   and up): the viewer sits centred in its cell above the title block, not hung from the top with 190 px under it. */
@container (max-width: 860px) {
  .aq-review-reticles__item { grid-template-columns: 72px minmax(0, 1fr); column-gap: var(--space-3); padding-block: var(--space-2); }
  .aq-review-reticles__mini .aq-review-reticles__br { width: var(--space-2); height: var(--space-2); }
  .aq-review-reticles__mini .aq-review-reticles__pic { inset: var(--space-2); }
  /* with no area code, the number sits left of the name on its line (not on a row of its own) */
  .aq-review-reticles__item:not(:has(.aq-review-reticles__code)) { grid-template-rows: auto 1fr; }
  .aq-review-reticles__item:not(:has(.aq-review-reticles__code)) .aq-review-reticles__mini { grid-row: 1 / span 2; }
  .aq-review-reticles__item:not(:has(.aq-review-reticles__code)) .aq-review-reticles__no2 { grid-row: 1; align-self: center; }
  .aq-review-reticles__item:not(:has(.aq-review-reticles__code)) .aq-review-reticles__t { grid-row: 1; padding-left: var(--space-8); }
  .aq-review-reticles__item:not(:has(.aq-review-reticles__code)) .aq-review-reticles__d { grid-row: 2; }
}
@container (min-width: 861px) {
  .aq-review-reticles__big { margin-block: auto; }
  .aq-review-reticles__tb { margin-top: 0; }
}

/* ---------- RiserValves: response times by request on one riser pipe (look riser-valves) ----------
   Navy sheet. A twin-wall riser runs down the gutter between the requests and the answers (one segment per row, so it
   stays continuous whatever the row heights). Branch A tees off at the first line of each row through a gate valve into
   the first response; branch B leaves the riser at the foot of the row, runs under the first response and turns up
   into what follows. Water is flow mixed toward on-navy; walls on-navy-muted. Drawn parts are fixed-size inline SVGs.
   Motion sets --rv-r (riser), --rv-a (branch A), --rv-b (branch B run), --rv-c (elbow and rise) per row; all default to
   1, so the drawing is complete without script. Phones: the riser runs down a left gutter and both branches are short
   tees into the zone labels. */
.aq-riser-valves-sec .aq-sec-head .aq-h1 { color: var(--on-navy); }
.aq-riser-valves-sec .aq-sec-head .aq-lead { color: var(--on-navy-muted); max-width: 60ch; }
.aq-riser-valves {
  --rv-q: 30%; --rv-g: calc(var(--space-24) + var(--space-8));
  --rv-wall: color-mix(in srgb, var(--on-navy-muted) 55%, transparent);
  --rv-water: color-mix(in srgb, var(--flow) 78%, var(--on-navy));
  --rv-hi: color-mix(in srgb, var(--flow) 40%, var(--on-navy));
  --rv-rule: color-mix(in srgb, var(--on-navy-muted) 25%, transparent);
}
.aq-riser-valves__colh, .aq-riser-valves__row { display: grid; grid-template-columns: var(--rv-q, 30%) var(--rv-g, calc(var(--space-24) + var(--space-8))) minmax(0, 1fr) minmax(0, 1fr); }
.aq-riser-valves__colh {
  margin: 0; padding-bottom: var(--space-3); border-bottom: 1px solid color-mix(in srgb, var(--on-navy-muted) 45%, transparent);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted);
}
.aq-riser-valves__colh > span:nth-child(2) { grid-column: 3; }
.aq-riser-valves__colh > span:nth-child(3) { grid-column: 4; padding-left: var(--space-8); }
.aq-riser-valves__legend { display: none; }
.aq-riser-valves__rows { list-style: none; margin: 0; padding: 0; }
.aq-riser-valves__row { position: relative; padding-block: var(--space-8); border-bottom: 1px solid var(--rv-rule, var(--on-navy-muted)); align-items: stretch; }
.aq-riser-valves__row.is-break { border-top: 1px solid var(--rv-wall, var(--on-navy-muted)); }

/* The request */
.aq-riser-valves__req { grid-column: 1; display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr); align-items: baseline; padding-right: var(--space-6); }
.aq-riser-valves__no { font: 400 14px/26px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--on-navy-muted); }
.aq-riser-valves__t { margin: 0; display: flex; flex-direction: column; gap: var(--space-1); font: 400 20px/26px var(--font-sans); letter-spacing: -0.01em; color: var(--on-navy); text-wrap: balance; }
.aq-riser-valves__what { font: 300 17px/24px var(--font-sans); letter-spacing: 0; color: var(--on-navy-muted); }
.aq-riser-valves__row.is-first-sev .aq-riser-valves__sev, .aq-riser-valves__row.is-first-sev .aq-riser-valves__no { color: var(--rv-hi, var(--on-navy)); }
.aq-riser-valves__sr, .aq-riser-valves__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

/* The answers */
.aq-riser-valves__cell { position: relative; min-width: 0; display: flex; flex-direction: column; gap: var(--space-2); }
.aq-riser-valves__cell[data-zone="1"] { grid-column: 3; padding-right: var(--space-8); }
.aq-riser-valves__cell[data-zone="2"] { grid-column: 4; padding-left: var(--space-8); }
.aq-riser-valves__v { margin: 0; font: 400 17px/26px var(--font-sans); color: var(--on-navy); overflow-wrap: break-word; text-wrap: pretty; }
.aq-riser-valves__v a { color: var(--on-navy); }
.aq-riser-valves__v a:focus-visible { outline: 2px solid var(--on-navy); outline-offset: 2px; }

/* Pipes: twin walls, water a centre line */
.aq-riser-valves__br { position: absolute; inset: 0; pointer-events: none; }
.aq-riser-valves__br--b { overflow: visible; }
.aq-riser-valves__riser, .aq-riser-valves__br--a, .aq-riser-valves__run, .aq-riser-valves__rise { position: absolute; box-sizing: border-box; pointer-events: none; }
.aq-riser-valves__w { position: absolute; display: block; background: var(--rv-water, var(--flow)); transition: background-color 160ms; }
.aq-riser-valves__riser { z-index: 1; left: calc(var(--rv-q, 30%) + var(--rv-g, calc(var(--space-24) + var(--space-8))) / 2 - 5px); width: 10px; top: 0; bottom: -1px; border-inline: 1.5px solid var(--rv-wall, var(--on-navy-muted)); background: var(--navy); }
.aq-riser-valves__riser .aq-riser-valves__w { left: 50%; width: 3px; margin-left: -1.5px; top: 0; bottom: 0; transform: scaleY(var(--rv-r, 1)); transform-origin: center top; }
.aq-riser-valves__row.is-top .aq-riser-valves__riser { top: calc(var(--space-8) - var(--space-6)); border-top: 1.5px solid var(--rv-wall, var(--on-navy-muted)); }
.aq-riser-valves__row.is-top .aq-riser-valves__riser::before { content: ""; position: absolute; left: -6px; right: -6px; top: -6px; height: 5px; border: 1.5px solid var(--rv-wall, var(--on-navy-muted)); background: var(--navy); }
.aq-riser-valves__row.is-end .aq-riser-valves__riser { bottom: calc(var(--space-4) - 5px); border-bottom: 1.5px solid var(--rv-wall, var(--on-navy-muted)); }
.aq-riser-valves__br--a, .aq-riser-valves__run { height: 10px; border-block: 1.5px solid var(--rv-wall, var(--on-navy-muted)); }
.aq-riser-valves__br--a .aq-riser-valves__w, .aq-riser-valves__run .aq-riser-valves__w { left: 0; right: 0; top: 50%; height: 3px; margin-top: -1.5px; transform-origin: left center; }
.aq-riser-valves__br--a { left: calc(var(--rv-g, calc(var(--space-24) + var(--space-8))) / -2 + 5px); right: calc(100% + var(--space-3)); top: var(--space-2); }
.aq-riser-valves__br--a .aq-riser-valves__w { transform: scaleX(var(--rv-a, 1)); }
.aq-riser-valves__run { left: calc(-100% - var(--rv-g, calc(var(--space-24) + var(--space-8))) / 2 + 5px); right: calc(100% - 2px); top: calc(100% + var(--space-4) - 5px); }
.aq-riser-valves__run .aq-riser-valves__w { transform: scaleX(var(--rv-b, 1)); }
.aq-riser-valves__elb { position: absolute; left: 2px; top: calc(100% + var(--space-4) - 10px); overflow: visible; }
.aq-riser-valves__ew { fill: none; stroke: var(--rv-wall, var(--on-navy-muted)); stroke-width: 1.5; }
.aq-riser-valves__ef { fill: none; stroke: var(--rv-water, var(--flow)); stroke-width: 3; stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--rv-c, 1)); transition: stroke 160ms; }
.aq-riser-valves__rise { left: 7px; width: 10px; top: var(--space-2); bottom: calc(10px - var(--space-4)); border-inline: 1.5px solid var(--rv-wall, var(--on-navy-muted)); border-top: 1.5px solid var(--rv-wall, var(--on-navy-muted)); }
.aq-riser-valves__rise .aq-riser-valves__w { left: 50%; width: 3px; margin-left: -1.5px; top: 0; bottom: 0; transform: scaleY(var(--rv-c, 1)); transform-origin: center bottom; }

/* The valve: gate body, stem and lever; open = body full of water, lever along the pipe; shut = lever across */
.aq-riser-valves__valve { position: absolute; left: calc(50% - 12px); top: calc(50% - 17px); overflow: visible; }
.aq-riser-valves__vb { fill: var(--rv-water, var(--flow)); stroke: var(--rv-wall, var(--on-navy-muted)); stroke-width: 1.5; stroke-linejoin: round; transition: fill 160ms; }
.aq-riser-valves__vs, .aq-riser-valves__vl { fill: none; stroke: var(--rv-wall, var(--on-navy-muted)); stroke-width: 1.5; stroke-linecap: round; }
.aq-riser-valves__vl { transform-box: fill-box; transform-origin: 50% 50%; transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-riser-valves__row[data-rv="shut"] .aq-riser-valves__vb { fill: var(--navy); }
.aq-riser-valves__row[data-rv="shut"] .aq-riser-valves__vl { transform: rotate(90deg); }

/* Pointing at a request opens its valve and runs its two branches in full, brighter */
.aq-riser-valves__row:hover .aq-riser-valves__vb, .aq-riser-valves__row:focus-within .aq-riser-valves__vb { fill: var(--on-navy); }
.aq-riser-valves__row:hover .aq-riser-valves__vl, .aq-riser-valves__row:focus-within .aq-riser-valves__vl { transform: none; }
.aq-riser-valves__row:hover .aq-riser-valves__cell .aq-riser-valves__w, .aq-riser-valves__row:focus-within .aq-riser-valves__cell .aq-riser-valves__w { background: var(--on-navy); transform: none; }
.aq-riser-valves__row:hover .aq-riser-valves__ef, .aq-riser-valves__row:focus-within .aq-riser-valves__ef { stroke: var(--on-navy); stroke-dashoffset: 0; }

@media (prefers-reduced-motion: reduce) {
  .aq-riser-valves__w, .aq-riser-valves__ef, .aq-riser-valves__vb, .aq-riser-valves__vl { transition: none; }
}

@container (max-width: 860px) {
  .aq-riser-valves { --rv-gp: var(--space-16); }
  .aq-riser-valves__colh { display: none; }
  .aq-riser-valves__row { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-4); padding: var(--space-6) 0 var(--space-6) var(--rv-gp, var(--space-16)); }
  .aq-riser-valves__req, .aq-riser-valves__cell[data-zone="1"], .aq-riser-valves__cell[data-zone="2"] { grid-column: 1; padding: 0; }
  .aq-riser-valves__req { grid-template-columns: var(--space-8) minmax(0, 1fr); }
  .aq-riser-valves__t { font-size: 19px; line-height: 25px; }
  .aq-riser-valves__k { position: static; width: auto; height: auto; overflow: visible; clip-path: none; white-space: normal;
    margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
  .aq-riser-valves__v { font-size: 16px; line-height: 24px; }
  .aq-riser-valves__riser { left: calc(var(--rv-gp, var(--space-16)) / 2 - 5px); }
  .aq-riser-valves__row.is-top .aq-riser-valves__riser { top: var(--space-2); }
  .aq-riser-valves__row.is-end .aq-riser-valves__riser { bottom: var(--space-6); }
  .aq-riser-valves__br--a, .aq-riser-valves__run { left: calc(var(--rv-gp, var(--space-16)) / -2 + 5px); right: calc(100% + var(--space-2)); top: 3px; }
  .aq-riser-valves__elb, .aq-riser-valves__rise { display: none; }
  .aq-riser-valves__valve { left: calc(50% - 10px); top: calc(50% - 14px); width: 20px; height: 20px; }
}
/* Phones under 600 px (pass 12 C, S12): the two column heads once, as a legend under the intro (the valve = the first
   answer, a twin-wall run = what follows); the rows drop their repeated mono labels (they stay for screen readers)
   and each branch glyph becomes the bullet of its cell's first line. */
@container (max-width: 600px) {
  .aq-riser-valves__legend { display: flex; flex-direction: column; gap: var(--space-3); margin: 0 0 var(--space-2); padding-bottom: var(--space-4);
    border-bottom: 1px solid color-mix(in srgb, var(--on-navy-muted) 45%, transparent); }
  .aq-riser-valves__lg { display: flex; align-items: center; gap: var(--space-3);
    font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
  .aq-riser-valves__lg svg, .aq-riser-valves__tee { flex: none; overflow: visible; }
  .aq-riser-valves__legend .aq-riser-valves__valve { position: static; width: 24px; height: 24px; margin-top: 4px; }
  .aq-riser-valves__tw { fill: none; stroke: var(--rv-wall, var(--on-navy-muted)); stroke-width: 1.5; }
  .aq-riser-valves__tf { fill: none; stroke: var(--rv-water, var(--flow)); stroke-width: 3; }
  .aq-riser-valves__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* the glyph sits on the centre of the cell's first 24 px line */
  .aq-riser-valves__br--a, .aq-riser-valves__run { top: 7px; }
  .aq-riser-valves__row { row-gap: var(--space-3); padding-block: var(--space-4) var(--space-6); }
}

/* ---------- RoleLoop: the roles as bays of one twin-wall pipe loop on the navy band, a valve on each role's branch ---------- */
.aq-role-loop-sec { }
.aq-role-loop { position: relative; margin-top: var(--space-8); padding: var(--space-12) var(--space-12) var(--space-16); }
.aq-role-loop__pipe { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
.aq-role-loop:not(.is-laid) .aq-role-loop__pipe { display: none; }
.aq-role-loop__pipe path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
/* twin wall: a wide stroke in the line colour, the bore in the band's navy over it, the water down the middle */
.aq-role-loop__wall { stroke: color-mix(in srgb, var(--on-navy) 62%, transparent); stroke-width: 11px; }
.aq-role-loop__bore { stroke: var(--navy); stroke-width: 8px; }
.aq-role-loop__water { stroke: var(--flow); stroke-width: 3px; }
/* a role's bay of the loop, lit while the role is pointed at */
.aq-role-loop__seg { stroke: var(--flow); stroke-width: 6px; stroke-opacity: 0; transition: stroke-opacity 120ms; }
.aq-role-loop__seg.is-lit { stroke-opacity: 1; transition-duration: 180ms; }
.aq-role-loop__sw { stroke: color-mix(in srgb, var(--on-navy) 62%, transparent); stroke-width: 9px; }
.aq-role-loop__sb { stroke: var(--navy); stroke-width: 6px; }
.aq-role-loop__sq { stroke: var(--flow); stroke-width: 3px; }
.aq-role-loop__vb { fill: var(--navy); stroke: var(--on-navy); stroke-width: 1.5px; }
.aq-role-loop__vs { stroke: var(--on-navy); stroke-width: 1.5px; }
/* closed: a filled body; status not given: dashed, and no water enters the branch */
.aq-role-loop__stub.is-closed .aq-role-loop__vb { fill: var(--on-navy); }
.aq-role-loop__stub.is-unset .aq-role-loop__sw { stroke-dasharray: 3 3; stroke-linecap: butt; }
.aq-role-loop__stub.is-unset .aq-role-loop__vb, .aq-role-loop__stub.is-unset .aq-role-loop__vs { stroke: var(--on-navy-muted); stroke-dasharray: 2.5 2; }
.aq-role-loop__stub.is-unset .aq-role-loop__sq { display: none; }
.aq-role-loop__stub.is-lit .aq-role-loop__vb, .aq-role-loop__stub.is-lit .aq-role-loop__vs { stroke: var(--flow); }

.aq-role-loop__bays { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-16); row-gap: var(--space-24); }
.aq-role-loop__bay { min-width: 0; display: flex; flex-direction: column; gap: var(--space-3); }
.aq-role-loop .aq-role-loop__no { margin: 0; padding: 0 0 var(--space-2) var(--space-12); border-bottom: 1px solid color-mix(in srgb, var(--on-navy) 30%, transparent);
  font: 400 12px/16px var(--font-mono); letter-spacing: 0.04em; color: var(--on-navy-muted); font-variant-numeric: tabular-nums; transition: border-color 180ms; }
.aq-role-loop__no span { color: var(--on-navy); transition: color 180ms; }
.aq-role-loop__bay.is-lit .aq-role-loop__no { border-color: var(--flow); }
.aq-role-loop__t { margin: 0; font: 300 26px/32px var(--font-sans); letter-spacing: -0.015em; color: var(--on-navy); }
.aq-role-loop .aq-role-loop__st { margin: 0; display: flex; align-items: flex-start; gap: var(--space-2); font: 400 12px/18px var(--font-mono); color: var(--on-navy); }
.aq-role-loop__vk { flex: none; width: var(--space-6); height: var(--space-4); margin-top: 1px; }
.aq-role-loop__vk path { fill: none; stroke: var(--on-navy); stroke-width: 1.5px; stroke-linejoin: round; }
.aq-role-loop__st.is-closed .aq-role-loop__vk path:first-child { fill: var(--on-navy); }
.aq-role-loop__st.is-unset .aq-role-loop__vk path { stroke: var(--on-navy); stroke-dasharray: 2.5 2; }
.aq-role-loop__dl { margin: var(--space-2) 0 0; display: flex; flex-direction: column; gap: var(--space-3); }
.aq-role-loop__f { display: flex; flex-direction: column; gap: var(--space-1); }
.aq-role-loop__f dt { font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
.aq-role-loop__f dd { margin: 0; font: 400 15px/23px var(--font-sans); color: var(--on-navy); overflow-wrap: anywhere; }
/* before the water reaches a bay (motion only) */
.aq-role-loop.is-pre .aq-role-loop__bay { opacity: 0; }
.aq-role-loop.is-pre .aq-role-loop__pipe { visibility: hidden; }

@container (max-width: 1100px) {
  .aq-role-loop { padding-inline: var(--space-8); }
  .aq-role-loop__bays { column-gap: var(--space-12); }
  .aq-role-loop__t { font-size: 22px; line-height: 28px; }
}
/* Phone-only parts (heads, legend): out of the desktop render */
.aq-role-loop__ph, .aq-role-loop__legend { display: none; }
.aq-role-loop__body { display: contents; }
.aq-role-loop__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* Phones (pass 12, S11/S12/S14): collapsed role rows (PhoneKit accordion). The loop is one supply-and-return pair
   down the left; each row's head: number line (branch and valve), the role, the status, base and pay one line each;
   the legend over the list names base and pay once. Tap opens what you do and what you must have. */
@container (max-width: 860px) {
  .aq-role-loop { margin-top: var(--space-4); padding: var(--space-4) 0 var(--space-4) var(--space-12); }
  .aq-role-loop__bays { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) { padding-left: calc(var(--space-8) + var(--space-2)); }
  .aq-role-loop__bays[data-pk-on] { row-gap: 0; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__wall { stroke-width: 7px; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__bore { stroke-width: 4px; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__water { stroke-width: 2px; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__sw { stroke-width: 7px; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__sb { stroke-width: 4px; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__sq { stroke-width: 2px; }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__no { display: none; }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__bay { border-top: 1px solid color-mix(in srgb, var(--on-navy) 30%, transparent); }
  .aq-role-loop__f dd { font-size: 15px; line-height: 22px; }
  .aq-role-loop .aq-role-loop__no { padding-left: var(--space-12); }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__bay { gap: 0; }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__ph { display: block; margin: 0; font: inherit; }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__hd { display: grid; grid-template-columns: minmax(0, 1fr) 44px; column-gap: var(--space-2); row-gap: var(--space-1);
    align-items: start; padding: var(--space-2) 0 var(--space-4) var(--space-2); color: var(--on-navy); }
  .aq-role-loop__ht { grid-column: 1; font: 300 22px/28px var(--font-sans); letter-spacing: -0.015em; }
  .aq-role-loop__hd .aq-phone-kit__chev { grid-column: 2; grid-row: 1 / span 2; margin: -8px 0 0; }
  .aq-role-loop__hd > .aq-role-loop__st, .aq-role-loop__hd > .aq-role-loop__hl { grid-column: 1 / -1; }
  .aq-role-loop .aq-role-loop__hd > .aq-role-loop__st { grid-column: 1; font-size: 14px; line-height: 20px; }
  .aq-role-loop__hl { position: relative; display: block; padding-left: var(--space-4); font: 400 14px/21px var(--font-sans); color: var(--on-navy); }
  .aq-role-loop__hl .aq-ph { font-size: var(--aq-chip-phone, 13px); }
  /* the two markers: base a ring (a place), pay a filled square */
  .aq-role-loop__hl::before { content: ""; position: absolute; left: 0; top: 6px; width: 9px; height: 9px; box-sizing: border-box; border: 1.5px solid var(--flow); border-radius: 50%; }
  .aq-role-loop__hl.is-pay::before { border-radius: 0; background: var(--flow); }
  .aq-role-loop__bays[data-pk-on] ~ .aq-role-loop__legend, .aq-role-loop__legend:has(+ .aq-role-loop__bays[data-pk-on]) {
    display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-6); margin: 0 0 var(--space-4); }
  .aq-role-loop__legend .aq-role-loop__hl { font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
  .aq-role-loop__legend .aq-role-loop__hl::before { top: 3px; }
  /* pass 12 round C: the head is the role and its status only; base and pay read in the body with the other fields */
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__hd > .aq-role-loop__hl { display: none; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__legend { display: none; }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__ht .aq-ph { font-family: var(--font-mono); font-size: 20px; line-height: 26px; letter-spacing: 0; }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__hd { padding-bottom: var(--space-3); }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__dl { margin: 0; padding: var(--space-1) 0 var(--space-3); }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__bay:has(> .aq-role-loop__body:not([hidden])) { border-color: var(--flow); }
}

/* ---------- RoleMatrix: who writes and who approves (table block as "roles") ----------
   On a plate, under a one-line key (Key | Aquemi | Your team | Shared). Each document is a row on a line hairline.
   Desktop: index and document in the first column, then one column per role, its role name above the party.
   Phones: the document as the row's title, the role cells side by side under it.
   Parties are marked by a 2 px line on their left: ours flow, yours ink-muted, shared a dashed line-strong. */
.aq-roles { min-width: 0; }
.aq-roles__key { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-6); margin: 0 0 var(--space-6); }
.aq-roles__key > span { white-space: nowrap; }
.aq-roles__key > .aq-roles__keyk { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-roles__key .aq-roles__stamp { flex: none; padding-block: 0; font-size: 14px; line-height: 20px; }
.aq-roles__rows { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
.aq-roles__row { display: grid; grid-template-columns: var(--space-12) minmax(0, 4fr) minmax(0, 8fr); column-gap: var(--space-4); align-items: start; padding-block: var(--space-4); border-top: 1px solid var(--line); }
.aq-roles__row > .aq-index { line-height: 28px; }
.aq-roles__t { margin: 0; font: 400 20px/28px var(--font-sans); letter-spacing: -0.005em; color: var(--ink); overflow-wrap: break-word; text-wrap: pretty; }
.aq-roles__stamps { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); column-gap: var(--space-6); }
.aq-roles__cell { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
.aq-roles__k { margin: 0; font: 500 14px/20px var(--font-sans); color: var(--ink-muted); }
.aq-roles__stamp { margin: 0; padding: var(--space-1) 0 var(--space-1) var(--space-3); border-left: 2px solid var(--line-strong); font: 400 16px/24px var(--font-sans); color: var(--ink); overflow-wrap: break-word; }
.aq-roles__stamp.is-ours { border-left-color: var(--flow); }
.aq-roles__stamp.is-yours { border-left-color: var(--ink-muted); }
.aq-roles__stamp.is-shared { border-left-style: dashed; }

@container (max-width: 860px) {
  .aq-roles__key { gap: var(--space-2) var(--space-4); }
  .aq-roles__row { grid-template-columns: var(--space-8) minmax(0, 1fr); column-gap: var(--space-2); row-gap: var(--space-3); }
  .aq-roles__row > .aq-index { line-height: 24px; }
  .aq-roles__t { font-size: 18px; line-height: 24px; }
  .aq-roles__stamps { grid-column: 1 / -1; column-gap: var(--space-3); }
  .aq-roles__k { font-size: 12px; line-height: 16px; }
  .aq-roles__stamp { padding-left: var(--space-2); font-size: 14px; line-height: 20px; }
}

/* ---------- RoomLimit: the room a package goes in, its battery limit on the floor, tie-ins keyed to rows (look "room-limit") ----------
   Desktop: title across the top; the IsoKit room cutaway left (held in view while the rows pass), the keyed rows right
   in three groups (the limit, the package's side, the site's side). The battery limit is a flow dash-and-dot line;
   tie-in nodes sit on it; numbered navy squares on leaders key each point to its row. A pointed row lights its square,
   leader and node, and a flow ring rides to its point (atlas-hotspots). Phones: the drawing cropped to the line, then
   the limit row, then each side as a two-column checklist. */
.aq-room-limit { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--space-12); row-gap: var(--space-8); align-items: start; }
.aq-room-limit__head { grid-column: 1 / -1; max-width: 760px; }
.aq-room-limit__fig { grid-column: 1; margin: 0; position: sticky; top: var(--space-24); }
.aq-room-limit__pan { position: relative; }
.aq-room-limit__svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-room-limit__svg .aq-room-limit__wall { fill: var(--surface-sunken); }
.aq-room-limit__svg .aq-room-limit__bl { fill: none; stroke: var(--flow); stroke-width: 2; stroke-dasharray: 16 5 3 5; vector-effect: non-scaling-stroke; }
.aq-room-limit__svg .aq-room-limit__node { fill: var(--surface); stroke: var(--flow); stroke-width: 1.5; vector-effect: non-scaling-stroke; transition: fill 180ms ease-out; }
.aq-room-limit__svg .aq-room-limit__node.is-rl { fill: var(--flow); }
.aq-room-limit__svg .aq-room-limit__cable .aq-iso__pipe-line, .aq-room-limit__svg .aq-room-limit__cable path { stroke: var(--ink-muted); stroke-dasharray: none; }
.aq-room-limit__svg .aq-iso__leader-line { stroke: var(--ink-muted); }
.aq-room-limit__svg .aq-iso__leader-dot { fill: var(--ink-muted); }
.aq-room-limit__svg .is-rl .aq-iso__leader-line { stroke: var(--flow); stroke-width: 1.5; }
.aq-room-limit__svg .is-rl .aq-iso__leader-dot { fill: var(--flow); }

/* numbered squares on the drawing and in the rows: the same navy key */
.aq-room-limit__pin, .aq-room-limit__no {
  display: grid; place-items: center; width: calc(var(--space-6) + var(--space-1)); height: calc(var(--space-6) + var(--space-1));
  background: var(--navy); color: var(--on-navy); font: 500 12px/1 var(--font-mono); letter-spacing: 0.02em;
  transition: background-color 180ms ease-out, transform 180ms ease-out;
}
.aq-room-limit__pin { margin-inline: var(--space-1); }
.aq-room-limit__pin.is-rl { background: var(--flow); color: var(--on-action); transform: translate(0, -50%) scale(1.12); }
.aq-room-limit__pin.aq-iso-figure__label--left.is-rl { transform: translate(-100%, -50%) scale(1.12); }
.aq-room-limit__no.is-free { background: transparent; color: var(--ink-muted); box-shadow: inset 0 0 0 1px var(--line-strong); }

/* the two sides and the line, named on the drawing */
.aq-room-limit__lab { position: absolute; font: 500 12px/16px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted); white-space: nowrap; pointer-events: none; }
.aq-room-limit__lab { transform: rotate(30deg) translate(0, -50%); transform-origin: 0 0; }
.aq-room-limit__lab.is-pkg { color: var(--flow); }

/* the ring: a full-size layer carries it to the chosen point (atlas-hotspots, 250 ms ease-out) */
.aq-room-limit__ringl { position: absolute; inset: 0; pointer-events: none; transform: translate(var(--rl-rx, 50%), var(--rl-ry, 50%)); transition: transform 250ms ease-out; }
.aq-room-limit__ring { display: none; position: absolute; left: calc(-1 * (var(--space-4) + var(--space-1))); top: calc(-1 * (var(--space-4) + var(--space-1))); width: calc(var(--space-8) + var(--space-2)); height: calc(var(--space-8) + var(--space-2)); border: 1.5px solid var(--flow); border-radius: 50%; transition: opacity 180ms ease-out, transform 180ms ease-out; }
/* the ring exists only while a row is chosen; it scales in from 60 % on its first frame */
.aq-room-limit[data-rl] .aq-room-limit__ring { display: block; opacity: 1; transform: none; }
@starting-style { .aq-room-limit[data-rl] .aq-room-limit__ring { opacity: 0; transform: scale(0.6); } }

/* the rows */
.aq-room-limit__rows { grid-column: 2; border-top: 1px solid var(--line-strong); }
.aq-room-limit__list { margin: 0; padding: 0; list-style: none; }
.aq-room-limit__item { display: grid; grid-template-columns: calc(var(--space-6) + var(--space-1)) minmax(0, 1fr); column-gap: var(--space-4); padding: var(--space-4) var(--space-2) var(--space-4) 0; border-bottom: 1px solid var(--line); align-content: start; outline: none; transition: background-color 160ms ease-out; }
.aq-room-limit__item > :not(.aq-room-limit__no) { grid-column: 2; }
.aq-room-limit__no { grid-column: 1; grid-row: 1 / span 4; align-self: start; }
.aq-room-limit__item:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
.aq-room-limit__item.is-rl { background: var(--flow-tint); }
.aq-room-limit__item.is-rl .aq-room-limit__no { background: var(--flow); color: var(--on-action); }
.aq-room-limit__p { margin: 0; font: 500 17px/24px var(--font-sans); color: var(--ink); }
.aq-room-limit__v { margin: var(--space-1) 0 0; font-size: 15px; line-height: 22px; color: var(--ink); }
.aq-room-limit__m { margin: var(--space-1) 0 0; font-size: 14px; line-height: 20px; color: var(--ink-muted); }
.aq-room-limit__go { margin: var(--space-2) 0 0; font-size: 14px; line-height: 20px; }
.aq-room-limit__link { color: var(--flow); }
.aq-room-limit__link::after { content: "\2192"; display: inline-block; margin-left: var(--space-1); text-decoration: none; }
.aq-room-limit__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
/* the limit row reads as the line itself: dash-and-dot rules above and below on the flow tint */
.aq-room-limit__item.is-limit { position: relative; padding-inline-start: var(--space-3); background: var(--flow-tint); border-bottom: 0; margin-bottom: var(--space-2); }
.aq-room-limit__item.is-limit::before, .aq-room-limit__item.is-limit::after {
  content: ""; position: absolute; left: 0; right: 0; height: 2px;
  background: repeating-linear-gradient(90deg, var(--flow) 0 16px, transparent 16px 21px, var(--flow) 21px 24px, transparent 24px 29px);
}
.aq-room-limit__item.is-limit::before { top: -1px; }
.aq-room-limit__item.is-limit::after { bottom: 0; }
/* dark (pass 12 verify): navy is close to flow-tint, so the limit row's square takes a flow edge */
:root[data-theme="dark"] .aq-room-limit__item.is-limit .aq-room-limit__no { box-shadow: inset 0 0 0 1px var(--flow); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .aq-room-limit__item.is-limit .aq-room-limit__no { box-shadow: inset 0 0 0 1px var(--flow); } }
.aq-room-limit__side { margin: 0; padding: var(--space-6) 0 var(--space-2); font: 500 12px/16px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted); border-bottom: 1px solid var(--line-strong); }
.aq-room-limit__side.is-pkg { color: var(--flow); }

@media (prefers-reduced-motion: reduce) {
  .aq-room-limit__ringl, .aq-room-limit__ring, .aq-room-limit__pin, .aq-room-limit__no, .aq-room-limit__item { transition: none; }
}

@container (max-width: 860px) {
  .aq-room-limit { grid-template-columns: minmax(0, 1fr); row-gap: calc(var(--space-4) + var(--space-1)); }
  .aq-room-limit__fig { grid-column: 1; position: relative; top: auto; overflow: hidden; aspect-ratio: var(--rl-ar, 1.6); max-width: 560px; margin-inline: calc(-1 * var(--space-2)); }
  .aq-room-limit__pan { position: absolute; width: var(--rl-w, 100%); left: var(--rl-x, 0); top: var(--rl-y, 0); }
  .aq-room-limit__pin { width: var(--space-6); height: var(--space-6); font-size: 12px; margin-inline: 0; }
  .aq-room-limit__lab { display: none; }
  .aq-room-limit__ring { left: calc(-1 * var(--space-4)); top: calc(-1 * var(--space-4)); width: var(--space-8); height: var(--space-8); }
  .aq-room-limit__rows { grid-column: 1; border-top: 0; }
  .aq-room-limit__item.is-limit { margin-bottom: 0; padding: var(--space-4) var(--space-3); }
  .aq-room-limit__item.is-limit .aq-room-limit__p { font-size: 17px; line-height: 24px; }
  /* each side: a two-column checklist of keyed squares */
  .aq-room-limit__list { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-3); }
  .aq-room-limit__list .aq-room-limit__item { grid-template-columns: var(--space-6) minmax(0, 1fr); column-gap: var(--space-2); padding: var(--space-3) 0 var(--space-4); }
  .aq-room-limit__list .aq-room-limit__item > :not(.aq-room-limit__no) { grid-column: 1 / -1; }
  .aq-room-limit__list .aq-room-limit__item > .aq-room-limit__p { grid-column: 2; grid-row: 1; align-self: center; }
  .aq-room-limit__list .aq-room-limit__no { grid-row: 1; width: var(--space-6); height: var(--space-6); }
  .aq-room-limit__p { font-size: 15px; line-height: 20px; font-weight: 600; }
  .aq-room-limit__v { margin-top: var(--space-2); font-size: 14px; line-height: 20px; }
  .aq-room-limit__m { font-size: 14px; line-height: 20px; }
  .aq-room-limit__go { margin-top: var(--space-1); }
  .aq-room-limit__link { display: inline-flex; align-items: center; min-height: 44px; }
}
/* tablet (pass 12 verify): centre the cropped drawing in the wider single column */
@container (min-width: 600px) and (max-width: 860px) { .aq-room-limit__fig { width: 100%; margin-inline: auto; } }

/* Phones with script (pass 12 round C): the crop becomes a PhoneKit sticky compact figure. It keeps today's crop (its
   own aspect ratio, about 180 px at 375; PhoneKit's fixed strip height is set back to auto) and is held under the
   header; the pan layer zooms to the chosen pin (look-room-limit.js). On wider tablets the strip is capped at 220 px
   tall. The sides run one column, so each row reaches the reading line by itself; the chosen row keeps its tint. */
@container (max-width: 860px) {
  .aq-room-limit[data-pk-sticky][data-pk-on] .aq-room-limit__fig { height: auto; aspect-ratio: var(--rl-ar, 1.6); max-width: min(560px, calc(220px * var(--rl-ar, 1.6)));
    width: auto; justify-self: stretch; z-index: 3; }
  .aq-room-limit[data-pk-on] .aq-room-limit__pan { transform-origin: 0 0; transform: translate(var(--rl-zx, 0px), var(--rl-zy, 0px)) scale(var(--rl-zs, 1));
    transition: transform 420ms cubic-bezier(0.2, 0, 0, 1); }
  .aq-room-limit[data-pk-on] .aq-room-limit__list { grid-template-columns: minmax(0, 1fr); }
  .aq-room-limit[data-pk-on] .aq-room-limit__list .aq-room-limit__item { grid-template-columns: var(--space-6) minmax(0, 1fr); column-gap: var(--space-3);
    row-gap: 2px; padding: var(--space-2) var(--space-2) var(--space-3); margin-inline: calc(-1 * var(--space-2)); }
  .aq-room-limit[data-pk-on] .aq-room-limit__list .aq-room-limit__no { align-self: start; }
  .aq-room-limit[data-pk-on] .aq-room-limit__go { margin-block: calc(-1 * var(--space-2)); }
  .aq-room-limit[data-pk-on] .aq-room-limit__side { padding-top: var(--space-4); }
  .aq-room-limit[data-pk-on] .aq-room-limit__list .aq-room-limit__item > :not(.aq-room-limit__no) { grid-column: 2; }
  .aq-room-limit[data-pk-on] .aq-room-limit__list .aq-room-limit__v { margin-top: 0; }
}
/* tablets: the capped strip is centred; its ground runs out to both edges so rows never show beside it */
@container (min-width: 600px) and (max-width: 860px) { .aq-room-limit[data-pk-sticky][data-pk-on] .aq-room-limit__fig { justify-self: center; width: 100%;
  box-shadow: 0 0 0 100vmax var(--surface); clip-path: inset(0 -100vmax); } }
@media (prefers-reduced-motion: reduce) { .aq-room-limit[data-pk-on] .aq-room-limit__pan { transition: none; } }

/* ---------- Router: pick your situation, see one route (table block with as: "router", blocks/router.js) ----------
   On a plate (wPlate). Desktop: situations as rows on hairlines on the left, each with the shared mono index; the
   chosen one is the plate's one flow-tint row with a 2 px flow line on its left and a flow line with an arrowhead into
   the route. The open route on the right spans every row in a line frame: stations, each with a "Station 0N" eyebrow,
   its column name and value, joined by flow lines with arrowheads (the water path); the linked end station is tinted.
   Phones: one column; the route opens under its situation and its stations run down with arrowed risers between them. */
.aq-router { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--space-12); align-items: start; }
.aq-router__opt {
  grid-column: 1; position: relative; display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr); align-items: baseline;
  width: 100%; min-height: 56px; margin: 0; padding: var(--space-4) var(--space-4) var(--space-4) var(--space-3);
  background: none; border: 0; border-left: 2px solid transparent; border-bottom: 1px solid var(--line); cursor: pointer; text-align: left;
  font: 500 16px/24px var(--font-sans); color: var(--ink-muted);
}
.aq-router__opt .aq-index { line-height: 24px; }
.aq-router__t { min-width: 0; text-wrap: pretty; overflow-wrap: break-word; }
.aq-router__opt:hover { color: var(--ink); }
.aq-router__opt:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-router__opt[aria-expanded="true"] { color: var(--ink); background: var(--flow-tint); border-left-color: var(--flow); }
.aq-router__opt[aria-expanded="true"] .aq-index { color: var(--flow); }
/* the flow line from the chosen situation into the route frame, ending in an arrowhead */
.aq-router__opt[aria-expanded="true"]::after {
  content: ""; position: absolute; top: calc(50% - 4px); right: calc(-1 * var(--space-12) - 1px); width: var(--space-12); height: 9px;
  background: var(--flow); clip-path: polygon(0 4px, calc(100% - 7px) 4px, calc(100% - 7px) 0, 100% 50%, calc(100% - 7px) 100%, calc(100% - 7px) 5px, 0 5px);
}
/* The route frame spans every situation row; its station chain sits centred in it (not stranded at the top) */
.aq-router__route { grid-column: 2; position: relative; align-self: stretch; display: flex; flex-direction: column; justify-content: center; padding: var(--space-6); border: 1px solid var(--line); background: var(--surface); }
.aq-router__route[hidden] { display: none; }
.aq-router__hit { position: absolute; inset: 0; z-index: 0; }
.aq-router__route.is-link:hover { border-color: var(--line-strong); }
.aq-router__stations { position: relative; z-index: 1; pointer-events: none; list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); column-gap: var(--space-8); align-items: start; counter-reset: aq-station; }
.aq-router__stations a { pointer-events: auto; }
.aq-router__stations > li { position: relative; min-width: 0; padding-top: var(--space-6); counter-increment: aq-station; }
.aq-router__stations > li::before {
  content: "Station 0" counter(aq-station); position: absolute; top: 0; left: 0;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
/* a flow line with an arrowhead in the gap to the next station, clear of both texts (space-2 each side) */
.aq-router__stations > li:not(:last-child)::after {
  content: ""; position: absolute; top: calc(var(--space-6) + var(--space-3) + 6px); right: calc(-1 * var(--space-8) + var(--space-2)); width: var(--space-4); height: 9px;
  background: var(--flow); clip-path: polygon(0 4px, calc(100% - 7px) 4px, calc(100% - 7px) 0, 100% 50%, calc(100% - 7px) 100%, calc(100% - 7px) 5px, 0 5px);
}
/* Four or more stations: two per row (a 2 x 2 for four), so each keeps a readable measure; the flow line runs along
   each row and the station numbers carry the order across the turn */
.aq-router__stations:has(> li:nth-child(4)) { grid-auto-flow: row; grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-6); }
.aq-router__stations:has(> li:nth-child(4)) > li:nth-child(2n)::after { display: none; }
.aq-router__k {
  margin: 0; padding: var(--space-3) 0 var(--space-1); border-top: 1px solid var(--line-strong);
  font: 500 14px/20px var(--font-sans); color: var(--ink-muted);
}
.aq-router__v {
  margin: 0; padding: 0 0 var(--space-2);
  font: 400 16px/24px var(--font-sans); color: var(--ink); overflow-wrap: break-word; text-wrap: pretty;
}
.aq-router__stations > li.is-go .aq-router__k { border-top-color: var(--flow); color: var(--flow); padding-inline: var(--space-3); background: var(--flow-tint); }
.aq-router__stations > li.is-go .aq-router__v { padding: 0 var(--space-3) var(--space-3); background: var(--flow-tint); }
.aq-router__v a { font-weight: 500; text-decoration: none; }
.aq-router__v a::after { content: "\a0\2192"; }
.aq-router__v a:hover, .aq-router__route.is-link:hover li.is-go a { text-decoration: underline; }
/* Pending station: the value opens with a [placeholder]; a dashed top line and a "To confirm" eyebrow */
.aq-router__stations > li.is-pending .aq-router__k { border-top-style: dashed; }
.aq-router__stations > li.is-pending .aq-router__v { color: var(--ink-muted); }
.aq-router__tbc {
  display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-1);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
.aq-router__tbc::before { content: ""; flex: none; width: var(--space-2); height: var(--space-2); border: 1px dashed var(--ink-muted); border-radius: var(--radius-pill); }

/* Motion hooks (Router/motion.js): --aq-pipe grows the runs in the flow direction, --aq-node pops the chosen marker.
   Both default to 1, so the drawing is complete without motion. */
.aq-router__opt[aria-expanded="true"]::after, .aq-router__stations > li:not(:last-child)::after { transform: scaleX(var(--aq-pipe, 1)); transform-origin: left center; }
.aq-router__opt[aria-expanded="true"]::before { transform: scale(var(--aq-node, 1)); }
@media (prefers-reduced-motion: no-preference) {
  .aq-router__opt .aq-index { transition: color 120ms, transform 160ms cubic-bezier(0.2, 0, 0, 1); }
  .aq-router__opt:not([aria-expanded="true"]):hover .aq-index { transform: translateX(var(--space-1)); }
}

@container (max-width: 860px) {
  .aq-router { grid-template-columns: minmax(0, 1fr); }
  .aq-router__opt { grid-template-columns: var(--space-8) minmax(0, 1fr); padding: var(--space-3) var(--space-3) var(--space-3) var(--space-2); font-size: 15px; line-height: 22px; }
  .aq-router__opt .aq-index { line-height: 22px; }
  .aq-router__opt[aria-expanded="true"]::after { top: auto; bottom: calc(-1 * var(--space-3) - 1px); right: auto; left: calc(var(--space-6) - 4px); width: 9px; height: var(--space-3); clip-path: polygon(4px 0, 5px 0, 5px calc(100% - 7px), 100% calc(100% - 7px), 50% 100%, 0 calc(100% - 7px), 4px calc(100% - 7px)); }
  .aq-router__route { grid-column: 1; grid-row: auto !important; margin: var(--space-3) 0 var(--space-3); padding: var(--space-4) var(--space-3); }
  .aq-router__stations, .aq-router__stations:has(> li:nth-child(4)) { grid-auto-flow: row; grid-template-columns: minmax(0, 1fr); row-gap: var(--space-4); }
  .aq-router__stations:has(> li:nth-child(4)) > li:nth-child(2n):not(:last-child)::after { display: block; }
  .aq-router__stations > li { padding-top: 0; }
  .aq-router__stations > li::before { display: none; }
  .aq-router__k::before { content: "0" counter(aq-station) "  "; white-space: pre; font-family: var(--font-mono); color: var(--ink-subtle); }
  .aq-router__stations > li:not(:last-child)::after {
    top: auto; bottom: calc(-1 * var(--space-4)); right: auto; left: calc(var(--space-6) - 4px); width: 9px; height: var(--space-4);
    clip-path: polygon(4px 0, 5px 0, 5px calc(100% - 7px), 100% calc(100% - 7px), 50% 100%, 0 calc(100% - 7px), 4px calc(100% - 7px));
  }
  .aq-router__v { font-size: 15px; line-height: 22px; }
  /* 44 px hit area on the inline link without moving the line */
  .aq-router__v a { padding-block: calc(var(--space-3) + var(--space-1) / 2); }
}
@container (max-width: 860px) { .aq-router__opt[aria-expanded="true"]::after, .aq-router__stations > li:not(:last-child)::after { transform: scaleY(var(--aq-pipe, 1)); transform-origin: center top; } }

/* ---------- RuleFigures: design rules as a Swiss sheet of small engineering figures ---------- */
.aq-rule-figures-sec { overflow: hidden; }
.aq-rule-figures { position: relative; display: flex; flex-direction: column; gap: var(--space-16); }
.aq-rule-figures__cap { position: absolute; right: 0; top: calc(-1 * var(--space-12)); margin: 0; font: 400 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }

/* Shared drawing strokes (line art, round joins; figures scale with their box, so strokes are set in user units) */
.aq-rule-figures svg path, .aq-rule-figures svg circle { fill: none; stroke-linecap: round; stroke-linejoin: round; }
.aq-rule-figures__ln, .aq-rule-figures__wall { stroke: var(--line-strong); stroke-width: 1.5; }
.aq-rule-figures__wall { stroke: var(--ink); stroke-width: 2; }
.aq-rule-figures svg .aq-rule-figures__fill { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.5; }
.aq-rule-figures__th { stroke: var(--line-strong); stroke-width: 1; }
.aq-rule-figures__dim { stroke: var(--ink-subtle); stroke-width: 1; }
.aq-rule-figures__fl { stroke: var(--flow); stroke-width: 1.5; }
.aq-rule-figures__fl.fl-hid { stroke-dasharray: 3 4; }
.aq-rule-figures__ring { stroke: var(--flow); stroke-width: 1.5; }
.aq-rule-figures__bub { stroke: var(--line-strong); stroke-width: 1.5; }
/* sanitemp: the sanitization level along the run as a tinted band, the maximum it is held under as a dashed line */
.aq-rule-figures svg .aq-rule-figures__band { fill: var(--flow-tint); stroke: none; }
.aq-rule-figures__lim { stroke: var(--ink-subtle); stroke-width: 1; stroke-dasharray: 5 4; }
/* sample / pou: a valve the copy has not chosen yet, drawn as an open, dashed seat */
.aq-rule-figures svg .aq-rule-figures__open { fill: none; stroke: var(--ink-subtle); stroke-width: 1.5; stroke-dasharray: 4 3; }
/* the phone crop of each figure is phone-only */
.aq-rule-figures svg.aq-rule-figures__fig--ph { display: none; }
.aq-rule-figures svg .aq-rule-figures__bub { fill: var(--surface); }
.aq-rule-figures__bub.is-opt { stroke-dasharray: 4 3; }
.aq-rule-figures__tx { fill: var(--ink-muted); font: 500 11px/1 var(--font-mono); }
.aq-rule-figures__tx.is-mid { text-anchor: middle; font-size: 10px; }

/* Lead rule: text left, the pipe cut lengthways running off the right edge of the page */
.aq-rule-figures__lead { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-12); align-items: center;
  padding-block: var(--space-8); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); }
.aq-rule-figures__lead-text { display: flex; flex-direction: column; gap: var(--space-4); }
.aq-rule-figures__no { margin: 0; font: 300 64px/1 var(--font-mono); letter-spacing: -0.04em; color: var(--flow); }
.aq-rule-figures__lead-p { margin: 0; font: 300 40px/44px var(--font-sans); letter-spacing: -0.02em; }
.aq-rule-figures__lead-art { position: relative; margin-right: calc(-1 * var(--space-32) * 2); aspect-ratio: 4 / 1; }
.aq-rule-figures__pipe { position: absolute; inset: 0; width: 100%; height: 100%; }
.aq-rule-figures__streak { stroke: var(--flow); stroke-width: 1.2; opacity: 0.85; }
.aq-rule-figures__eddy { stroke: var(--flow); stroke-width: 1; opacity: 0.7; }
.aq-rule-figures__arrow { stroke: var(--ink); stroke-width: 1.5; }
.aq-rule-figures__env { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 4 4; }

/* Rule figure in mono: the number (or its placeholder) that the rule is held to */
.aq-rule-figures__rule { margin: 0; font: 400 18px/26px var(--font-mono); color: var(--ink); font-variant-numeric: tabular-nums; }
.aq-rule-figures__rule--lead { font-size: 24px; line-height: 34px; }

.aq-rule-figures__dl { margin: 0; display: grid; gap: var(--space-3); }
.aq-rule-figures__dl div { display: grid; gap: var(--space-1); }
.aq-rule-figures__dl dt { font: 400 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-rule-figures__dl dd { margin: 0; }
/* the basis is its own dl after the (phone-only) Basis head, so the dl stays valid; spaced as when it sat inside the first */
.aq-rule-figures__dl[data-pk-body] { gap: var(--space-1); margin-top: calc(var(--space-3) - var(--space-4)); }
.aq-rule-figures__v { font: 400 16px/24px var(--font-sans); color: var(--ink); }
.aq-rule-figures__m { font: 400 13px/20px var(--font-mono); color: var(--ink-muted); }
.aq-rule-figures__link { color: var(--flow); }

/* The other rules: a three-column grid of figure cards, hairlines between */
.aq-rule-figures__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-8); row-gap: var(--space-12); }
.aq-rule-figures__card { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--line-strong); }
.aq-rule-figures__figbox { aspect-ratio: 2 / 1; background: var(--surface-sunken); border: 1px solid var(--line); padding: var(--space-3); }
.aq-section--alt .aq-rule-figures__figbox { background: var(--surface); }
.aq-rule-figures__fig { display: block; width: 100%; height: 100%; overflow: visible; }
.aq-rule-figures__head { margin: 0; display: flex; align-items: baseline; gap: var(--space-3); }
.aq-rule-figures__n { font: 400 28px/1 var(--font-mono); letter-spacing: -0.03em; color: var(--ink-subtle); }
.aq-rule-figures__p { font: 500 20px/28px var(--font-sans); letter-spacing: -0.005em; }
.aq-rule-figures__card:hover .aq-rule-figures__n { color: var(--flow); }
.aq-rule-figures__card:hover .aq-rule-figures__figbox { border-color: var(--line-strong); }
.aq-rule-figures__card:hover .aq-rule-figures__fl { stroke-width: 2.5; }

/* Desktop shows every rule; the fold is for phones */
.aq-fold:not(.is-open) .aq-rule-figures__card.aq-fold-x { display: flex; }
.aq-fold:has(> .aq-rule-figures__grid) > .aq-fold__btn { display: none; }

.aq-rule-figures__streaks, .aq-rule-figures__eddies, .aq-rule-figures__prof { pointer-events: none; }

@container (max-width: 1100px) {
  .aq-rule-figures__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
/* Wide (pass 12 C): rules 02-08 in four columns, two rows, so rule 08 no longer stands alone on a third row */
@container (min-width: 1180px) {
  .aq-rule-figures__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--space-6); }
}
@container (max-width: 860px) {
  /* Phones (pass 12, S9/S13): the lead text over its pipe, the pipe inside the gutter; then each rule a row: its figure
     cropped square at 96 px on the left (letters at 12 px or more), number and name, rule figure and design value on
     the right; the basis behind a "Basis +" head (PhoneKit accordion). The fold still shows the first rules. */
  .aq-rule-figures { gap: var(--space-8); }
  .aq-rule-figures__cap { position: static; }
  .aq-rule-figures__lead { grid-template-columns: minmax(0, 1fr); gap: var(--space-5, 20px); padding-block: var(--space-6); }
  .aq-rule-figures__lead-art { margin: 0; aspect-ratio: 3 / 1; }
  .aq-rule-figures__no { font-size: var(--aq-num-phone, 44px); }
  .aq-rule-figures__lead-p { font-size: 28px; line-height: 34px; }
  .aq-rule-figures__rule--lead { font-size: 18px; line-height: 26px; }
  .aq-rule-figures__grid { grid-template-columns: minmax(0, 1fr); row-gap: 0; }
  .aq-rule-figures__card { display: grid; grid-template-columns: 96px minmax(0, 1fr); column-gap: var(--space-4); row-gap: var(--space-2); align-content: start; padding: var(--space-4) 0; }
  .aq-rule-figures__card.is-nofig { grid-template-columns: minmax(0, 1fr); }
  .aq-rule-figures__card > :not(.aq-rule-figures__figbox) { grid-column: -2 / -1; }
  .aq-rule-figures__figbox { grid-column: 1; grid-row: 1 / span 3; align-self: start; width: 96px; height: 96px; aspect-ratio: auto; padding: 0; box-sizing: border-box; }
  .aq-rule-figures__fig { display: none; }
  .aq-rule-figures svg.aq-rule-figures__fig--ph { display: block; width: 100%; height: 100%; overflow: hidden; }
  .aq-rule-figures__fig--ph .aq-rule-figures__tx { font-size: 17px; }
  .aq-rule-figures__fig--ph path, .aq-rule-figures__fig--ph circle { vector-effect: non-scaling-stroke; stroke-width: 1.5px; }
  .aq-rule-figures__fig--ph .aq-rule-figures__tx.is-mid { font-size: 17px; }
  .aq-rule-figures__head { gap: var(--space-2); }
  .aq-rule-figures__n { font-size: 20px; }
  .aq-rule-figures__p { font-size: 18px; line-height: 24px; }
  .aq-rule-figures__rule { font-size: 15px; line-height: 22px; }
  .aq-rule-figures__dl { gap: var(--space-1); }
  .aq-rule-figures__dl[data-pk-body] { margin-top: 0; }
  .aq-rule-figures__grid[data-pk-on] .aq-rule-figures__dl > div:first-child dt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .aq-rule-figures__grid[data-pk-on] [data-pk-body] > dt { display: none; }
  .aq-rule-figures__v { font-size: 15px; line-height: 22px; }
  .aq-rule-figures__m { font-size: var(--aq-read-phone, 14px); line-height: 21px; }
  .aq-rule-figures-sec .aq-rule-figures__grid[data-pk-on] .aq-rule-figures__bh {
    width: auto; min-height: 44px; padding: 0; gap: 0; margin: calc(-2 * var(--space-1)) 0 calc(-1 * var(--space-3));
    font: 400 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
  }
  .aq-rule-figures-sec .aq-rule-figures__grid[data-pk-on] .aq-rule-figures__bh .aq-phone-kit__chev { margin-left: 0; }
  .aq-rule-figures__link { position: relative; }
  .aq-rule-figures__link::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; min-height: var(--aq-hit, 44px); transform: translateY(-50%); }
  .aq-rule-figures .aq-fold:not(.is-open) .aq-rule-figures__card.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-rule-figures__grid) > .aq-fold__btn { display: flex; }
}

/* ---------- ScenePlates: a plants ledger beside one navy plate drawing where the water goes (look scene-plates) ----------
   Left: the title set large and light, then the ledger (a real table in sans on hairlines: the plant with its index
   button, where the water goes as a numbered list keyed to the plate's pins, the legal floor and limit, the fit).
   Right: the navy plate, held in view while the ledger scrolls, a window over a reel of one scene per plant (index and
   plant, an IsoKit drawing of one water header with a drop to each numbered point of use, the numbered callouts). The
   row in hand slides the reel. Phones: title, the plate as a 220 px strip held under the header, then the rows. */
.aq-scene-plates { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--space-12); align-items: start; }
.aq-scene-plates__main { display: flex; flex-direction: column; gap: var(--space-6); min-width: 0; }
.aq-scene-plates__main .aq-sec-head { max-width: none; }
.aq-scene-plates__main .aq-h1 { margin: 0; font-size: clamp(44px, 6cqi, 80px); line-height: 1.02; font-weight: 300; letter-spacing: -0.035em; text-wrap: balance; }
.aq-scene-plates__side { position: sticky; top: var(--space-24); min-width: 0; }

/* The ledger */
.aq-scene-plates__table { width: 100%; border-collapse: collapse; table-layout: fixed; }
.aq-scene-plates__table thead th { padding: 0 var(--space-3) var(--space-3) 0; border-bottom: 1px solid var(--line-strong); text-align: left; vertical-align: bottom;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
.aq-scene-plates__table thead th:first-child { width: 25%; }
.aq-scene-plates__table thead th:nth-child(2) { width: 25%; }
.aq-scene-plates__table thead th + th { padding-left: var(--space-3); }
.aq-scene-plates__row > * { position: relative; padding: var(--space-4) var(--space-3) var(--space-6) 0; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top;
  font: 400 14px/21px var(--font-sans); color: var(--ink); overflow-wrap: break-word; }
.aq-scene-plates__row > * + * { padding-left: var(--space-3); }
.aq-scene-plates__row > th { font-weight: inherit; }
.aq-scene-plates__plant { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-1); align-items: start; }
.aq-scene-plates__pick { min-width: 44px; min-height: 44px; margin: calc(-1 * var(--space-3)) 0 0 calc(-1 * var(--space-2)); padding: 0 var(--space-2);
  border: 0; background: none; cursor: pointer; text-align: left; font: 500 13px/44px var(--font-mono); letter-spacing: 0.08em; font-variant-numeric: tabular-nums; color: var(--ink-muted); }
.aq-scene-plates__pick:hover, .aq-scene-plates__row.is-on .aq-scene-plates__pick { color: var(--flow); }
.aq-scene-plates__pick:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
.aq-scene-plates__name { font: 400 17px/24px var(--font-sans); color: var(--ink); text-wrap: balance; }
.aq-scene-plates__name a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 4px; text-decoration-color: var(--flow); }
/* the row in hand: a flow rule along its foot, its index lit, its numbers filled */
.aq-scene-plates__row.is-on > * { border-bottom-color: var(--flow); box-shadow: inset 0 -1px 0 var(--flow); }
.aq-scene-plates__uses { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
.aq-scene-plates__uses li { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-2); align-items: start; }
.aq-scene-plates__un, .aq-scene-plates__pn, .aq-scene-plates__pin { display: inline-grid; place-items: center; box-sizing: border-box; width: 20px; height: 20px; font: 500 11px/1 var(--font-mono); font-variant-numeric: tabular-nums; }
.aq-scene-plates__un { margin-top: 1px; border: 1px solid var(--line-strong); color: var(--ink-muted); }
.aq-scene-plates__row.is-on .aq-scene-plates__un { border-color: var(--navy); background: var(--navy); color: var(--on-navy); }
.aq-scene-plates__ln { display: block; }
.aq-scene-plates__ln--then { margin-top: var(--space-1); color: var(--ink-muted); }
.aq-scene-plates__fit a { color: var(--ink); text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--flow); }
.aq-scene-plates__fit a:hover { color: var(--flow); }
.aq-scene-plates-sec .aq-fold__btn { margin-top: var(--space-6); }

/* The plate: navy, a window over the reel of scenes */
.aq-scene-plates__plate { position: relative; overflow: hidden; background: var(--navy); color: var(--on-navy); }
.aq-scene-plates__plate::before { content: ""; position: absolute; inset: var(--space-2); border: 1px solid color-mix(in srgb, var(--on-navy-muted) 30%, transparent); pointer-events: none; z-index: 1; }
.aq-scene-plates__reel { display: grid; }
.aq-scene-plates__still { grid-area: 1 / 1; margin: 0; display: grid; grid-template-rows: auto auto auto; gap: var(--space-4); padding: var(--space-6) var(--space-6) var(--space-6); min-width: 0;
  transform: translateY(calc(var(--d, 0) * 100%)); }
.aq-scene-plates__cap { display: flex; align-items: baseline; gap: var(--space-3); padding-bottom: var(--space-3); border-bottom: 1px solid color-mix(in srgb, var(--on-navy-muted) 35%, transparent); }
.aq-scene-plates__ci { flex: none; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; font-variant-numeric: tabular-nums; color: var(--on-navy-muted); }
.aq-scene-plates__ck { min-width: 0; font: 300 22px/28px var(--font-sans); letter-spacing: -0.01em; color: var(--on-navy); text-wrap: balance; }
/* drawing area: the drawing box keeps its own ratio so the pins stay on their stations */
.aq-scene-plates__area { container-type: inline-size; display: grid; place-items: center; }
.aq-scene-plates__fig { position: relative; width: min(100cqw, calc(var(--space-32) * 3 * var(--ar, 1.4))); aspect-ratio: var(--ar, 1.4); }
.aq-scene-plates__svg { display: block; width: 100%; height: 100%; }
.aq-scene-plates__pin { position: absolute; width: var(--space-6); height: var(--space-6); transform: translate(-50%, -50%); border: 1.5px solid var(--on-navy); background: var(--navy); color: var(--on-navy); font-size: 12px; }
.aq-scene-plates__still.is-on .aq-scene-plates__pin { background: var(--on-navy); color: var(--navy); }
.aq-scene-plates__pn { width: var(--space-6); height: var(--space-6); border: 1.5px solid var(--on-navy); color: var(--on-navy); font-size: 12px; }
.aq-scene-plates__calls { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
.aq-scene-plates__calls li { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-3); align-items: center; padding-block: var(--space-2); border-top: 1px solid color-mix(in srgb, var(--on-navy-muted) 35%, transparent);
  font: 400 15px/22px var(--font-sans); color: var(--on-navy); overflow-wrap: break-word; }

@media (prefers-reduced-motion: no-preference) {
  .aq-scene-plates__still { transition: transform 240ms cubic-bezier(0.2, 0.85, 0.25, 1); }
  .aq-scene-plates__plate.is-instant .aq-scene-plates__still { transition: none; }
  .aq-scene-plates__row > * { transition: border-color 240ms, box-shadow 240ms; }
  .aq-scene-plates__pick, .aq-scene-plates__un { transition: color 160ms, background-color 160ms, border-color 160ms; }
}

@container (max-width: 1100px) {
  .aq-scene-plates { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); column-gap: var(--space-6); }
  .aq-scene-plates__table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .aq-scene-plates__table, .aq-scene-plates__table tbody, .aq-scene-plates__row { display: block; }
  .aq-scene-plates__row { padding: var(--space-3) 0 var(--space-4); border-bottom: 1px solid var(--line); }
  .aq-scene-plates__row > *, .aq-scene-plates__row > * + * { display: block; padding: var(--space-1) 0 var(--space-1) var(--space-12); border: 0; }
  .aq-scene-plates__row > th { padding-left: 0; }
  .aq-scene-plates__row.is-on { box-shadow: inset 0 -2px 0 var(--flow); }
  .aq-scene-plates__row.is-on > * { box-shadow: none; }
  .aq-scene-plates__row > td::before { content: attr(data-l); display: block; margin-bottom: var(--space-1); font: 500 11px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
  .aq-scene-plates__row > td:empty { display: none; }
}

@container (max-width: 860px) {
  .aq-scene-plates { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); }
  .aq-scene-plates__main, .aq-scene-plates__side { display: contents; }
  .aq-scene-plates__main .aq-h1 { font-size: clamp(38px, 11cqi, 52px); }
  .aq-scene-plates__plate { order: 2; }
  .aq-scene-plates-sec .aq-fold, .aq-scene-plates__table { order: 3; }
  .aq-scene-plates__still { padding: var(--space-6) var(--space-4); }
  .aq-scene-plates__ck { font-size: 19px; line-height: 25px; }
  /* rows as compact cards: the index and plant, the numbered uses (keyed to the strip's pins), floor and limit, fit */
  .aq-scene-plates__row { padding: var(--space-2) 0 var(--space-4); }
  /* no hanging indent (S13): the cells start under the index numeral, so the reading column is the full card */
  .aq-scene-plates__row > *, .aq-scene-plates__row > * + * { padding-left: var(--space-3); }
  .aq-scene-plates__row.is-on { box-shadow: inset 2px 0 0 var(--flow); }
  .aq-scene-plates__row > th { padding: 0 0 0 var(--space-2); }
  .aq-scene-plates__plant { align-items: center; }
  .aq-scene-plates__pick { margin-top: 0; }
  .aq-scene-plates__name { font-size: 17px; line-height: 23px; padding-top: 0; align-self: center; }
  .aq-scene-plates__uses { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); }
  .aq-scene-plates__uses li { display: inline-grid; column-gap: var(--space-1); }
  .aq-scene-plates__row > * { font-size: var(--aq-read-phone, 14px); line-height: 21px; }
  /* pass 12 C: a 44 px target (the 12 px pad gave 42 px on a 14/21 line); inline, so a two-line link still wraps in
     its sentence, the pad growing its hit box without moving the text */
  .aq-scene-plates__fit a { display: inline; padding-block: 13px; }
  /* the plate as a 220 px strip held under the header (PhoneKit): caption and drawing, the callouts left to the rows */
  .aq-scene-plates[data-pk-on] .aq-scene-plates__plate { margin: 0 calc(-1 * var(--space-4)); background: var(--navy); border-bottom: 0; }
  /* column heads once (S12): the cell labels show on the first row only (kept for screen readers on the others); the
     uses need none after it, their numbers are the strip's pins */
  .aq-scene-plates__row + .aq-scene-plates__row > td::before { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; margin: 0; }
  .aq-scene-plates__row + .aq-scene-plates__row > td + td { margin-top: var(--space-1); }
  .aq-scene-plates[data-pk-on] .aq-scene-plates__plate::before { inset: var(--space-1); }
  .aq-scene-plates[data-pk-on] .aq-scene-plates__reel { height: 100%; }
  .aq-scene-plates[data-pk-on] .aq-scene-plates__still { grid-template-rows: auto minmax(0, 1fr); gap: var(--space-1); padding: var(--space-2) var(--space-4) var(--space-2); }
  .aq-scene-plates[data-pk-on] .aq-scene-plates__calls { display: none; }
  .aq-scene-plates[data-pk-on] .aq-scene-plates__cap { padding-bottom: var(--space-1); }
  .aq-scene-plates[data-pk-on] .aq-scene-plates__ck { font-size: 15px; line-height: 20px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .aq-scene-plates[data-pk-on] .aq-scene-plates__area { container-type: size; min-height: 0; height: 100%; }
  .aq-scene-plates[data-pk-on] .aq-scene-plates__fig { width: min(100cqw, calc(100cqh * var(--ar, 1.4))); }
  .aq-scene-plates[data-pk-on] .aq-scene-plates__pin { width: 20px; height: 20px; }
}

/* ---------- SectionTrain: a pretreatment train as one sectional elevation, each bed holding what it caught ---------- */
/* Limestone sheet (the component sets data-theme="light" so flow keeps its light value on the fixed limestone ground).
   The svg spans the content width; the stage columns under it share its 200-unit column grid. */
.aq-section-train-sec .aq-sec-head .aq-h1 { color: var(--on-limestone); }
.aq-section-train { position: relative; display: flex; flex-direction: column; gap: var(--space-6); color: var(--on-limestone); background: transparent; }
.aq-section-train__defs { position: absolute; width: 0; height: 0; overflow: hidden; }
.aq-section-train__svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-section-train svg * { vector-effect: non-scaling-stroke; stroke-linejoin: round; stroke-linecap: round; }

/* Drawing: walls cut and hatched, interiors on the raised paper, beds in fine marks */
.aq-section-train__hatch-bg { fill: var(--limestone); }
.aq-section-train__hatch { stroke: var(--on-limestone-muted); stroke-width: 0.75; vector-effect: none; }
.aq-section-train__wall { stroke: var(--on-limestone); stroke-width: 1.5; }
.aq-section-train__in { fill: var(--surface-raised); stroke: var(--on-limestone-muted); stroke-width: 1; }
.aq-section-train__head { fill: var(--surface-raised); stroke: var(--on-limestone); stroke-width: 1.5; }
.aq-section-train__level { fill: none; stroke: var(--on-limestone-muted); stroke-width: 1; stroke-dasharray: 4 3; }
.aq-section-train__ripple { fill: none; stroke: var(--flow); stroke-width: 1; opacity: 0.55; }
.aq-section-train__gap { fill: none; stroke: var(--on-limestone-muted); stroke-width: 1; }
.aq-section-train__valve { fill: var(--surface-raised); stroke: var(--on-limestone); stroke-width: 1.5; }
.aq-section-train__sand { fill: var(--on-limestone-muted); }
.aq-section-train__pebble, .aq-section-train__bead, .aq-section-train__grain { fill: none; stroke: var(--on-limestone-muted); stroke-width: 1; }
.aq-section-train__grain { fill: var(--limestone); }
.aq-section-train__bed--idle { opacity: 0.45; }
.aq-section-train__regen { fill: none; stroke: var(--on-limestone-muted); stroke-width: 1.25; }
.aq-section-train__pleat, .aq-section-train__core, .aq-section-train__drain { fill: none; stroke: var(--on-limestone); stroke-width: 1; }

/* The pipe: a twin wall (a wide dark stroke under a narrower paper one) and the water as a flow line */
.aq-section-train__pipe { fill: none; stroke: var(--on-limestone); stroke-width: 12; vector-effect: none; stroke-linejoin: round; }
.aq-section-train__bore { fill: none; stroke: var(--surface-raised); stroke-width: 9; vector-effect: none; stroke-linejoin: round; }
.aq-section-train__flow { fill: none; stroke: var(--flow); stroke-width: 2; }
.aq-section-train__drop { fill: var(--flow); opacity: 0; }
.aq-section-train__arrow { fill: none; stroke: var(--flow); stroke-width: 2; }
.aq-section-train__swarm { display: none; }

/* What the water carries: particles solid, hardness hexagons, chlorine crosses, fines dust */
.aq-section-train__g--p, .aq-section-train__g--f { fill: var(--on-limestone); }
.aq-section-train__g--h { fill: var(--surface-raised); stroke: var(--on-limestone); stroke-width: 1.25; }
.aq-section-train__g--c { fill: none; stroke: var(--on-limestone); stroke-width: 1.5; }

/* Lenses: a magnified sample of the water, at the feed and at the RO */
.aq-section-train__lens-rim { fill: var(--limestone); stroke: var(--on-limestone); stroke-width: 1.5; }
.aq-section-train__lens-face { fill: var(--surface-raised); stroke: var(--on-limestone-muted); stroke-width: 1; }
.aq-section-train__lens-water { fill: none; stroke: var(--flow); stroke-width: 1; opacity: 0.6; }
.aq-section-train__lead { fill: none; stroke: var(--on-limestone-muted); stroke-width: 1; stroke-dasharray: 2 3; }
.aq-section-train__dot { fill: var(--on-limestone); }

/* Monitoring bus: a dashed signal line with instrument bubbles tapped off the pipe */
.aq-section-train__bus { fill: none; stroke: var(--on-limestone-muted); stroke-width: 1; stroke-dasharray: 6 3 1 3; }
.aq-section-train__tap { fill: none; stroke: var(--on-limestone-muted); stroke-width: 1; }
.aq-section-train__bubble { fill: var(--surface-raised); stroke: var(--on-limestone); stroke-width: 1.25; }

/* Stage columns under the drawing */
.aq-section-train__stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 7), minmax(0, 1fr)); }
.aq-section-train__stage { position: relative; padding: var(--space-4) var(--space-3) 0; border-top: 1px solid var(--on-limestone-muted); }
.aq-section-train__stage + .aq-section-train__stage { border-left: 1px solid color-mix(in srgb, var(--on-limestone-muted) 35%, transparent); }
.aq-section-train__mini { display: none; }
.aq-section-train__text { display: flex; flex-direction: column; gap: var(--space-2); }
.aq-section-train__no { margin: 0; font: 400 12px/16px var(--font-mono); color: var(--on-limestone); } /* pass 12 C: full ink, 12 px mono needs it */
.aq-section-train__stage.is-on .aq-section-train__no .aq-index { color: var(--flow); }
.aq-section-train__t { margin: 0; font: 500 16px/22px var(--font-sans); letter-spacing: -0.005em; color: var(--on-limestone); }
.aq-section-train__t a { color: var(--flow); text-decoration: underline; text-underline-offset: 3px; }
.aq-section-train__t a::after { content: " \2192"; }
.aq-section-train__d { margin: 0; font: 400 14px/21px var(--font-sans); color: var(--on-limestone-muted); }
.aq-section-train__catch { display: inline-flex; align-self: flex-start; align-items: center; gap: var(--space-2); margin: var(--space-1) 0 0;
  padding: var(--space-1) var(--space-2); border: 1px solid var(--on-limestone); background: var(--surface-raised);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--on-limestone); }
.aq-section-train__cg { width: 14px; height: 14px; flex: none; overflow: visible; }
.aq-section-train__base { margin: 0; display: flex; align-items: center; gap: var(--space-3); padding-top: var(--space-3);
  font: 400 13px/20px var(--font-mono); color: var(--on-limestone-muted); }
.aq-section-train__base-mark { flex: none; width: var(--space-12); height: 0; border-top: 1px dashed var(--on-limestone-muted); }

/* Phones: one frame of the elevation per stage, run down the page on a pipe rail at the left (pass 12 C: frames
   76 px wide, scale 0.38 of the 200-unit column, so rail, offsets and the outlet fold scale with them) */
@container (max-width: 860px) {
  .aq-section-train__svg { display: none; }
  .aq-section-train__stages { grid-template-columns: minmax(0, 1fr); }
  .aq-section-train__stage { display: grid; grid-template-columns: 76px minmax(0, 1fr); column-gap: var(--space-4); align-items: start;
    padding: 0 0 var(--space-4); border: 0; }
  .aq-section-train__stage + .aq-section-train__stage { border-left: 0; }
  .aq-section-train__stage::before { content: ""; position: absolute; left: 38px; top: 0; bottom: 0; width: 3px; transform: translateX(-50%);
    border-inline: 1px solid var(--on-limestone); background: var(--surface-raised); z-index: 0; }
  /* the rail is the pipe: it starts at the feed lens, runs behind every vessel (their walls and beds are filled, the
     paper round them is not) and ends at the outlet lens */
  .aq-section-train__stage:first-child::before { top: 57px; }
  .aq-section-train__stage:last-child::before { bottom: auto; height: 57px; }
  .aq-section-train__mini { display: block; position: relative; z-index: 1; width: 76px; height: auto; background: transparent; }
  /* the backflow preventer turns onto the rail; the outlet's arrowhead is the rail's end, so it goes */
  .aq-section-train__mini .aq-section-train__valve { transform-box: fill-box; transform-origin: center; transform: translate(52px, 0) rotate(90deg); }
  .aq-section-train__mini .aq-section-train__arrow, .aq-section-train__mini .aq-section-train__dot { display: none; }
  .aq-section-train__mini .aq-section-train__lead { display: none; }
  .aq-section-train__text { padding-top: var(--space-4); }
  .aq-section-train__t { font-size: 17px; line-height: 24px; }
  .aq-section-train__base { align-items: flex-start; }
  .aq-section-train__base-mark { width: var(--space-6); margin-top: var(--space-3); }
  /* pass 12: the outlet row ("To RO") folds to the lens: no dead paper under it, the link a 44 px target beside the lens */
  .aq-section-train__stage:last-child { padding-bottom: 0; }
  .aq-section-train__stage:last-child .aq-section-train__mini { margin-bottom: -52px; }
  .aq-section-train__stage:last-child .aq-section-train__text { padding-top: var(--space-8); gap: 0; }
  .aq-section-train__t a { display: inline-flex; align-items: center; min-height: 44px; }
  .aq-section-train__t a::after { content: "\00a0\2192"; }
}
.aq-section-train__seep { fill: none; stroke: var(--flow); stroke-width: 1.25; stroke-dasharray: 2 5; opacity: 0.7; }

/* ---------- SignalDial: an instrument schedule beside one multi-channel transmitter dial (look "signal-dial") ---------- */
/* Desktop: the table (left) and the dial (right) side by side; the dial's bezel turns (--sd-a, degrees) to bring the
   chosen channel under the index. Phones: the dial first, smaller; the rows stack under it. */
.aq-signal-dial {
  display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr); grid-template-areas: "table fig";
  column-gap: var(--space-16); align-items: center;
}
.aq-signal-dial__fig { grid-area: fig; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
.aq-signal-dial__table { grid-area: table; }

/* the dial */
.aq-signal-dial__dial {
  position: relative; width: 100%; max-width: 460px; aspect-ratio: 1; border-radius: 50%;
  background: var(--surface-raised); cursor: ew-resize; touch-action: pan-y; user-select: none; -webkit-user-select: none;
}
.aq-signal-dial__dial:focus-visible { outline: 2px solid var(--focus); outline-offset: var(--space-2); }
.aq-signal-dial__dial.is-drag { cursor: grabbing; }
.aq-signal-dial__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.aq-signal-dial__rim { fill: none; stroke: var(--line-strong); stroke-width: 1; }
.aq-signal-dial__rim2 { fill: var(--surface); stroke: var(--line); stroke-width: 1; }
.aq-signal-dial__ring {
  transform: rotate(calc(var(--sd-a, 0) * 1deg)); transform-box: view-box; transform-origin: 200px 200px;
  transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
}
.aq-signal-dial__dial.is-drag .aq-signal-dial__ring { transition: none; }
.aq-signal-dial__tk { stroke: var(--line-strong); stroke-width: 1; opacity: 0.6; }
.aq-signal-dial__tk--mid { opacity: 1; }
.aq-signal-dial__tk--stop { stroke: var(--ink); stroke-width: 1.5; opacity: 1; }
.aq-signal-dial__tk--stop.is-on { stroke: var(--flow); stroke-width: 2.5; }
.aq-signal-dial__sn { font: 400 12px var(--font-mono); fill: var(--ink-subtle); text-anchor: middle; transition: fill 200ms ease; }
.aq-signal-dial__sn.is-on { fill: var(--flow); }
.aq-signal-dial__fine { fill: none; stroke: var(--line-strong); stroke-width: 1; opacity: 0.5; }
.aq-signal-dial__index { fill: var(--flow); stroke: var(--flow); stroke-width: 1.5; }

/* the readout on the face */
.aq-signal-dial__read {
  position: absolute; left: 50%; top: 50%; width: 58%; transform: translate(-50%, -50%);
  display: flex; flex-direction: column; align-items: center; text-align: center; pointer-events: none;
}
.aq-signal-dial__ch { font: 400 12px/16px var(--font-mono); letter-spacing: 0.08em; color: var(--ink-subtle); }
.aq-signal-dial__num { display: flex; align-items: baseline; gap: var(--space-2); color: var(--ink); }
.aq-signal-dial__digits { font: 300 clamp(56px, 7vw, 96px)/1 var(--font-mono); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
.aq-signal-dial__of { font: 400 13px/1 var(--font-mono); color: var(--ink-subtle); }
.aq-signal-dial__name { margin-top: var(--space-2); font: 400 18px/24px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); text-wrap: balance; }
.aq-signal-dial__lim { align-self: stretch; height: 1px; margin: var(--space-3) calc(-1 * var(--space-4)) var(--space-2); background: var(--flow); }
.aq-signal-dial__val { font: 400 13px/18px var(--font-sans); color: var(--ink-muted); text-wrap: balance; }
.aq-signal-dial__tag {
  margin-top: var(--space-2); padding: 0 var(--space-2); border: 1px solid var(--line-strong);
  font: 400 11px/18px var(--font-mono); color: var(--ink-muted); white-space: normal;
}
.aq-signal-dial__tag[hidden] { display: none; }
.aq-signal-dial__read.is-tick > * { animation: aq-sd-tick 220ms cubic-bezier(0.2, 0.8, 0.2, 1); }
@keyframes aq-sd-tick { from { opacity: 0.2; transform: translateY(var(--sd-dir, 8px)); } to { opacity: 1; transform: none; } }
.aq-signal-dial__hint { margin: 0; font: 400 12px/16px var(--font-mono); color: var(--ink-subtle); }

/* the schedule */
.aq-signal-dial__table { width: 100%; border-collapse: collapse; }
.aq-signal-dial__table thead th {
  padding: 0 var(--space-3) var(--space-3); text-align: left; border-bottom: 1px solid var(--line-strong);
  font: 400 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-subtle);
}
.aq-signal-dial__row > * { padding: var(--space-3); vertical-align: top; border-bottom: 1px solid var(--line); text-align: left; transition: background-color 200ms ease; }
.aq-signal-dial__row > th { padding: 0; width: 34%; font-weight: 400; }
.aq-signal-dial__pick {
  display: grid; grid-template-columns: var(--space-8) 1fr; align-items: baseline; width: 100%; min-height: 44px;
  padding: var(--space-3); border: 0; border-left: 2px solid transparent; background: none; text-align: left; cursor: pointer;
  font: 500 15px/22px var(--font-sans); color: var(--ink);
}
