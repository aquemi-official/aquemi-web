/* ---------- PlantStations: the points of use as numbered stations on an isometric plant room ---------- */
/* Desktop: the plan (IsoKit drawing with HTML tags over it) on the left, the numbered rows on the right. */
.aq-plant-stations { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--space-12); align-items: center; color: var(--ink); }
.aq-plant-stations__plan { position: relative; margin: 0; }
.aq-plant-stations__svg { display: block; width: 100%; height: auto; }
.aq-plant-stations__route { fill: none; stroke: var(--flow); stroke-width: 1.5; stroke-dasharray: 6 5; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke;
  transition: stroke-width 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-plant-stations__drop.is-hot { stroke-width: 3; stroke-dasharray: none; }

/* Tags: one per station, keyed to the row number; 13 px mono on a navy chip, a short stem down to the station */
.aq-plant-stations__tag { position: absolute; z-index: 1; transform: translate(-50%, calc(-100% - var(--space-2))); padding: var(--space-1) var(--space-2);
  background: var(--navy); color: var(--on-navy); font: 500 13px/16px var(--font-mono); letter-spacing: 0.02em; white-space: nowrap; pointer-events: none;
  transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-plant-stations__tag::after { content: ""; position: absolute; left: 50%; top: 100%; width: 1px; height: var(--space-2); background: var(--navy); transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-plant-stations__tag.is-hot { background: var(--flow); color: var(--surface); }
.aq-plant-stations__tag.is-hot::after { background: var(--flow); }

/* Rows: ruled, the number large in mono (the tag's key), the use, then where it goes */
.aq-plant-stations__rows { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
.aq-plant-stations__row { border-bottom: 1px solid var(--line-strong); }
.aq-plant-stations__in { display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr); align-items: baseline; padding: var(--space-4) 0; color: inherit; text-decoration: none; }
.aq-plant-stations__no { font: 400 24px/28px var(--font-mono); color: var(--ink-muted); transition: color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-plant-stations__row.is-hot .aq-plant-stations__no { color: var(--flow); }
.aq-plant-stations__txt { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
.aq-plant-stations__t { font: 500 18px/24px var(--font-sans); color: var(--ink); }
.aq-plant-stations__d { font: 400 15px/22px var(--font-sans); color: var(--ink-muted); }
a.aq-plant-stations__in:hover .aq-plant-stations__t { text-decoration: underline; text-underline-offset: 3px; }
a.aq-plant-stations__in:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* Phones: the plan trimmed to the room, then every row (each has a tag on the plan, so none folds) */
@container (max-width: 860px) {
  .aq-plant-stations { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); overflow-x: clip; }
  /* tablets: the whole room, capped and centred (the phone trim cut both back walls at 768) */
  .aq-plant-stations__plan { width: 100%; max-width: 640px; margin-inline: auto; }
  .aq-plant-stations__tag { font-size: 13px; line-height: 16px; padding: 2px var(--space-1); }
  .aq-plant-stations__in { grid-template-columns: var(--space-8) minmax(0, 1fr); padding: var(--space-3) 0; }
  .aq-plant-stations__no { font-size: 17px; line-height: 24px; }
  .aq-plant-stations__t { font-size: 17px; line-height: 24px; }
}

/* small phones: trimmed to the room, the plan runs wider than the column and its empty floor margins fall off the sides */
@container (max-width: 600px) {
  .aq-plant-stations__plan { width: 124%; max-width: none; margin-left: -12%; margin-right: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .aq-plant-stations__route, .aq-plant-stations__tag, .aq-plant-stations__tag::after, .aq-plant-stations__no { transition: none; }
}
