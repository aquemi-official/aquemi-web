.aq-limit-gauges__bar { position: relative; display: flex; flex-direction: column; gap: var(--space-2); }
.aq-limit-gauges__chip {
  align-self: flex-start; position: relative; left: calc(var(--f, 0.5) * 100%); transform: translateX(calc(var(--f, 0.5) * -100%)); max-width: 100%;
  color: var(--ink); font: 400 12px/16px var(--font-mono); font-variant-numeric: tabular-nums; overflow-wrap: anywhere;
