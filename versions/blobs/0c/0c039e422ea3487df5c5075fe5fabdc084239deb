/* ---------- NavBar and phone menu ---------- */
/* Quiet header on surface: logo left, six sections in sentence case (each a button that opens its mega panel), the
   "Service request" link and one primary button right, a line rule below. */
.aq-nav {
  position: relative; display: flex; align-items: center; gap: var(--space-8);
  height: 72px; padding: 0 var(--space-8);
  background: var(--surface); border-bottom: 1px solid var(--line);
}
.aq-nav__home { display: flex; align-items: center; }
.aq-nav__logo { width: 112px; height: auto; }
.aq-nav__logo--lockup { width: 152px; }

.aq-nav__links { display: flex; align-items: center; gap: var(--space-6); margin: 0; padding: 0; list-style: none; flex: 1; min-width: 0; }
/* The items stay unpositioned: an open panel is placed against the bar (.aq-nav), full width under it */
.aq-nav__item { display: flex; align-items: center; }
/* Section buttons (and a plain section link), and the service link (a utility link, not a section) styled as one */
.aq-nav__trigger {
  display: inline-flex; align-items: center; gap: var(--space-1); margin: 0; padding: 0; border: 0; background: none; cursor: pointer;
}
.aq-nav__links > li > a, .aq-nav__trigger, .aq-nav__service {
  color: var(--ink-muted); text-decoration: none; font: 500 14px/20px var(--font-sans); white-space: nowrap;
  transition: color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-nav__links > li > a:hover, .aq-nav__links > li > a[aria-current="page"], .aq-nav__trigger:hover, .aq-nav__trigger[aria-current], .aq-nav__trigger[aria-expanded="true"],
.aq-nav__service:hover, .aq-nav__service[aria-current="page"] { color: var(--ink); }
/* The chevron: two 1.5 px strokes in currentColor; it turns over while the panel is open */
.aq-nav__chev { position: relative; flex: none; width: 8px; height: 8px; transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.aq-nav__chev::before {
  content: ""; position: absolute; left: 1.5px; top: 0.5px; width: 5px; height: 5px;
  border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg);
}
.aq-nav__trigger[aria-expanded="true"] .aq-nav__chev { transform: rotate(180deg); }
/* The links take the free width on wide screens; the spacer only works in the compact bar (here it would add a gap) */
.aq-nav__spacer { display: none; }
.aq-nav__frame { display: inline-flex; }
.aq-nav__toggle { display: none; }

/* Theme switch: a quiet 44 px icon button between the service link and the proposal button, kept in the compact bar
   beside the menu toggle. It shows the theme it switches to: a moon in light, a sun in dark (the same selector pattern
   as the logo swap in base.css). Strokes in currentColor, ink-muted turning ink on hover like the section labels. */
.aq-nav__theme {
  display: inline-flex; align-items: center; justify-content: center; flex: none;
  width: var(--aq-hit); height: var(--aq-hit); margin: 0 calc(-1 * var(--space-2)); padding: 0;
  background: none; border: 0; border-radius: var(--radius-sm); color: var(--ink-muted); cursor: pointer;
  transition: color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-nav__theme:hover { color: var(--ink); }
.aq-nav__theme:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
.aq-nav__theme svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.aq-nav__sun { display: none; }
[data-theme="dark"] .aq-nav__moon { display: none; }
[data-theme="dark"] .aq-nav__sun { display: block; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .aq-nav__moon { display: none; }
  :root:not([data-theme="light"]) .aq-nav__sun { display: block; }
}
@media (prefers-reduced-motion: reduce) { .aq-nav__theme { transition: none; } }

/* Menu: the urgent block, the sections, the page's section jump, then the proposal button, on surface */
.aq-menu { display: none; }
.aq-menu__list { display: grid; margin: 0; padding: 0; list-style: none; }
.aq-menu__list > li > a {
  display: flex; align-items: baseline; gap: var(--space-3); min-height: 44px;
  padding: var(--space-3) 0; color: var(--ink); text-decoration: none;
  font: 400 20px/28px var(--font-sans); letter-spacing: -0.005em; border-bottom: 1px solid var(--line);
}
.aq-menu__list--jump a { font: 400 16px/24px var(--font-sans); color: var(--ink-muted); padding-block: var(--space-2); }
.aq-menu__list > li > a[aria-current] { color: var(--ink); }
.aq-menu__list > li > a[aria-current]::after { content: "→"; content: "→" / ""; margin-left: auto; color: var(--flow); }
.aq-menu__jump { display: grid; }
.aq-menu__label {
  padding: var(--space-6) 0 var(--space-2);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
.aq-menu__cta { display: flex; }
.aq-menu__cta .aq-btn { flex: 1; justify-content: center; }

/* Urgent block, first in the menu: "Production stopped?", the service number (a tel: link once confirmed, the
   placeholder until then) under a "Call" eyebrow, the hours it is answered, then the service request row. On limestone
   with on-limestone text; data-theme="light" on the block keeps its placeholder, hairline, arrow and focus ring on the
   light values, since limestone stays light in both themes. Text, not a heading: the menu's outline does not change. */
.aq-menu__urgent { display: grid; gap: var(--space-2); padding: var(--space-4); background: var(--limestone); color: var(--on-limestone); }
.aq-menu__ask { margin: 0; font: 500 14px/20px var(--font-sans); color: var(--on-limestone); }
.aq-menu__call {
  display: block; min-height: 44px; padding-block: var(--space-2);
  font: 400 20px/28px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--on-limestone); text-decoration: none; overflow-wrap: anywhere;
}
.aq-menu__k {
  display: inline-block; margin-right: var(--space-3);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted);
}
a.aq-menu__call:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
/* The hours the number is answered, right under it: the number never shows without them */
.aq-menu__hours { margin: 0; font: 400 14px/20px var(--font-sans); color: var(--on-limestone-muted); }
.aq-menu__service {
  display: flex; align-items: baseline; gap: var(--space-3); min-height: 44px;
  padding-top: var(--space-3); border-top: 1px solid var(--line-strong); color: var(--on-limestone); text-decoration: none;
  font: 400 20px/28px var(--font-sans); letter-spacing: -0.005em;
}
.aq-menu__service[aria-current]::after { content: "→"; content: "→" / ""; margin-left: auto; color: var(--flow); }

@media (prefers-reduced-motion: reduce) {
  .aq-nav__links > li > a, .aq-nav__trigger, .aq-nav__chev, .aq-nav__service { transition: none; }
}

/* Hover and focus: a flow rule draws under the label from its left end */
.aq-nav__links > li > a, .aq-nav__trigger, .aq-nav__service { position: relative; }
.aq-nav__links > li > a::before, .aq-nav__trigger::before, .aq-nav__service::before {
  content: ""; position: absolute; left: 0; right: 0; bottom: calc(-1 * var(--space-1)); height: 1px; background: var(--flow);
  transform: scaleX(0); transform-origin: 0 50%; transition: transform 240ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-nav__links > li > a:hover::before, .aq-nav__links > li > a:focus-visible::before, .aq-nav__trigger:hover::before, .aq-nav__trigger:focus-visible::before,
.aq-nav__trigger[aria-expanded="true"]::before, .aq-nav__service:hover::before, .aq-nav__service:focus-visible::before { transform: scaleX(1); }
.aq-nav__links > li > a[aria-current="page"]::before, .aq-nav__trigger[aria-current]::before, .aq-nav__service[aria-current="page"]::before { content: none; }
.aq-menu__list a, .aq-menu__service { transition: color 160ms cubic-bezier(0.2, 0, 0, 1); }
@media (prefers-reduced-motion: reduce) { .aq-nav__links > li > a::before, .aq-nav__trigger::before, .aq-nav__service::before, .aq-menu__list a, .aq-menu__service { transition: none; } }

/* Mid widths: tighten the gaps (at the wide spacing the full bar needs about 1,140 px) */
@container (max-width: 1120px) {
  .aq-nav { gap: var(--space-4); padding: 0 var(--space-6); }
  .aq-nav__links { gap: var(--space-3); }
  .aq-nav .aq-nav__logo--lockup { width: 140px; }
}

/* Compact bar: the logo, six section buttons, service link and button need about 1,010 px at the mid spacing, so up to
   1,040 px the sections and the button hide and the toggle opens the menu, which carries all of them */
@container (max-width: 1040px) {
  .aq-nav__links, .aq-nav__service, .aq-nav > .aq-nav__frame { display: none; }
  .aq-nav__spacer { display: block; flex: 1; }
  .aq-nav__toggle { display: inline-flex; }
  .aq-menu {
    display: grid; gap: var(--space-6); padding: var(--space-2) var(--space-6) var(--space-8);
    background: var(--surface); border-bottom: 1px solid var(--line);
  }
}

/* The same compact form when the labels outgrow the bar at any width (is-tight, set by the width guard in NavBar.js) */
.aq-nav.is-tight .aq-nav__links, .aq-nav.is-tight .aq-nav__service, .aq-nav.is-tight > .aq-nav__frame { display: none; }
.aq-nav.is-tight .aq-nav__spacer { display: block; flex: 1; }
.aq-nav.is-tight .aq-nav__toggle { display: inline-flex; }
.aq-nav.is-tight + .aq-menu {
  display: grid; gap: var(--space-6); padding: var(--space-2) var(--space-6) var(--space-8);
  background: var(--surface); border-bottom: 1px solid var(--line);
}

@container (max-width: 860px) {
  .aq-nav { height: 64px; padding: 0 var(--space-4); gap: var(--space-4); }
  .aq-nav .aq-nav__logo--lockup { width: 112px; }
  .aq-menu { padding-inline: var(--space-4); }
}

/* Pass 9b (NavBar/motion.js). The wide bar's sliding rule (sliding-tabs): one flow rule under the current section that
   slides to the link under the pointer or keyboard focus; 100 px wide, scaled to the link, so it moves on transforms.
   With it on (has-mark) the per-link rules stand down. Without motion the per-link rules above stay. */
/* The rule is placed against the bar (the items stay unpositioned for the panels): a line-height's half below the bar's
   middle, plus space-1, as the per-link rules sit */
.aq-nav__links > .aq-nav__mark { position: absolute; left: 0; top: calc(50% + 10px + var(--space-1)); width: 100px; height: 1px; background: var(--flow); transform-origin: 0 50%; opacity: 0; pointer-events: none; }
.aq-nav.has-mark .aq-nav__links > li > a::before, .aq-nav.has-mark .aq-nav__trigger::before { content: none; }
/* The toggle's mark: two bars that cross while the menu is open (curtain-index's toggle), beside the words */
.aq-nav__toggle { gap: var(--space-3); }
.aq-nav__burger { position: relative; display: inline-block; flex: none; width: 18px; height: 12px; }
.aq-nav__burger > i { position: absolute; left: 0; width: 100%; height: 1.5px; background: currentColor; transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.aq-nav__burger > i:first-child { top: 2.25px; }
.aq-nav__burger > i:last-child { top: 8.25px; }
.aq-nav__toggle[aria-expanded="true"] .aq-nav__burger > i:first-child { transform: translateY(3px) rotate(45deg); }
.aq-nav__toggle[aria-expanded="true"] .aq-nav__burger > i:last-child { transform: translateY(-3px) rotate(-45deg); }
@media (prefers-reduced-motion: reduce) { .aq-nav__burger > i { transition: none; } }
.aq-nav__toggle-t { white-space: nowrap; }

/* ---------- Mega panels (pass 12): one per section, full width under the bar ----------
   Not modal (no scrim) and not a landmark; it lives in its button's <li> and is placed against the bar. Above the
   SectionNav (5) and the look layers, below BackToTop (30). Tall panels scroll inside on short laptops. */
.aq-mega {
  position: absolute; top: 100%; left: 0; right: 0; z-index: 20;
  max-height: calc(100dvh - var(--mega-top, 72px)); overflow: auto; overscroll-behavior: contain;
  background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line-strong); box-shadow: var(--shadow-overlay);
  font: 400 16px/24px var(--font-sans); color: var(--ink); white-space: normal;
}
.aq-mega[hidden], .aq-mega__bg[hidden] { display: none; }
/* The shared backdrop that the switch between two open panels springs (NavBar/motion.js); hidden at rest */
.aq-mega__bg {
  position: absolute; top: 100%; left: 0; right: 0; z-index: 19; height: 0; pointer-events: none;
  background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line-strong); box-shadow: var(--shadow-overlay);
}
.aq-nav.is-morph .aq-mega { background: transparent; border-color: transparent; box-shadow: none; }
.aq-mega__in {
  display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-8); row-gap: var(--space-6);
  max-width: var(--content-max); margin-inline: auto; padding: var(--space-8);
}
.aq-mega__head { grid-column: 1 / 4; display: grid; align-content: start; gap: var(--space-2); }
.aq-mega__groups { grid-column: 4 / 10; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-8); row-gap: var(--space-6); align-content: start; }
.aq-mega__groups--n1 { grid-template-columns: minmax(0, 1fr); }
.aq-mega__groups--n1 ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-8); }
.aq-mega__groups--n3 { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-6); }
.aq-mega__in--nofeat .aq-mega__groups { grid-column: 4 / -1; }
/* The groups stand side by side in one row; their labels share one track, so a label that wraps to two lines moves
   every column's first link down together */
@supports (grid-template-rows: subgrid) {
  .aq-mega__groups:not(.aq-mega__groups--n1) { grid-template-rows: auto auto; }
  .aq-mega__groups:not(.aq-mega__groups--n1) > .aq-mega__group { grid-row: span 2; grid-template-rows: subgrid; row-gap: var(--space-2); }
}
.aq-mega__feat { grid-column: 10 / 13; align-self: start; }
.aq-mega__foot { grid-column: 1 / -1; }

/* Head: the section name (a label, not a heading), the lead line, the overview link */
.aq-mega__name, .aq-mega__label, .aq-mega__eyebrow {
  margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
.aq-mega__lead { margin: 0; font: 400 16px/24px var(--font-sans); color: var(--ink); max-width: 36ch; text-wrap: pretty; }
.aq-mega__all, .aq-mega__more { color: var(--ink); text-decoration: none; font: 500 14px/20px var(--font-sans); }
.aq-mega__all { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; justify-self: start; }
.aq-mega__all::after, .aq-mega__more::after, .aq-mega__task::after { content: "→"; content: "→" / ""; color: var(--flow); display: inline-block; transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.aq-mega__more::after, .aq-mega__task::after { margin-left: var(--space-1); }
.aq-mega__all:hover::after, .aq-mega__more:hover::after, .aq-mega__task:hover::after, .aq-mega__feat:hover .aq-mega__tail::after { transform: translateX(4px); }

/* Groups: a label, then links (title and one-line description), each block 44 px or more */
.aq-mega__group { display: grid; align-content: start; gap: var(--space-2); }
.aq-mega__group ul, .aq-mega__tasks ul { margin: 0; padding: 0; list-style: none; }
.aq-mega__link { display: block; min-height: 44px; padding-block: var(--space-2); color: var(--ink); text-decoration: none; }
.aq-mega__t {
  font: 500 16px/24px var(--font-sans); color: var(--ink);
  background: linear-gradient(var(--flow), var(--flow)) 0 100% / 0 1px no-repeat; transition: background-size 240ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-mega__link:hover .aq-mega__t, .aq-mega__link:focus-visible .aq-mega__t, .aq-mega__feat:hover .aq-mega__t, .aq-mega__feat:focus-visible .aq-mega__t { background-size: 100% 1px; }
.aq-mega__link[aria-current] .aq-mega__t::after { content: " →"; content: " →" / ""; color: var(--flow); }
.aq-mega__d { display: block; margin-top: var(--space-1); font: 400 14px/20px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

/* Featured card: a real destination (guide, note, audit route), on sunken with a hairline, plate corners */
.aq-mega__feat {
  display: grid; align-content: start; justify-items: start; gap: var(--space-2); padding: var(--space-6);
  background: var(--surface-sunken); border: 1px solid var(--line); border-radius: var(--radius-0); color: var(--ink); text-decoration: none;
}
.aq-mega__feat .aq-spot.aq-mega__icon { width: var(--space-12); height: var(--space-12); margin-bottom: var(--space-2); background-color: var(--flow); }
.aq-mega__feat .aq-mega__t { font: 400 20px/28px var(--font-sans); letter-spacing: -0.005em; text-wrap: balance; }
/* The title's last word and its arrow (aq-mega__tail) never part */
.aq-mega__tail { white-space: nowrap; }
.aq-mega__feat .aq-mega__tail::after { content: "→"; content: "→" / ""; display: inline-block; margin-left: var(--space-2); color: var(--flow); transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.aq-mega__feat .aq-mega__d { margin: 0; }

/* Foot line (the exclusions, said once) */
.aq-mega__foot { margin: 0; padding-top: var(--space-4); border-top: 1px solid var(--line); font: 400 14px/20px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
.aq-mega__more { font-weight: 500; white-space: nowrap; }

/* "I need to": the same row in every panel, a sunken band across the panel foot; hairline separators, no pills.
   Seven tasks never fit one line inside content-max, so they are set on purpose: a grid of four columns (4 + 3), the
   label on the first row's line, every column's hairline in line from row to row */
.aq-mega__tasks { background: var(--surface-sunken); border-top: 1px solid var(--line); }
.aq-mega__tasks-in {
  display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: start; column-gap: var(--space-6);
  max-width: var(--content-max); margin-inline: auto; padding: var(--space-3) var(--space-8);
}
/* A 16 px line centred in the 32 px task row */
.aq-mega__tasks .aq-mega__label { padding-block: var(--space-2); }
/* Every link carries a hairline on its left; the list is pulled left by one gap and clipped there, so the first column
   shows none */
.aq-mega__tasks ul {
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: var(--space-1);
  margin-left: calc(-1 * var(--space-3) - 1px); clip-path: inset(0 0 0 calc(var(--space-3) + 1px));
}
.aq-mega__tasks li { padding-inline: var(--space-3); border-left: 1px solid var(--line); }
/* space-1 of padding keeps the inset focus ring off the words and the arrow */
.aq-mega__task { display: inline-flex; align-items: center; min-height: 32px; padding-inline: var(--space-1); color: var(--ink); text-decoration: none; font: 400 14px/20px var(--font-sans); }
.aq-mega__task:focus-visible { outline-offset: -2px; }
.aq-mega__task:hover { text-decoration: underline; text-decoration-color: var(--flow); text-underline-offset: 4px; text-decoration-thickness: 1px; }

/* Below 1,240 px: the head becomes one line (name, lead, overview) above the groups and the featured card */
@container (max-width: 1239px) {
  .aq-mega__head { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-6); row-gap: 0; }
  .aq-mega__lead { max-width: none; }
  .aq-mega__groups { grid-column: 1 / 9; }
  .aq-mega__in--nofeat .aq-mega__groups { grid-column: 1 / -1; }
  .aq-mega__feat { grid-column: 9 / 13; }
}
@container (max-width: 1120px) {
  .aq-mega__in { padding: var(--space-6); column-gap: var(--space-6); }
  .aq-mega__tasks-in { padding-inline: var(--space-6); }
}
@media (prefers-reduced-motion: reduce) {
  .aq-mega__t, .aq-mega__all::after, .aq-mega__more::after, .aq-mega__task::after, .aq-mega__feat .aq-mega__tail::after { transition: none; }
}

/* ---------- Phone menu: the sections as an accordion (pass 12) ----------
   Section rows are buttons, 56 px, hairline rows, a plus that turns into a cross while open; depth stops at two
   (section, links): group labels are text. */
.aq-menu__sect {
  display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); width: 100%; min-height: 56px;
  margin: 0; padding: var(--space-3) 0; border: 0; border-bottom: 1px solid var(--line); background: none; cursor: pointer;
  color: var(--ink); font: 400 20px/28px var(--font-sans); letter-spacing: -0.005em; text-align: left;
}
.aq-menu__plus { position: relative; flex: none; width: 14px; height: 14px; transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.aq-menu__plus::before, .aq-menu__plus::after { content: ""; position: absolute; left: 0; top: 6.25px; width: 14px; height: 1.5px; background: currentColor; }
.aq-menu__plus::after { transform: rotate(90deg); }
.aq-menu__sect[aria-expanded="true"] .aq-menu__plus { transform: rotate(45deg); }
/* The sections list: rows are section buttons with their groups (and a plain link for a section without a panel) */
.aq-menu__list--sect > li { display: grid; }
.aq-menu__group[hidden] { display: none; }
.aq-menu__group-in { display: grid; gap: var(--space-4); padding: var(--space-2) 0 var(--space-6); border-bottom: 1px solid var(--line); }
.aq-menu__all { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; justify-self: start; color: var(--ink); text-decoration: none; font: 500 16px/24px var(--font-sans); }
.aq-menu__all::after, .aq-menu__feat .aq-menu__t::after { content: "→"; content: "→" / ""; color: var(--flow); }
.aq-menu__feat .aq-menu__t::after { margin-left: var(--space-2); }
.aq-menu__feat {
  display: grid; gap: var(--space-1); padding: var(--space-4); min-height: 44px;
  background: var(--surface-sunken); border: 1px solid var(--line); color: var(--ink); text-decoration: none;
}
.aq-menu__eyebrow, .aq-menu__glabel { margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-menu__feat .aq-menu__t { font: 500 16px/24px var(--font-sans); }
.aq-menu__d { font: 400 14px/20px var(--font-sans); color: var(--ink-muted); }
.aq-menu__ggrid { display: grid; gap: var(--space-4); }
.aq-menu__gg { display: grid; align-content: start; }
.aq-menu__gg ul, .aq-menu__tasks { display: grid; margin: 0; padding: 0; list-style: none; }
.aq-menu__link { display: flex; flex-direction: column; justify-content: center; min-height: 44px; padding-block: var(--space-2); color: var(--ink); text-decoration: none; }
.aq-menu__link .aq-menu__t { font: 400 16px/24px var(--font-sans); }
.aq-menu__link .aq-menu__d { display: none; }
.aq-menu__link[aria-current] .aq-menu__t::after { content: " →"; content: " →" / ""; color: var(--flow); }
.aq-menu__foot { margin: 0; font: 400 14px/20px var(--font-sans); color: var(--ink-muted); }
/* Inline in the foot sentence: the padding makes a 44 px target without opening the line spacing */
.aq-menu__more { padding-block: var(--space-4); color: var(--ink); font-weight: 500; text-decoration: none; white-space: nowrap; }
.aq-menu__more::after { content: "→"; content: "→" / ""; margin-left: var(--space-1); color: var(--flow); }
@container (min-width: 480px) { .aq-menu__link .aq-menu__d { display: block; } }
@container (min-width: 600px) { .aq-menu__ggrid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-8); } }
@media (prefers-reduced-motion: reduce) { .aq-menu__plus { transition: none; } }
