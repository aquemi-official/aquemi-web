/* ---------- CodeIndex: a short document set as a filing index (look "code-index") ----------
   Compact (default, pass 12 round C): each row is a 48 px outline tab chip carrying the filing code, the title and the
   status line beside it; wide: two columns filled down (--rows from the renderer, 4 + 3 for seven); phones: one row
   each. Key documents (.is-key) draw their chip in flow.
   Poster (.aq-code-index--poster, look-only "poster": true): the code as huge outline Geist Mono (text-stroke under a
   ground-coloured fill) cropped by the page edge, alternating sides (.is-r), the text beside it. ---------- */
.aq-section.aq-code-index-sec { overflow-x: clip; }
.aq-code-index { position: relative; }
.aq-code-index__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
.aq-code-index__t { margin: 0; font: 400 20px/26px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); text-wrap: balance; }
.aq-code-index__t a { color: inherit; text-decoration: none; }
.aq-code-index__t a::after { content: "\a0\2192"; color: var(--flow); }
.aq-code-index__t a:hover { color: var(--flow); }
.aq-code-index__t a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-code-index__d { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
.aq-code-index__more { margin: var(--space-8) 0 0; }

/* Compact rows */
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__list {
  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(var(--rows, 4), auto); grid-auto-flow: column; column-gap: var(--space-12);
  border-top: 0;
}
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__row {
  display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr); column-gap: var(--space-4); align-items: start;
  padding: var(--space-4) 0 var(--space-6); border-top: 1px solid var(--line-strong);
}
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__code {
  display: grid; place-items: center; box-sizing: border-box; width: var(--space-12); height: var(--space-12); padding: 0 2px;
  border: 1.5px solid var(--line-strong); border-radius: var(--radius-sm); background: var(--surface);
  font: 500 12px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink); white-space: nowrap; user-select: none;
  transition: background-color 200ms, color 200ms, border-color 200ms;
}
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__row.is-key .aq-code-index__code { border-color: var(--flow); color: var(--flow); }
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__row:hover .aq-code-index__code { background: var(--surface-sunken); }
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__row.is-key:hover .aq-code-index__code { background: var(--flow-tint); }
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__text { min-width: 0; display: flex; flex-direction: column; gap: var(--space-1); }
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__n { font: 400 12px/16px var(--font-mono); letter-spacing: 0.06em; color: var(--ink-subtle); }
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__row.is-key .aq-code-index__n { color: var(--flow); }
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__nc { display: none; }
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__list > :last-child,
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__row.is-colend { border-bottom: 1px solid var(--line-strong); }
/* folded (fold set, not yet opened): the columns hold the shown rows only, so column 1 ends earlier (--rows-f) */
.aq-code-index:not(.aq-code-index--poster) .aq-fold:not(.is-open) > .aq-code-index__list { --rows: var(--rows-f, 4); }
.aq-code-index:not(.aq-code-index--poster) .aq-fold:not(.is-open) .aq-code-index__row.is-colend { border-bottom: 0; }
.aq-code-index:not(.aq-code-index--poster) .aq-fold:not(.is-open) .aq-code-index__row.is-colend-f,
.aq-code-index:not(.aq-code-index--poster) .aq-fold:not(.is-open) .aq-code-index__row.is-end-f { border-bottom: 1px solid var(--line-strong); }
@container (max-width: 860px) {
  .aq-code-index:not(.aq-code-index--poster) .aq-code-index__list { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; grid-auto-flow: row; }
  .aq-code-index:not(.aq-code-index--poster) .aq-code-index__row { padding: var(--space-3) 0; column-gap: var(--space-3); }
  .aq-code-index__d { font-size: var(--aq-read-phone, 14px); line-height: 20px; }
  .aq-code-index:not(.aq-code-index--poster) .aq-code-index__row.is-colend:not(:last-child),
  .aq-code-index:not(.aq-code-index--poster) .aq-fold:not(.is-open) .aq-code-index__row.is-colend-f:not(.is-end-f) { border-bottom: 0; }
  .aq-code-index:not(.aq-code-index--poster) .aq-code-index__n { display: none; }
  .aq-code-index__t { font-size: 17px; line-height: 23px; }
}

/* Poster (look-only "poster": true): the pre-round-C huge outline codes */
.aq-code-index--poster .aq-code-index__row {
  position: relative; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; column-gap: var(--space-8);
  min-height: var(--space-32); padding: var(--space-6) 0; border-bottom: 1px solid var(--line-strong);
}
.aq-code-index--poster .aq-code-index__code {
  font: 300 208px/0.9 var(--font-mono); letter-spacing: -0.07em; white-space: nowrap;
  /* the stroke is painted under a ground-coloured fill: only its outer half shows, so the variable font's overlapping
     contours (inside N, Q, R) stay hidden; 3 px reads as a 1.5 px outline */
  color: var(--surface); -webkit-text-stroke: 3px var(--line-strong); paint-order: stroke fill; margin-left: calc(-1 * var(--space-8)); transition: color 300ms cubic-bezier(0.2, 0, 0, 1);
  user-select: none;
}
.aq-code-index--poster .aq-code-index__row.is-key .aq-code-index__code { -webkit-text-stroke-color: var(--flow); }
.aq-code-index--poster .aq-code-index__row.is-r { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); }
.aq-code-index--poster .aq-code-index__row.is-r .aq-code-index__code { order: 2; justify-self: end; margin-left: 0; margin-right: calc(-1 * var(--space-8)); }
.aq-code-index--poster .aq-code-index__row:hover .aq-code-index__code { color: var(--surface-sunken); }
.aq-code-index--poster .aq-code-index__row.is-key:hover .aq-code-index__code { color: var(--flow-tint); }
.aq-code-index--poster .aq-code-index__text { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--space-2); max-width: 46ch; }
.aq-code-index--poster .aq-code-index__n { font: 400 13px/16px var(--font-mono); letter-spacing: 0.06em; color: var(--ink-subtle); }
.aq-code-index--poster .aq-code-index__row.is-key .aq-code-index__n { color: var(--flow); }
.aq-code-index--poster .aq-code-index__t { font-size: 28px; line-height: 34px; letter-spacing: -0.015em; }
.aq-code-index--poster .aq-code-index__d { font-size: 16px; line-height: 25px; }
@container (max-width: 1100px) {
  .aq-code-index--poster .aq-code-index__code { font-size: 140px; margin-left: calc(-1 * var(--space-4)); }
  .aq-code-index--poster .aq-code-index__row.is-r .aq-code-index__code { margin-right: calc(-1 * var(--space-4)); }
}
@container (max-width: 860px) {
  .aq-code-index--poster .aq-code-index__row, .aq-code-index--poster .aq-code-index__row.is-r { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-2); min-height: 0; padding: var(--space-4) 0 var(--space-8); }
  .aq-code-index--poster .aq-code-index__code, .aq-code-index--poster .aq-code-index__row.is-r .aq-code-index__code { order: 0; justify-self: start; font-size: 76px; margin: 0 0 0 calc(-1 * var(--space-1)); }
  .aq-code-index--poster .aq-code-index__row.is-r .aq-code-index__code { justify-self: end; margin: 0 calc(-1 * var(--space-1)) 0 0; }
  .aq-code-index--poster .aq-code-index__t { font-size: 22px; line-height: 28px; }
}
/* compact: a linked title stretches its hit area over the whole row (at least 48 px tall: the chip) */
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__row { position: relative; }
.aq-code-index:not(.aq-code-index--poster) .aq-code-index__t a::before { content: ""; position: absolute; inset: 0; }
