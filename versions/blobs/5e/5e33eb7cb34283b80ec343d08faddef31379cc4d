.aq-note-sheet__fig svg { display: block; width: 72%; max-width: 260px; height: auto; }
.aq-note-sheet__spot { width: 160px; height: 160px; }
.aq-note-sheet__sk { display: flex; gap: var(--space-3); margin: auto 0 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-note-sheet__sn { color: var(--flow); }
