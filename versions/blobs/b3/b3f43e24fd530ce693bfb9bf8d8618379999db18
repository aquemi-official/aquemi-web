/* ---------- CoverageMap: one column per region beside an instrument readout (look coverage-map, pass 9b) ----------
   Desktop: three cells to a row on hairline columns; the readout (limestone survey sheet, data-theme light) takes the top
   right cell: the region in hand, its severity 1 on-site time as the large figure, the seal stamp, the tile map with its
   tiles lit. Phones: the tile map is the province picker, and only the chosen region's column shows under it. */
.aq-coverage-map { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-8); row-gap: var(--space-12);
  border-top: 1px solid var(--line-strong); padding-top: var(--space-8); }

/* A region column */
.aq-coverage-map__col { position: relative; display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; padding-left: var(--space-6); border-left: 1px solid var(--line); }
.aq-coverage-map__col::before { content: ""; position: absolute; left: -1px; top: 0; bottom: 0; border-left: 2px solid var(--flow); transform: scaleY(0); transform-origin: center top; }
.aq-coverage-map__col.is-on::before { transform: scaleY(1); }
.aq-coverage-map__i { margin: 0; align-self: flex-end; font: 400 13px/20px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink-muted); }
.aq-coverage-map__col.is-on .aq-coverage-map__i { color: var(--flow); }
.aq-coverage-map__t { margin: calc(-1 * var(--space-3)) 0 0; font: 300 32px/38px var(--font-sans); letter-spacing: -0.02em; color: var(--ink); }
.aq-coverage-map__pick { display: inline-block; min-height: 44px; margin: 0; padding: var(--space-1) 0; border: 0; background: none; color: inherit; font: inherit; letter-spacing: inherit; text-align: left; text-wrap: balance; cursor: pointer;
  text-decoration: underline 1px transparent; text-underline-offset: 6px; }
.aq-coverage-map__pick:hover, .aq-coverage-map__pick[aria-pressed="true"] { text-decoration-color: var(--flow); }
.aq-coverage-map__pick:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-coverage-map__codes { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-1); }
.aq-coverage-map__codes span { padding: 0 var(--space-1); border: 1px solid var(--line-strong); font: 400 12px/18px var(--font-mono); color: var(--ink-muted); }
.aq-coverage-map__dl { margin: var(--space-2) 0 0; display: flex; flex-direction: column; }
.aq-coverage-map__dl > div { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--space-1); padding-block: var(--space-3); border-top: 1px solid var(--line); }
.aq-coverage-map__dl dt { font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
.aq-coverage-map__dl dd { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--ink); overflow-wrap: break-word; }
.aq-coverage-map__dl > div:first-child dd { font-family: var(--font-mono); font-size: 14px; }

/* The readout: a limestone survey sheet in the top right cell */
.aq-coverage-map__now { position: relative; grid-column: 3; grid-row: 1; display: flex; flex-direction: column; gap: var(--space-6); min-width: 0; align-self: start;
  margin-top: calc(-1 * var(--space-8) - 1px); padding: var(--space-6); border-top: 3px solid var(--line-strong); background: var(--limestone); color: var(--on-limestone); }
.aq-coverage-map__now::before { content: ""; position: absolute; inset: var(--space-2); top: var(--space-1); border: 1px solid color-mix(in srgb, var(--on-limestone-muted) 30%, transparent); pointer-events: none; }
.aq-coverage-map__faces { position: relative; display: grid; }
.aq-coverage-map__nv { grid-area: 1 / 1; display: none; flex-direction: column; gap: var(--space-3); min-width: 0; }
.aq-coverage-map__nv.is-on { display: flex; }
.aq-coverage-map__nh { margin: 0; display: flex; flex-direction: column; gap: var(--space-1); padding-bottom: var(--space-3); border-bottom: 1px solid color-mix(in srgb, var(--on-limestone-muted) 35%, transparent); }
.aq-coverage-map__ni { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; font-variant-numeric: tabular-nums; color: var(--on-limestone-muted); }
.aq-coverage-map__nt { font: 300 28px/32px var(--font-sans); letter-spacing: -0.02em; color: var(--on-limestone); text-wrap: balance; }
.aq-coverage-map__nb { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--space-4); align-items: center; }
/* the large readout figure: a real time sets at 72 px mono light; a placeholder keeps its chip, larger */
.aq-coverage-map__big { margin: 0; font: 300 72px/1 var(--font-mono); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; color: var(--flow); overflow-wrap: break-word; }
.aq-coverage-map__big:has(> .aq-ph) { font-size: 18px; line-height: 30px; letter-spacing: 0; }
.aq-coverage-map__big .aq-ph { font-size: 18px; letter-spacing: 0; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
/* the seal stamp: a double ring, the CRN body over the seal */
.aq-coverage-map__stamp { position: relative; margin: 0; width: calc(var(--space-24) + var(--space-4)); aspect-ratio: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: var(--space-1);
  border: 1.5px solid var(--on-limestone-muted); border-radius: 50%; text-align: center; }
.aq-coverage-map__stamp::before { content: ""; position: absolute; inset: var(--space-1); border: 1px solid color-mix(in srgb, var(--on-limestone-muted) 60%, transparent); border-radius: 50%; }
.aq-coverage-map__stamp > span { display: flex; flex-direction: column; max-width: 76%; }
.aq-coverage-map__stamp > span + span { padding-top: var(--space-1); border-top: 1px solid color-mix(in srgb, var(--on-limestone-muted) 45%, transparent); }
.aq-coverage-map__sk { font: 500 12px/14px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-coverage-map__sv { font: 500 13px/16px var(--font-mono); letter-spacing: 0.02em; color: var(--on-limestone); overflow-wrap: anywhere; }
.aq-coverage-map__nl { margin: 0; display: flex; flex-direction: column; gap: var(--space-1); font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-coverage-map__nl > span { font: 400 15px/22px var(--font-sans); letter-spacing: 0; text-transform: none; color: var(--on-limestone); }

/* the mono parts of a face that decode when it comes on (motion.js) */
.aq-coverage-map__sc { font-variant-numeric: tabular-nums; }

/* The tile map under the readout */
.aq-coverage-map__grid { position: relative; display: grid; grid-template-columns: repeat(var(--cols, 7), minmax(0, 1fr)); grid-template-rows: repeat(var(--rows, 4), auto); gap: var(--space-1); }
.aq-coverage-map__tile { position: relative; aspect-ratio: 1; min-width: 0; display: flex; align-items: flex-start; margin: 0; padding: var(--space-1); border: 1.5px solid var(--on-limestone-muted); border-radius: 0; background: var(--surface-raised); color: var(--on-limestone); font: inherit; text-align: left; cursor: pointer; -webkit-appearance: none; appearance: none; }
.aq-coverage-map__tile.is-none { border-style: dashed; }
.aq-coverage-map__tile:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; z-index: 1; }
/* a tile without a row of its own, picked (it puts its named row, or the row for the rest, on the readout) */
.aq-coverage-map__tile.is-pick.is-none { background: var(--flow-tint); border-color: var(--flow); }
.aq-coverage-map__code { font: 400 12px/14px var(--font-mono); letter-spacing: 0.02em; }
.aq-coverage-map__tile.is-on { background: var(--flow); border-color: var(--flow); color: var(--on-navy); }
.aq-coverage-map__tile.is-home { border-width: 3px; border-color: var(--navy); }
.aq-coverage-map__tile.is-home::after { content: ""; position: absolute; left: var(--space-1); bottom: var(--space-1); width: var(--space-2); height: var(--space-2); background: var(--navy); }
.aq-coverage-map__tile.is-home.is-on::after { background: var(--on-navy); }
.aq-coverage-map__base { position: relative; margin: 0; display: flex; align-items: center; gap: var(--space-3); font: 400 15px/22px var(--font-sans); color: var(--on-limestone); }
.aq-coverage-map__chips { display: none; }
.aq-coverage-map__say { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }
.aq-coverage-map__pin { width: var(--space-4); height: var(--space-4); border: 3px solid var(--navy); position: relative; }
.aq-coverage-map__pin::after { content: ""; position: absolute; inset: 2px; background: var(--navy); }

@media (prefers-reduced-motion: no-preference) {
  .aq-coverage-map__tile { transition: background-color 240ms, border-color 240ms, color 240ms; }
  .aq-coverage-map__col::before { transition: transform 400ms cubic-bezier(0.2, 0, 0, 1); }
  .aq-coverage-map__pick { transition: text-decoration-color 160ms; }
}

/* Phones (pass 12, S11/S14): the tile map is the province picker. The readout sheet carries the map (one frame, no
   inner hairline) and the stamp when the region has one; the region's figure and name are not repeated there, because
   only the chosen region's column shows, straight under the sheet. Tiles are 44 px. */
@container (max-width: 860px) {
  .aq-coverage-map { grid-template-columns: minmax(0, 1fr); row-gap: 0; padding-top: 0; border-top: 0; }
  .aq-coverage-map__now { grid-column: 1; grid-row: auto; order: -1; margin-top: 0; padding: var(--space-4) var(--space-2) var(--space-3); gap: var(--space-3); }
  .aq-coverage-map__now::before { display: none; }
  .aq-coverage-map__nh, .aq-coverage-map__big, .aq-coverage-map__nl { display: none; }
  .aq-coverage-map__faces:not(:has(.aq-coverage-map__stamp)) { display: none; }
  .aq-coverage-map__nb { grid-template-columns: minmax(0, 1fr); justify-items: end; }
  .aq-coverage-map__grid { gap: 2px; width: 100%; max-width: 26rem; }
  .aq-coverage-map__tile { min-height: 44px; }
  .aq-coverage-map__tile.is-none[data-named] { border-style: solid; }
  /* the regions as chips under the map: the same choice as a tile, named */
  .aq-coverage-map__chips { display: flex; flex-wrap: wrap; gap: var(--space-1); padding-inline: var(--space-2); }
  .aq-coverage-map__chip { min-height: 44px; margin: 0; padding: var(--space-1) var(--space-2); border: 1.5px solid var(--on-limestone-muted); border-radius: 0; background: var(--surface-raised);
    color: var(--on-limestone); font: 400 14px/20px var(--font-sans); text-align: left; cursor: pointer; -webkit-appearance: none; appearance: none; }
  .aq-coverage-map__chip[aria-pressed="true"] { background: var(--flow); border-color: var(--flow); color: var(--on-navy); }
  .aq-coverage-map__chip:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .aq-coverage-map__code { font-size: 13px; }
  .aq-coverage-map__base { padding-inline: var(--space-2); font-size: 15px; }
  .aq-coverage-map__col:not(.is-on) { display: none; }
  .aq-coverage-map__col { padding: var(--space-4) 0 0 var(--space-4); }
  .aq-coverage-map__i { position: absolute; right: 0; top: var(--space-4); }
  .aq-coverage-map__t { margin: 0; padding-right: var(--space-12); font-size: 26px; line-height: 32px; }
  .aq-coverage-map__pick { cursor: default; text-decoration: none; }
  .aq-coverage-map__dl { margin-top: 0; }
  .aq-coverage-map__dl dd, .aq-coverage-map__dl > div:first-child dd { font-size: 15px; }
  .aq-coverage-map__dl .aq-ph { font-size: var(--aq-read-phone, 14px); }
}
.aq-coverage-map-sec { overflow: visible; }

/* Survey sheet (pass 9b): FxContour draws the terrain's contour lines in on-limestone under the readout, faint (index
   contours at 12 %, the rest at 7 %), masked off the top half where the region, the figure and the stamp sit. */
.aq-coverage-map__now > .aq-fx-shader { --fx-amt: 0.12;
  -webkit-mask-image: linear-gradient(to bottom, transparent 40%, var(--ink) 70%); mask-image: linear-gradient(to bottom, transparent 40%, var(--ink) 70%); }
