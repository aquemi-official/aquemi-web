  .aq-standards-orbit[data-pk-on] .aq-standards-orbit__pan { height: 100%; aspect-ratio: var(--so-pw, 4) / var(--so-ch, 3); }
  .aq-standards-orbit[data-pk-on] .aq-standards-orbit__layer { position: absolute; left: 0; width: 100%; top: calc(var(--so-cy, 0) / var(--so-ch, 3) * -100%); height: calc(var(--so-ph, 3) / var(--so-ch, 3) * 100%); }
  .aq-standards-orbit[data-pk-on] .aq-standards-orbit__svg { width: 100%; height: 100%; }
  /* the pins keep their 24 px size whatever the zoom */
  .aq-standards-orbit[data-pk-on] .aq-standards-orbit__pin { transform: translate(-50%, -50%) scale(calc(1 / var(--pk-s, 1))); }
  .aq-standards-orbit[data-pk-on] .aq-standards-orbit__pin.is-pk-active { transform: translate(-50%, -50%) scale(calc(1.15 / var(--pk-s, 1))); }
