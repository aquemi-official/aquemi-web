  .aq-note-sheet__fig svg { width: auto; max-width: 100%; height: 100%; }
  .aq-note-sheet__spot { width: 120px; height: 120px; }
  .aq-note-sheet__sk { margin-top: var(--space-1); }
  .aq-note-sheet__q { display: none; }
  .aq-note-sheet__st { font-size: 18px; line-height: 25px; }
