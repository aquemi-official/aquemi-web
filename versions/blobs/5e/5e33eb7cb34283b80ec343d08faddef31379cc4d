  .aq-standards-orbit__codes > li { display: flex; min-width: 0; }
  .aq-standards-orbit__code { flex: 1; min-height: var(--aq-hit, 44px); padding: var(--space-1) var(--space-2) var(--space-1) var(--space-3); justify-content: space-between; white-space: normal; font-size: 13px; line-height: 17px; }
  .aq-standards-orbit__code::before { inset: 0; }
}
/* tablets (600-860 px): the large figure stays (no strip, data-pk-bp 599), the 44 px chips wrap at their own width */
@container (min-width: 600px) and (max-width: 860px) {
  .aq-standards-orbit__codes { display: flex; flex-wrap: wrap; width: auto; }
