/* Readout: bottom right of the dial on its hairline (y 146 in the viewBox): the number above it, the caption below it.
   The caption is the value's qualifiers (is-q, may wrap) or Upper/Lower limit. */
.aq-limit-gauges__read { position: relative; display: block; margin-top: calc(-1 * var(--space-2)); text-align: right; color: var(--ink); }
.aq-limit-gauges__line { position: absolute; right: 0; bottom: 100%; padding-bottom: var(--space-1); white-space: nowrap; }
.aq-limit-gauges__num { font: 300 24px/28px var(--font-mono); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; white-space: nowrap; }
.aq-limit-gauges__unit { font: 400 12px/16px var(--font-mono); color: var(--ink-muted); }
.aq-limit-gauges__cap { display: block; padding-top: var(--space-1); white-space: nowrap; font: 400 12px/16px var(--font-sans); color: var(--ink-muted); }
.aq-limit-gauges__cap.is-q { white-space: normal; font: 400 12px/16px var(--font-mono); overflow-wrap: break-word; }

/* Foot: the basis under a hairline */
.aq-limit-gauges__foot { margin-top: auto; padding-top: var(--space-2); border-top: 1px solid var(--line); }
.aq-limit-gauges__spec { margin: 0; display: grid; gap: var(--space-1); }
.aq-limit-gauges__spec > div { position: relative; }
