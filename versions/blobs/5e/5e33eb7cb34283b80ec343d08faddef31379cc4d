/* ---------- SpecTable ---------- */
/* Shared: caption, header labels, cell type (the brand SpecTable). */
.aq-spec { width: 100%; border-collapse: collapse; background: var(--surface-raised); font-family: var(--font-sans); color: var(--ink); }
.aq-spec caption { text-align: left; padding-bottom: var(--space-3); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
