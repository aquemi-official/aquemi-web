@container (max-width: 860px) {
  /* Phone: two compact instruments per row (dial about 135-150 px). No scale numbers (at a legible 12 px they collide
     with the arc; the label and readout carry the value); every label at 12 px minimum; the label drops its "Limit"
     word; the readout moves under the dial; the basis keeps only its standard tags (the wording between them is hidden). */
  .aq-limit-gauges, .aq-limit-gauges:has(> li:nth-child(2):last-child), .aq-limit-gauges:has(> li:nth-child(4):last-child), .aq-limit-gauges:has(> li:nth-child(7):last-child), .aq-limit-gauges:has(> li:nth-child(8):last-child) { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-4); }
  .aq-limit-gauges__item { padding-top: var(--space-3); gap: var(--space-2); }
