/* ---------- RoleLoop: the roles as bays of one twin-wall pipe loop on the navy band, a valve on each role's branch ---------- */
.aq-role-loop-sec { }
.aq-role-loop { position: relative; margin-top: var(--space-8); padding: var(--space-12) var(--space-12) var(--space-16); }
.aq-role-loop__pipe { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
.aq-role-loop:not(.is-laid) .aq-role-loop__pipe { display: none; }
.aq-role-loop__pipe path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
/* twin wall: a wide stroke in the line colour, the bore in the band's navy over it, the water down the middle */
.aq-role-loop__wall { stroke: color-mix(in srgb, var(--on-navy) 62%, transparent); stroke-width: 11px; }
.aq-role-loop__bore { stroke: var(--navy); stroke-width: 8px; }
.aq-role-loop__water { stroke: var(--flow); stroke-width: 3px; }
/* a role's bay of the loop, lit while the role is pointed at */
.aq-role-loop__seg { stroke: var(--flow); stroke-width: 6px; stroke-opacity: 0; transition: stroke-opacity 120ms; }
.aq-role-loop__seg.is-lit { stroke-opacity: 1; transition-duration: 180ms; }
.aq-role-loop__sw { stroke: color-mix(in srgb, var(--on-navy) 62%, transparent); stroke-width: 9px; }
.aq-role-loop__sb { stroke: var(--navy); stroke-width: 6px; }
.aq-role-loop__sq { stroke: var(--flow); stroke-width: 3px; }
.aq-role-loop__vb { fill: var(--navy); stroke: var(--on-navy); stroke-width: 1.5px; }
.aq-role-loop__vs { stroke: var(--on-navy); stroke-width: 1.5px; }
/* closed: a filled body; status not given: dashed, and no water enters the branch */
.aq-role-loop__stub.is-closed .aq-role-loop__vb { fill: var(--on-navy); }
.aq-role-loop__stub.is-unset .aq-role-loop__sw { stroke-dasharray: 3 3; stroke-linecap: butt; }
.aq-role-loop__stub.is-unset .aq-role-loop__vb, .aq-role-loop__stub.is-unset .aq-role-loop__vs { stroke: var(--on-navy-muted); stroke-dasharray: 2.5 2; }
.aq-role-loop__stub.is-unset .aq-role-loop__sq { display: none; }
.aq-role-loop__stub.is-lit .aq-role-loop__vb, .aq-role-loop__stub.is-lit .aq-role-loop__vs { stroke: var(--flow); }

.aq-role-loop__bays { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-16); row-gap: var(--space-24); }
.aq-role-loop__bay { min-width: 0; display: flex; flex-direction: column; gap: var(--space-3); }
.aq-role-loop .aq-role-loop__no { margin: 0; padding: 0 0 var(--space-2) var(--space-12); border-bottom: 1px solid color-mix(in srgb, var(--on-navy) 30%, transparent);
  font: 400 12px/16px var(--font-mono); letter-spacing: 0.04em; color: var(--on-navy-muted); font-variant-numeric: tabular-nums; transition: border-color 180ms; }
.aq-role-loop__no span { color: var(--on-navy); transition: color 180ms; }
.aq-role-loop__bay.is-lit .aq-role-loop__no { border-color: var(--flow); }
.aq-role-loop__t { margin: 0; font: 300 26px/32px var(--font-sans); letter-spacing: -0.015em; color: var(--on-navy); }
.aq-role-loop .aq-role-loop__st { margin: 0; display: flex; align-items: flex-start; gap: var(--space-2); font: 400 12px/18px var(--font-mono); color: var(--on-navy); }
.aq-role-loop__vk { flex: none; width: var(--space-6); height: var(--space-4); margin-top: 1px; }
.aq-role-loop__vk path { fill: none; stroke: var(--on-navy); stroke-width: 1.5px; stroke-linejoin: round; }
.aq-role-loop__st.is-closed .aq-role-loop__vk path:first-child { fill: var(--on-navy); }
.aq-role-loop__st.is-unset .aq-role-loop__vk path { stroke: var(--on-navy); stroke-dasharray: 2.5 2; }
.aq-role-loop__dl { margin: var(--space-2) 0 0; display: flex; flex-direction: column; gap: var(--space-3); }
.aq-role-loop__f { display: flex; flex-direction: column; gap: var(--space-1); }
.aq-role-loop__f dt { font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
.aq-role-loop__f dd { margin: 0; font: 400 15px/23px var(--font-sans); color: var(--on-navy); overflow-wrap: anywhere; }
/* before the water reaches a bay (motion only) */
.aq-role-loop.is-pre .aq-role-loop__bay { opacity: 0; }
.aq-role-loop.is-pre .aq-role-loop__pipe { visibility: hidden; }

@container (max-width: 1100px) {
  .aq-role-loop { padding-inline: var(--space-8); }
  .aq-role-loop__bays { column-gap: var(--space-12); }
  .aq-role-loop__t { font-size: 22px; line-height: 28px; }
}
/* Phone-only parts (heads, legend): out of the desktop render */
.aq-role-loop__ph, .aq-role-loop__legend { display: none; }
.aq-role-loop__body { display: contents; }
.aq-role-loop__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* Phones (pass 12, S11/S12/S14): collapsed role rows (PhoneKit accordion). The loop is one supply-and-return pair
   down the left; each row's head: number line (branch and valve), the role, the status, base and pay one line each;
   the legend over the list names base and pay once. Tap opens what you do and what you must have. */
@container (max-width: 860px) {
  .aq-role-loop { margin-top: var(--space-4); padding: var(--space-4) 0 var(--space-4) var(--space-12); }
  .aq-role-loop__bays { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) { padding-left: calc(var(--space-8) + var(--space-2)); }
  .aq-role-loop__bays[data-pk-on] { row-gap: 0; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__wall { stroke-width: 7px; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__bore { stroke-width: 4px; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__water { stroke-width: 2px; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__sw { stroke-width: 7px; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__sb { stroke-width: 4px; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__sq { stroke-width: 2px; }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__no { display: none; }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__bay { border-top: 1px solid color-mix(in srgb, var(--on-navy) 30%, transparent); }
  .aq-role-loop__f dd { font-size: 15px; line-height: 22px; }
  .aq-role-loop .aq-role-loop__no { padding-left: var(--space-12); }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__bay { gap: 0; }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__ph { display: block; margin: 0; font: inherit; }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__hd { display: grid; grid-template-columns: minmax(0, 1fr) 44px; column-gap: var(--space-2); row-gap: var(--space-1);
    align-items: start; padding: var(--space-2) 0 var(--space-4) var(--space-2); color: var(--on-navy); }
  .aq-role-loop__ht { grid-column: 1; font: 300 22px/28px var(--font-sans); letter-spacing: -0.015em; }
  .aq-role-loop__hd .aq-phone-kit__chev { grid-column: 2; grid-row: 1 / span 2; margin: -8px 0 0; }
  .aq-role-loop__hd > .aq-role-loop__st, .aq-role-loop__hd > .aq-role-loop__hl { grid-column: 1 / -1; }
  .aq-role-loop .aq-role-loop__hd > .aq-role-loop__st { grid-column: 1; font-size: 14px; line-height: 20px; }
  .aq-role-loop__hl { position: relative; display: block; padding-left: var(--space-4); font: 400 14px/21px var(--font-sans); color: var(--on-navy); }
  .aq-role-loop__hl .aq-ph { font-size: var(--aq-chip-phone, 13px); }
  /* the two markers: base a ring (a place), pay a filled square */
  .aq-role-loop__hl::before { content: ""; position: absolute; left: 0; top: 6px; width: 9px; height: 9px; box-sizing: border-box; border: 1.5px solid var(--flow); border-radius: 50%; }
  .aq-role-loop__hl.is-pay::before { border-radius: 0; background: var(--flow); }
  .aq-role-loop__bays[data-pk-on] ~ .aq-role-loop__legend, .aq-role-loop__legend:has(+ .aq-role-loop__bays[data-pk-on]) {
    display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-6); margin: 0 0 var(--space-4); }
  .aq-role-loop__legend .aq-role-loop__hl { font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
  .aq-role-loop__legend .aq-role-loop__hl::before { top: 3px; }
  /* pass 12 round C: the head is the role and its status only; base and pay read in the body with the other fields */
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__hd > .aq-role-loop__hl { display: none; }
  .aq-role-loop:has(.aq-role-loop__bays[data-pk-on]) .aq-role-loop__legend { display: none; }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__ht .aq-ph { font-family: var(--font-mono); font-size: 20px; line-height: 26px; letter-spacing: 0; }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__hd { padding-bottom: var(--space-3); }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__dl { margin: 0; padding: var(--space-1) 0 var(--space-3); }
  .aq-role-loop__bays[data-pk-on] .aq-role-loop__bay:has(> .aq-role-loop__body:not([hidden])) { border-color: var(--flow); }
}
