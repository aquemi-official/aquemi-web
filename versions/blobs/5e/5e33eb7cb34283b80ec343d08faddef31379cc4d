/* ---------- Rule variant (spec as: "rules", blocks/rules.js) ----------
   Design rules on the same plate: one row per rule between line hairlines: mono index | rule name | the threshold bar
   with the rule as written under it | basis. The bar: a line-strong track, the passing side as a flow line on it
   (right of the mark for ≥, left for ≤), an ink mark with its value label above it (kept inside the bar: left --f,
   shifted back by --f of its own width), scale ends in mono when the threshold is a number. An open bar (placeholder
   threshold) has no scale numbers. A rule without a threshold shows its value between hairlines in the same column. */
.aq-limit-gauges--rules { display: block; border-bottom: 1px solid var(--line); }
.aq-limit-gauges__rule {
  position: relative; display: grid; grid-template-columns: var(--space-12) minmax(0, 4fr) minmax(0, 6fr) minmax(0, 3fr);
  column-gap: var(--space-6); align-items: start; padding: var(--space-6) 0; border-top: 1px solid var(--line);
}
