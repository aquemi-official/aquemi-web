/* ---------- OnboardingFan: an onboarding folder fanned open, one tabbed paper per item (look "onboarding-fan") ----------
   Wide: a limestone folder (back panel with its tab, and a front lip) holds one fan of papers. Each paper leans by
   its offset from the middle (--o, 2.4 deg a step) about its bottom centre, its tab cut at its own
   place along the top edge (--t, 0 at the left paper to 1 at the right). Key items (.is-key) edge their tab in flow.
   A paper lifts out of the folder when pointed at or focused. Containers of 1,100 px and under: two fans (4 + 3),
   leaning by --o2. Phones (640 and under): compact rows inside the folder (tab chip, title, what the paper is, the
   stamp), under a small fan of tab tops. Papers and the folder are data-paper objects: paper stays paper in dark. ---------- */
.aq-section.aq-onboarding-fan-sec { overflow-x: clip; }
.aq-onboarding-fan { --of-tab: 30px; --of-lip: 76px; position: relative; padding-top: calc(var(--of-tab, 30px) + var(--space-6)); }
.aq-onboarding-fan__crown { display: none; }

/* the folder: back panel with its tab, front lip (wide: the tab stands in the 80 px gutter left of the fan) */
.aq-onboarding-fan__back {
  position: absolute; left: 0; right: 0; top: 34%; bottom: 0; z-index: 0;
  background: var(--limestone); border: 1.5px solid var(--line-strong); border-radius: var(--radius-sm) var(--radius-md) var(--radius-md) var(--radius-md);
}
.aq-onboarding-fan__back::before {
  content: ""; position: absolute; left: -1.5px; bottom: 100%; width: var(--space-8); height: var(--space-6);
  background: var(--limestone); border: 1.5px solid var(--line-strong); border-bottom: 0; border-radius: var(--radius-md) var(--radius-md) 0 0;
  margin-bottom: -1.5px; clip-path: polygon(0 0, 88% 0, 100% 100%, 0 100%);
}
.aq-onboarding-fan__front {
  position: absolute; left: 0; right: 0; bottom: 0; height: var(--of-lip, 76px); z-index: 2; pointer-events: none;
  background: var(--limestone); border: 1.5px solid var(--line-strong); border-radius: 0 0 var(--radius-md) var(--radius-md);
  -webkit-mask: radial-gradient(circle at 50% 0, transparent calc(var(--space-6) - 2px), black calc(var(--space-6) - 1.5px));
  mask: radial-gradient(circle at 50% 0, transparent calc(var(--space-6) - 2px), black calc(var(--space-6) - 1.5px));
}
/* the thumb cut in the folder's front: the papers show through it */
.aq-onboarding-fan__front::after {
  content: ""; position: absolute; top: -1.5px; left: 50%; width: var(--space-12); height: var(--space-6); box-sizing: border-box; transform: translateX(-50%);
  border: 1.5px solid var(--line-strong); border-top: 0; border-radius: 0 0 var(--space-6) var(--space-6);
}

/* the papers */
.aq-onboarding-fan__papers {
  position: relative; z-index: 1; list-style: none; margin: 0; padding: 0 calc(var(--space-16) + var(--space-4)) var(--space-3);
  display: flex; align-items: stretch;
}
.aq-onboarding-fan__paper {
  position: relative; flex: 1 1 0; min-width: 0; margin: 0 calc(var(--space-1) * -1); box-sizing: border-box;
  display: flex; flex-direction: column; gap: var(--space-2); min-height: 380px;
  padding: var(--space-4) var(--space-4) calc(var(--of-lip, 76px) + var(--space-3));
  background: var(--surface-raised); color: var(--ink); border: 1px solid var(--line-strong); border-radius: 0 var(--radius-sm) var(--radius-sm) var(--radius-sm);
  transform-origin: 50% 100%;
  transform: rotate(calc(var(--o, 0) * 2.4deg));
  transition: transform 220ms cubic-bezier(.22, 1, .36, 1), box-shadow 200ms;
}
.aq-onboarding-fan.is-fanning .aq-onboarding-fan__paper { transition: none; }
.aq-onboarding-fan__paper:hover, .aq-onboarding-fan__paper:focus-within {
  z-index: 3; transform: translateY(calc(var(--space-4) * -1)) rotate(0deg); box-shadow: var(--shadow-overlay);
}
.aq-onboarding-fan__tab {
  position: absolute; bottom: 100%; left: calc(var(--t, 0) * (100% - 64px)); width: 64px; height: var(--of-tab, 30px); margin-bottom: -1px;
  display: grid; place-items: center; box-sizing: border-box;
  background: var(--surface-raised); border: 1px solid var(--line-strong); border-bottom: 0; border-radius: var(--radius-md) var(--radius-md) 0 0;
}
.aq-onboarding-fan__paper.is-key .aq-onboarding-fan__tab { border-top: 3px solid var(--flow); }
.aq-onboarding-fan__code { font: 500 13px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink); white-space: nowrap; }
.aq-onboarding-fan__paper.is-key .aq-onboarding-fan__code { color: var(--flow); }
.aq-onboarding-fan__t { margin: 0; font: 400 18px/24px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); text-wrap: balance; overflow-wrap: break-word; hyphens: auto; }
.aq-onboarding-fan__t a { color: inherit; text-decoration: none; }
.aq-onboarding-fan__t a::before { content: ""; position: absolute; inset: 0; z-index: 1; }
.aq-onboarding-fan__t a::after { content: "\a0\2192"; color: var(--flow); }
.aq-onboarding-fan__t a:hover { color: var(--flow); }
.aq-onboarding-fan__t a:focus-visible { outline: none; }
.aq-onboarding-fan__paper:has(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-onboarding-fan__d { margin: 0; font: 400 14px/20px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

/* the status-stamp slot: a dashed rubber-stamp outline, set at a stamp's slant */
.aq-onboarding-fan__stamp {
  padding: var(--space-2) var(--space-3); display: flex; flex-direction: column; gap: var(--space-1);
  border: 1.5px dashed var(--line-strong); border-radius: var(--radius-sm); transform: rotate(-2deg); transform-origin: 0 100%;
}
.aq-onboarding-fan__paper > .aq-onboarding-fan__stamp { margin: auto 0 0; }
.aq-onboarding-fan__paper.is-key .aq-onboarding-fan__stamp { border-color: var(--flow); }
.aq-onboarding-fan__sk { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-onboarding-fan__sv { font: 400 14px/20px var(--font-sans); color: var(--ink); overflow-wrap: break-word; }
.aq-onboarding-fan__sr { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }

/* two fans (4 + 3) */
@container (max-width: 1100px) {
  .aq-onboarding-fan__back { top: calc(var(--of-tab, 30px) + var(--space-16)); }
  .aq-onboarding-fan__papers { flex-wrap: wrap; row-gap: calc(var(--of-tab, 30px) + var(--space-4)); padding: 0 var(--space-6) var(--space-3); }
  .aq-onboarding-fan__paper {
    flex: 0 0 calc(100% / var(--n1, 4) + var(--space-2)); min-height: 300px;
    transform: rotate(calc(var(--o2, 0) * 1.6deg));
  }
  .aq-onboarding-fan__paper { padding: var(--space-4) var(--space-3); }
  .aq-onboarding-fan__paper > .aq-onboarding-fan__stamp { padding-inline: var(--space-2); }
  .aq-onboarding-fan__paper.is-row2, .aq-onboarding-fan__paper.is-row2 ~ .aq-onboarding-fan__paper { padding-bottom: calc(var(--of-lip, 76px) + var(--space-3)); }
  .aq-onboarding-fan__paper.is-row2 { margin-left: calc(100% / (var(--n1, 4) * 2) - var(--space-1)); }
  .aq-onboarding-fan__tab { left: calc(var(--t2, 0) * (100% - 64px)); }
  .aq-onboarding-fan__paper:hover, .aq-onboarding-fan__paper:focus-within { transform: translateY(calc(var(--space-2) * -1)) rotate(0deg); }
}

/* phones: the folder holds compact rows (tab chip and title, then the stamp) under a small fan of tab tops */
@container (max-width: 640px) {
  .aq-onboarding-fan { padding-top: 0; }
  .aq-onboarding-fan__crown {
    display: flex; justify-content: center; height: var(--space-12); margin: 0 var(--space-4) calc(var(--space-4) * -1) 34%; position: relative; z-index: 0;
  }
  .aq-onboarding-fan__crown i {
    position: relative; flex: 0 1 var(--space-8); height: var(--space-16); margin: 0 calc(var(--space-1) * -1); box-sizing: border-box;
    background: var(--surface-raised); border: 1px solid var(--line-strong); border-radius: 0 var(--radius-sm) 0 0;
    transform-origin: 50% 100%; transform: translateY(calc(var(--o, 0) * var(--o, 0) * 1.5px + var(--space-1))) rotate(calc(var(--o, 0) * 4deg));
  }
  .aq-onboarding-fan__crown i::before {
    content: ""; position: absolute; bottom: 100%; left: calc(var(--t, 0) * (100% - 20px)); width: 20px; height: 8px; margin-bottom: -1px;
    background: var(--surface-raised); border: 1px solid var(--line-strong); border-bottom: 0; border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }
  .aq-onboarding-fan__crown i.is-key::before { border-top: 2px solid var(--flow); }
  .aq-onboarding-fan__back { top: var(--space-8); }
  .aq-onboarding-fan__back::before { width: 30%; }
  .aq-onboarding-fan__front { display: none; }
  .aq-onboarding-fan__papers { display: block; padding: var(--space-2); }
  .aq-onboarding-fan__paper,
  .aq-onboarding-fan__paper.is-row2, .aq-onboarding-fan__paper.is-row2 ~ .aq-onboarding-fan__paper {
    display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-3); row-gap: var(--space-1); align-items: center;
    min-height: 0; margin: 0 0 -1px; padding: var(--space-2) var(--space-3) var(--space-3); border-radius: 0; transform: none;
  }
  .aq-onboarding-fan__paper:hover, .aq-onboarding-fan__paper:focus-within { transform: none; box-shadow: none; z-index: 1; }
  .aq-onboarding-fan__tab {
    position: static; width: auto; min-width: var(--space-12); height: 26px; margin: 0; padding: 0 var(--space-2);
    border: 1px solid var(--line-strong); border-radius: var(--radius-md) var(--radius-md) 0 0;
  }
  .aq-onboarding-fan__paper.is-key .aq-onboarding-fan__tab { border-top: 3px solid var(--flow); }
  .aq-onboarding-fan__code { font-size: 12px; }
  .aq-onboarding-fan__t { font-size: 16px; line-height: 22px; }
  .aq-onboarding-fan__d, .aq-onboarding-fan__stamp { grid-column: 1 / -1; }
  .aq-onboarding-fan__d { font-size: var(--aq-read-phone, 14px); }
  .aq-onboarding-fan__paper > .aq-onboarding-fan__stamp { justify-self: start; margin: 0; padding: 0 var(--space-2); transform: rotate(-0.8deg); }
  .aq-onboarding-fan__sk { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  .aq-onboarding-fan__sv { font-size: var(--aq-read-phone, 14px); }
}

@media (prefers-reduced-motion: reduce) {
  .aq-onboarding-fan__paper { transition: none; }
}
