.aq-spec thead th { background: var(--surface-sunken); font: 500 14px/20px var(--font-sans); color: var(--ink-muted); }
.aq-spec tbody th { font: 400 16px/24px var(--font-sans); color: var(--ink); }
.aq-spec__value { font: 400 14px/24px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink); overflow-wrap: break-word; }
.aq-spec__method { font: 400 14px/24px var(--font-sans); color: var(--ink-muted); }
