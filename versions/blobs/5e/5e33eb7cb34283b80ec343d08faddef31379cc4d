}

@media (prefers-reduced-motion: reduce) {
  .aq-config-cards__card, .aq-config-cards__go::before { transition: none; }
}

/* ---------- ContactRoutes: the ways in, as route sheets on a navy band (block contact-routes) ----------
   After 62-concept-contact-routes: a route line under the heading drops into each sheet's folder tab; each sheet shows
   what happens after you act as a sequence (numbered steps on a water rail) ending at its response clock, then the
   action. Ordinary routes are limestone sheets (data-theme light); the urgent route is the dark sheet with the call bar
   (data-theme dark). The sheets share one subgrid (tab, head, call, steps, clock, action) so the rows line up.
   Desktop keeps the data order (--o); phones stack in markup order, urgent first, on a riser down the left. */
.aq-contact-routes-sec { --cr-line: color-mix(in srgb, var(--on-navy-muted) 55%, var(--navy)); }
.aq-contact-routes {
  --cr-tab: var(--space-8);
  position: relative; list-style: none; margin: var(--space-12) 0 0; padding: 0;
  display: grid; grid-template-columns: repeat(var(--routes, 3), minmax(0, 1fr)); grid-template-rows: repeat(6, auto);
  column-gap: var(--space-6);
}
/* The route line: runs under the heading and across the band, one drop into each sheet's tab */
.aq-contact-routes::before {
  content: ""; position: absolute; left: 0; right: calc(100% / var(--routes, 3) - var(--space-12)); top: calc(-1 * var(--space-6));
  height: 0; border-top: 1.5px dashed var(--cr-line, var(--on-navy-muted));
  transform: scaleX(var(--aq-riser, 1)); transform-origin: left center;
}
.aq-contact-routes__route {
  order: var(--o, 0); position: relative; min-width: 0;
  grid-row: span 6; display: grid; grid-template-rows: subgrid; row-gap: 0;
  color: var(--ink); background: none;
}
/* The sheet: everything under the tab */
.aq-contact-routes__route::before {
  content: ""; position: absolute; inset: var(--cr-tab, var(--space-8)) 0 0 0; z-index: 0;
  background: var(--limestone); border: 1px solid transparent;
}
.aq-contact-routes__route.is-urgent::before { background: var(--navy); border-color: var(--line-strong); }
/* The drop from the route line into the tab */
.aq-contact-routes__route::after {
  content: ""; position: absolute; left: var(--space-6); top: calc(-1 * var(--space-6)); height: var(--space-6); width: 0;
  border-left: 1.5px dashed var(--cr-line, var(--on-navy-muted)); transform: scaleY(var(--aq-stub, 1)); transform-origin: center top;
}
.aq-contact-routes__route > *, .aq-contact-routes__body > * { position: relative; z-index: 1; min-width: 0; margin: 0; padding-inline: var(--space-6); }
/* The body opens into the sheet's subgrid: head, call bar, steps, clock and action are rows shared by every sheet, so
   the step rails, clocks and actions line up across the band (a route without a call bar leaves that row open). */
.aq-contact-routes__route > .aq-contact-routes__body { display: contents; }
.aq-contact-routes__tab { grid-row: 1; }
.aq-contact-routes__main { grid-row: 2; }
.aq-contact-routes__call { grid-row: 3; }
.aq-contact-routes__steps { grid-row: 4; }
.aq-contact-routes__clock { grid-row: 5; }
.aq-contact-routes__action { grid-row: 6; }

/* Folder tab: Route N · Urgent · This page */
.aq-contact-routes__tab {
  justify-self: start; height: var(--cr-tab, var(--space-8)); display: flex; align-items: center; gap: var(--space-2);
  padding-inline: var(--space-4) var(--space-8) !important; background: var(--limestone);
  clip-path: polygon(0 0, calc(100% - var(--space-4)) 0, 100% 100%, 0 100%);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
/* The urgent tab: the urgent sheet's own navy ground with its line-strong edge (pass 12 verify L3: the line-strong slate
   ground gave its 12 px mono 3.9:1 in ink and 2.3:1 in flow) */
.aq-contact-routes__route.is-urgent .aq-contact-routes__tab { background: var(--navy); box-shadow: inset 1px 1px 0 var(--line-strong); color: var(--ink); }
.aq-contact-routes__route.is-urgent.is-current .aq-contact-routes__mark { color: var(--ink); }
.aq-contact-routes__rn-p { display: none; }
.aq-contact-routes__rn { font-variant-numeric: tabular-nums; }
.aq-contact-routes__mark { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--ink); }
.aq-contact-routes__mark::before { content: "·"; content: "·" / ""; color: var(--ink-muted); }
.aq-contact-routes__route.is-current .aq-contact-routes__mark { color: var(--flow); }
.aq-contact-routes__route.is-current::before { box-shadow: inset 0 3px 0 var(--flow); }

/* Head: the situation, large and light, and one line */
.aq-contact-routes__main { display: flex; flex-direction: column; gap: var(--space-3); padding-block: var(--space-6) var(--space-6); }
.aq-contact-routes__t { margin: 0; font: 300 30px/36px var(--font-sans); letter-spacing: -0.02em; color: inherit; overflow-wrap: break-word; text-wrap: balance; }
.aq-contact-routes__route.is-urgent .aq-contact-routes__t { color: var(--flow); }
.aq-contact-routes__d { margin: 0; font: 400 16px/24px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

/* Call bar: the urgent route's number, large in mono */
.aq-contact-routes__call { padding-bottom: var(--space-6); }
.aq-contact-routes__call:not(.is-empty) {
  display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: var(--space-3); row-gap: var(--space-1);
  margin-inline: var(--space-6) !important; margin-bottom: var(--space-6) !important; padding: var(--space-4) !important;
  border: 1px solid var(--line-strong); background: transparent; color: var(--ink);
}
.aq-contact-routes__call .aq-contact-routes__icon { width: 20px; height: 20px; background-color: var(--flow); }
.aq-contact-routes__num { grid-column: 1 / -1; font: 300 36px/44px var(--font-mono); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: inherit; text-decoration: none; overflow-wrap: anywhere; }
.aq-contact-routes__num .aq-ph { font-size: 0.5em; line-height: 1.4; }
a.aq-contact-routes__num:hover { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }

.aq-contact-routes__k { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-contact-routes__icon { width: 16px; height: 16px; background-color: var(--ink-muted); }

/* Steps: numbered stops on the water rail */
.aq-contact-routes__steps {
  --cr-x: calc(var(--space-6) + 7px);
  flex: 1 1 auto; list-style: none; display: flex; flex-direction: column; gap: var(--space-6);
  padding-top: var(--space-6) !important; border-top: 1px solid var(--line);
  margin-inline: 0 !important;
}
.aq-contact-routes__steps::before, .aq-contact-routes__steps::after {
  content: ""; position: absolute; left: var(--cr-x, var(--space-8)); top: calc(var(--space-6) + 8px); bottom: 0; width: 0; border-left: 1.5px solid var(--line-strong);
}
.aq-contact-routes__steps::after { border-left-color: var(--flow); transform: scaleY(var(--aq-line, 1)); transform-origin: center top; }
.aq-contact-routes__steps > li { position: relative; display: grid; grid-template-columns: var(--space-8) minmax(0, 1fr); grid-template-rows: auto auto; column-gap: var(--space-3); }
.aq-contact-routes__node {
  grid-row: 1 / span 2; align-self: start; margin-top: 1px; width: 15px; height: 15px; border-radius: 50%;
  border: 1.5px solid var(--flow); background: var(--limestone); z-index: 1;
}
.aq-contact-routes__route.is-urgent .aq-contact-routes__node { background: var(--navy); }
.aq-contact-routes__steps > li:first-child .aq-contact-routes__node { background: var(--flow); }
.aq-contact-routes__n { font: 400 12px/16px var(--font-mono); letter-spacing: 0.08em; font-variant-numeric: tabular-nums; color: var(--ink-muted); }
.aq-contact-routes__s { font: 400 17px/24px var(--font-sans); color: inherit; overflow-wrap: break-word; text-wrap: pretty; }

/* Terminus: the response clock where the rail ends */
.aq-contact-routes__clock:not(.is-empty) {
  display: grid; grid-template-columns: var(--space-8) minmax(0, 1fr); column-gap: var(--space-3); row-gap: var(--space-1); align-items: start;
  padding-block: var(--space-6) var(--space-6);
}
.aq-contact-routes__clock:not(.is-empty)::before {
  content: ""; position: absolute; left: calc(var(--space-6) + 7px); top: 0; height: var(--space-6); width: 0; border-left: 1.5px solid var(--flow);
  transform: scaleY(var(--aq-line, 1)); transform-origin: center top;
}
.aq-contact-routes__end {
  grid-row: 1 / span 2; display: grid; place-items: center; width: var(--space-8); height: var(--space-8); margin-left: calc(-1 * var(--space-2));
  border: 1.5px solid var(--flow); background: var(--limestone);
}
.aq-contact-routes__route.is-urgent .aq-contact-routes__end { background: var(--navy); }
.aq-contact-routes__end .aq-contact-routes__icon { background-color: var(--flow); }
.aq-contact-routes__v { font: 300 20px/28px var(--font-sans); letter-spacing: -0.01em; color: inherit; overflow-wrap: break-word; text-wrap: pretty; }
.aq-contact-routes__v .aq-ph { font-size: 13px; line-height: 20px; }

/* Action at the foot of the sheet */
.aq-contact-routes__action { padding-bottom: var(--space-6); align-self: end; }
.aq-contact-routes__route .aq-btn--primary { background: var(--action); color: var(--on-action); }
.aq-contact-routes__route .aq-btn--primary:hover { background: var(--action-hover); }
.aq-contact-routes__action .aq-btn { width: 100%; height: auto; min-height: 44px; padding-block: var(--space-2); justify-content: center; text-align: center; white-space: normal; }

@media (prefers-reduced-motion: no-preference) {
  .aq-contact-routes__tab { transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); }
  .aq-contact-routes__node { transition: background-color 200ms, transform 200ms cubic-bezier(0.2, 0, 0, 1); }
  .aq-contact-routes__route:hover .aq-contact-routes__tab, .aq-contact-routes__route:focus-within .aq-contact-routes__tab { transform: translateY(calc(-1 * var(--space-1))); }
  .aq-contact-routes__route:hover .aq-contact-routes__node, .aq-contact-routes__route:focus-within .aq-contact-routes__node { background: var(--flow); }
  .aq-contact-routes__action .aq-btn__arrow { display: inline-block; transition: transform 160ms cubic-bezier(0.2, 0, 0, 1); }
  .aq-contact-routes__action .aq-btn:hover .aq-btn__arrow { transform: translateY(2px); }
}

@container (max-width: 860px) {
  .aq-contact-routes { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; row-gap: var(--space-8); margin-top: var(--space-8); padding-left: var(--space-4); }
  /* the route line turns into a riser down the left, a stub into each tab */
  .aq-contact-routes::before { left: 0; right: auto; top: calc(var(--cr-tab, var(--space-8)) / 2); bottom: var(--space-12); height: auto; border-top: 0; border-left: 1.5px dashed var(--cr-line, var(--on-navy-muted));
    transform: scaleY(var(--aq-riser, 1)); transform-origin: center top; }
  .aq-contact-routes__route { order: 0; grid-row: auto; display: flex; flex-direction: column; }
  .aq-contact-routes__route::after { left: calc(-1 * var(--space-4)); top: calc(var(--cr-tab, var(--space-8)) / 2); width: var(--space-4); height: 0; border-left: 0; border-top: 1.5px dashed var(--cr-line, var(--on-navy-muted));
    transform: scaleX(var(--aq-stub, 1)); transform-origin: left center; }
  .aq-contact-routes__route > *, .aq-contact-routes__body > * { padding-inline: var(--space-4); }
  .aq-contact-routes__call:not(.is-empty) { margin-inline: var(--space-4) !important; }
  .aq-contact-routes__clock.is-empty { display: none; }
  .aq-contact-routes__steps { flex: none; }
  .aq-contact-routes__steps { --cr-x: calc(var(--space-4) + 7px); }
  .aq-contact-routes__clock:not(.is-empty)::before { left: calc(var(--space-4) + 7px); }
  .aq-contact-routes__main { padding-block: var(--space-4); }
  .aq-contact-routes__t { font-size: 24px; line-height: 30px; }
  .aq-contact-routes__d { font-size: 15px; line-height: 24px; }
  .aq-contact-routes__s { font-size: 16px; line-height: 24px; }
  .aq-contact-routes__v { font-size: 18px; line-height: 26px; }
  .aq-contact-routes__num { font-size: 28px; line-height: 36px; }
  .aq-contact-routes__action { padding-bottom: var(--space-4); align-self: stretch; }
  .aq-contact-routes__tab { align-self: flex-start; }
}

/* Pass 9b (ContactRoutes/motion.js, animated-beam): the beam that runs a sheet's step rail, a short flow highlight
   5 px wide, a limestone glint with a flow rim and glow, brightest at its head; placed and moved by the motion layer, removed when it arrives. */
.aq-contact-routes__route > .aq-contact-routes__pulse {
  position: absolute; z-index: 2; width: 5px; height: 56px; padding: 0; border-radius: var(--radius-pill); pointer-events: none;
  background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--limestone) 70%, transparent) 60%, var(--limestone));
  box-shadow: 0 0 0 1.5px var(--flow), 0 6px 14px color-mix(in srgb, var(--flow) 55%, transparent);
}
.aq-contact-routes__route .aq-contact-routes__node, .aq-contact-routes__route .aq-contact-routes__end { transform-origin: 50% 50%; }
/* Press on the urgent call line once its number is a real link */
@media (prefers-reduced-motion: no-preference) {
  a.aq-contact-routes__num { display: inline-block; transition: transform 120ms cubic-bezier(0.2, 0, 0, 1); }
  a.aq-contact-routes__num:active { transform: translateY(1px) scale(0.98); transition-duration: 60ms; }
}

/* ---------- Pass 12: phones (visual audit S11, about 2,000 px down to under 1,000) ----------
   Desktop never shows the toggle or the jump row and always shows the steps. Below 860 px:
   - the urgent route (first in the markup) stays a whole card: its number is a full-width call button (the action
     fill; a tel: link over the whole box once the number is confirmed), its action an outlined button below;
   - every route's steps sit behind "How it works" (a toggle that opens the numbered steps under it); the response
     line keeps its clock mark and drops the "Response" eyebrow (44 px toggle, the shared --aq-hit floor);
   - the route for this page is one line: its title as a 56 px anchor down to this page's form. */
.aq-contact-routes__how, .aq-contact-routes__jump { display: none; }

@container (max-width: 860px) {
  .aq-contact-routes { row-gap: var(--space-4); margin-top: var(--space-4); }
  .aq-contact-routes__main { padding-block: var(--space-3) var(--space-3); gap: var(--space-1); }
  .aq-contact-routes__t { font-size: 22px; line-height: 28px; }
  .aq-contact-routes__d { font-size: var(--aq-read-phone, 14px); line-height: 20px; }
  /* phone order: head, call, response line, toggle, steps, action */
  .aq-contact-routes__clock { order: 3; }
  .aq-contact-routes__how { order: 4; }
  .aq-contact-routes__steps { order: 5; }
  .aq-contact-routes__action { order: 6; }
  .aq-contact-routes__jump { order: 7; }
  .aq-contact-routes__action { padding-bottom: var(--space-3); }

  /* Response line: compact, the clock mark small, no rail stub into it */
  .aq-contact-routes__clock:not(.is-empty) { grid-template-columns: var(--space-6) minmax(0, 1fr); column-gap: var(--space-3); padding-block: var(--space-2); border-top: 1px solid var(--line); }
  .aq-contact-routes__clock:not(.is-empty)::before { display: none; }
  .aq-contact-routes__clock .aq-contact-routes__k { display: none; }
  .aq-contact-routes__end { grid-row: 1; width: var(--space-6); height: var(--space-6); margin-left: 0; }
  .aq-contact-routes__end .aq-contact-routes__icon { width: 14px; height: 14px; }
  .aq-contact-routes__v { font-size: 16px; line-height: 24px; }
  .aq-contact-routes__v .aq-ph { font-size: var(--aq-chip-phone, 13px); line-height: 20px; }

  /* "How it works": a full-width 48 px toggle row with a chevron; the steps show only while it is open */
  .aq-contact-routes__how {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    width: auto; min-height: var(--aq-hit, 44px); margin: 0; padding-block: 0; border: 0; border-top: 1px solid var(--line); background: none; cursor: pointer;
    font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); text-align: left;
  }
  .aq-contact-routes__how:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .aq-contact-routes__chev { flex: none; width: 8px; height: 8px; margin-right: var(--space-1); border: solid currentColor; border-width: 0 1.5px 1.5px 0; transform: translateY(-2px) rotate(45deg); }
  .aq-contact-routes__how[aria-expanded="true"] .aq-contact-routes__chev { transform: translateY(2px) rotate(-135deg); }
  .aq-contact-routes__how[aria-expanded="false"] + .aq-contact-routes__steps { display: none; }
  .aq-contact-routes__steps { gap: var(--space-4); padding-block: var(--space-2) var(--space-4) !important; border-top: 0; }
  .aq-contact-routes__steps::before, .aq-contact-routes__steps::after { top: calc(var(--space-2) + 8px); bottom: var(--space-6); }
  .aq-contact-routes__s { font-size: 15px; line-height: 22px; }

  /* Urgent route: the call as a full-width button in the action fill, the route's own action outlined under it */
  .aq-contact-routes__call:not(.is-empty) {
    position: relative; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: var(--space-1) var(--space-2);
    min-height: 56px; box-sizing: border-box; margin-bottom: var(--space-3) !important; padding: var(--space-3) var(--space-4) !important;
    background: var(--action); border-color: var(--action); color: var(--on-action); border-radius: var(--radius-sm);
  }
  .aq-contact-routes__call .aq-contact-routes__icon { background-color: var(--on-action); }
  .aq-contact-routes__call .aq-contact-routes__k { font: 500 16px/24px var(--font-sans); letter-spacing: 0; text-transform: none; color: inherit; }
  .aq-contact-routes__call .aq-contact-routes__num { grid-column: auto; font: 500 18px/24px var(--font-mono); letter-spacing: 0; }
  .aq-contact-routes__call .aq-contact-routes__num .aq-ph { font-size: var(--aq-read-phone, 14px); line-height: 22px; }
  /* once the number is a tel: link, the whole button dials */
  .aq-contact-routes__call a.aq-contact-routes__num::after { content: ""; position: absolute; inset: 0; }
  .aq-contact-routes__route.is-urgent .aq-contact-routes__action .aq-btn--primary { background: transparent; color: var(--ink); border: 1px solid var(--line-strong); }
  .aq-contact-routes__route.is-urgent .aq-contact-routes__action .aq-btn--primary:hover { background: transparent; border-color: var(--ink); }

  /* This page (not urgent): one line, the title as an anchor to the form */
  .aq-contact-routes__route.is-current:not(.is-urgent) > :not(.aq-contact-routes__tab):not(.aq-contact-routes__jump),
  .aq-contact-routes__route.is-current:not(.is-urgent) > .aq-contact-routes__body > * { display: none; }
  .aq-contact-routes__route.is-current:not(.is-urgent) > .aq-contact-routes__jump {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); min-height: 56px;
    font: 400 18px/24px var(--font-sans); color: var(--ink); text-decoration: none;
  }
  .aq-contact-routes__jump-arrow { flex: none; color: var(--flow); font-size: 20px; }
  .aq-contact-routes__jump:hover > span:first-child { text-decoration: underline; text-underline-offset: 4px; }
  .aq-contact-routes__jump:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }

  /* Pass 12 verify: route numbers in phone order (L4); the urgent route tighter (L1): its response line merged under
     the call with no rule, the call box 56 px with the phone icon alone saying "Call" (the description stays: it
     carries the severity and the answer time) */
  .aq-contact-routes__rn-d { display: none; }
  .aq-contact-routes__rn-p { display: inline; }
  .aq-contact-routes__route.is-urgent .aq-contact-routes__clock:not(.is-empty) { padding-block: var(--space-1); border-top: 0; }
  .aq-contact-routes__call:not(.is-empty) { padding-block: var(--space-2) !important; }
  .aq-contact-routes__call .aq-contact-routes__k { display: none; }
}

/* ---------- CostSkid: running costs wired to the parts of one skid (look "cost-skid") ----------
   Title left, the IsoKit skid right (limestone-ink line art on the section ground, no sheet), numbered leaders to a
   number column at its right; the running-cost table under it on hairlines: mono number, item, value, set by. A
   pointed row turns its parts, leader and number flow and takes a flow-tint ground. */
.aq-cost-skid__top { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-8); align-items: center; }
.aq-cost-skid .aq-sec-head .aq-h1 { font-weight: 300; font-size: 64px; line-height: 68px; letter-spacing: -0.035em; }
.aq-cost-skid__fig { margin: 0; }
.aq-cost-skid__svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-cost-skid__svg .aq-iso__leader-line { stroke: var(--ink-muted); }
.aq-cost-skid__svg .is-on .aq-iso__leader-line { stroke: var(--flow); stroke-width: 1.5; }
.aq-cost-skid__svg .is-on .aq-iso__leader-dot { fill: var(--flow); }
.aq-cost-skid__pin {
  display: grid; place-items: center; width: var(--space-8); height: var(--space-8); margin-left: var(--space-1);
  border: 1px solid var(--line-strong); background: var(--surface); font: 400 12px/1 var(--font-mono); color: var(--ink);
  transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
}
.aq-cost-skid__pin.is-on { background: var(--flow); border-color: var(--flow); color: var(--on-action); }
.aq-cost-skid__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

.aq-cost-skid__table { margin-top: var(--space-8); }
.aq-cost-skid__table { width: 100%; border-collapse: collapse; }
.aq-cost-skid__table thead th {
  padding: 0 var(--space-4) var(--space-3) 0; text-align: left; font: 400 12px/17px var(--font-mono); color: var(--ink-muted);
  border-bottom: 1px solid var(--line-strong);
}
.aq-cost-skid__table thead th:first-child { width: var(--space-12); }
.aq-cost-skid__row > * { padding: var(--space-4) var(--space-4) var(--space-4) 0; vertical-align: top; text-align: left; border-bottom: 1px solid var(--line); transition: background-color 160ms ease; }
.aq-cost-skid__row { outline: none; }
.aq-cost-skid__row:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
.aq-cost-skid__row > .aq-cost-skid__n { padding-left: var(--space-3); font: 400 12px/24px var(--font-mono); color: var(--ink-muted); }
.aq-cost-skid__p { width: 34%; font: 400 17px/24px var(--font-sans); }
/* round C: values in sans 15/22; only a [bracketed] placeholder is mono (its chip), so a written value never
   switches the table into mono */
.aq-cost-skid__v { width: 30%; font: 400 15px/22px var(--font-sans); }
@container (min-width: 861px) { .aq-cost-skid__v .aq-ph { font-size: 12px; } }
.aq-cost-skid__m { font-size: 15px; line-height: 22px; color: var(--ink-muted); }
.aq-cost-skid__k { display: none; }
.aq-cost-skid__row.is-on > * { background: var(--flow-tint); }
.aq-cost-skid__row.is-on .aq-cost-skid__n { color: var(--flow); }

/* round C, the "Site safety" use (cmp-documentation, anchor safety): the drawing starts at grid column 6 (5fr / 7fr),
   so the long heading never runs into it, and the drawing keeps a space-8 clear of the table's header rule. */
@container (min-width: 861px) {
  .aq-cost-skid-sec[id="safety"] .aq-cost-skid__top { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .aq-cost-skid-sec[id="safety"] .aq-cost-skid__fig { margin-block-end: var(--space-8); }
}

/* the phone's third-column button (desktop shows the column itself) */
.aq-cost-skid__why { display: none; }

@container (max-width: 860px) {
  .aq-cost-skid__top { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .aq-cost-skid .aq-sec-head .aq-h1 { font-size: 36px; line-height: 42px; }
  .aq-cost-skid__pin { width: var(--space-6); height: var(--space-6); font-size: 12px; }
  .aq-cost-skid__table { margin-top: var(--space-6); }
  .aq-cost-skid__table, .aq-cost-skid__table tbody { display: block; }
  .aq-cost-skid__table thead { display: none; }
  /* pass 12: two compact lines per row (number + item; value + the third column's 44 px button), all rows open */
  .aq-cost-skid__row { display: grid; grid-template-columns: var(--space-8) minmax(0, 1fr) auto; column-gap: var(--space-2); padding-block: var(--space-3) var(--space-2); border-bottom: 1px solid var(--line); }
  .aq-cost-skid__row > * { display: block; width: auto; padding: 0; border: 0; }
  .aq-cost-skid__row > .aq-cost-skid__n { grid-row: 1; grid-column: 1; padding-left: 0; }
  .aq-cost-skid__row > .aq-cost-skid__p { grid-row: 1; grid-column: 2 / -1; font-size: 16px; line-height: 22px; }
  .aq-cost-skid__row > .aq-cost-skid__v { grid-row: 2; grid-column: 2; align-self: center; padding-block: var(--space-1); font-size: 14px; line-height: 20px; color: var(--ink-muted); }
  .aq-cost-skid__row > .aq-cost-skid__why { display: block; grid-row: 2; grid-column: 3; align-self: start; }
  .aq-cost-skid__row > .aq-cost-skid__m { display: none; grid-row: 3; grid-column: 2 / -1; padding: 0 0 var(--space-2); font-size: 15px; line-height: 22px; }
  .aq-cost-skid__row.is-open > .aq-cost-skid__m { display: block; }
  .aq-cost-skid__v .aq-cost-skid__k { display: none; }
  .aq-cost-skid__k { display: block; font: 400 12px/17px var(--font-mono); color: var(--ink-muted); }
  .aq-cost-skid__wb { display: inline-flex; align-items: center; min-height: 44px; margin: 0 calc(-1 * var(--space-2)) 0 0; padding: 0 0 0 var(--space-2); border: 0; background: none; color: var(--flow); font: 400 13px/16px var(--font-mono); letter-spacing: 0.04em; cursor: pointer; white-space: nowrap; }
  .aq-cost-skid__wb .aq-phone-kit__chev { width: 32px; height: 44px; margin-left: 0; }
  .aq-cost-skid__wb:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  /* a row title that links: a 44 px tall hit box over the line, no visual change */
  .aq-cost-skid__p a { position: relative; }
  .aq-cost-skid__p a::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 44px; transform: translateY(-50%); }
}

/* ---------- CoverageMap: one column per region beside an instrument readout (look coverage-map, pass 9b) ----------
   Desktop: three cells to a row on hairline columns; the readout (limestone survey sheet, data-theme light) takes the top
   right cell: the region in hand, its severity 1 on-site time as the large figure, the seal stamp, the tile map with its
   tiles lit. Phones: the tile map is the province picker, and only the chosen region's column shows under it. */
.aq-coverage-map { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-8); row-gap: var(--space-12);
  border-top: 1px solid var(--line-strong); padding-top: var(--space-8); }

/* A region column */
.aq-coverage-map__col { position: relative; display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; padding-left: var(--space-6); border-left: 1px solid var(--line); }
.aq-coverage-map__col::before { content: ""; position: absolute; left: -1px; top: 0; bottom: 0; border-left: 2px solid var(--flow); transform: scaleY(0); transform-origin: center top; }
.aq-coverage-map__col.is-on::before { transform: scaleY(1); }
.aq-coverage-map__i { margin: 0; align-self: flex-end; font: 400 13px/20px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink-muted); }
.aq-coverage-map__col.is-on .aq-coverage-map__i { color: var(--flow); }
.aq-coverage-map__t { margin: calc(-1 * var(--space-3)) 0 0; font: 300 32px/38px var(--font-sans); letter-spacing: -0.02em; color: var(--ink); }
.aq-coverage-map__pick { display: inline-block; min-height: 44px; margin: 0; padding: var(--space-1) 0; border: 0; background: none; color: inherit; font: inherit; letter-spacing: inherit; text-align: left; text-wrap: balance; cursor: pointer;
  text-decoration: underline 1px transparent; text-underline-offset: 6px; }
.aq-coverage-map__pick:hover, .aq-coverage-map__pick[aria-pressed="true"] { text-decoration-color: var(--flow); }
.aq-coverage-map__pick:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-coverage-map__codes { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-1); }
.aq-coverage-map__codes span { padding: 0 var(--space-1); border: 1px solid var(--line-strong); font: 400 12px/18px var(--font-mono); color: var(--ink-muted); }
.aq-coverage-map__dl { margin: var(--space-2) 0 0; display: flex; flex-direction: column; }
.aq-coverage-map__dl > div { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--space-1); padding-block: var(--space-3); border-top: 1px solid var(--line); }
.aq-coverage-map__dl dt { font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
.aq-coverage-map__dl dd { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--ink); overflow-wrap: break-word; }
.aq-coverage-map__dl > div:first-child dd { font-family: var(--font-mono); font-size: 14px; }

/* The readout: a limestone survey sheet in the top right cell */
.aq-coverage-map__now { position: relative; grid-column: 3; grid-row: 1; display: flex; flex-direction: column; gap: var(--space-6); min-width: 0; align-self: start;
  margin-top: calc(-1 * var(--space-8) - 1px); padding: var(--space-6); border-top: 3px solid var(--line-strong); background: var(--limestone); color: var(--on-limestone); }
.aq-coverage-map__now::before { content: ""; position: absolute; inset: var(--space-2); top: var(--space-1); border: 1px solid color-mix(in srgb, var(--on-limestone-muted) 30%, transparent); pointer-events: none; }
.aq-coverage-map__faces { position: relative; display: grid; }
.aq-coverage-map__nv { grid-area: 1 / 1; display: none; flex-direction: column; gap: var(--space-3); min-width: 0; }
.aq-coverage-map__nv.is-on { display: flex; }
.aq-coverage-map__nh { margin: 0; display: flex; flex-direction: column; gap: var(--space-1); padding-bottom: var(--space-3); border-bottom: 1px solid color-mix(in srgb, var(--on-limestone-muted) 35%, transparent); }
.aq-coverage-map__ni { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; font-variant-numeric: tabular-nums; color: var(--on-limestone-muted); }
.aq-coverage-map__nt { font: 300 28px/32px var(--font-sans); letter-spacing: -0.02em; color: var(--on-limestone); text-wrap: balance; }
.aq-coverage-map__nb { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--space-4); align-items: center; }
/* the large readout figure: a real time sets at 72 px mono light; a placeholder keeps its chip, larger */
.aq-coverage-map__big { margin: 0; font: 300 72px/1 var(--font-mono); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; color: var(--flow); overflow-wrap: break-word; }
.aq-coverage-map__big:has(> .aq-ph) { font-size: 18px; line-height: 30px; letter-spacing: 0; }
.aq-coverage-map__big .aq-ph { font-size: 18px; letter-spacing: 0; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
/* the seal stamp: a double ring, the CRN body over the seal */
.aq-coverage-map__stamp { position: relative; margin: 0; width: calc(var(--space-24) + var(--space-4)); aspect-ratio: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: var(--space-1);
  border: 1.5px solid var(--on-limestone-muted); border-radius: 50%; text-align: center; }
.aq-coverage-map__stamp::before { content: ""; position: absolute; inset: var(--space-1); border: 1px solid color-mix(in srgb, var(--on-limestone-muted) 60%, transparent); border-radius: 50%; }
.aq-coverage-map__stamp > span { display: flex; flex-direction: column; max-width: 76%; }
.aq-coverage-map__stamp > span + span { padding-top: var(--space-1); border-top: 1px solid color-mix(in srgb, var(--on-limestone-muted) 45%, transparent); }
.aq-coverage-map__sk { font: 500 12px/14px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-coverage-map__sv { font: 500 13px/16px var(--font-mono); letter-spacing: 0.02em; color: var(--on-limestone); overflow-wrap: anywhere; }
.aq-coverage-map__nl { margin: 0; display: flex; flex-direction: column; gap: var(--space-1); font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-coverage-map__nl > span { font: 400 15px/22px var(--font-sans); letter-spacing: 0; text-transform: none; color: var(--on-limestone); }

/* the mono parts of a face that decode when it comes on (motion.js) */
.aq-coverage-map__sc { font-variant-numeric: tabular-nums; }

/* The tile map under the readout */
.aq-coverage-map__grid { position: relative; display: grid; grid-template-columns: repeat(var(--cols, 7), minmax(0, 1fr)); grid-template-rows: repeat(var(--rows, 4), auto); gap: var(--space-1); }
.aq-coverage-map__tile { position: relative; aspect-ratio: 1; min-width: 0; display: flex; align-items: flex-start; margin: 0; padding: var(--space-1); border: 1.5px solid var(--on-limestone-muted); border-radius: 0; background: var(--surface-raised); color: var(--on-limestone); font: inherit; text-align: left; cursor: pointer; -webkit-appearance: none; appearance: none; }
.aq-coverage-map__tile.is-none { border-style: dashed; }
.aq-coverage-map__tile:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; z-index: 1; }
/* a tile without a row of its own, picked (it puts its named row, or the row for the rest, on the readout) */
.aq-coverage-map__tile.is-pick.is-none { background: var(--flow-tint); border-color: var(--flow); }
.aq-coverage-map__code { font: 400 12px/14px var(--font-mono); letter-spacing: 0.02em; }
.aq-coverage-map__tile.is-on { background: var(--flow); border-color: var(--flow); color: var(--on-navy); }
.aq-coverage-map__tile.is-home { border-width: 3px; border-color: var(--navy); }
.aq-coverage-map__tile.is-home::after { content: ""; position: absolute; left: var(--space-1); bottom: var(--space-1); width: var(--space-2); height: var(--space-2); background: var(--navy); }
.aq-coverage-map__tile.is-home.is-on::after { background: var(--on-navy); }
.aq-coverage-map__base { position: relative; margin: 0; display: flex; align-items: center; gap: var(--space-3); font: 400 15px/22px var(--font-sans); color: var(--on-limestone); }
.aq-coverage-map__chips { display: none; }
.aq-coverage-map__say { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }
.aq-coverage-map__pin { width: var(--space-4); height: var(--space-4); border: 3px solid var(--navy); position: relative; }
.aq-coverage-map__pin::after { content: ""; position: absolute; inset: 2px; background: var(--navy); }

@media (prefers-reduced-motion: no-preference) {
  .aq-coverage-map__tile { transition: background-color 240ms, border-color 240ms, color 240ms; }
  .aq-coverage-map__col::before { transition: transform 400ms cubic-bezier(0.2, 0, 0, 1); }
  .aq-coverage-map__pick { transition: text-decoration-color 160ms; }
}

/* Phones (pass 12, S11/S14): the tile map is the province picker. The readout sheet carries the map (one frame, no
   inner hairline) and the stamp when the region has one; the region's figure and name are not repeated there, because
   only the chosen region's column shows, straight under the sheet. Tiles are 44 px. */
@container (max-width: 860px) {
  .aq-coverage-map { grid-template-columns: minmax(0, 1fr); row-gap: 0; padding-top: 0; border-top: 0; }
  .aq-coverage-map__now { grid-column: 1; grid-row: auto; order: -1; margin-top: 0; padding: var(--space-4) var(--space-2) var(--space-3); gap: var(--space-3); }
  .aq-coverage-map__now::before { display: none; }
  .aq-coverage-map__nh, .aq-coverage-map__big, .aq-coverage-map__nl { display: none; }
  .aq-coverage-map__faces:not(:has(.aq-coverage-map__stamp)) { display: none; }
  .aq-coverage-map__nb { grid-template-columns: minmax(0, 1fr); justify-items: end; }
  .aq-coverage-map__grid { gap: 2px; width: 100%; max-width: 26rem; }
  .aq-coverage-map__tile { min-height: 44px; }
  .aq-coverage-map__tile.is-none[data-named] { border-style: solid; }
  /* the regions as chips under the map: the same choice as a tile, named */
  .aq-coverage-map__chips { display: flex; flex-wrap: wrap; gap: var(--space-1); padding-inline: var(--space-2); }
  .aq-coverage-map__chip { min-height: 44px; margin: 0; padding: var(--space-1) var(--space-2); border: 1.5px solid var(--on-limestone-muted); border-radius: 0; background: var(--surface-raised);
    color: var(--on-limestone); font: 400 14px/20px var(--font-sans); text-align: left; cursor: pointer; -webkit-appearance: none; appearance: none; }
  .aq-coverage-map__chip[aria-pressed="true"] { background: var(--flow); border-color: var(--flow); color: var(--on-navy); }
  .aq-coverage-map__chip:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .aq-coverage-map__code { font-size: 13px; }
  .aq-coverage-map__base { padding-inline: var(--space-2); font-size: 15px; }
  .aq-coverage-map__col:not(.is-on) { display: none; }
  .aq-coverage-map__col { padding: var(--space-4) 0 0 var(--space-4); }
  .aq-coverage-map__i { position: absolute; right: 0; top: var(--space-4); }
  .aq-coverage-map__t { margin: 0; padding-right: var(--space-12); font-size: 26px; line-height: 32px; }
  .aq-coverage-map__pick { cursor: default; text-decoration: none; }
  .aq-coverage-map__dl { margin-top: 0; }
  .aq-coverage-map__dl dd, .aq-coverage-map__dl > div:first-child dd { font-size: 15px; }
  .aq-coverage-map__dl .aq-ph { font-size: var(--aq-read-phone, 14px); }
}
.aq-coverage-map-sec { overflow: visible; }

/* Survey sheet (pass 9b): FxContour draws the terrain's contour lines in on-limestone under the readout, faint (index
   contours at 12 %, the rest at 7 %), masked off the top half where the region, the figure and the stamp sit. */
.aq-coverage-map__now > .aq-fx-shader { --fx-amt: 0.12;
  -webkit-mask-image: linear-gradient(to bottom, transparent 40%, var(--ink) 70%); mask-image: linear-gradient(to bottom, transparent 40%, var(--ink) 70%); }

/* ---------- CutoverSchedule: an upgrade as a schedule with your system's water line (look "cutover-schedule") ----------
   Rows in a 12-column split: number (mono), the step (5 columns: name in light 24 px, line, hold stamp), the track
   (6 columns, a faint column rule per step). Bars are hairline-framed boxes on the track; the shutdown step's bar is
   navy (on-site work with the system down), a hold bar ends in a diamond on its right end. Above, the water line in
   flow across the track, broken at the shutdown with a dashed bracket and its label. "Not to scale" in mono at
   the foot. Phones: the step's text over its track. */
.aq-cutover-schedule { --cols: var(--space-8) minmax(0, 5fr) minmax(0, 6fr); }
.aq-cutover-schedule__lane, .aq-cutover-schedule__row { display: grid; grid-template-columns: var(--cols, auto); column-gap: var(--space-6); }
.aq-cutover-schedule__lane { align-items: end; padding-bottom: var(--space-4); border-bottom: 1px solid var(--line-strong); }
.aq-cutover-schedule__lk { grid-column: 2; font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--flow); text-align: right; }
.aq-cutover-schedule__ltrack { grid-column: 3; position: relative; height: var(--space-12); }
.aq-cutover-schedule__water { position: absolute; bottom: var(--space-2); height: 0; border-top: 3px solid var(--flow); transform-origin: 0 50%; }
.aq-cutover-schedule__gap { position: absolute; bottom: 0; height: var(--space-6); border: 1.5px dashed var(--ink-muted); border-bottom: 0; }
.aq-cutover-schedule__gl { position: absolute; left: 50%; bottom: 100%; transform: translateX(-50%); margin-bottom: var(--space-1); white-space: nowrap; font: 500 11px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink); }
.aq-cutover-schedule__rows { list-style: none; margin: 0; padding: 0; }
.aq-cutover-schedule__row { align-items: stretch; border-bottom: 1px solid var(--line); }
.aq-cutover-schedule__n { padding-top: var(--space-6); font: 500 12px/30px var(--font-mono); color: var(--ink-subtle); }
.aq-cutover-schedule__txt { padding: var(--space-6) 0; }
.aq-cutover-schedule__t { margin: 0; font: 300 24px/30px var(--font-sans); letter-spacing: -0.015em; color: var(--ink); }
.aq-cutover-schedule__go { color: inherit; text-decoration: none; }
.aq-cutover-schedule__go::after { content: " →"; color: var(--flow); }
.aq-cutover-schedule__d { margin: var(--space-2) 0 0; max-width: 46ch; font: 400 15px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
.aq-cutover-schedule__hold { display: inline-flex; gap: var(--space-2); align-items: center; margin: var(--space-3) 0 0; padding: var(--space-1) var(--space-2); border: 1.5px solid var(--ink); font: 500 12px/16px var(--font-mono); color: var(--ink); }
.aq-cutover-schedule__hk { padding-right: var(--space-2); border-right: 1px solid var(--ink); text-transform: uppercase; letter-spacing: 0.08em; }
.aq-cutover-schedule__track { position: relative; min-height: var(--space-16); }
.aq-cutover-schedule__grid span { position: absolute; top: 0; bottom: 0; border-left: 1px dashed var(--line); }
.aq-cutover-schedule__bar { position: absolute; top: 50%; height: var(--space-6); margin-top: calc(-1 * var(--space-3)); border: 1.5px solid var(--ink); background: var(--surface-raised); transform-origin: 0 50%; transition: background-color 200ms ease; }
.aq-section--alt .aq-cutover-schedule__bar { background: var(--surface); }
.aq-cutover-schedule__row.is-cut .aq-cutover-schedule__bar { background: var(--ink); border-color: var(--ink); }
.aq-cutover-schedule__diamond { position: absolute; right: calc(-1 * var(--space-3)); top: 50%; width: var(--space-4); height: var(--space-4); margin-top: calc(-1 * var(--space-2)); background: var(--surface); border: 2px solid var(--ink); transform: rotate(45deg); }
.aq-cutover-schedule__row:hover .aq-cutover-schedule__bar { background: var(--flow-tint); border-color: var(--flow); }
.aq-cutover-schedule__row.is-cut:hover .aq-cutover-schedule__bar { background: var(--ink); }
.aq-cutover-schedule__nts { margin: var(--space-3) 0 0; text-align: right; font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }

/* the phone strip (mini schedule) is phone-only */
.aq-cutover-schedule__mini { display: none; }

@container (max-width: 860px) {
  /* Phones (pass 12): the lane and the per-row tracks give way to one mini schedule held under the header (PhoneKit
     sticky strip, 96 px): the step number in view on the left, then the water line with its shutdown gap and all the
     bars stair-stepped, the bar of the row in view filled flow. Rows are compact cards: number, name, line, hold. */
  .aq-cutover-schedule { --cols: var(--space-8) minmax(0, 1fr); }
  .aq-cutover-schedule__lane, .aq-cutover-schedule__track { display: none; }
  .aq-cutover-schedule__mini {
    display: grid; grid-template-columns: var(--space-16) minmax(0, 1fr); column-gap: var(--space-3); align-items: stretch;
    height: 96px; box-sizing: border-box; padding: var(--space-3) 0; background: var(--surface); border-bottom: 1px solid var(--line-strong);
    box-shadow: calc(-1 * var(--space-4)) 0 0 var(--surface), var(--space-4) 0 0 var(--surface);
  }
  .aq-cutover-schedule__mn { position: relative; display: flex; flex-direction: column; justify-content: center; border-right: 1px solid var(--line); }
  .aq-cutover-schedule__mn > span { display: none; font: 300 var(--aq-num-phone, 44px)/1 var(--font-sans); letter-spacing: -0.04em; color: var(--flow); font-variant-numeric: tabular-nums; }
  .aq-cutover-schedule__mn > span:first-child, .aq-cutover-schedule[data-pk-active] .aq-cutover-schedule__mn > span.is-pk-active { display: block; }
  .aq-cutover-schedule[data-pk-active] .aq-cutover-schedule__mn > span:first-child:not(.is-pk-active) { display: none; }
  .aq-cutover-schedule__mn small { font: 500 12px/16px var(--font-mono); color: var(--ink-subtle); margin-top: var(--space-1); }
  .aq-cutover-schedule__mg { position: relative; display: grid; grid-template-rows: 16px 8px minmax(0, 1fr); min-width: 0; }
  .aq-cutover-schedule__mk { font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--flow); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .aq-cutover-schedule__mw { position: relative; }
  .aq-cutover-schedule__mw .aq-cutover-schedule__water { bottom: 2px; border-top-width: 2px; }
  .aq-cutover-schedule__mgap { position: absolute; bottom: 0; height: 6px; border: 1px dashed var(--ink-muted); border-bottom: 0; box-sizing: border-box; }
  .aq-cutover-schedule__mb { position: relative; margin-top: var(--space-1); }
  .aq-cutover-schedule__mb > span { position: absolute; min-height: 4px; box-sizing: border-box; border: 1px solid var(--ink); background: var(--surface-raised); transition: background-color 200ms ease, border-color 200ms ease; }
  .aq-cutover-schedule__mb > span.is-cut { background: var(--ink); }
  .aq-cutover-schedule__mb > span.is-pk-active { background: var(--flow); border-color: var(--flow); }
  .aq-cutover-schedule__row { grid-template-columns: var(--cols, auto); border-bottom-color: var(--line); }
  .aq-cutover-schedule__txt { padding: var(--space-4) 0; }
  .aq-cutover-schedule__n { padding-top: var(--space-4); font-size: 13px; line-height: 26px; transition: color 200ms ease; }
  .aq-cutover-schedule__row.is-pk-active .aq-cutover-schedule__n { color: var(--flow); }
  .aq-cutover-schedule__t { font-size: 20px; line-height: 26px; }
  .aq-cutover-schedule__d { margin-top: var(--space-1); font-size: 15px; line-height: 22px; }
  .aq-cutover-schedule__hold { margin-top: var(--space-2); font-size: 12px; }
  /* pass 12 verify (S4): the HOLD key stays mono; the sentence after it reads at 14 px */
  .aq-cutover-schedule__hold > span:last-child { font: 400 14px/20px var(--font-sans); letter-spacing: 0; text-transform: none; }
  .aq-cutover-schedule__go { position: relative; }
  .aq-cutover-schedule__go::before { content: ""; position: absolute; inset: 50% auto auto 0; width: 100%; min-height: var(--aq-hit, 44px); transform: translateY(-50%); }
}
@media (prefers-reduced-motion: reduce) {
  .aq-cutover-schedule__mb > span, .aq-cutover-schedule__n { transition: none; }
}
.aq-cutover-schedule-sec .aq-sec-head .aq-h1 { font: 300 56px/60px var(--font-sans); letter-spacing: -0.03em; max-width: 20ch; }
@container (max-width: 860px) { .aq-cutover-schedule-sec .aq-sec-head .aq-h1 { font: 300 36px/42px var(--font-sans); } }

/* ---------- DerivationSheet: a grade table worked as numbered equation lines on a calculation pad ---------- */
.aq-derivation-sheet-sec { position: relative; }
.aq-derivation-sheet { position: relative; margin-top: var(--space-8); padding: var(--space-6) var(--space-8) var(--space-6) var(--space-16); background: var(--surface-raised);
  border: 1px solid var(--line-strong); overflow: hidden; }
.aq-derivation-sheet__grid { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.aq-derivation-sheet__grid path { fill: none; stroke: var(--line); stroke-width: 0.6; }
.aq-derivation-sheet__g5 path, .aq-derivation-sheet__grid pattern#aq-ds-grid5 path { stroke: var(--line); stroke-width: 1.2; }
.aq-derivation-sheet__margin { position: absolute; top: 0; bottom: 0; left: var(--space-12); width: var(--space-1); border-inline: 1px solid var(--flow); opacity: 0.7; transform-origin: 50% 0; }
.aq-derivation-sheet__lines { position: relative; list-style: none; margin: 0; padding: 0; }

.aq-derivation-sheet__line { position: relative; display: grid; align-items: center; column-gap: var(--space-4);
  grid-template-columns: minmax(0, 4fr) var(--space-12) minmax(0, 4fr) var(--space-12) minmax(0, 3fr); padding: var(--space-8) 0; }
.aq-derivation-sheet__line + .aq-derivation-sheet__line { border-top: 1px dashed var(--line-strong); }
.aq-derivation-sheet__no { position: absolute; right: calc(100% + var(--space-6)); top: var(--space-8); text-align: right;
  font: 400 14px/20px var(--font-mono); color: var(--flow); }
.aq-derivation-sheet__k { display: block; margin-bottom: var(--space-2); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-derivation-sheet__line + .aq-derivation-sheet__line .aq-derivation-sheet__k { display: none; }
.aq-derivation-sheet__given, .aq-derivation-sheet__lim, .aq-derivation-sheet__ans { min-width: 0; }
.aq-derivation-sheet__t { margin: 0; font: 300 24px/31px var(--font-sans); letter-spacing: -0.015em; color: var(--ink); }
.aq-derivation-sheet__set { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
.aq-derivation-sheet__set li { position: relative; padding-left: var(--space-4); font: 300 20px/27px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); text-wrap: pretty; }
.aq-derivation-sheet__set li::before { content: ""; position: absolute; left: 0; top: 0.65em; width: var(--space-2); border-top: 1.5px solid var(--flow); }
.aq-derivation-sheet__op { display: block; width: var(--space-12); color: var(--ink-subtle); }
.aq-derivation-sheet__op svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-derivation-sheet__op path { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
.aq-derivation-sheet__op.is-imp { color: var(--flow); }

/* Hero figure: the number large, the unit beside it, the reference under a hairline */
.aq-derivation-sheet__v { margin: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 var(--space-3); }
.aq-derivation-sheet__num { font: 300 72px/72px var(--font-mono); letter-spacing: -0.05em; color: var(--ink); font-variant-numeric: tabular-nums; }
.aq-derivation-sheet__u { font: 400 15px/20px var(--font-sans); color: var(--ink-muted); max-width: 12ch; }
.aq-derivation-sheet__ref { margin: var(--space-2) 0 0; padding-top: var(--space-2); border-top: 1px solid var(--line); font: 400 13px/20px var(--font-mono); color: var(--ink-muted); }

/* The answer, boxed */
.aq-derivation-sheet__ans { position: relative; padding: var(--space-4); }
.aq-derivation-sheet__w { position: relative; margin: 0; font: 400 19px/26px var(--font-sans); color: var(--ink); }
.aq-derivation-sheet__box { position: absolute; inset: 0; border: 1.5px solid var(--ink); pointer-events: none; }
.aq-derivation-sheet__box::after { content: ""; position: absolute; left: var(--space-1); right: var(--space-1); bottom: calc(var(--space-2) * -1); height: 0; border-top: 1px solid var(--ink); }
.aq-derivation-sheet__line:hover .aq-derivation-sheet__box { border-color: var(--flow); }
.aq-derivation-sheet__line:hover .aq-derivation-sheet__op { color: var(--flow); }

@container (max-width: 1100px) {
  .aq-derivation-sheet { padding-right: var(--space-6); }
  .aq-derivation-sheet__line { grid-template-columns: minmax(0, 1fr) var(--space-8) minmax(0, 1fr); row-gap: var(--space-4); }
  .aq-derivation-sheet__op { width: var(--space-8); }
  .aq-derivation-sheet__op.is-imp { grid-column: 2; }
  .aq-derivation-sheet__ans { grid-column: 3; }
  .aq-derivation-sheet__num { font-size: 60px; line-height: 60px; }
}

/* Phones (pass 12, S12/S13): each line one compact card on the pad. The step and its boxed answer share the first row
   (the answer as a framed chip on the right), "what sets it" runs under them as one 14 px line; no arrows, no number
   gutter, the margin rule a thin edge rule. Column keys stay on the first line only, as on desktop. */
@container (max-width: 860px) {
  .aq-derivation-sheet { margin-top: var(--space-4); padding: var(--space-1) var(--space-4) var(--space-1) var(--space-6); }
  .aq-derivation-sheet__margin { left: var(--space-3); width: 2px; border-inline-width: 0.75px; }
  .aq-derivation-sheet__no, .aq-derivation-sheet__op, .aq-derivation-sheet__op.is-imp { display: none; }
  .aq-derivation-sheet__line { grid-template-columns: minmax(0, 1fr) minmax(0, 46%); grid-template-areas: "given ans" "lim lim";
    align-items: start; column-gap: var(--space-3); row-gap: var(--space-2); padding: var(--space-4) 0; }
  /* long answers (any over 48 characters): every answer sits under its step, boxed to its own width */
  .aq-derivation-sheet.is-stacked .aq-derivation-sheet__line { grid-template-columns: minmax(0, 1fr); grid-template-areas: "given" "ans" "lim"; }
  .aq-derivation-sheet.is-stacked .aq-derivation-sheet__ans { justify-self: start; max-width: 100%; }
  .aq-derivation-sheet__given { grid-area: given; }
  .aq-derivation-sheet__ans { grid-area: ans; grid-column: auto; padding: var(--space-2) var(--space-3); }
  .aq-derivation-sheet__lim { grid-area: lim; }
  .aq-derivation-sheet__line:first-child .aq-derivation-sheet__k { margin-bottom: var(--space-1); }
  .aq-derivation-sheet__t { font-size: 17px; line-height: 23px; letter-spacing: -0.01em; font-weight: 400; }
  .aq-derivation-sheet__w { font-size: 15px; line-height: 20px; }
  .aq-derivation-sheet__box::after { bottom: calc(var(--space-1) * -1); }
  /* what sets it: one run of text, items joined by a middle dot */
  .aq-derivation-sheet__set { display: block; }
  .aq-derivation-sheet__set li { display: inline; padding: 0; font: 400 14px/20px var(--font-sans); color: var(--ink-muted); }
  .aq-derivation-sheet__set li::before { content: none; }
  .aq-derivation-sheet__set li + li::before { content: " · "; position: static; border: 0; width: auto; color: var(--flow); }
  .aq-derivation-sheet__v { display: inline-flex; gap: 0 var(--space-2); }
  .aq-derivation-sheet__num { font-size: 22px; line-height: 24px; letter-spacing: -0.02em; }
  .aq-derivation-sheet__u { max-width: none; font-size: 14px; }
  .aq-derivation-sheet__ref { margin: var(--space-1) 0 0; padding: 0; border: 0; font-size: 13px; }
}
/* 600 px and under (pass 12 round C, optional item): lines 12 px above and below (from 16), so the pad runs shorter
   without changing a line's own composition */
@container (max-width: 600px) {
  .aq-derivation-sheet__line { padding-block: var(--space-3); }
}

/* ---------- DocList: the documents delivered with a system, as a hairline list ---------- */
/* One row per document between `line` hairlines: index | code (mono) | name | detail | optional line icon. The deciding
   documents lead; their code turns flow (a word, not a fill). No frame, tabs or cards: the list grammar of .aq-rows.
   Plain lists (no recognised codes) drop the code column. */
.aq-docs {
  margin: 0; padding: 0; list-style: none; border-bottom: 1px solid var(--line);
}
.aq-docs > li {
  display: grid; grid-template-columns: var(--space-12) var(--space-24) minmax(0, 4fr) minmax(0, 6fr) var(--space-8);
  grid-template-areas: "i c t d ic"; column-gap: var(--space-6); align-items: baseline;
  min-width: 0; padding-block: var(--space-4); border-top: 1px solid var(--line);
}
.aq-docs--plain > li { grid-template-columns: var(--space-12) minmax(0, 4fr) minmax(0, 6fr) var(--space-8); grid-template-areas: "i t d ic"; }
.aq-docs > li > .aq-index { grid-area: i; }
.aq-docs__code {
  grid-area: c; min-width: 0; font: 500 13px/24px var(--font-mono); letter-spacing: 0.02em; color: var(--ink-muted);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.aq-docs__name {
  grid-area: t; min-width: 0; font: 500 17px/24px var(--font-sans); letter-spacing: -0.005em; color: var(--ink);
  overflow-wrap: break-word; text-wrap: pretty;
}
.aq-docs__name a { color: inherit; }
.aq-docs__name a:hover { color: var(--flow); }
.aq-docs__d { grid-area: d; min-width: 0; max-width: var(--text-max); font: 400 15px/24px var(--font-sans); color: var(--ink-muted); overflow-wrap: break-word; text-wrap: pretty; }
.aq-docs__icon { grid-area: ic; align-self: center; justify-self: end; width: var(--space-8); height: var(--space-8); }
/* Key documents: the ones that decide the review. The code in flow is the only colour in the section. */
.aq-docs > li.is-key .aq-docs__code { color: var(--flow); }

/* Fold: on desktop every row shows (the "Show all" button hidden); the fold works on phones only. */
.aq-fold:not(.is-open) .aq-docs > li.aq-fold-x { display: grid; }
.aq-fold:has(> .aq-docs) > .aq-fold__btn { display: none; }

/* Block link: one Button link (the link variant) under the list, "Full index →", space-4 below its last hairline */
.aq-docs__more { margin: 0; }

/* Phone: index and code on one line, the name under the code, the detail under the name; no icon. */
/* A document whose name links to a page lifts a little on hover */
.aq-docs > li:has(.aq-docs__name a) { transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-docs > li:has(.aq-docs__name a):hover { transform: translateY(calc(-1 * var(--space-1))); }
.aq-docs > li:has(.aq-docs__name a):hover .aq-docs__name a { color: var(--flow); }
@media (prefers-reduced-motion: reduce) { .aq-docs > li:has(.aq-docs__name a) { transition: none; } }

@container (max-width: 860px) {
  .aq-docs > li, .aq-docs--plain > li {
    grid-template-columns: var(--space-8) minmax(0, 1fr); grid-template-areas: "i c" ". t" ". d";
    column-gap: var(--space-3); row-gap: var(--space-1); padding-block: var(--space-3);
  }
  .aq-docs--plain > li { grid-template-areas: "i t" ". d"; }
  .aq-docs__code { font-size: 12px; line-height: 20px; }
  .aq-docs__name { font-size: 16px; line-height: 24px; }
  .aq-docs__d { font-size: 14px; line-height: 22px; }
  .aq-docs__icon { display: none; }
  .aq-fold:not(.is-open) .aq-docs > li.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-docs) > .aq-fold__btn { display: flex; }
}

/* ---------- DrawingRegister: framed outline drawings, one steel-blue viewfinder, the selected item's detail (look "drawing-register") ---------- */
/* The section is a limestone band forced to the light theme (data-theme="light"), so flow stays the steel blue.
   The viewfinder is one element over the row of frames: --sel moves it by whole cells (its own width plus the gap),
   so it needs no measuring. The glide (240 ms, .2/.85/.25/1) follows Subframe Motion "Project index"
   (project-index), MIT, (c) 2026 Subframe, as ReviewReticles does; it is a CSS transition, so it is instant under
   reduced motion. */
.aq-drawing-register { --gap: var(--space-4); display: flex; flex-direction: column; gap: var(--space-8); border: 1px solid var(--line-strong); padding: var(--space-8); position: relative; }
.aq-drawing-register::before { content: ""; position: absolute; inset: var(--space-2); border: 1px solid var(--line); pointer-events: none; }
.aq-drawing-register__strip { position: relative; }
.aq-drawing-register__cells { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 6), minmax(0, 1fr)); gap: var(--gap, var(--space-4)); }
.aq-drawing-register__item { position: relative; min-width: 0; }
.aq-drawing-register__cell {
  display: flex; flex-direction: column; gap: var(--space-2); width: 100%; padding: 0; margin: 0; border: 0; background: none; text-align: start; color: var(--on-limestone); font: inherit; cursor: pointer;
}
.aq-drawing-register__cell:focus-visible { outline: 2px solid var(--focus); outline-offset: var(--space-3); }
.aq-drawing-register__frame { display: block; aspect-ratio: 6 / 5; border: 1px solid var(--on-limestone); background: var(--surface); position: relative; transition: border-color 200ms ease; }
.aq-drawing-register__svg { display: block; width: 100%; height: 100%; overflow: visible; }
.aq-drawing-register__svg path, .aq-drawing-register__svg circle, .aq-drawing-register__svg ellipse { fill: none; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
.aq-drawing-register__svg .aq-drawing-register__eq { fill: var(--surface); stroke: var(--on-limestone); stroke-width: 1.4; }
.aq-drawing-register__ln { stroke: var(--on-limestone); stroke-width: 1.4; }
.aq-drawing-register__th { stroke: var(--on-limestone); stroke-width: 0.9; }
.aq-drawing-register__hd { stroke: var(--on-limestone); stroke-width: 2.4; }
.aq-drawing-register__dash { stroke: var(--on-limestone-muted); stroke-width: 0.9; stroke-dasharray: 3 3; }
.aq-drawing-register__wa { stroke: var(--flow); stroke-width: 1.6; }
.aq-drawing-register__code { font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em; color: var(--on-limestone); }
.aq-drawing-register__name { font: 400 15px/20px var(--font-sans); color: var(--on-limestone-muted); text-wrap: balance; transition: color 200ms ease; }
.aq-drawing-register__item.is-on .aq-drawing-register__name { color: var(--on-limestone); }
.aq-drawing-register__item.is-on .aq-drawing-register__code { color: var(--flow); }
/* item text for readers: the visible copy is the detail below (aria-hidden) */
.aq-drawing-register__d, .aq-drawing-register__link { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; margin: 0; }
.aq-drawing-register__go { color: inherit; }
/* the viewfinder: one steel-blue square that overhangs the selected frame */
.aq-drawing-register__vf {
  position: absolute; left: 0; top: 0; width: calc((100% - (var(--n, 6) - 1) * var(--gap, var(--space-4))) / var(--n, 6)); aspect-ratio: 6 / 5; pointer-events: none;
  transform: translateX(calc(var(--sel, 0) * (100% + var(--gap, var(--space-4))))); transition: transform 240ms cubic-bezier(0.2, 0.85, 0.25, 1);
}
.aq-drawing-register__vf::before { content: ""; position: absolute; inset: calc(-1 * var(--space-3)) calc(-1 * var(--space-3)) calc(-1 * var(--space-1)); background: color-mix(in srgb, var(--flow) 26%, transparent); border: 2px solid var(--flow); }
/* the detail: the selected item drawn large in a dimensioned frame, its notes, the title block */
.aq-drawing-register__detail { position: relative; }
.aq-drawing-register__pane { display: none; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-8); align-items: stretch; }
.aq-drawing-register__pane.is-on { display: grid; }
.aq-drawing-register__zoom { position: relative; border: 1px solid var(--on-limestone); background: var(--surface); padding: var(--space-8) var(--space-8) var(--space-6) var(--space-12); }
.aq-drawing-register__svg--big { height: auto; max-height: calc(var(--space-32) * 2); margin: 0 auto; }
.aq-drawing-register__dim { position: absolute; border-color: var(--on-limestone-muted); border-style: solid; border-width: 0; }
.aq-drawing-register__dim--h { left: var(--space-12); right: var(--space-8); top: var(--space-4); height: var(--space-2); border-width: 0 1px; border-top-width: 1px; }
.aq-drawing-register__dim--v { left: var(--space-4); top: var(--space-8); bottom: var(--space-6); width: var(--space-2); border-width: 1px 0; border-left-width: 1px; }
.aq-drawing-register__notes { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
.aq-drawing-register__nl { margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-drawing-register__nt { margin: 0; font: 300 32px/36px var(--font-sans); letter-spacing: -0.02em; color: var(--on-limestone); text-wrap: balance; }
.aq-drawing-register__nd { margin: 0; font: 400 17px/26px var(--font-sans); color: var(--on-limestone-muted); max-width: 46ch; text-wrap: pretty; }
.aq-drawing-register__tb {
  margin: auto 0 0; display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; border: 1px solid var(--on-limestone);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--on-limestone);
}
.aq-drawing-register__tb span { padding: var(--space-3) var(--space-4); border-left: 1px solid var(--on-limestone); }
.aq-drawing-register__tb span:first-child { border-left: 0; }
.aq-drawing-register__tbn, .aq-drawing-register__tbc { color: var(--flow); }
.aq-drawing-register-sec { position: relative; }
@media (hover: hover) { .aq-drawing-register__cell:hover .aq-drawing-register__frame { border-color: var(--flow); } }

/* Phones: drawings two to a row, the selected one framed in steel blue, then the viewfinder block on steel blue */
@container (max-width: 860px) {
  .aq-drawing-register { padding: var(--space-4); gap: var(--space-6); --gap: var(--space-3); }
  .aq-drawing-register::before { display: none; }
  .aq-drawing-register__cells { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-4); }
  .aq-drawing-register__cell { min-height: var(--aq-hit, 44px); gap: var(--space-1); }
  .aq-drawing-register__vf { display: none; }
  .aq-drawing-register__item.is-on .aq-drawing-register__frame { border-color: var(--flow); box-shadow: 0 0 0 2px var(--flow); background: color-mix(in srgb, var(--flow) 14%, var(--surface)); }
  .aq-drawing-register__name { font-size: var(--aq-read-phone, 14px); line-height: 20px; }
  .aq-drawing-register__pane.is-on { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; background: var(--flow); color: var(--on-navy); }
  .aq-drawing-register__zoom { display: grid; place-items: center; border: 0; background: none; padding: var(--space-4) var(--space-4) 0 var(--space-8); }
  .aq-drawing-register__dim--h { left: var(--space-8); right: var(--space-4); top: var(--space-2); }
  .aq-drawing-register__dim--v { left: var(--space-3); top: var(--space-4); bottom: 0; }
  .aq-drawing-register__dim { border-color: var(--on-navy-muted); }
  .aq-drawing-register__svg--big { max-height: calc(var(--space-32) + var(--space-8)); width: auto; }
  .aq-drawing-register__svg--big .aq-drawing-register__eq { fill: var(--flow); stroke: var(--on-navy); }
  .aq-drawing-register__svg--big .aq-drawing-register__ln, .aq-drawing-register__svg--big .aq-drawing-register__th, .aq-drawing-register__svg--big .aq-drawing-register__hd { stroke: var(--on-navy); }
  .aq-drawing-register__svg--big .aq-drawing-register__dash { stroke: var(--on-navy-muted); }
  .aq-drawing-register__svg--big .aq-drawing-register__wa { stroke: var(--limestone); stroke-width: 2.2; }
  .aq-drawing-register__notes { padding: var(--space-4); gap: var(--space-2); }
  .aq-drawing-register__nl { color: var(--on-navy); }
  .aq-drawing-register__nt { font-size: 24px; line-height: 28px; color: var(--on-navy); }
  .aq-drawing-register__nd { font-size: 15px; line-height: 22px; color: var(--on-navy); }
  .aq-drawing-register__tb { margin-top: var(--space-3); border-color: var(--on-navy-muted); color: var(--on-navy); grid-template-columns: auto minmax(0, 1fr) auto; }
  .aq-drawing-register__tb span { border-color: var(--on-navy-muted); padding: var(--space-2) var(--space-3); }
  .aq-drawing-register__tbc { display: none; }
  .aq-drawing-register__tbn { color: var(--on-navy); }
}
/* Tablets (561 to 860 px): drawings three to a row, and the large drawing beside its notes on the steel blue */
@container (min-width: 561px) and (max-width: 860px) {
  .aq-drawing-register__cells { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .aq-drawing-register__pane.is-on { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .aq-drawing-register__zoom { padding-bottom: var(--space-4); }
}

/* ---------- EvidenceMap: requirement -> how we meet it -> the documents that prove it (table block as "evidence") ----------
   A real table drawn as a mapping. Desktop: the requirement column at h3 with the shared mono index and a hairline on
   its right edge; a hairline leader runs from it to "how", and from "how" into a spine that fans out to each document
   chip. Chips are small file shapes (folded top-right corner, CSS only) in mono. A quiet page link follows.
   Phones: rows stack (number and requirement, how, then files); the fan stays on the left of the files. */
.aq-evidence { min-width: 0; }
.aq-evidence__table { width: 100%; border-collapse: collapse; table-layout: fixed; }
.aq-evidence__table thead th {
  padding: var(--space-3) var(--space-4) var(--space-3) var(--space-12); background: var(--surface-sunken); border-bottom: 1px solid var(--line); text-align: left; vertical-align: bottom;
  font: 500 14px/20px var(--font-sans); color: var(--ink-muted);
}
.aq-evidence__table thead th:first-child { width: 36%; }
.aq-evidence__table thead th:nth-child(2) { width: 31%; padding-left: var(--space-12); }
.aq-evidence__table thead th:nth-child(3) { padding-left: var(--space-12); }
.aq-evidence__row > * { position: relative; padding: var(--space-6) 0; vertical-align: top; text-align: left; border-bottom: 1px solid var(--line); }

/* Requirement: h3, the shared mono index hanging to the left, a hairline on the right edge */
.aq-evidence__t { padding-right: var(--space-6) !important; padding-left: var(--space-12) !important; border-right: 1px solid var(--line); font: 500 20px/28px var(--font-sans); letter-spacing: -0.005em; color: var(--ink); overflow-wrap: break-word; text-wrap: pretty; }
.aq-evidence__n { position: absolute; left: 0; top: var(--space-6); font: 400 13px/28px var(--font-mono); letter-spacing: 0.02em; font-variant-numeric: tabular-nums; color: var(--ink-subtle); }
.aq-evidence__name { display: block; }
.aq-evidence__name a { color: inherit; }

/* How: a leader from the requirement's rule, ending in a dot */
.aq-evidence__how { padding-left: var(--space-12) !important; padding-right: var(--space-4) !important; font: 400 16px/26px var(--font-sans); color: var(--ink-muted); overflow-wrap: break-word; text-wrap: pretty; }
.aq-evidence__how::before { content: ""; position: absolute; left: 0; top: calc(var(--space-6) + 12px); width: var(--space-8); border-top: 1px solid var(--line); }
.aq-evidence__how::after { content: ""; position: absolute; left: calc(var(--space-8) - 2px); top: calc(var(--space-6) + 10px); width: 5px; height: 5px; border-radius: var(--radius-pill); background: var(--flow); }

/* Proof: a leader into a spine that fans out to each file */
.aq-evidence__proof { padding-left: var(--space-12) !important; }
.aq-evidence__proof::before { content: ""; position: absolute; left: 0; top: calc(var(--space-6) + 13px); width: var(--space-4); border-top: 1px solid var(--line); }
.aq-evidence__docs { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
.aq-evidence__docs::before { content: ""; position: absolute; left: calc(-1 * var(--space-8)); top: 13px; bottom: 13px; border-left: 1px solid var(--line); }
.aq-evidence__doc { position: relative; max-width: 100%; }
.aq-evidence__doc::before { content: ""; position: absolute; right: 100%; top: 13px; width: var(--space-8); border-top: 1px solid var(--line); }
.aq-evidence__doc::after { content: ""; position: absolute; left: -4px; top: 11px; border: 3px solid transparent; border-left: 4px solid var(--flow); }

/* File chip: a sheet with its top-right corner folded */
.aq-evidence__file {
  position: relative; display: block; padding: 2px var(--space-4) 2px var(--space-2);
  background: var(--surface-raised); border: 1px solid var(--line); border-radius: var(--radius-0);
  clip-path: polygon(0 0, calc(100% - var(--space-3)) 0, 100% var(--space-3), 100% 100%, 0 100%);
  font: 400 12px/20px var(--font-mono); color: var(--ink); overflow-wrap: anywhere;
}
.aq-evidence__file::after {
  content: ""; position: absolute; top: -1px; right: -1px; width: var(--space-3); height: var(--space-3); box-sizing: border-box;
  border-left: 1px solid var(--line); border-bottom: 1px solid var(--line);
  background: var(--surface-sunken);
}
.aq-evidence__k { margin: 0 0 var(--space-2); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-evidence__docs + .aq-evidence__k { margin-top: var(--space-4); }
/* Grouped files (several evidence columns): the leader enters below the first caption; later spines join the first */
.aq-evidence__proof:has(> .aq-evidence__k:first-child)::before { top: calc(var(--space-6) + var(--space-2) + 29px); }
.aq-evidence__k ~ .aq-evidence__k + .aq-evidence__docs::before { top: calc(-1 * (var(--space-2) + var(--space-4) + 29px)); }
.aq-evidence__go { margin: var(--space-3) 0 0; font: 500 14px/22px var(--font-sans); }
.aq-evidence__proof > .aq-evidence__go:first-child { margin-top: 0; }
.aq-evidence__go a { text-decoration: none; }
.aq-evidence__go a::after { content: "\a0\2192"; }
.aq-evidence__go a:hover { text-decoration: underline; }
@container (max-width: 860px) { .aq-evidence__go a { padding-block: calc(var(--space-3) + var(--space-1) / 2); } }

/* References: clause numbers are not files. On the fan they print as mono text (the standard's name as an eyebrow
   when there are several columns), with the same tick and arrow but no sheet. */
.aq-evidence__doc.is-ref { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-2); }
.aq-evidence__rk { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-evidence__clause { font: 500 15px/26px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink); overflow-wrap: anywhere; }
.aq-evidence__refs + .aq-evidence__k, .aq-evidence__refs + .aq-evidence__docs { margin-top: var(--space-4); }
/* A clause written into the requirement ("· ISO 9001 6.3, 8.5.6"): a mono reference line under the name */
.aq-evidence__ref { display: block; margin-top: var(--space-2); font: 400 13px/20px var(--font-mono); letter-spacing: 0; font-variant-numeric: tabular-nums; color: var(--ink-muted); }
/* "How" as a clause list: the clause numbers in a mono column */
.aq-evidence__clauses { display: grid; gap: var(--space-1); margin: 0; padding: 0; list-style: none; }
.aq-evidence__clauses li { display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr); column-gap: var(--space-2); }
.aq-evidence__cl { font: 500 13px/24px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink); }

@container (max-width: 860px) {
  .aq-evidence__table, .aq-evidence__table tbody, .aq-evidence__row, .aq-evidence__row > * { display: block; }
  .aq-evidence__table thead { display: none; }
  .aq-evidence__table tbody { border-top: 1px solid var(--line); }
  .aq-evidence__row { padding-block: var(--space-6); border-bottom: 1px solid var(--line); }
  .aq-evidence__row > * { padding: 0 !important; border: 0 !important; }
  .aq-evidence__t { padding-left: var(--space-8) !important; font-size: 18px; line-height: 26px; }
  .aq-evidence__n { top: 0; font-size: 13px; line-height: 26px; }
  .aq-evidence__how { margin-top: var(--space-2); padding-left: var(--space-8) !important; font-size: 15px; }
  .aq-evidence__how::after { display: none; }
  .aq-evidence__how::before { left: var(--space-2); top: calc(-1 * var(--space-2)); bottom: 0; width: 0; border-top: 0; border-left: 1px solid var(--line); }
  .aq-evidence__t { padding-bottom: var(--space-1) !important; }
  /* The left connector: a rule down from the number into the fan of files */
  .aq-evidence__proof { margin-top: var(--space-4); padding-left: var(--space-8) !important; }
  .aq-evidence__proof::before { left: var(--space-2); top: calc(-1 * var(--space-4)); width: 0; height: calc(var(--space-4) + 13px); border-top: 0; border-left: 1px solid var(--line); }
  .aq-evidence__proof:has(> .aq-evidence__k:first-child)::before { top: calc(-1 * var(--space-4)); height: calc(var(--space-4) + var(--space-2) + 29px); }
  .aq-evidence__docs::before { left: calc(-1 * var(--space-6)); top: 0; }
  .aq-evidence__doc::before { width: var(--space-6); }
  .aq-evidence__ref { font-size: 12px; line-height: 18px; margin-top: var(--space-1); }
  .aq-evidence__clause { font-size: 14px; line-height: 24px; }
}

/* ---------- Explainer: one idea as a figure plus 3-4 numbered callouts (prose block as "explainer") ----------
   Desktop: the figure in a Plate (a `line` frame on surface-raised) on the left, the numbered callouts on the right,
   separated by `line` hairlines. Phones: plate first, callouts under it. Figures: "levels" (test-tube columns drawn in
   line-strong against a dashed limit) or "art" (the page's equipment drawing with the callouts' numbers pinned on it).
   Numbers on a figure are aria-hidden; the text says it all. */
.aq-explainer { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--space-12); align-items: start; }
.aq-explainer__plate { min-width: 0; }
/* Desktop: the figure stays in view (below the sticky section nav) while the reader works down the points */
.aq-explainer > .aq-explainer__plate { position: sticky; top: calc(var(--space-16) + var(--space-4)); }
.aq-explainer__fig { position: relative; margin: 0; }
.aq-explainer__points { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
.aq-explainer__points > li { display: flex; flex-direction: column; gap: var(--space-2); padding-block: var(--space-6); border-top: 1px solid var(--line); }
.aq-explainer__points > li:first-child { padding-top: 0; border-top: 0; }
.aq-explainer__n { color: var(--ink-subtle); }
.aq-explainer__t { margin: 0; font: 500 20px/28px var(--font-sans); letter-spacing: -0.005em; color: var(--ink); text-wrap: balance; }
.aq-explainer__unit { text-transform: none; }
.aq-explainer__d { margin: 0; max-width: var(--text-max); font: 400 16px/26px var(--font-sans); color: var(--ink-muted); overflow-wrap: break-word; text-wrap: pretty; }
.aq-explainer:has(.aq-explainer__fig--art) { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
.aq-explainer--bare { grid-template-columns: minmax(0, 1fr); }
/* Bare (no figure): the points side by side in one row (up to four; five or more wrap three to a row), each under a
   `line` hairline, so the row reads as one quiet strip rather than a half-empty 2 x 2 */
.aq-explainer--bare .aq-explainer__points { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); column-gap: var(--space-8); border-bottom: 0; }
.aq-explainer--bare .aq-explainer__points:has(> li:nth-child(5)) { grid-auto-flow: row; grid-template-columns: repeat(3, minmax(0, 1fr)); }
.aq-explainer--bare .aq-explainer__points > li, .aq-explainer--bare .aq-explainer__points > li:first-child { padding-top: var(--space-4); border-top: 1px solid var(--line); }

/* Number marker, on a tube or pinned on a drawing: a flow ring with flow digits (a line, not a fill) */
.aq-explainer__mark { display: inline-grid; place-items: center; width: var(--space-6); height: var(--space-6); box-sizing: border-box; border: 1px solid var(--flow); border-radius: var(--radius-pill); background: var(--surface); color: var(--flow); font: 500 12px/1 var(--font-mono); }
.aq-explainer__pin { position: absolute; transform: translate(-50%, -50%); display: flex; }

/* Levels: test-tube columns drawn in line-strong, filled to a value; the limit a dashed fail rule across them */
.aq-levels { display: flex; flex-direction: column; gap: var(--space-6); }
.aq-levels__plot { position: relative; display: grid; grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr)); column-gap: var(--space-6); height: calc(var(--space-32) * 2); padding: var(--space-6) 0 0 var(--space-32); border-bottom: 1px solid var(--line-strong); }
.aq-levels__col { display: flex; justify-content: center; height: 100%; }
.aq-levels__tube { position: relative; width: var(--space-16); height: 100%; }
/* A lip across the tube's open top */
.aq-levels__tube::after { content: ""; position: absolute; top: 0; left: calc(-1 * var(--space-2)); right: calc(-1 * var(--space-2)); border-top: 1.5px solid var(--line-strong); }
.aq-levels__glass { position: absolute; inset: 0; overflow: hidden; border: 1.5px solid var(--line-strong); border-top: 0; border-radius: 0 0 var(--radius-pill) var(--radius-pill); }
.aq-levels__fill { position: absolute; left: 0; right: 0; bottom: 0; height: var(--h, 0%); background: var(--flow-tint); border-top: 1.5px solid var(--flow); }
.aq-levels__fill.is-at, .aq-levels__fill.is-above { border-top-color: var(--fail); }
.aq-levels__top { position: absolute; left: 0; right: 0; bottom: var(--h, 0%); height: 0; }
.aq-levels__top > .aq-explainer__mark { position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%); }
.aq-levels__v { position: absolute; left: calc(100% + var(--space-3)); top: var(--space-1); white-space: nowrap; font: 500 12px/16px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink); }
/* Margin: a dimension line from the fill up to the limit; at or above the limit, "No margin" in fail */
.aq-levels__gap { position: absolute; left: calc(100% + var(--space-3)); font: 500 12px/16px var(--font-mono); white-space: nowrap; }
.aq-levels__gap.is-margin { bottom: var(--h, 0%); height: calc(100% * var(--at, 0.7) - var(--h, 0%)); display: flex; align-items: center; padding-left: var(--space-2); border-left: 1px solid var(--flow); color: var(--flow); }
.aq-levels__gap.is-margin::before, .aq-levels__gap.is-margin::after { content: ""; position: absolute; left: calc(-1 * var(--space-1) - 1px); width: var(--space-2); border-top: 1px solid var(--flow); }
.aq-levels__gap.is-margin::before { top: 0; }
.aq-levels__gap.is-margin::after { bottom: 0; }
.aq-levels__gap.is-none { bottom: calc(var(--h, 0%) - var(--space-12)); color: var(--fail); }
.aq-levels__limit { position: absolute; left: calc(-1 * var(--space-4)); right: 0; bottom: calc((100% - var(--space-6)) * var(--at, 0.7)); border-top: 1.5px dashed var(--fail); }
.aq-levels__limit > span { position: absolute; left: var(--space-4); bottom: var(--space-1); width: calc(var(--space-32) - var(--space-8)); font: 500 12px/16px var(--font-mono); color: var(--fail); }
.aq-levels__keys { padding-left: var(--space-32); display: grid; grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr)); column-gap: var(--space-6); }
.aq-levels__key { display: flex; flex-direction: column; gap: var(--space-1); margin: 0; text-align: center; }
.aq-levels__label { font: 500 14px/20px var(--font-sans); color: var(--ink); }
.aq-levels__note { font: 400 14px/22px var(--font-sans); color: var(--ink-muted); }

@container (max-width: 860px) {
  .aq-explainer > .aq-explainer__plate { position: relative; top: auto; }
  .aq-explainer, .aq-explainer:has(.aq-explainer__fig--art), .aq-explainer--bare .aq-explainer__points { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .aq-explainer__points > li { padding-block: var(--space-4); }
  .aq-explainer__points > li:first-child { padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .aq-explainer--bare .aq-explainer__points { grid-auto-flow: row; row-gap: 0; }
  .aq-explainer__t { font-size: 18px; line-height: 26px; }
  .aq-explainer__d { font-size: 15px; line-height: 24px; }
  .aq-levels { gap: var(--space-4); }
  .aq-levels__plot { height: calc(var(--space-32) * 1.75); column-gap: var(--space-4); padding-left: var(--space-16); }
  .aq-levels__col { justify-content: flex-start; padding-left: var(--space-4); }
  .aq-levels__tube { width: var(--space-8); }
  .aq-levels__v, .aq-levels__gap { left: calc(100% + var(--space-2)); }
  .aq-levels__limit > span { width: calc(var(--space-16) - var(--space-2)); }
  .aq-levels__keys { padding-left: 0; column-gap: var(--space-4); }
  .aq-levels__key { text-align: left; }
  .aq-levels__label { font-size: 13px; line-height: 20px; }
  .aq-levels__note { font-size: 13px; line-height: 20px; }
}

/* ---------- FAQ: question rows under a large outline counter ---------- */
/* Pass 9. The heading column carries the dial: the number of questions in very large outline numerals (line-strong
   stroke, no fill), which turns over to the open question's number ("02", "of 06") while one is open, its stroke in
   flow. The rows: index, the question in Geist 400 22/30, and a square 44 px key holding a drawn plus that turns into a
   minus. The open row is marked by a flow rule down its left edge and its key fills with the action colour. Native
   <details>, so it works without JavaScript; a shared name keeps one answer open. */
.aq-faq-section .aq-split-section__head { top: var(--space-16); }
.aq-faq__dial { display: flex; flex-direction: column; gap: var(--space-2); margin-top: var(--space-8); pointer-events: none; user-select: none; }
.aq-faq__dial-n { display: block; overflow: hidden; height: 0.84em; font: 300 clamp(112px, 13cqi, 188px)/0.84 var(--font-sans); letter-spacing: -0.06em; font-variant-numeric: tabular-nums; }
.aq-faq__dial-n > span { display: block; color: transparent; -webkit-text-stroke: 1px var(--line-strong); transition: -webkit-text-stroke-color 300ms cubic-bezier(0.2, 0, 0, 1); }
.aq-faq__dial-of { display: flex; align-items: center; gap: var(--space-3); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-faq__dial-of::before { content: ""; width: var(--space-8); height: 1.5px; background: var(--line-strong); transition: background-color 300ms cubic-bezier(0.2, 0, 0, 1); }
/* the word beside the rule: "questions" at rest, "of 06" while one is open */
.aq-faq__dial-k { font-variant-numeric: tabular-nums; }
.aq-faq__dial.is-open .aq-faq__dial-n > span { -webkit-text-stroke-color: var(--flow); }
.aq-faq__dial.is-open .aq-faq__dial-of::before { background: var(--flow); }

.aq-faq { display: flex; flex-direction: column; border-bottom: 1px solid var(--line); }
.aq-faq > details { position: relative; border-top: 1px solid var(--line); }
/* the open row's flow rule, drawn down its left edge */
.aq-faq > details::before { content: ""; position: absolute; left: 0; top: -1px; bottom: 0; width: 2px; background: var(--flow); transform-origin: 50% 0; transform: scaleY(0); transition: transform 260ms cubic-bezier(0.2, 0, 0, 1); pointer-events: none; }
.aq-faq > details[open]:not(.is-closing)::before { transform: scaleY(1); }
.aq-faq summary {
  display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr) var(--space-12);
  column-gap: var(--space-4); align-items: start; min-height: 44px; box-sizing: border-box;
  padding: var(--space-6) 0 var(--space-6) var(--space-4); cursor: pointer; list-style: none;
  font: 400 22px/30px var(--font-sans); letter-spacing: -0.012em; color: var(--ink);
}
.aq-faq summary::-webkit-details-marker { display: none; }
.aq-faq summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-faq summary .aq-index { line-height: 30px; transition: color 200ms; }
.aq-faq__q { min-width: 0; text-wrap: pretty; overflow-wrap: break-word; transition: color 200ms, transform 300ms cubic-bezier(0.2, 0, 0, 1); }
.aq-faq summary:hover .aq-faq__q { color: var(--flow); transform: translateX(var(--space-1)); }
.aq-faq summary:hover .aq-index, .aq-faq details[open]:not(.is-closing) summary .aq-index { color: var(--flow); }
/* The key: a 44 px square (radius-sm) with a drawn plus (two 1.5 px bars, aq-faq__glyph); open, the key fills with
   the action colour and the plus turns half a turn as its upright lies flat, a minus. While FAQ/motion.js eases a row
   shut it carries is-closing, so the key turns back with the height. */
.aq-faq__sign {
  justify-self: end; display: inline-grid; place-items: center; width: 44px; height: 44px; margin-block: calc((30px - 44px) / 2); box-sizing: border-box;
  border: 1px solid var(--line-strong); border-radius: var(--radius-sm); color: var(--ink);
  transition: background-color 240ms cubic-bezier(0.2, 0, 0, 1), border-color 240ms cubic-bezier(0.2, 0, 0, 1), color 240ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-faq__glyph { position: relative; display: inline-block; width: 14px; height: 14px; transition: transform 260ms cubic-bezier(0.2, 0, 0, 1); }
.aq-faq__glyph::before, .aq-faq__glyph::after { content: ""; position: absolute; left: 0; top: calc(50% - 0.75px); width: 100%; height: 1.5px; background: currentColor; transition: transform 260ms cubic-bezier(0.2, 0, 0, 1); }
.aq-faq__glyph::after { transform: rotate(90deg); }
.aq-faq summary:hover .aq-faq__sign { border-color: var(--ink); }
.aq-faq details[open]:not(.is-closing) .aq-faq__sign { background: var(--action); border-color: var(--action); color: var(--on-action); }
.aq-faq details[open]:not(.is-closing) .aq-faq__glyph { transform: rotate(180deg); }
.aq-faq details[open]:not(.is-closing) .aq-faq__glyph::after { transform: rotate(0deg); }

/* Answer: under the question column, a step larger than body copy */
.aq-faq__a {
  margin: 0 calc(var(--space-12) + var(--space-4)) 0 calc(var(--space-12) + var(--space-4) + var(--space-4)); padding: 0 0 var(--space-8);
  animation: aq-faq-in 400ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-faq__a p { margin: 0; max-width: var(--text-max); font: 400 17px/28px var(--font-sans); color: var(--ink-muted); }
.aq-faq__a p + p { margin-top: var(--space-2); }
/* The answer's one link (item link): the Button link variant on its own line under the answer */
.aq-faq__a .aq-faq__more { margin-top: var(--space-4); }
/* pass 12 C: the answer's link is a 44 px target at every width (it was 20 px on desktop) */
.aq-faq__a .aq-btn--link { min-height: var(--aq-hit); display: inline-flex; align-items: center; }
@keyframes aq-faq-in { from { opacity: 0; transform: translateY(var(--space-2)); } to { opacity: 1; transform: none; } }
@keyframes aq-faq-fade { from { opacity: 0; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) {
  .aq-faq__a { animation-name: aq-faq-fade; }
  .aq-faq__q, .aq-faq__sign, .aq-faq__glyph, .aq-faq__glyph::before, .aq-faq__glyph::after, .aq-faq > details::before, .aq-faq__dial-n > span { transition: none; }
}

@container (max-width: 860px) {
  /* Phones: no dial (the heading sits right above the rows); smaller rows, the key at 44 px */
  .aq-faq__dial { display: none; }
  .aq-faq summary { grid-template-columns: var(--space-6) minmax(0, 1fr) 44px; column-gap: var(--space-3); padding: var(--space-4) 0 var(--space-4) var(--space-3); font-size: 18px; line-height: 26px; }
  .aq-faq summary .aq-index { line-height: 26px; }
  .aq-faq__sign { margin-block: calc((26px - 44px) / 2); }
  .aq-faq__a { margin: 0 0 0 calc(var(--space-6) + var(--space-3) + var(--space-3)); padding-bottom: var(--space-6); }
  /* answers at the phone answer size (--aq-faq-phone, 15 px; pass 12 S4), so a [placeholder] chip in them is 13 px */
  .aq-faq__a p { font-size: var(--aq-faq-phone, 15px); line-height: 24px; }
}

/* ---------- FaultList: failure modes that open to cause and design control (table block as "failures") ----------
   A list on line hairlines, like a register: each failure is a row with the shared mono index, the failure at h3 and a
   +/- sign. Open, the remaining columns sit side by side under the failure, each led by an eyebrow on a hairline (the
   last one, the design control, on a flow line). No frames, fills or status dots. Phones: the columns stacked. */
.aq-faults { display: flex; flex-direction: column; border-bottom: 1px solid var(--line); }
.aq-faults > details { border-top: 1px solid var(--line); }
.aq-faults summary {
  position: relative; display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr) var(--space-12); align-items: baseline;
  min-height: 44px; padding-block: var(--space-4);
  cursor: pointer; list-style: none; font: 500 20px/28px var(--font-sans); letter-spacing: -0.005em; color: var(--ink);
}
.aq-faults summary::-webkit-details-marker { display: none; }
.aq-faults summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-faults summary .aq-index { line-height: 28px; }
.aq-faults__t { min-width: 0; text-wrap: pretty; overflow-wrap: break-word; }
.aq-faults summary:hover .aq-faults__t { color: var(--flow); }
.aq-faults__sign { justify-self: end; font: 300 20px/28px var(--font-mono); color: var(--ink-muted); }
.aq-faults__sign::before { content: "+"; }
.aq-faults details[open] > summary .aq-index { color: var(--flow); }
.aq-faults details[open] .aq-faults__sign::before { content: "\2212"; }
.aq-faults__body {
  display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); column-gap: var(--space-8);
  margin-left: var(--space-12); margin-right: var(--space-12); padding-bottom: var(--space-6);
}
.aq-faults__body > div { min-width: 0; padding-top: var(--space-3); border-top: 1px solid var(--line); }
.aq-faults__body > div:last-child { border-top-color: var(--flow); }
.aq-faults__k { margin: 0 0 var(--space-2); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-faults__v { margin: 0; font: 400 16px/26px var(--font-sans); color: var(--ink); text-wrap: pretty; overflow-wrap: break-word; }

@container (max-width: 860px) {
  .aq-faults summary { grid-template-columns: var(--space-8) minmax(0, 1fr) var(--space-8); padding-block: var(--space-3); font-size: 18px; line-height: 26px; }
  .aq-faults summary .aq-index { line-height: 26px; }
  .aq-faults__sign { font-size: 18px; line-height: 26px; }
  .aq-faults__body { grid-auto-flow: row; row-gap: var(--space-4); margin-left: var(--space-8); margin-right: 0; padding-bottom: var(--space-4); }
  .aq-faults__v { font-size: 15px; line-height: 23px; }
}

/* ---------- FidelityLadder: design stages as one drawing gaining detail, on a navy blueprint band (look
   "fidelity-ladder"). A grid of sheets (--cols per row), each the same package drawn at its stage's level; under each,
   the run with its node (a closed valve before a hold station), then number, name, text and the hold stamp. ---------- */
.aq-fidelity-ladder {
  list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
  column-gap: var(--space-6); row-gap: var(--space-16); counter-reset: none;
}
.aq-fidelity-ladder__st { position: relative; display: flex; flex-direction: column; min-width: 0; }

/* the sheet */
.aq-fidelity-ladder__sheet {
  position: relative; aspect-ratio: 9 / 5; background: color-mix(in srgb, var(--navy) 90%, var(--on-navy));
  border: 1px solid color-mix(in srgb, var(--on-navy) 26%, transparent);
  outline: 1px solid color-mix(in srgb, var(--on-navy) 12%, transparent); outline-offset: calc(-1 * var(--space-2));
}
.aq-fidelity-ladder__svg { position: absolute; inset: var(--space-3) var(--space-3) var(--space-6); width: calc(100% - 2 * var(--space-3)); height: calc(100% - var(--space-3) - var(--space-6)); overflow: visible; }
.aq-fidelity-ladder__svg * { vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
.aq-fidelity-ladder__ln { fill: none; stroke: var(--on-navy-muted); stroke-width: 1.5; }
.aq-fidelity-ladder__thin { fill: none; stroke: var(--on-navy-muted); stroke-width: 1; }
.aq-fidelity-ladder__hid { fill: none; stroke: var(--on-navy-muted); stroke-width: 1; stroke-dasharray: 4 3; }
.aq-fidelity-ladder__grid { fill: none; stroke: color-mix(in srgb, var(--on-navy) 26%, transparent); stroke-width: 1; }
.aq-fidelity-ladder__txt { fill: none; stroke: color-mix(in srgb, var(--on-navy) 30%, transparent); stroke-width: 4; stroke-linecap: butt; }
.aq-fidelity-ladder__flow { fill: none; stroke: color-mix(in srgb, var(--flow) 55%, var(--on-navy)); stroke-width: 2; }
.aq-fidelity-ladder__box { fill: color-mix(in srgb, var(--navy) 90%, var(--on-navy)); stroke: var(--on-navy-muted); stroke-width: 1.5; }
.aq-fidelity-ladder__alt { fill: none; stroke: var(--on-navy-muted); stroke-width: 1; stroke-dasharray: 4 3; }
.aq-fidelity-ladder__lbl { font: 400 11px/1 var(--font-mono); fill: var(--on-navy-muted); stroke: none; letter-spacing: 0.04em; }
.aq-fidelity-ladder__jc { fill: color-mix(in srgb, var(--navy) 90%, var(--on-navy)); stroke: color-mix(in srgb, var(--flow) 55%, var(--on-navy)); stroke-width: 1.5; }
.aq-fidelity-ladder__no, .aq-fidelity-ladder__lvl {
  position: absolute; bottom: var(--space-2); font: 400 12px/16px var(--font-mono); letter-spacing: 0.06em; color: var(--on-navy-muted); text-transform: uppercase;
}
.aq-fidelity-ladder__no { left: var(--space-3); }
.aq-fidelity-ladder__lvl { right: var(--space-3); color: var(--on-navy); }
/* the freeze stamp on the approved sheet */
.aq-fidelity-ladder__frz {
  position: absolute; left: 8%; top: 12%; width: var(--space-16); height: var(--space-16); display: grid; place-items: center; border-radius: 50%;
  border: 3px double var(--limestone); color: var(--limestone); font: 500 16px/1 var(--font-mono); letter-spacing: 0.08em; transform: rotate(-12deg);
}

/* the run: a line across the top of the text, a node per stage, a closed valve before a hold station */
.aq-fidelity-ladder__run { position: relative; display: block; height: var(--space-12); }
.aq-fidelity-ladder__run::before {
  content: ""; position: absolute; left: 0; right: calc(-1 * var(--space-6)); top: 50%; border-top: 2px solid color-mix(in srgb, var(--flow) 55%, var(--on-navy));
}
.aq-fidelity-ladder__st.is-eol .aq-fidelity-ladder__run::before, .aq-fidelity-ladder__st.is-last .aq-fidelity-ladder__run::before { right: 0; }
.aq-fidelity-ladder__st.is-eol .aq-fidelity-ladder__run::after {
  content: ""; position: absolute; right: 0; top: 50%; width: var(--space-2); height: var(--space-2); margin-top: calc(-1 * var(--space-1));
  border-top: 2px solid color-mix(in srgb, var(--flow) 55%, var(--on-navy)); border-right: 2px solid color-mix(in srgb, var(--flow) 55%, var(--on-navy)); transform: translateY(-1px) rotate(45deg);
}
.aq-fidelity-ladder__node {
  position: absolute; left: var(--space-8); top: 50%; width: var(--space-3); height: var(--space-3); transform: translate(-50%, -50%); border-radius: 50%;
  background: var(--navy); border: 2px solid var(--on-navy);
}
.aq-fidelity-ladder__st.is-hold .aq-fidelity-ladder__node { background: var(--limestone); border-color: var(--limestone); }
.aq-fidelity-ladder__valve {
  position: absolute; left: 0; top: 50%; width: var(--space-6); height: var(--space-6); transform: translateY(-62%);
  fill: var(--navy); stroke: var(--limestone); stroke-width: 1.5; stroke-linejoin: round; overflow: visible;
}

/* the text */
.aq-fidelity-ladder__body { display: flex; flex-direction: column; gap: var(--space-2); padding-left: var(--space-8); }
.aq-fidelity-ladder__n { font: 400 13px/16px var(--font-mono); color: var(--on-navy-muted); letter-spacing: 0.04em; }
.aq-fidelity-ladder__t { margin: 0; font: 400 22px/28px var(--font-sans); letter-spacing: -0.01em; color: var(--on-navy); }
.aq-fidelity-ladder__t a { color: inherit; text-decoration: none; }
.aq-fidelity-ladder__t a:hover { text-decoration: underline; text-underline-offset: 3px; }
.aq-fidelity-ladder__d { margin: 0; font: 400 15px/23px var(--font-sans); color: var(--on-navy-muted); text-wrap: pretty; max-width: 42ch; }
.aq-fidelity-ladder__hold { margin: var(--space-2) 0 0; }
.aq-fidelity-ladder__stamp {
  display: inline-flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); align-items: baseline; padding: var(--space-1) var(--space-3);
  border: 1.5px solid var(--limestone); color: var(--limestone); font: 400 13px/18px var(--font-mono); transform: rotate(-1.5deg); transform-origin: 0 50%;
}
.aq-fidelity-ladder__stamp-k { font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; font-size: 12px; }

/* hover: the sheet being read lifts its lines to full strength */
.aq-fidelity-ladder__st:hover .aq-fidelity-ladder__sheet { border-color: var(--on-navy-muted); }
.aq-fidelity-ladder__st:hover .aq-fidelity-ladder__node { background: var(--on-navy); }

@container (max-width: 860px) {
  .aq-fidelity-ladder { grid-template-columns: minmax(0, 1fr); row-gap: 0; }
  .aq-fidelity-ladder__st { padding: 0 0 var(--space-12) var(--space-8); }
  /* the run turns vertical down the left edge */
  .aq-fidelity-ladder__run { position: absolute; left: 0; top: 0; bottom: 0; width: var(--space-6); height: auto; }
  .aq-fidelity-ladder__run::before { left: 50%; right: auto; top: 0; bottom: 0; border-top: 0; border-left: 2px solid color-mix(in srgb, var(--flow) 55%, var(--on-navy)); }
  .aq-fidelity-ladder__st.is-last .aq-fidelity-ladder__run::before { bottom: auto; height: var(--space-6); }
  .aq-fidelity-ladder__st.is-eol .aq-fidelity-ladder__run::after { display: none; }
  .aq-fidelity-ladder__node { left: 50%; top: var(--space-6); }
  .aq-fidelity-ladder__valve { left: 0; top: 0; transform: rotate(90deg); background: var(--navy); }
  .aq-fidelity-ladder__st.is-hold .aq-fidelity-ladder__node { top: calc(var(--space-6) + var(--space-4)); }
  .aq-fidelity-ladder__body { padding: var(--space-4) 0 0; }
  .aq-fidelity-ladder__t { font-size: 20px; line-height: 26px; }
}
.aq-section.aq-fidelity-ladder-sec { overflow-x: clip; }
.aq-fidelity-ladder__j { transform-box: fill-box; transform-origin: center; }

/* pass 12 phone (optional item, svc-design.1): the sheets at 70 % of the column (their footer labels stay 12 px),
   less space between stages; about 400 px shorter, the ladder reads the same. */
@container (max-width: 860px) {
  .aq-fidelity-ladder__sheet { width: 70%; }
  .aq-fidelity-ladder__st { padding-bottom: var(--space-10, 40px); }
}
/* verify V7: at 70 % the sheets' inner drawing labels (PRE, RO, EDI, TANK, ...) render about 4 px; they are sheet
   texture (the sheets are aria-hidden), so phones drop them and keep the drawing and the 12 px footers. */
@container (max-width: 860px) { .aq-fidelity-ladder__lbl { display: none; } }

/* pass 12 round C (svc-design.1, phone height 2,258 px): at 600 px and under each stage is a two-column grid, the
   sheet as a 120 px thumbnail in column 1 with the numeral and title beside it in column 2, then the body and the HOLD
   stamp full width under both. The thumbnail keeps its level label (11 px); the sheet number repeats the numeral
   beside it, so it drops; the inner drawing labels stay hidden (they would render under 11 px). */
@container (max-width: 600px) {
  .aq-fidelity-ladder__st {
    display: grid; grid-template-columns: 120px minmax(0, 1fr); grid-template-rows: auto auto 1fr; column-gap: 12px;
    align-content: start; padding-block: 20px;
  }
  .aq-fidelity-ladder__body { display: contents; }
  .aq-fidelity-ladder__sheet { grid-column: 1; grid-row: 1 / span 3; width: auto; align-self: start; }
  .aq-fidelity-ladder__svg { inset: var(--space-1) var(--space-1) 20px; width: calc(100% - 2 * var(--space-1)); height: calc(100% - var(--space-1) - 20px); }
  .aq-fidelity-ladder__no { display: none; }
  .aq-fidelity-ladder__lvl { bottom: var(--space-1); right: var(--space-2); font-size: 11px; line-height: 14px; }
  .aq-fidelity-ladder__frz { width: var(--space-8); height: var(--space-8); border-width: 2px; font-size: 11px; left: 6%; top: 8%; }
  .aq-fidelity-ladder__n { grid-column: 2; grid-row: 1; align-self: start; }
  .aq-fidelity-ladder__t { grid-column: 2; grid-row: 2; align-self: start; margin-top: var(--space-1); }
  .aq-fidelity-ladder__d { grid-column: 1 / -1; grid-row: 4; margin-top: var(--space-2); max-width: none; }
  .aq-fidelity-ladder__hold { grid-column: 1 / -1; grid-row: 5; margin-top: var(--space-2); }
  .aq-fidelity-ladder__node { top: 36px; }
  .aq-fidelity-ladder__valve { top: var(--space-2); }
  .aq-fidelity-ladder__st.is-hold .aq-fidelity-ladder__node { top: 60px; }
  .aq-fidelity-ladder__st.is-last .aq-fidelity-ladder__run::before { height: 36px; }
  /* the first stage starts at the top of the list and the last ends at its foot (the section padding spaces them) */
  .aq-fidelity-ladder__st:first-child { padding-top: 0; }
  .aq-fidelity-ladder__st:first-child:not(.is-hold) .aq-fidelity-ladder__node { top: 16px; }
  .aq-fidelity-ladder__st.is-last { padding-bottom: 0; }
}

/* pass 12 round C fix round (tablet, 601-860 px, was 3,001 px): the same two-column stage, the sheet a 200 px
   thumbnail in column 1 and the numeral, title, body and HOLD stamp all in column 2 beside it. */
@container (min-width: 601px) and (max-width: 860px) {
  .aq-fidelity-ladder__st {
    display: grid; grid-template-columns: 200px minmax(0, 1fr); grid-template-rows: auto auto auto auto 1fr; column-gap: var(--space-6);
    align-content: start; padding-block: var(--space-8);
  }
  .aq-fidelity-ladder__body { display: contents; }
  .aq-fidelity-ladder__sheet { grid-column: 1; grid-row: 1 / -1; width: auto; align-self: start; }
  .aq-fidelity-ladder__no { display: none; }
  .aq-fidelity-ladder__frz { width: var(--space-10, 40px); height: var(--space-10, 40px); border-width: 2px; font-size: 12px; left: 6%; top: 8%; }
  .aq-fidelity-ladder__n { grid-column: 2; grid-row: 1; }
  .aq-fidelity-ladder__t { grid-column: 2; grid-row: 2; margin-top: var(--space-1); }
  .aq-fidelity-ladder__d { grid-column: 2; grid-row: 3; margin-top: var(--space-2); max-width: none; }
  .aq-fidelity-ladder__hold { grid-column: 2; grid-row: 4; margin-top: var(--space-4); }
  .aq-fidelity-ladder__node { top: 44px; }
  .aq-fidelity-ladder__valve { top: var(--space-4); }
  .aq-fidelity-ladder__st.is-hold .aq-fidelity-ladder__node { top: 68px; }
  .aq-fidelity-ladder__st.is-last .aq-fidelity-ladder__run::before { height: 44px; }
  .aq-fidelity-ladder__st:first-child { padding-top: 0; }
  .aq-fidelity-ladder__st:first-child:not(.is-hold) .aq-fidelity-ladder__node { top: 12px; }
  .aq-fidelity-ladder__st.is-last { padding-bottom: 0; }
}

/* ---------- GateLine: steps strung on one double-line pipe, gate valves between them (look "gate-line") ----------
   A navy band, the page's one navy (round C: no data-theme="dark"; the water is --gl-flow, flow lightened toward
   on-navy as on the other navy bands, so it holds on navy in both themes). Equal columns, one per step, no gap, so the runs join
   into one pipe. Each column: a hairline icon, its run of pipe (two on-navy-muted walls, flow water inside; the
   shutdown step's run is dry: a dashed bore and its label), then number (light 40 px), name (light 22 px), line and
   hold stamp. A PP diaphragm valve (P&ID bow-tie body, domed bonnet, no stem) sits on the joint at the left of every step but the first; the
   hold reads once, as the stamp under its step. The pipe leaves at the right through an arrow. A legend over the pipe
   names the water. Phones: one column; the pipe runs down the left, the valves turned with it; icon, number, name
   and line on the right. */
.aq-gate-line-sec { --gl-flow: color-mix(in srgb, var(--flow) 40%, var(--on-navy)); --focus: var(--gl-flow, var(--flow)); }
/* placeholders on navy: a dashed on-navy outline, as on the other navy looks (the band is no longer data-theme dark) */
.aq-gate-line-sec .aq-ph { background: transparent; color: var(--on-navy); outline: 1px dashed var(--on-navy-muted); outline-offset: -1px; }
.aq-gate-line-sec .aq-sec-head .aq-h1 { font: 300 56px/60px var(--font-sans); letter-spacing: -0.03em; color: var(--on-navy); }
.aq-gate-line__legend { display: flex; align-items: center; justify-content: flex-end; gap: var(--space-3); margin: 0; font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy); }
.aq-gate-line__sw { width: var(--space-8); height: var(--space-2); background: var(--gl-flow, var(--flow)); }
.aq-gate-line { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr)); }
.aq-gate-line__step { position: relative; display: grid; grid-template-rows: calc(var(--space-16) + var(--space-8)) var(--space-4) auto; min-width: 0; }
.aq-gate-line__ic { align-self: end; padding: 0 var(--space-4) var(--space-6) var(--space-8); }
.aq-gate-line__ic .aq-icon { display: block; width: var(--space-12); height: var(--space-12); background: var(--on-navy-muted); transition: background-color 160ms ease; }
.aq-gate-line__step:hover .aq-gate-line__ic .aq-icon { background: var(--gl-flow, var(--flow)); }

/* the run of pipe: walls, water or a dry bore */
.aq-gate-line__run { position: relative; display: block; }
.aq-gate-line__walls { position: absolute; inset: 0; border-top: 1.5px solid var(--on-navy-muted); border-bottom: 1.5px solid var(--on-navy-muted); }
.aq-gate-line__water { position: absolute; inset: var(--space-1) 0; background: var(--gl-flow, var(--flow)); transform-origin: 0 0; }
.aq-gate-line__dry { position: absolute; inset: var(--space-1) var(--space-6); border: 1.5px dashed var(--on-navy-muted); }
.aq-gate-line__dl { position: absolute; right: calc(-1 * var(--space-6)); bottom: calc(100% + var(--space-6)); white-space: nowrap; font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy); }
.aq-gate-line__out { position: absolute; right: calc(-1 * var(--space-1)); top: 50%; width: var(--space-4); height: var(--space-4); border-top: 1.5px solid var(--on-navy); border-right: 1.5px solid var(--on-navy); transform: translateY(-50%) rotate(45deg); }

/* the diaphragm valve on the joint */
.aq-gate-line__gate { position: absolute; z-index: 1; left: 0; top: 50%; width: var(--space-8); translate: -50% -63.2%; }
.aq-gate-line__vsvg { display: block; width: 100%; height: auto; aspect-ratio: 28 / 38; overflow: visible; }
.aq-gate-line__vb { fill: var(--navy); stroke: var(--on-navy); stroke-width: 1.5; stroke-linejoin: round; }
.aq-gate-line__vfill { fill: var(--on-navy); fill-opacity: 0; }
.aq-gate-line__vh { fill: none; stroke: var(--on-navy); stroke-width: 1.5; stroke-linejoin: round; }

/* the step's text */
.aq-gate-line__txt { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-8) var(--space-6) 0 var(--space-8); }
.aq-gate-line__n { font: 300 40px/1 var(--font-sans); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; color: var(--on-navy); }
.aq-gate-line__t { margin: var(--space-2) 0 0; font: 300 22px/28px var(--font-sans); letter-spacing: -0.01em; color: var(--on-navy); text-wrap: balance; }
.aq-gate-line__go { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
.aq-gate-line__d { margin: 0; font: 400 14px/21px var(--font-sans); color: var(--on-navy-muted); text-wrap: pretty; }
.aq-gate-line__hold { margin: var(--space-2) 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font: 400 13px/18px var(--font-mono); color: var(--on-navy); }
.aq-gate-line__who { font-size: 14px; line-height: 20px; }
.aq-gate-line__hk { padding: 0 var(--space-2); border: 1.5px solid var(--gl-flow, var(--flow)); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }

@container (max-width: 860px) {
  .aq-gate-line-sec .aq-sec-head .aq-h1 { font: 300 36px/42px var(--font-sans); }
  .aq-gate-line__legend { justify-content: flex-start; }
  .aq-gate-line { grid-template-columns: minmax(0, 1fr); }
