  position: relative; flex: 1 1 0; min-width: 0; counter-increment: aq-form-step;
  display: flex; flex-direction: column; gap: var(--space-2); padding-right: var(--space-3);
  font: 500 14px/20px var(--font-sans); color: var(--ink-subtle);
}
.aq-form__progress li::before {
  content: counter(aq-form-step); position: relative; z-index: 1; display: grid; place-items: center;
  width: var(--space-8); height: var(--space-8); box-sizing: border-box; border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
  background: var(--surface-raised); font: 400 13px/1 var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink-muted);
  transition: background-color 300ms cubic-bezier(0.2, 0, 0, 1), border-color 300ms cubic-bezier(0.2, 0, 0, 1), color 300ms cubic-bezier(0.2, 0, 0, 1);
}
/* the line from this node to the next */
.aq-form__progress li:not(:last-child)::after {
  content: ""; position: absolute; left: var(--space-8); right: 0; top: calc(var(--space-4) - 0.5px); height: 1px; background: var(--line-strong);
  transform-origin: 0 50%; transition: background-color 300ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-form__progress li:has(~ li[aria-current="step"])::before { border-color: var(--flow); color: var(--flow); }
.aq-form__progress li:has(~ li[aria-current="step"])::after { height: 1.5px; background: var(--flow); transform: scaleX(var(--aq-fill, 1)); }
.aq-form__progress li:has(~ li[aria-current="step"]) { color: var(--ink-muted); }
.aq-form__progress li[aria-current="step"] { color: var(--ink); }
.aq-form__progress li[aria-current="step"]::before { background: var(--action); border-color: var(--action); color: var(--on-action); }
.aq-form__step[hidden] { display: none; }
.aq-form__step > .aq-form__actions { margin-top: var(--space-8); }
/* The block note under the last step's actions, space-4 below the buttons (scoped so the page's p reset, .aq-page p,
   does not set it flush against them) */
.aq-form .aq-form__note { margin: var(--space-4) 0 0; }
.aq-form__step > .wform-msg { display: block; margin-top: var(--space-2); }

/* Submit band */
.aq-form__actions {
  display: flex; gap: var(--space-4); align-items: center; flex-wrap: wrap;
  padding-top: var(--space-6); border-top: 1px solid var(--line);
}
/* A single sheet's block note (the privacy notice link) sits in its submit band, on its own line under the button:
   space-4 below it, as a stepped form's note under its last step's actions */
.aq-form .aq-form__actions > .aq-form__note { flex: 1 0 100%; margin: 0; }
/* Until it has something to say, the band's status line takes no place (out of the flex flow, still a live region), so
   on phones, where the button fills the line, it adds no empty row above the note */
.aq-form__actions > .wform-msg:empty { position: absolute; }

/* With motion the current step also wears a ring (aq-form__mark, made by EnquiryForm/motion.js) that slides to the
   new step's node with Flip, as the water reaches it. */
.aq-form__mark { position: absolute; z-index: 2; left: calc(-1 * var(--space-1)); top: calc(-1 * var(--space-1)); width: calc(var(--space-8) + var(--space-2)); height: calc(var(--space-8) + var(--space-2)); box-sizing: border-box; border: 1.5px solid var(--flow); border-radius: var(--radius-sm); pointer-events: none; }
.aq-form__actions .aq-btn--primary { min-height: var(--space-12); padding-inline: var(--space-6); }
@media (prefers-reduced-motion: reduce) { .aq-form__progress li::before, .aq-form__progress li::after, .aq-form .aq-checks label { transition: none; } }
/* Pass 9b feedback (EnquiryForm/motion.js, ported from Subframe Motion).
   task-steps: a passed step's node shows a tick instead of its number and springs in (--aq-pop, 0.8 to 1). */
.aq-form__progress li:has(~ li[aria-current="step"])::before { content: "\2713"; content: "\2713" / ""; font-size: 15px; transform: scale(var(--aq-pop, 1)); }
/* border-beam: one lap of a flow light round the group being filled in (a conic light in a 1 px ring, just outside it) */
.wform .aq-field, .wform .aq-fieldset { position: relative; }
.aq-form__beam {
  position: absolute; inset: calc(-1 * var(--space-2)); border-radius: var(--radius-md); pointer-events: none; opacity: 0;
  padding: 1px; background: conic-gradient(from var(--aq-a, 0deg), transparent 0 70%, color-mix(in srgb, var(--flow) 40%, transparent) 84%, var(--flow) 94%, transparent 100%);
  -webkit-mask: linear-gradient(black, black) content-box, linear-gradient(black, black); -webkit-mask-composite: xor;
  mask: linear-gradient(black, black) content-box exclude, linear-gradient(black, black);
}
/* address-check: the field's border turns over 150 ms; a field put right shows a pass tick after its label */
.wform .aq-field__input { transition: border-color 150ms cubic-bezier(0.2, 0, 0, 1), box-shadow 150ms cubic-bezier(0.2, 0, 0, 1); }
.aq-form__ok { display: inline-grid; place-items: center; vertical-align: -2px; margin-left: var(--space-2); color: var(--pass); }
/* loading-button: the submit's faces share one grid cell, so the button keeps its width through pending and error */
.aq-form__faces { display: inline-grid; align-items: center; justify-items: center; }
.aq-form__face { grid-area: 1 / 1; display: inline-flex; align-items: center; gap: var(--space-2); }
.aq-form__face.is-pending, .aq-form__face.is-error { opacity: 0; visibility: hidden; }
.aq-form__submit[data-face="error"] { background: var(--fail); border-color: var(--fail); color: var(--surface); }
@media (prefers-reduced-motion: reduce) { .wform .aq-field__input { transition: none; } }

@container (max-width: 860px) {
  /* Phones: tighter panel, one column, full-width submit */
  .aq-form { gap: var(--space-6); padding: 0 var(--space-4) var(--space-6); }
  .aq-form .aq-form__title { margin-inline: calc(-1 * var(--space-4) - 1px); padding: var(--space-3) var(--space-4); }
  .aq-form__progress li { font-size: 13px; line-height: 18px; padding-right: var(--space-2); }
  .aq-form__num { font-size: 22px; line-height: 26px; }
  .aq-form__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .aq-form__legend { margin-bottom: var(--space-4); font-size: 18px; line-height: 26px; }
  .aq-form__submit { width: 100%; justify-content: center; }
}

/* ---------- Pass 12 (visual audit) ----------
   - Item numbers count only the fields showing (wRenum in parts/EnquiryForm.js); a hidden field's empty ref takes no room.
   - Fields in a two-column row start at the top of their cell: a neighbour with a help line no longer stretches this
     field's label row and pushes its input down (contact-locations "Number of visitors", 20 px lower than "Preferred dates").
   - Phones: short option lists (aq-checks--short: four or more options of 20 characters or fewer) in two columns; the
     progress list's step names at the 14 px reading floor. */
.aq-form__ref:empty { display: none; }
.aq-form__grid > .aq-field { align-content: start; }
@container (max-width: 860px) {
  /* two columns only where a cell is 140 px or more (288 px inside the panel at 375 px); one column at 360 px; labels at the 14 px reading floor, where
     "Troubleshooting" ran past its 136 px cell (pass 12 verify M2) */
  .aq-form .aq-checks--short { grid-template-columns: repeat(auto-fit, minmax(min(100%, calc(var(--space-32) + var(--space-3))), 1fr)); }
  .aq-form .aq-checks--short label { gap: var(--space-2); padding-inline: var(--space-2); font-size: var(--aq-read-phone, 14px); line-height: 20px; overflow-wrap: normal; -webkit-hyphens: auto; hyphens: auto; }
  .aq-form__progress li { font-size: var(--aq-read-phone, 14px); line-height: 20px; }
}

/* ---------- TextField ---------- */
.aq-field { display: grid; gap: var(--space-2); max-width: 420px; min-width: 0; }
.aq-field__label { font: 500 14px/20px var(--font-sans); color: var(--ink); }
.aq-field__optional { font-weight: 400; color: var(--ink-muted); }
.aq-field__input {
  width: 100%; height: 44px; padding: 0 var(--space-4); box-sizing: border-box;
  background: var(--surface-raised); color: var(--ink);
  border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
  font: 400 16px/24px var(--font-sans);
}
textarea.aq-field__input { height: auto; min-height: 120px; padding: var(--space-3) var(--space-4); resize: vertical; }
.aq-field__input::placeholder { color: var(--ink-subtle); }
.aq-field__input:hover { border-color: var(--ink-muted); }
.aq-field__input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-color: var(--ink); }
.aq-field__suffix { position: relative; }
.aq-field__suffix .aq-field__input { padding-right: 64px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.aq-field__unit { position: absolute; right: var(--space-4); top: 50%; transform: translateY(-50%); font: 400 14px/20px var(--font-mono); color: var(--ink-muted); }
.aq-field__help { margin: 0; font: 400 14px/22px var(--font-sans); color: var(--ink-muted); }
/* Focus: the field's border and label take flow while the keyboard ring sits outside it */
.aq-field__input:focus { border-color: var(--flow); }
.aq-field:focus-within > .aq-field__label, .aq-fieldset:focus-within > .aq-field__label { color: var(--flow); }
.aq-field:focus-within .aq-form__ref { color: var(--flow); }
/* Error: fail border with a fail edge on the left, and one line under the field saying what to fix */
.aq-field.is-error .aq-field__input { border-color: var(--fail); box-shadow: inset 3px 0 0 var(--fail); }
.aq-field.is-error .aq-field__help { color: var(--ink-muted); }
.aq-field__error { display: flex; align-items: baseline; gap: var(--space-2); margin: 0; font: 500 14px/20px var(--font-sans); color: var(--fail); }
.aq-field__error::before { content: "!"; content: "!" / ""; flex: none; display: inline-grid; place-items: center; width: var(--space-4); height: var(--space-4); border-radius: var(--radius-pill); background: var(--fail); color: var(--surface); font: 600 11px/1 var(--font-mono); transform: translateY(2px); }
.aq-fieldset.is-error .aq-checks label { border-color: var(--fail); }
.aq-fieldset.is-error > .aq-field__error { margin-top: var(--space-2); }
@media (prefers-reduced-motion: no-preference) {
  .aq-field__input, .aq-field__label { transition: border-color 120ms, box-shadow 120ms, color 120ms; }
}
.aq-fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
.aq-checks { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }
.aq-checks label { display: inline-flex; gap: var(--space-2); align-items: center; font: 400 15px/24px var(--font-sans); color: var(--ink); }
