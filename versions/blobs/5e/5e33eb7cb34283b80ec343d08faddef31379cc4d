.aq-spec:not(.aq-spec--compare) tbody tr.is-highlight { background: var(--flow-tint); }
.aq-spec:not(.aq-spec--compare) tbody tr.is-highlight ~ tr.is-highlight { background: none; border-left: 2px solid var(--flow); }
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead + tr.is-lead { border-top: 1px solid var(--line); }
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead + tr:not(.is-lead), .aq-spec:not(.aq-spec--compare) tbody tr.is-lead + tr:not(.is-lead) + tr { border-top: 0; }
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead th { font: 500 20px/28px var(--font-sans); letter-spacing: -0.005em; }
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead .aq-spec__value { align-self: center; font: 400 20px/28px var(--font-mono); letter-spacing: -0.01em; }
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead .aq-spec__status { justify-self: start; }
.aq-spec:not(.aq-spec--compare) tbody tr.is-highlight:not(.is-lead) { margin-inline: calc(var(--space-4) * -1); padding-inline: var(--space-4); }
.aq-spec:not(.aq-spec--compare) tbody tr.is-highlight ~ tr.is-highlight:not(.is-lead) { padding-left: calc(var(--space-4) - 2px); }

/* Readout lead row: a lead row whose value holds a number sets that limit as the section's one readout figure
   (Geist Mono 300 40/44, the unit beside it in ink-muted), with the parameter, the full value and the basis to its
   right. Same flow-tint band as any lead row. The figure is aria-hidden; the value cell keeps the full text. */
.aq-spec:not(.aq-spec--compare) tbody tr.is-lead.is-readout {
  grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); grid-template-areas: "r p" "r v" "r m" "r s"; grid-template-rows: auto auto auto 1fr;
  column-gap: var(--space-8); row-gap: var(--space-1); align-items: start;
}
.aq-spec:not(.aq-spec--compare) tbody tr.is-readout > .aq-spec__read { grid-area: r; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-2); align-self: center; }
.aq-spec__read-n { font: 300 40px/44px var(--font-mono); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--ink); white-space: nowrap; }
.aq-spec__read-u { font: 400 14px/20px var(--font-mono); color: var(--ink-muted); }
.aq-spec:not(.aq-spec--compare) tbody tr.is-readout th { font: 500 20px/28px var(--font-sans); }
.aq-spec:not(.aq-spec--compare) tbody tr.is-readout .aq-spec__value { align-self: start; font: 400 14px/24px var(--font-mono); }
.aq-spec:not(.aq-spec--compare) tbody tr.is-readout .aq-spec__method { color: var(--ink-muted); }

/* Row link (rows[].link): a quiet page link under the basis, "FAT and SAT →" */
.aq-spec__link { display: block; margin-top: var(--space-1); font: 500 14px/20px var(--font-sans); color: var(--flow); text-decoration: none; }
.aq-spec__link::after { content: "\a0\2192"; content: "\a0\2192" / ""; }
.aq-spec__link:hover { text-decoration: underline; text-underline-offset: 3px; }
.aq-spec__link:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
/* Note link (block fields note_link, note_link_label): the note's last words, a text link in the same grammar inline
   in the small line, "… water. What it costs to run →" */
.aq-spec__note-link { font-weight: 500; color: var(--flow); text-decoration: none; }
.aq-spec__note-link::after { content: "\a0\2192"; content: "\a0\2192" / ""; }
.aq-spec__note-link:hover { text-decoration: underline; text-underline-offset: 3px; }
.aq-spec__note-link:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* Status words for results */
.aq-status { display: inline-flex; align-items: center; gap: var(--space-1); font: 500 14px/24px var(--font-sans); }
.aq-status--pass { color: var(--pass); }
.aq-status--caution { color: var(--caution); }
.aq-status--fail { color: var(--fail); }

@container (max-width: 860px) {
  /* Phone: compact rows on hairlines. Line 1 the parameter; line 2 the value; line 3 the basis (13 px muted), then the
     link (44 px hit area). The column-label strip is hidden on screen (kept for screen readers). */
  .aq-spec:not(.aq-spec--compare) thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .aq-spec:not(.aq-spec--compare) tbody { display: block; padding-inline: 0; background: none; border-bottom: 1px solid var(--line); }
  .aq-spec:not(.aq-spec--compare) tbody tr,
  .aq-spec:not(.aq-spec--compare) tbody tr.is-highlight { display: block; margin: 0; padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .aq-spec:not(.aq-spec--compare) tbody tr.is-highlight,
  .aq-spec:not(.aq-spec--compare) tbody tr.is-highlight:not(.is-lead) { margin: 0; padding-inline: var(--space-3); }
  .aq-spec:not(.aq-spec--compare) tbody th,
  .aq-spec:not(.aq-spec--compare) tbody tr.is-lead th { display: block; margin-bottom: var(--space-1); font: 400 16px/24px var(--font-sans); }
  .aq-spec:not(.aq-spec--compare) tbody tr.is-lead th { font: 500 18px/26px var(--font-sans); }
  .aq-spec:not(.aq-spec--compare) .aq-spec__value,
  .aq-spec:not(.aq-spec--compare) tbody tr.is-lead .aq-spec__value { display: block; font: 400 14px/22px var(--font-mono); letter-spacing: 0; }
  .aq-spec:not(.aq-spec--compare) .aq-spec__method,
  .aq-spec:not(.aq-spec--compare) tbody tr.is-highlight .aq-spec__method { display: block; margin-top: var(--space-1); font-size: 13px; line-height: 20px; }
  .aq-spec__link { display: inline; margin: 0; padding-block: calc(var(--space-3) + var(--space-1) / 2); font-size: 13px; line-height: 20px; }
  .aq-spec__note-link { padding-block: calc(var(--space-3) + var(--space-1) / 2); }
  .aq-spec:not(.aq-spec--compare) tbody tr.is-lead.is-readout { display: block; padding: var(--space-4) var(--space-3); }
  .aq-spec:not(.aq-spec--compare) tbody tr.is-readout > .aq-spec__read { display: flex; margin-bottom: var(--space-2); }
  .aq-spec__read-n { font-size: 32px; line-height: 36px; }
  .aq-spec:not(.aq-spec--compare) tbody tr.is-readout th { font: 500 18px/26px var(--font-sans); }
  .aq-spec:not(.aq-spec--compare) tbody tr.is-readout .aq-spec__value { font-size: 14px; line-height: 22px; }
  .aq-spec:not(.aq-spec--compare) tbody tr.is-readout .aq-spec__method { display: block; }
}

/* ---------- StandardTag ---------- */
.aq-tag {
  display: inline-flex; align-items: center; height: 28px; padding: 0 var(--space-3);
  border: 1px solid var(--line-strong); border-radius: var(--radius-pill);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em; color: var(--ink);
  background: transparent; white-space: nowrap; text-decoration: none;
}
a.aq-tag:hover { border-color: var(--ink); }
a.aq-tag:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
@media (prefers-reduced-motion: no-preference) { a.aq-tag { transition: border-color 120ms; } }
.aq-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }

/* Narrow containers: a long standard name wraps inside its tag */
@container (max-width: 860px) {
  .aq-tag { max-width: 100%; white-space: normal; height: auto; }
}

/* ---------- EnquiryForm: the enquiry as a numbered data sheet ---------- */
/* A quiet panel (surface-raised, one line hairline) holding an eyebrow title row, numbered fieldsets (1.0, 2.0)
   with numbered items (1.1, 1.2) and one submit band. Separation by hairlines only. */
.aq-form {
  position: relative;
  display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8);
  max-width: 880px; min-width: 0; box-sizing: border-box;
  padding: 0 var(--space-8) var(--space-8);
