/* ---------- BuildingLoop: a building section on a navy band, one pale loop threading the floors to numbered stops (look "building-loop") ---------- */
/* The figure is three tracks: margin names | drawing | margin names. The margins stretch to the drawing's height and
   each name sits at its stop's height (--y, a fraction the look computes), so nothing is measured. */
.aq-building-loop { display: flex; flex-direction: column; gap: var(--space-8); }
.aq-building-loop__fig { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3.4fr) minmax(0, 1fr); column-gap: var(--space-4); border-top: 1px solid color-mix(in srgb, var(--on-navy-muted) 30%, transparent); padding-top: var(--space-8); }
.aq-building-loop__draw { min-width: 0; }
.aq-building-loop__svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-building-loop__svg path, .aq-building-loop__svg circle { fill: none; stroke-linecap: round; stroke-linejoin: round; }
.aq-building-loop__gr { stroke: var(--on-navy-muted); stroke-width: 1.5; }
.aq-building-loop__wall { stroke: var(--on-navy-muted); stroke-width: 2; }
.aq-building-loop__slab { stroke: var(--on-navy-muted); stroke-width: 4; opacity: 0.55; }
.aq-building-loop__hair { stroke: var(--on-navy-muted); stroke-width: 1; opacity: 0.45; }
.aq-building-loop__win { stroke: var(--on-navy-muted); stroke-width: 3; opacity: 0.4; }
.aq-building-loop__svg .aq-building-loop__fx { fill: var(--navy); stroke: var(--on-navy); stroke-width: 1.4; }
.aq-building-loop__fl { stroke: var(--on-navy-muted); stroke-width: 1; }
.aq-building-loop__loop { stroke: var(--limestone); stroke-width: 3.5; }
.aq-building-loop__glint { stroke: none; }
.aq-building-loop__drop { stroke: var(--limestone); stroke-width: 2; }
.aq-building-loop__lead { stroke: var(--on-navy-muted); stroke-width: 1; stroke-dasharray: 3 4; }
.aq-building-loop__svg .aq-building-loop__tick { fill: var(--navy); stroke: var(--on-navy); stroke-width: 1.4; }
.aq-building-loop__svg .aq-building-loop__ring { r: 16px; fill: var(--navy); stroke: var(--limestone); stroke-width: 2; }
.aq-building-loop__num { fill: var(--on-navy); font: 500 15px/1 var(--font-mono); text-anchor: middle; dominant-baseline: central; }
.aq-building-loop__stop * { transition: stroke 200ms ease, fill 200ms ease; }
.aq-building-loop__stop.is-hot .aq-building-loop__ring, .aq-building-loop__stop.is-hot .aq-building-loop__tick { fill: var(--flow); stroke: var(--on-navy); }
.aq-building-loop__stop.is-hot .aq-building-loop__lead { stroke: var(--flow); stroke-dasharray: none; }
.aq-building-loop__stop.is-hot .aq-building-loop__fx { stroke: var(--flow); }
/* margin names, level with their stops */
.aq-building-loop__margin { position: relative; min-width: 0; }
.aq-building-loop__label {
  position: absolute; top: calc(var(--y, 0.5) * 100%); transform: translateY(-50%); left: 0; right: 0;
  font: 400 15px/20px var(--font-sans); color: var(--on-navy); text-wrap: balance; transition: color 200ms ease;
}
.aq-building-loop__margin--l .aq-building-loop__label { text-align: end; }
.aq-building-loop__ln { font: 500 12px/20px var(--font-mono); color: var(--on-navy-muted); white-space: nowrap; }
.aq-building-loop__label.is-hot, .aq-building-loop__label.is-hot .aq-building-loop__ln { color: var(--flow); }
/* captions: one column per stop on hairlines */
.aq-building-loop__caps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr)); border-top: 1px solid color-mix(in srgb, var(--on-navy-muted) 40%, transparent); }
.aq-building-loop__cap { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-3); row-gap: var(--space-2); align-content: start; padding: var(--space-4) var(--space-4) 0; border-left: 1px solid color-mix(in srgb, var(--on-navy-muted) 30%, transparent); position: relative; }
.aq-building-loop__cap:first-child { border-left: 0; padding-left: 0; }
.aq-building-loop__cap::before { content: ""; position: absolute; left: 0; right: 0; top: -1px; border-top: 2px solid var(--flow); transform: scaleX(0); transform-origin: 0 50%; transition: transform 300ms cubic-bezier(0.2, 0, 0, 1); }
.aq-building-loop__cap.is-hot::before { transform: scaleX(1); }
.aq-building-loop__no { display: grid; place-items: center; width: calc(var(--space-6) + var(--space-2)); height: calc(var(--space-6) + var(--space-2)); border: 1.5px solid var(--limestone); border-radius: var(--radius-pill); font: 500 12px/1 var(--font-mono); color: var(--on-navy); transition: background-color 200ms ease; }
.aq-building-loop__cap.is-hot .aq-building-loop__no { background: var(--flow); }
.aq-building-loop__t { margin: 0; align-self: center; font: 500 16px/22px var(--font-sans); color: var(--on-navy); text-wrap: balance; }
.aq-building-loop__d { grid-column: 2; margin: 0; font: 400 14px/22px var(--font-sans); color: var(--on-navy-muted); text-wrap: pretty; }
.aq-building-loop-sec { position: relative; }

@container (max-width: 1100px) {
  .aq-building-loop__fig { grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr) minmax(0, 1fr); }
  .aq-building-loop__label { font-size: 14px; line-height: 18px; }
  .aq-building-loop__cap { grid-template-columns: minmax(0, 1fr); padding-left: var(--space-3); }
  .aq-building-loop__d { grid-column: 1; }
  /* the drawing renders at ~420 px here: larger rings and numerals so they stay legible (phones override below) */
  .aq-building-loop__svg .aq-building-loop__ring { r: 20px; }
  .aq-building-loop__num { font-size: 20px; }
}
/* wide: one-line and two-line caption titles take the same height, so every body starts level */
@container (min-width: 1101px) {
  .aq-building-loop__t { min-height: 44px; display: flex; align-items: center; }
}
/* Phones: the drawing at full width with its numbered stops, then a riser: the pale loop down the left, a row per stop */
@container (max-width: 860px) {
  .aq-building-loop { gap: var(--space-6); }
  .aq-building-loop__fig { display: block; padding-top: var(--space-6); }
  .aq-building-loop__margin { display: none; }
  .aq-building-loop__svg .aq-building-loop__ring { r: 26px; stroke-width: 3; }
  .aq-building-loop__num { font-size: 28px; }
  .aq-building-loop__loop { stroke-width: 5; }
  .aq-building-loop__lead, .aq-building-loop__tick { display: none; }
  .aq-building-loop__caps { display: block; position: relative; border-top: 0; padding-left: calc(var(--space-12) + var(--space-2)); }
  .aq-building-loop__caps::before { content: ""; position: absolute; left: calc(var(--space-4) + var(--space-1) - 1px); top: var(--space-2); bottom: var(--space-6); border-left: 3px solid var(--limestone); border-radius: var(--radius-pill); }
  .aq-building-loop__cap, .aq-building-loop__cap:first-child { display: block; position: relative; border-left: 0; padding: 0 0 var(--space-6); }
  .aq-building-loop__cap::before { display: none; }
  .aq-building-loop__no { position: absolute; left: calc(-1 * (var(--space-12) + var(--space-2))); top: calc(-1 * var(--space-1)); width: calc(var(--space-8) + var(--space-1)); height: calc(var(--space-8) + var(--space-1)); background: var(--navy); border-width: 2px; }
  .aq-building-loop__t { font-size: 17px; line-height: 24px; }
  .aq-building-loop__d { margin-top: var(--space-1); font-size: var(--aq-read-phone, 14px); line-height: 22px; }
}
