/* ---------- Button ---------- */
.aq-btn {
  display: inline-flex; align-items: center; gap: var(--space-2);
  height: 44px; padding: 0 var(--space-6);
  border: 1px solid transparent; border-radius: var(--radius-sm);
  font: 500 14px/20px var(--font-sans); letter-spacing: 0; white-space: nowrap;
  text-decoration: none; cursor: pointer;
  transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), border-color 200ms cubic-bezier(0.2, 0, 0, 1), transform 120ms cubic-bezier(0.2, 0, 0, 1);
}
/* Pass 9b motion (Button/motion.js). The transform is one composition so every effect can share it:
   --aq-mx / --aq-my: the primary's magnetic pull (px, numbers); --aq-px / --aq-py: where the press landed (-1..1).
   Press (press-depth): the button sinks a pixel, shrinks to 0.97 and tips up to 3 deg toward the press point, 60 ms
   down and 180 ms back; the arrow pulls back, like a key going down. While the magnet follows the pointer (is-magnet)
   the transform is driven frame by frame, so its transition is dropped. */
.aq-btn { transform: translate(calc(var(--aq-mx, 0) * 1px), calc(var(--aq-my, 0) * 1px)); }
.aq-btn:active:not([disabled]) {
  transform: translate(calc(var(--aq-mx, 0) * 1px), calc(var(--aq-my, 0) * 1px)) perspective(340px)
    rotateX(calc(var(--aq-py, 0) * -3deg)) rotateY(calc(var(--aq-px, 0) * 3deg)) translateY(1px) scale(0.97);
  transition-duration: 60ms;
}
.aq-btn:not(:active) { transition-duration: 200ms, 200ms, 180ms; }
.aq-btn.is-magnet:not(:active) { transition-property: background-color, border-color; }
/* Secondary hover (slide-text): the label rolls up and its copy (a text-shadow one button-height down) rolls in */
.aq-btn--secondary { overflow: hidden; }
.aq-btn__label { display: inline-flex; align-items: center; gap: inherit; }
.aq-btn:active:not([disabled]) .aq-btn__arrow { transform: translateX(1px); }
.aq-btn--primary { background: var(--action); color: var(--on-action); }
.aq-btn--primary:hover { background: var(--action-hover); }
.aq-btn--secondary { background: transparent; color: var(--ink); border-color: var(--line-strong); }
.aq-btn--secondary:hover { border-color: var(--ink); }
.aq-btn--link { height: auto; padding: 0; color: var(--flow); background: none; }
.aq-btn--link:hover { text-decoration: underline; text-underline-offset: 4px; }
.aq-btn[disabled] { background: var(--surface-sunken); color: var(--ink-subtle); border-color: transparent; cursor: not-allowed; }
/* Pending call: a call button whose number is still a [placeholder]. A <span>, not a link: the label as plain text in the
   ground's own colour, no fill or frame, so the draft shows the missing number and nothing pretends to dial */
.aq-btn.aq-btn--pending { padding: 0; background: none; border-color: transparent; color: inherit; cursor: default; }
.aq-btn.aq-btn--pending:active { transform: none; }
.aq-btn__arrow { transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-btn:hover .aq-btn__arrow, .aq-btn:focus-visible .aq-btn__arrow { transform: translateX(4px); }

@media (prefers-reduced-motion: reduce) {
  .aq-btn, .aq-btn__arrow { transition: none; }
  .aq-btn, .aq-btn:active:not([disabled]), .aq-btn:active:not([disabled]) .aq-btn__arrow { transform: none; }
}

/* Narrow containers: long labels wrap inside the button instead of running off the screen */
@container (max-width: 860px) {
  .aq-btn { height: auto; min-height: 44px; max-width: 100%; padding-block: var(--space-3); white-space: normal; text-align: left; }
  .aq-btn--link { min-height: 44px; padding: 0; justify-content: flex-start; }
}

/* ---------- BackToTop: a quiet floating button that returns to the top of a long page ---------- */
/* Fixed bottom right. Hidden (and out of the tab order) within the first screen; one screen down it fades in and stays
   while the reader scrolls on, in either direction (BackToTop.js).
   A control, so radius-sm and a line-strong rule; it floats, so it takes shadow-overlay (the brand book's one shadow). */
.aq-back-to-top {
  position: fixed; right: var(--space-8); bottom: var(--space-8); z-index: 30;
  display: inline-flex; align-items: center; gap: var(--space-2); height: 44px; padding: 0 var(--space-4);
  background: var(--surface-raised); color: var(--ink); border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
  box-shadow: var(--shadow-overlay); font: 500 14px/20px var(--font-sans); cursor: pointer;
  opacity: 0; visibility: hidden; transform: translateY(var(--space-2));
  transition: opacity 200ms cubic-bezier(0.2, 0, 0, 1), transform 200ms cubic-bezier(0.2, 0, 0, 1), visibility 0s linear 200ms, border-color 200ms, color 200ms;
}
.aq-back-to-top.is-shown { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
.aq-back-to-top:hover { border-color: var(--ink); }
.aq-back-to-top:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-back-to-top__arrow { color: var(--flow); font-family: var(--font-mono); transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-back-to-top:hover .aq-back-to-top__arrow { transform: translateY(calc(-1 * var(--space-1))); }

@media (prefers-reduced-motion: reduce) {
  .aq-back-to-top, .aq-back-to-top__arrow { transition: none; transform: none; }
}

/* Phones (pass 12, S1): the arrow alone in a 44 px square on the solid page ground, 16 px in from the edge and kept
   inside a 56 px bottom safe area (16 px inset plus the device's own inset, so it clears a home bar). BackToTop.js steps
   it aside while the footer is partly in view (its disclosure chevrons); the footer keeps 56 px clear under its legal
   line for it at the page end. The label stays for screen
   readers. */
@container (max-width: 860px) {
  .aq-back-to-top {
    right: var(--space-4); bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    width: var(--aq-hit); height: var(--aq-hit); padding: 0; justify-content: center; background: var(--surface);
  }
  .aq-back-to-top__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
}

/* ---------- Footer: the site map on navy ---------- */
/* The brand footer as the site first drew it, with its spacing: navy in both themes; the Limestone logo at 160 px with one line of
   description and the contact line, then four sitemap columns in one row, headed in the eyebrow style in Limestone; the legal
   line under a faint Limestone hairline. Tablets: the head and the columns two by two; phones (600 px and under): the
   columns as disclosures (below). */
.aq-footer { background: var(--navy); color: var(--on-navy-muted); padding-block: var(--space-16) var(--space-8); }
.aq-footer__cols { display: grid; grid-template-columns: minmax(0, 1.3fr) repeat(4, minmax(0, 1fr)); gap: var(--space-8); }
.aq-footer__head { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
.aq-footer__logo { display: block; width: 160px; height: auto; }
.aq-footer__desc { margin: 0; font: 400 14px/22px var(--font-sans); color: var(--on-navy-muted); }
.aq-footer__col { min-width: 0; }
.aq-footer .aq-footer__colhead { margin: 0 0 var(--space-3); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--limestone); }
/* Links: 14/20 with 4 px above and below (pass 12 C, G-C1): single-line items keep the 28 px pitch, and a link that wraps
   sets its two lines 20 px apart, closer than the gap to the next link, so it reads as one item. The 4 px is padding,
   not margin (round C verify F3), so each link's hit box is the full 28 px on a touch tablet. The column name is a
   plain heading here; its phone toggle is hidden. */
.aq-footer__links { display: flex; flex-direction: column; align-items: flex-start; }
.aq-footer a { display: block; color: var(--on-navy-muted); text-decoration: none; font: 400 14px/20px var(--font-sans); }
.aq-footer .aq-footer__links a { margin-block: 0; padding-block: var(--space-1); }
.aq-footer__toggle { display: none; }
.aq-footer a:hover { color: var(--on-navy); text-decoration: underline; text-underline-offset: 4px; }
.aq-footer a:focus-visible { outline: 2px solid var(--limestone); outline-offset: 2px; }

/* Contact line under the description: service number, sales number, head office, one per line in 14/22 on-navy-muted.
   A confirmed number is a tel: link (hover and focus as the other links); a [placeholder] stays text. */
.aq-footer__contact { display: flex; flex-direction: column; align-items: flex-start; margin: 0; font: 400 14px/22px var(--font-sans); font-style: normal; color: var(--on-navy-muted); }
/* Links inside the contact and legal lines keep the line's own type */
.aq-footer .aq-footer__contact a, .aq-footer .aq-footer__legal a { display: inline; font: inherit; }

/* Legal line along the bottom, under a faint Limestone hairline */
.aq-footer__legal {
  display: flex; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap;
  margin-top: var(--space-12); padding-top: var(--space-6);
  border-top: 1px solid color-mix(in srgb, var(--limestone) 25%, transparent);
  font: 400 13px/20px var(--font-sans); color: var(--on-navy-muted);
}

/* Desktop (round C verify F1): BackToTop shows idle at the page end, 127 x 44 at 32 px from the right and bottom, which
   is on the legal line. The line keeps 160 px clear at its right end (the button, its inset and a gap), so the
   Privacy · Terms · Accessibility links sit left of it. No height change. */
@container (min-width: 861px) {
  .aq-footer__legal { padding-right: calc(var(--space-32) + var(--space-8)); }
}

@container (max-width: 860px) {
  .aq-footer__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* 56 px under the legal line (pass 12 S1): the fixed back-to-top square (16 px inset, 44 px) never covers it */
  .aq-footer { padding-bottom: calc(56px + var(--space-4) + env(safe-area-inset-bottom, 0px)); }
}

/* Phones, 600 px and under (pass 12 C, G-C1/F1): the brand block full width, then the four columns as disclosures, one
   under the other. Each head is a 48 px button in the column-head style with the PhoneKit chevron (aria-expanded,
   Footer.js); Company opens first. An open column shows its links two to a row, each a 44 px target (flex, 20 px line
   height, so a wrapped label stays one item). The legal links are 44 px too. About 800 px in all, from 1,361. */
@container (max-width: 600px) {
  .aq-footer { padding-top: calc(var(--space-8) + var(--space-2)); }
  .aq-footer__cols { grid-template-columns: minmax(0, 1fr); gap: 0; }
  .aq-footer__cols > :first-child { grid-column: 1 / -1; gap: var(--space-3); padding-bottom: var(--space-4); }
  .aq-footer__col { border-top: 1px solid color-mix(in srgb, var(--limestone) 18%, transparent); }
  .aq-footer .aq-footer__colhead { margin: 0; }
  .aq-footer__colname { display: none; }
  .aq-footer__toggle {
    display: flex; align-items: center; width: 100%; min-height: 48px; margin: 0; padding: 0; border: 0; background: none; cursor: pointer;
    font: inherit; letter-spacing: inherit; text-transform: inherit; color: inherit; text-align: left;
  }
  .aq-footer__toggle:focus-visible { outline: 2px solid var(--limestone); outline-offset: -2px; }
  .aq-footer__toggle .aq-phone-kit__chev { margin-right: calc(-1 * var(--space-3)); }
  .aq-footer__links { display: none; }
  .aq-footer__col.is-open .aq-footer__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-4); }
  .aq-footer .aq-footer__links a { display: flex; align-items: center; min-height: var(--aq-hit); margin: 0; padding-block: 0; line-height: 20px; }
  .aq-footer__legal { margin-top: 0; padding-top: var(--space-3); gap: 0 var(--space-4); }
  .aq-footer .aq-footer__legal a { display: inline-flex; align-items: center; min-height: var(--aq-hit); }
}

/* ---------- NavBar and phone menu ---------- */
/* Quiet header on surface: logo left, six sections in sentence case (each a button that opens its mega panel), the
   "Service request" link and one primary button right, a line rule below. */
.aq-nav {
  position: relative; display: flex; align-items: center; gap: var(--space-8);
  height: 72px; padding: 0 var(--space-8);
  background: var(--surface); border-bottom: 1px solid var(--line);
}
.aq-nav__home { display: flex; align-items: center; }
.aq-nav__logo { width: 112px; height: auto; }
.aq-nav__logo--lockup { width: 152px; }

.aq-nav__links { display: flex; align-items: center; gap: var(--space-6); margin: 0; padding: 0; list-style: none; flex: 1; min-width: 0; }
/* The items stay unpositioned: an open panel is placed against the bar (.aq-nav), full width under it */
.aq-nav__item { display: flex; align-items: center; }
/* Section buttons (and a plain section link), and the service link (a utility link, not a section) styled as one */
.aq-nav__trigger {
  display: inline-flex; align-items: center; gap: var(--space-1); margin: 0; padding: 0; border: 0; background: none; cursor: pointer;
}
.aq-nav__links > li > a, .aq-nav__trigger, .aq-nav__service {
  color: var(--ink-muted); text-decoration: none; font: 500 14px/20px var(--font-sans); white-space: nowrap;
  transition: color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-nav__links > li > a:hover, .aq-nav__links > li > a[aria-current="page"], .aq-nav__trigger:hover, .aq-nav__trigger[aria-current], .aq-nav__trigger[aria-expanded="true"],
.aq-nav__service:hover, .aq-nav__service[aria-current="page"] { color: var(--ink); }
/* The chevron: two 1.5 px strokes in currentColor; it turns over while the panel is open */
.aq-nav__chev { position: relative; flex: none; width: 8px; height: 8px; transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.aq-nav__chev::before {
  content: ""; position: absolute; left: 1.5px; top: 0.5px; width: 5px; height: 5px;
  border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg);
}
.aq-nav__trigger[aria-expanded="true"] .aq-nav__chev { transform: rotate(180deg); }
/* The links take the free width on wide screens; the spacer only works in the compact bar (here it would add a gap) */
.aq-nav__spacer { display: none; }
.aq-nav__frame { display: inline-flex; }
.aq-nav__toggle { display: none; }

/* Theme switch: a quiet 44 px icon button between the service link and the proposal button, kept in the compact bar
   beside the menu toggle. It shows the theme it switches to: a moon in light, a sun in dark (the same selector pattern
   as the logo swap in base.css). Strokes in currentColor, ink-muted turning ink on hover like the section labels. */
.aq-nav__theme {
  display: inline-flex; align-items: center; justify-content: center; flex: none;
  width: var(--aq-hit); height: var(--aq-hit); margin: 0 calc(-1 * var(--space-2)); padding: 0;
  background: none; border: 0; border-radius: var(--radius-sm); color: var(--ink-muted); cursor: pointer;
  transition: color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-nav__theme:hover { color: var(--ink); }
.aq-nav__theme:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
.aq-nav__theme svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.aq-nav__sun { display: none; }
[data-theme="dark"] .aq-nav__moon { display: none; }
[data-theme="dark"] .aq-nav__sun { display: block; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .aq-nav__moon { display: none; }
  :root:not([data-theme="light"]) .aq-nav__sun { display: block; }
}
@media (prefers-reduced-motion: reduce) { .aq-nav__theme { transition: none; } }

/* Menu: the urgent block, the sections, the page's section jump, then the proposal button, on surface */
.aq-menu { display: none; }
.aq-menu__list { display: grid; margin: 0; padding: 0; list-style: none; }
.aq-menu__list > li > a {
  display: flex; align-items: baseline; gap: var(--space-3); min-height: 44px;
  padding: var(--space-3) 0; color: var(--ink); text-decoration: none;
  font: 400 20px/28px var(--font-sans); letter-spacing: -0.005em; border-bottom: 1px solid var(--line);
}
.aq-menu__list--jump a { font: 400 16px/24px var(--font-sans); color: var(--ink-muted); padding-block: var(--space-2); }
.aq-menu__list > li > a[aria-current] { color: var(--ink); }
.aq-menu__list > li > a[aria-current]::after { content: "→"; content: "→" / ""; margin-left: auto; color: var(--flow); }
.aq-menu__jump { display: grid; }
.aq-menu__label {
  padding: var(--space-6) 0 var(--space-2);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
.aq-menu__cta { display: flex; }
.aq-menu__cta .aq-btn { flex: 1; justify-content: center; }

/* Urgent block, first in the menu: "Production stopped?", the service number (a tel: link once confirmed, the
   placeholder until then) under a "Call" eyebrow, the hours it is answered, then the service request row. On limestone
   with on-limestone text; data-theme="light" on the block keeps its placeholder, hairline, arrow and focus ring on the
   light values, since limestone stays light in both themes. Text, not a heading: the menu's outline does not change. */
.aq-menu__urgent { display: grid; gap: var(--space-2); padding: var(--space-4); background: var(--limestone); color: var(--on-limestone); }
.aq-menu__ask { margin: 0; font: 500 14px/20px var(--font-sans); color: var(--on-limestone); }
.aq-menu__call {
  display: block; min-height: 44px; padding-block: var(--space-2);
  font: 400 20px/28px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--on-limestone); text-decoration: none; overflow-wrap: anywhere;
}
.aq-menu__k {
  display: inline-block; margin-right: var(--space-3);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted);
}
a.aq-menu__call:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
/* The hours the number is answered, right under it: the number never shows without them */
.aq-menu__hours { margin: 0; font: 400 14px/20px var(--font-sans); color: var(--on-limestone-muted); }
.aq-menu__service {
  display: flex; align-items: baseline; gap: var(--space-3); min-height: 44px;
  padding-top: var(--space-3); border-top: 1px solid var(--line-strong); color: var(--on-limestone); text-decoration: none;
  font: 400 20px/28px var(--font-sans); letter-spacing: -0.005em;
}
.aq-menu__service[aria-current]::after { content: "→"; content: "→" / ""; margin-left: auto; color: var(--flow); }

@media (prefers-reduced-motion: reduce) {
  .aq-nav__links > li > a, .aq-nav__trigger, .aq-nav__chev, .aq-nav__service { transition: none; }
}

/* Hover and focus: a flow rule draws under the label from its left end */
.aq-nav__links > li > a, .aq-nav__trigger, .aq-nav__service { position: relative; }
.aq-nav__links > li > a::before, .aq-nav__trigger::before, .aq-nav__service::before {
  content: ""; position: absolute; left: 0; right: 0; bottom: calc(-1 * var(--space-1)); height: 1px; background: var(--flow);
  transform: scaleX(0); transform-origin: 0 50%; transition: transform 240ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-nav__links > li > a:hover::before, .aq-nav__links > li > a:focus-visible::before, .aq-nav__trigger:hover::before, .aq-nav__trigger:focus-visible::before,
.aq-nav__trigger[aria-expanded="true"]::before, .aq-nav__service:hover::before, .aq-nav__service:focus-visible::before { transform: scaleX(1); }
.aq-nav__links > li > a[aria-current="page"]::before, .aq-nav__trigger[aria-current]::before, .aq-nav__service[aria-current="page"]::before { content: none; }
.aq-menu__list a, .aq-menu__service { transition: color 160ms cubic-bezier(0.2, 0, 0, 1); }
@media (prefers-reduced-motion: reduce) { .aq-nav__links > li > a::before, .aq-nav__trigger::before, .aq-nav__service::before, .aq-menu__list a, .aq-menu__service { transition: none; } }

/* Mid widths: tighten the gaps (at the wide spacing the full bar needs about 1,140 px) */
@container (max-width: 1120px) {
  .aq-nav { gap: var(--space-4); padding: 0 var(--space-6); }
  .aq-nav__links { gap: var(--space-3); }
  .aq-nav .aq-nav__logo--lockup { width: 140px; }
}

/* Compact bar: the logo, six section buttons, service link and button need about 1,010 px at the mid spacing, so up to
   1,040 px the sections and the button hide and the toggle opens the menu, which carries all of them */
@container (max-width: 1040px) {
  .aq-nav__links, .aq-nav__service, .aq-nav > .aq-nav__frame { display: none; }
  .aq-nav__spacer { display: block; flex: 1; }
  .aq-nav__toggle { display: inline-flex; }
  .aq-menu {
    display: grid; gap: var(--space-6); padding: var(--space-2) var(--space-6) var(--space-8);
    background: var(--surface); border-bottom: 1px solid var(--line);
  }
}

/* The same compact form when the labels outgrow the bar at any width (is-tight, set by the width guard in NavBar.js) */
.aq-nav.is-tight .aq-nav__links, .aq-nav.is-tight .aq-nav__service, .aq-nav.is-tight > .aq-nav__frame { display: none; }
.aq-nav.is-tight .aq-nav__spacer { display: block; flex: 1; }
.aq-nav.is-tight .aq-nav__toggle { display: inline-flex; }
.aq-nav.is-tight + .aq-menu {
  display: grid; gap: var(--space-6); padding: var(--space-2) var(--space-6) var(--space-8);
  background: var(--surface); border-bottom: 1px solid var(--line);
}

@container (max-width: 860px) {
  .aq-nav { height: 64px; padding: 0 var(--space-4); gap: var(--space-4); }
  .aq-nav .aq-nav__logo--lockup { width: 112px; }
  .aq-menu { padding-inline: var(--space-4); }
}

/* Pass 9b (NavBar/motion.js). The wide bar's sliding rule (sliding-tabs): one flow rule under the current section that
   slides to the link under the pointer or keyboard focus; 100 px wide, scaled to the link, so it moves on transforms.
   With it on (has-mark) the per-link rules stand down. Without motion the per-link rules above stay. */
/* The rule is placed against the bar (the items stay unpositioned for the panels): a line-height's half below the bar's
   middle, plus space-1, as the per-link rules sit */
.aq-nav__links > .aq-nav__mark { position: absolute; left: 0; top: calc(50% + 10px + var(--space-1)); width: 100px; height: 1px; background: var(--flow); transform-origin: 0 50%; opacity: 0; pointer-events: none; }
.aq-nav.has-mark .aq-nav__links > li > a::before, .aq-nav.has-mark .aq-nav__trigger::before { content: none; }
/* The toggle's mark: two bars that cross while the menu is open (curtain-index's toggle), beside the words */
.aq-nav__toggle { gap: var(--space-3); }
.aq-nav__burger { position: relative; display: inline-block; flex: none; width: 18px; height: 12px; }
.aq-nav__burger > i { position: absolute; left: 0; width: 100%; height: 1.5px; background: currentColor; transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.aq-nav__burger > i:first-child { top: 2.25px; }
.aq-nav__burger > i:last-child { top: 8.25px; }
.aq-nav__toggle[aria-expanded="true"] .aq-nav__burger > i:first-child { transform: translateY(3px) rotate(45deg); }
.aq-nav__toggle[aria-expanded="true"] .aq-nav__burger > i:last-child { transform: translateY(-3px) rotate(-45deg); }
@media (prefers-reduced-motion: reduce) { .aq-nav__burger > i { transition: none; } }
.aq-nav__toggle-t { white-space: nowrap; }

/* ---------- Mega panels (pass 12): one per section, full width under the bar ----------
   Not modal (no scrim) and not a landmark; it lives in its button's <li> and is placed against the bar. Above the
   SectionNav (5) and the look layers, below BackToTop (30). Tall panels scroll inside on short laptops. */
.aq-mega {
  position: absolute; top: 100%; left: 0; right: 0; z-index: 20;
  max-height: calc(100dvh - var(--mega-top, 72px)); overflow: auto; overscroll-behavior: contain;
  background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line-strong); box-shadow: var(--shadow-overlay);
  font: 400 16px/24px var(--font-sans); color: var(--ink); white-space: normal;
}
.aq-mega[hidden], .aq-mega__bg[hidden] { display: none; }
/* The shared backdrop that the switch between two open panels springs (NavBar/motion.js); hidden at rest */
.aq-mega__bg {
  position: absolute; top: 100%; left: 0; right: 0; z-index: 19; height: 0; pointer-events: none;
  background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line-strong); box-shadow: var(--shadow-overlay);
}
.aq-nav.is-morph .aq-mega { background: transparent; border-color: transparent; box-shadow: none; }
.aq-mega__in {
  display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-8); row-gap: var(--space-6);
  max-width: var(--content-max); margin-inline: auto; padding: var(--space-8);
}
.aq-mega__head { grid-column: 1 / 4; display: grid; align-content: start; gap: var(--space-2); }
.aq-mega__groups { grid-column: 4 / 10; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-8); row-gap: var(--space-6); align-content: start; }
.aq-mega__groups--n1 { grid-template-columns: minmax(0, 1fr); }
.aq-mega__groups--n1 ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-8); }
.aq-mega__groups--n3 { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-6); }
.aq-mega__in--nofeat .aq-mega__groups { grid-column: 4 / -1; }
/* The groups stand side by side in one row; their labels share one track, so a label that wraps to two lines moves
   every column's first link down together */
@supports (grid-template-rows: subgrid) {
  .aq-mega__groups:not(.aq-mega__groups--n1) { grid-template-rows: auto auto; }
  .aq-mega__groups:not(.aq-mega__groups--n1) > .aq-mega__group { grid-row: span 2; grid-template-rows: subgrid; row-gap: var(--space-2); }
}
.aq-mega__feat { grid-column: 10 / 13; align-self: start; }
.aq-mega__foot { grid-column: 1 / -1; }

/* Head: the section name (a label, not a heading), the lead line, the overview link */
.aq-mega__name, .aq-mega__label, .aq-mega__eyebrow {
  margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
.aq-mega__lead { margin: 0; font: 400 16px/24px var(--font-sans); color: var(--ink); max-width: 36ch; text-wrap: pretty; }
.aq-mega__all, .aq-mega__more { color: var(--ink); text-decoration: none; font: 500 14px/20px var(--font-sans); }
.aq-mega__all { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; justify-self: start; }
.aq-mega__all::after, .aq-mega__more::after, .aq-mega__task::after { content: "→"; content: "→" / ""; color: var(--flow); display: inline-block; transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.aq-mega__more::after, .aq-mega__task::after { margin-left: var(--space-1); }
.aq-mega__all:hover::after, .aq-mega__more:hover::after, .aq-mega__task:hover::after, .aq-mega__feat:hover .aq-mega__tail::after { transform: translateX(4px); }

/* Groups: a label, then links (title and one-line description), each block 44 px or more */
.aq-mega__group { display: grid; align-content: start; gap: var(--space-2); }
.aq-mega__group ul, .aq-mega__tasks ul { margin: 0; padding: 0; list-style: none; }
.aq-mega__link { display: block; min-height: 44px; padding-block: var(--space-2); color: var(--ink); text-decoration: none; }
.aq-mega__t {
  font: 500 16px/24px var(--font-sans); color: var(--ink);
  background: linear-gradient(var(--flow), var(--flow)) 0 100% / 0 1px no-repeat; transition: background-size 240ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-mega__link:hover .aq-mega__t, .aq-mega__link:focus-visible .aq-mega__t, .aq-mega__feat:hover .aq-mega__t, .aq-mega__feat:focus-visible .aq-mega__t { background-size: 100% 1px; }
.aq-mega__link[aria-current] .aq-mega__t::after { content: " →"; content: " →" / ""; color: var(--flow); }
.aq-mega__d { display: block; margin-top: var(--space-1); font: 400 14px/20px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

/* Featured card: a real destination (guide, note, audit route), on sunken with a hairline, plate corners */
.aq-mega__feat {
  display: grid; align-content: start; justify-items: start; gap: var(--space-2); padding: var(--space-6);
  background: var(--surface-sunken); border: 1px solid var(--line); border-radius: var(--radius-0); color: var(--ink); text-decoration: none;
}
.aq-mega__feat .aq-spot.aq-mega__icon { width: var(--space-12); height: var(--space-12); margin-bottom: var(--space-2); background-color: var(--flow); }
.aq-mega__feat .aq-mega__t { font: 400 20px/28px var(--font-sans); letter-spacing: -0.005em; text-wrap: balance; }
/* The title's last word and its arrow (aq-mega__tail) never part */
.aq-mega__tail { white-space: nowrap; }
.aq-mega__feat .aq-mega__tail::after { content: "→"; content: "→" / ""; display: inline-block; margin-left: var(--space-2); color: var(--flow); transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.aq-mega__feat .aq-mega__d { margin: 0; }

/* Foot line (the exclusions, said once) */
.aq-mega__foot { margin: 0; padding-top: var(--space-4); border-top: 1px solid var(--line); font: 400 14px/20px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
.aq-mega__more { font-weight: 500; white-space: nowrap; }

/* "I need to": the same row in every panel, a sunken band across the panel foot; hairline separators, no pills.
   Seven tasks never fit one line inside content-max, so they are set on purpose: a grid of four columns (4 + 3), the
   label on the first row's line, every column's hairline in line from row to row */
.aq-mega__tasks { background: var(--surface-sunken); border-top: 1px solid var(--line); }
.aq-mega__tasks-in {
  display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: start; column-gap: var(--space-6);
  max-width: var(--content-max); margin-inline: auto; padding: var(--space-3) var(--space-8);
}
/* A 16 px line centred in the 32 px task row */
.aq-mega__tasks .aq-mega__label { padding-block: var(--space-2); }
/* Every link carries a hairline on its left; the list is pulled left by one gap and clipped there, so the first column
   shows none */
.aq-mega__tasks ul {
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: var(--space-1);
  margin-left: calc(-1 * var(--space-3) - 1px); clip-path: inset(0 0 0 calc(var(--space-3) + 1px));
}
.aq-mega__tasks li { padding-inline: var(--space-3); border-left: 1px solid var(--line); }
/* space-1 of padding keeps the inset focus ring off the words and the arrow */
.aq-mega__task { display: inline-flex; align-items: center; min-height: 32px; padding-inline: var(--space-1); color: var(--ink); text-decoration: none; font: 400 14px/20px var(--font-sans); }
.aq-mega__task:focus-visible { outline-offset: -2px; }
.aq-mega__task:hover { text-decoration: underline; text-decoration-color: var(--flow); text-underline-offset: 4px; text-decoration-thickness: 1px; }

/* Below 1,240 px: the head becomes one line (name, lead, overview) above the groups and the featured card */
@container (max-width: 1239px) {
  .aq-mega__head { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-6); row-gap: 0; }
  .aq-mega__lead { max-width: none; }
  .aq-mega__groups { grid-column: 1 / 9; }
  .aq-mega__in--nofeat .aq-mega__groups { grid-column: 1 / -1; }
  .aq-mega__feat { grid-column: 9 / 13; }
}
@container (max-width: 1120px) {
  .aq-mega__in { padding: var(--space-6); column-gap: var(--space-6); }
  .aq-mega__tasks-in { padding-inline: var(--space-6); }
}
@media (prefers-reduced-motion: reduce) {
  .aq-mega__t, .aq-mega__all::after, .aq-mega__more::after, .aq-mega__task::after, .aq-mega__feat .aq-mega__tail::after { transition: none; }
}

/* ---------- Phone menu: the sections as an accordion (pass 12) ----------
   Section rows are buttons, 56 px, hairline rows, a plus that turns into a cross while open; depth stops at two
   (section, links): group labels are text. */
.aq-menu__sect {
  display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); width: 100%; min-height: 56px;
  margin: 0; padding: var(--space-3) 0; border: 0; border-bottom: 1px solid var(--line); background: none; cursor: pointer;
  color: var(--ink); font: 400 20px/28px var(--font-sans); letter-spacing: -0.005em; text-align: left;
}
.aq-menu__plus { position: relative; flex: none; width: 14px; height: 14px; transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.aq-menu__plus::before, .aq-menu__plus::after { content: ""; position: absolute; left: 0; top: 6.25px; width: 14px; height: 1.5px; background: currentColor; }
.aq-menu__plus::after { transform: rotate(90deg); }
.aq-menu__sect[aria-expanded="true"] .aq-menu__plus { transform: rotate(45deg); }
/* The sections list: rows are section buttons with their groups (and a plain link for a section without a panel) */
.aq-menu__list--sect > li { display: grid; }
.aq-menu__group[hidden] { display: none; }
.aq-menu__group-in { display: grid; gap: var(--space-4); padding: var(--space-2) 0 var(--space-6); border-bottom: 1px solid var(--line); }
.aq-menu__all { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; justify-self: start; color: var(--ink); text-decoration: none; font: 500 16px/24px var(--font-sans); }
.aq-menu__all::after, .aq-menu__feat .aq-menu__t::after { content: "→"; content: "→" / ""; color: var(--flow); }
.aq-menu__feat .aq-menu__t::after { margin-left: var(--space-2); }
.aq-menu__feat {
  display: grid; gap: var(--space-1); padding: var(--space-4); min-height: 44px;
  background: var(--surface-sunken); border: 1px solid var(--line); color: var(--ink); text-decoration: none;
}
.aq-menu__eyebrow, .aq-menu__glabel { margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-menu__feat .aq-menu__t { font: 500 16px/24px var(--font-sans); }
.aq-menu__d { font: 400 14px/20px var(--font-sans); color: var(--ink-muted); }
.aq-menu__ggrid { display: grid; gap: var(--space-4); }
.aq-menu__gg { display: grid; align-content: start; }
.aq-menu__gg ul, .aq-menu__tasks { display: grid; margin: 0; padding: 0; list-style: none; }
.aq-menu__link { display: flex; flex-direction: column; justify-content: center; min-height: 44px; padding-block: var(--space-2); color: var(--ink); text-decoration: none; }
.aq-menu__link .aq-menu__t { font: 400 16px/24px var(--font-sans); }
.aq-menu__link .aq-menu__d { display: none; }
.aq-menu__link[aria-current] .aq-menu__t::after { content: " →"; content: " →" / ""; color: var(--flow); }
.aq-menu__foot { margin: 0; font: 400 14px/20px var(--font-sans); color: var(--ink-muted); }
/* Inline in the foot sentence: the padding makes a 44 px target without opening the line spacing */
.aq-menu__more { padding-block: var(--space-4); color: var(--ink); font-weight: 500; text-decoration: none; white-space: nowrap; }
.aq-menu__more::after { content: "→"; content: "→" / ""; margin-left: var(--space-1); color: var(--flow); }
@container (min-width: 480px) { .aq-menu__link .aq-menu__d { display: block; } }
@container (min-width: 600px) { .aq-menu__ggrid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-8); } }
@media (prefers-reduced-motion: reduce) { .aq-menu__plus { transition: none; } }

/* ---------- SectionNav ---------- */
/* A quiet sticky bar: eyebrow label, numbered jump links (the one being read is underlined in `flow`), page progress. */
.aq-section-nav { position: sticky; top: 0; z-index: 5; background: var(--surface); border-bottom: 1px solid var(--line); transition: transform 240ms cubic-bezier(0.2, 0, 0, 1); }
.aq-section-nav .aq-in { display: flex; align-items: stretch; min-height: 56px; }
.aq-section-nav__label {
  display: flex; align-items: center; gap: var(--space-1); flex: none;
  padding-right: var(--space-4); border-right: 1px solid var(--line);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); white-space: nowrap;
}
.aq-section-nav__links {
  display: flex; align-items: center; gap: var(--space-1); flex: 1; min-width: 0;
  margin: 0; padding: 0 var(--space-3); list-style: none;
  overflow-x: auto; scrollbar-width: none; white-space: nowrap;
}
.aq-section-nav__links::-webkit-scrollbar { display: none; }
.aq-section-nav__links li { flex: none; }
.aq-section-nav__links a {
  display: inline-flex; align-items: baseline; gap: var(--space-2);
  padding: var(--space-2) var(--space-3); border-bottom: 1px solid transparent;
  font: 400 14px/20px var(--font-sans); color: var(--ink-muted); text-decoration: none;
  transition: color 200ms cubic-bezier(0.2, 0, 0, 1), border-color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-section-nav__num { font: 400 12px/16px var(--font-mono); letter-spacing: 0.02em; color: var(--ink-subtle); font-variant-numeric: tabular-nums; }
.aq-section-nav__links a:hover { color: var(--ink); }
.aq-section-nav__links a[aria-current="true"] { color: var(--ink); border-bottom-color: var(--flow); }
.aq-section-nav__links a:focus-visible { outline-offset: 0; }

/* At the footer (pass 12 C, F2): SectionNav.js sets is-footed while the footer is in view; the bar slides up out of
   sight and leaves the tab order once it has gone, and comes back as soon as the footer leaves the view. */
.aq-section-nav.is-footed { transform: translateY(calc(-100% - 2px)); visibility: hidden; transition: transform 240ms cubic-bezier(0.2, 0, 0, 1), visibility 0s linear 240ms; }

/* Page progress: ten hairline segments and a percentage, updated on scroll */
.aq-section-nav__progress {
  display: flex; flex-direction: column; justify-content: center; align-items: flex-end; gap: var(--space-1); flex: none;
  padding-left: var(--space-4); border-left: 1px solid var(--line);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
.aq-section-nav__readout { display: flex; align-items: center; gap: var(--space-2); }
.aq-section-nav__meter { display: inline-flex; gap: calc(var(--space-1) / 2); }
.aq-section-nav__seg { display: block; width: var(--space-2); height: 2px; background: var(--line); transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-section-nav__seg.is-on { background: var(--flow); }
.aq-section-nav__pct { min-width: 4ch; text-align: right; letter-spacing: 0.02em; color: var(--ink-muted); font-variant-numeric: tabular-nums; }

/* Jumped-to sections clear the sticky bar (56 px desktop, 44 px phones) with room above the heading */
.aq-page:has(.aq-section-nav) section[id] { scroll-margin-top: var(--space-16); }

@media (prefers-reduced-motion: reduce) {
  .aq-section-nav, .aq-section-nav__links a, .aq-section-nav__seg { transition: none; }
}

/* Motion marker (SectionNav/motion.js adds has-mark): one flow bar along the bottom edge that slides to the link being
   read. It is 100 px wide and scaled to the link's width, so it moves on transforms only. */
.aq-section-nav__links { position: relative; }
.aq-section-nav__links > .aq-section-nav__mark { position: absolute; left: 0; bottom: 0; width: 100px; height: 1px; background: var(--flow); pointer-events: none; }
.aq-section-nav.has-mark .aq-section-nav__links a[aria-current="true"] { box-shadow: none; text-decoration: none; border-color: transparent; }
/* Hover highlight (fluid-tab-rail): a flow-tint plate that glides under the link the pointer is on; it sits behind the
   links (they stack above it) and is sized and placed by SectionNav/motion.js. Height 0 while it is not showing. */
.aq-section-nav__links > .aq-section-nav__glow { position: absolute; left: 0; top: 0; width: 0; height: 0; border-radius: var(--radius-sm); background: var(--flow-tint); pointer-events: none; opacity: 0; }
.aq-section-nav__links > li:not(.aq-section-nav__glow, .aq-section-nav__mark) { position: relative; z-index: 1; }
.aq-section-nav__links > .aq-section-nav__mark { z-index: 2; }

@container (max-width: 860px) {
  /* Phones: a slim 44 px strip of links; the progress meter becomes a 2 px flow line along its bottom edge, and
     the bar tucks away while the reader scrolls down (is-tucked, set by SectionNav.js), so it never sits on content. */
  .aq-section-nav { border-bottom-color: var(--line); }
  .aq-section-nav.is-tucked { transform: translateY(calc(-100% - 2px)); }
  .aq-section-nav .aq-in { position: relative; min-height: 44px; padding-inline: 0; }
  .aq-section-nav__label, .aq-section-nav__progress-label, .aq-section-nav__pct { display: none; }
  .aq-section-nav__links { padding: 0 var(--space-2); gap: 0; }
  .aq-section-nav__links a { align-items: center; min-height: 44px; padding: 0 var(--space-3); font-size: 13px; line-height: 18px; }
  .aq-section-nav__links a[aria-current="true"] { border-bottom-color: var(--ink); }
  .aq-section-nav__progress { position: absolute; left: 0; right: 0; bottom: -1px; padding: 0; border: 0; pointer-events: none; }
  .aq-section-nav__readout { width: 100%; }
  .aq-section-nav__meter { display: flex; flex: 1; gap: 0; padding: 0; border: 0; }
  .aq-section-nav__seg { flex: 1; width: auto; height: 2px; background: transparent; }
  .aq-section-nav__seg.is-on { background: var(--flow); }
  .aq-page:has(.aq-section-nav) section[id] { scroll-margin-top: var(--space-12); }
}
@container (max-width: 860px) { .aq-section-nav.has-mark .aq-section-nav__links a[aria-current="true"] { border-bottom-color: transparent; } }

/* ---------- ApplicationWheel: where one water goes, as an application wheel ---------- */
/* Desktop: a three-column grid, the wheel in the middle spanning every row, the groups' blocks in the side columns,
   one per row, centred on their row. Each block's leader is a hairline drawn from its inner edge towards the wheel's
   centre, under the wheel: the wheel's disc is filled with the ground, so the line stops exactly at the segment's
   outer edge whatever the block's height. */
.aq-application-wheel { --wheel: min(42cqw, 580px); --gap: var(--space-8);
  position: relative; display: grid; grid-template-columns: minmax(0, 1fr) var(--wheel, 480px) minmax(0, 1fr);
  grid-template-rows: repeat(var(--rows, 3), auto); column-gap: var(--gap, var(--space-8)); row-gap: var(--space-8); align-items: center; }
.aq-application-wheel__wheel { grid-column: 2; grid-row: 1 / span var(--rows, 3); position: relative; z-index: 1; align-self: center; }
.aq-application-wheel__svg { display: block; width: 100%; height: auto; overflow: visible; }
.aq-application-wheel__disc { fill: var(--surface); stroke: none; }
.aq-application-wheel__seg { cursor: pointer; }
.aq-application-wheel__seg path { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1px; vector-effect: non-scaling-stroke;
  transition: fill 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-application-wheel__seg:nth-child(odd of .aq-application-wheel__seg) path { fill: color-mix(in srgb, var(--line) 60%, var(--surface)); }
.aq-application-wheel__seg.is-hot path { fill: var(--flow-tint); }
.aq-application-wheel__num { font: 400 16px/1 var(--font-mono); letter-spacing: 0.04em; fill: var(--ink-muted); text-anchor: middle; dominant-baseline: central; pointer-events: none; }
.aq-application-wheel__num.is-hot { fill: var(--ink); }
.aq-application-wheel__hub { fill: var(--surface); stroke: var(--line); stroke-width: 1px; vector-effect: non-scaling-stroke; }
.aq-application-wheel__loop { fill: none; stroke: var(--flow); stroke-width: 2px; vector-effect: non-scaling-stroke; stroke-dasharray: 3 7; }
.aq-application-wheel__pkg { overflow: visible; }
/* the phone strip's readout (PhoneKit on, 600 px and under); never shown elsewhere */
.aq-application-wheel__now { display: none; }

.aq-application-wheel__list { display: contents; list-style: none; margin: 0; padding: 0; }
.aq-application-wheel__grp { position: relative; grid-row: var(--row, auto); min-width: 0; display: flex; flex-direction: column; gap: var(--space-2);
  padding-block: var(--space-2); }
.aq-application-wheel__grp--r { grid-column: 3; padding-left: var(--space-6); border-left: 1px solid var(--line-strong); }
.aq-application-wheel__grp--l { grid-column: 1; padding-right: var(--space-6); border-right: 1px solid var(--line-strong); }
/* the leaders: laid out by the look's script in one layer over the whole figure (pixel viewBox), under the wheel */
.aq-application-wheel__leads { position: absolute; left: 0; top: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 2; }
.aq-application-wheel__lead path { fill: none; stroke: var(--line-strong); stroke-width: 1px; transition: stroke 200ms; }
.aq-application-wheel__lead circle { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1px; transition: fill 200ms, stroke 200ms; }
.aq-application-wheel__lead.is-hot path { stroke: var(--flow); }
.aq-application-wheel__lead.is-hot circle { fill: var(--flow); stroke: var(--flow); }

.aq-application-wheel__n { margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; color: var(--ink-subtle); }
.aq-application-wheel__t { margin: 0; font: 400 20px/26px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
.aq-application-wheel__link { color: inherit; text-decoration: none; }
.aq-application-wheel__link::after { content: "\00a0\2192"; color: var(--flow); display: inline-block; transition: transform 200ms; }
.aq-application-wheel__link:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; text-decoration-color: var(--flow); }
.aq-application-wheel__link:hover::after { transform: translateX(var(--space-1)); }
.aq-application-wheel__link:focus-visible { outline: 2px solid var(--focus); outline-offset: var(--space-1); }
.aq-application-wheel__tag { align-self: flex-start; margin: 0; padding: 1px var(--space-2); border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
  font: 400 12px/18px var(--font-mono); letter-spacing: 0.02em; color: var(--ink-muted); }
.aq-application-wheel__uses { list-style: none; margin: var(--space-1) 0 0; padding: 0; display: grid; gap: 2px; }
.aq-application-wheel__uses li { display: flex; gap: var(--space-2); font: 400 14px/20px var(--font-sans); color: var(--ink-muted); }
.aq-application-wheel__ui { flex: none; min-width: 3.4em; font: 400 11px/20px var(--font-mono); color: var(--ink-subtle); }

@container (max-width: 1100px) {
  .aq-application-wheel { --wheel: min(38cqw, 420px); --gap: var(--space-6); }
  .aq-application-wheel__t { font-size: 18px; line-height: 24px; }
}

/* Phones: the wheel on top, a riser down the middle from it, the groups as a two-column grid branching off it */
@container (max-width: 860px) {
  .aq-application-wheel { --gap: var(--space-6); grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; row-gap: var(--space-8); align-items: start; }
  .aq-application-wheel__wheel { grid-column: 1 / -1; grid-row: auto; justify-self: center; width: min(100%, 320px); }
  /* the riser: a twin-wall line from the wheel's foot down the column gap */
  .aq-application-wheel::before { content: ""; position: absolute; left: 50%; top: min(100cqw, 320px); bottom: var(--space-8); width: var(--space-2); margin-left: calc(var(--space-2) / -2);
    border-inline: 1px solid var(--line-strong); background: linear-gradient(var(--flow), var(--flow)) center / 2px 100% no-repeat; box-sizing: border-box; }
  .aq-application-wheel__grp, .aq-application-wheel__grp--r, .aq-application-wheel__grp--l { grid-column: auto; grid-row: auto; padding: var(--space-3) 0 0; border: 0; border-top: 1px solid var(--line-strong); }
  /* the branch: a stub from the riser to the block's top rule */
  .aq-application-wheel__leads { display: none; }
  .aq-application-wheel__grp::before { content: ""; position: absolute; top: -1px; height: 1px; width: calc(var(--gap, var(--space-8)) / 2); background: var(--line-strong); }
  .aq-application-wheel__grp:nth-child(odd)::before { left: 100%; right: auto; }
  .aq-application-wheel__grp:nth-child(even)::before { right: 100%; left: auto; }
  .aq-application-wheel__t { font-size: 17px; line-height: 22px; }
  .aq-application-wheel__link { display: inline-block; min-height: var(--aq-hit, 44px); padding-block: var(--space-2); box-sizing: border-box; }
  .aq-application-wheel__tag { font-size: 12px; line-height: 18px; }
  .aq-application-wheel__uses li { font-size: var(--aq-read-phone, 14px); line-height: 20px; }
  .aq-application-wheel__ui { display: none; }
  .aq-application-wheel__num { font-size: 22px; }
}

/* 600 px and under (pass 12 round C): the wheel is a PhoneKit sticky compact figure. A 140 px strip (the wheel at
   124 px and the name of the group in view) holds under the header; the segment whose list is on the reading line
   fills with flow. The groups run in one column under it. Without script (PhoneKit off) the 860 px layout above stays. */
@container (max-width: 600px) {
  .aq-application-wheel[data-pk-on] { grid-template-columns: minmax(0, 1fr); row-gap: 0; }
  .aq-application-wheel[data-pk-on]::before { display: none; }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__wheel { grid-column: 1; justify-self: stretch; align-self: start; width: auto;
    display: flex; align-items: center; gap: var(--space-4); padding-block: var(--space-2); }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__svg { flex: none; width: 124px; height: 124px; overflow: hidden; cursor: pointer; }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__num { font-size: 40px; font-weight: 500; }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__seg.is-pk-active path { fill: var(--flow); stroke: var(--flow); }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__num.is-pk-active { fill: var(--surface); }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__now { display: block; flex: 1; min-width: 0; list-style: none; margin: 0; padding: 0; }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__now li { display: none; font: 400 17px/22px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__now li.is-pk-active { display: block; }
  /* the group's own title still shows under the strip: the readout steps back until it has passed (script) */
  .aq-application-wheel[data-pk-on] .aq-application-wheel__now { transition: opacity 200ms; }
  .aq-application-wheel[data-pk-on][data-aw-fresh] .aq-application-wheel__now { opacity: 0; }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__now-n { display: block; margin-bottom: var(--space-1); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; color: var(--flow); }
  /* the groups: one column, each under a rule, its number lit while it is the one in view */
  .aq-application-wheel[data-pk-on] .aq-application-wheel__grp { display: grid; grid-template-columns: 28px minmax(0, 1fr); column-gap: var(--space-2); row-gap: var(--space-1);
    align-items: baseline; padding: var(--space-3) 0 var(--space-2); }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__n { grid-column: 1; }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__t, .aq-application-wheel[data-pk-on] .aq-application-wheel__tag,
  .aq-application-wheel[data-pk-on] .aq-application-wheel__uses { grid-column: 2; }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__tag { justify-self: start; }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__grp::before { display: none; }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__grp:first-child { border-top-color: transparent; }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__grp.is-pk-active .aq-application-wheel__n { color: var(--flow); }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__uses { margin-top: var(--space-1); gap: 2px; }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__uses li { font-size: 14px; line-height: 20px; }
  .aq-application-wheel[data-pk-on] .aq-application-wheel__uses li::before { content: ""; flex: none; width: var(--space-2); height: 1px; margin-top: 10px; background: var(--line-strong); }
}
@media (prefers-reduced-motion: reduce) {
  .aq-application-wheel[data-pk-on] .aq-application-wheel__now { transition: none; }
}

/* ---------- ApprovalMerge: who prepares, one approval (look "approval-merge") ----------
   Heading on the left, the intro's figure echoed huge and light on the right. Under it a header strip, then rows on
   hairlines in four fixed tracks (index 4 %, request 40 %, lanes 36 %, wire 20 %), the merged approval in a column of
   its own to the right. Lanes: a vertical hairline per party at its lane centre, continuous through the rows; a row's
   node sits on its party's lane (Aquemi: flow fill; your side: ring in ink; shared: dashed ring), the party and the
   detail centred under it. The wire runs from the node to the bus (a vertical flow line), the bus ends in one stamp.
   Phones: rows stack (request, then the party). With one approver (pass 12) a right-edge approval rail takes the
   merge: a node per request on it, the rail running into one stamp (rules at the end). With several approvers each
   row keeps its own approver chip. */
.aq-approval-merge__top { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-8); }
.aq-approval-merge-sec .aq-sec-head .aq-h1 { font: 300 56px/60px var(--font-sans); letter-spacing: -0.03em; max-width: 18ch; }
.aq-approval-merge__hero { margin: 0; display: flex; flex-direction: column; align-items: flex-end; flex: none; }
.aq-approval-merge__fig { font: 300 168px/0.82 var(--font-sans); letter-spacing: -0.06em; color: var(--ink); font-variant-numeric: tabular-nums; }
.aq-approval-merge__unit { margin-top: var(--space-3); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-approval-merge { --bus: calc(var(--space-32) + var(--space-16)); }
.aq-approval-merge__heads { display: grid; grid-template-columns: 44% 36% 20%; padding-right: var(--bus, var(--space-32)); border-bottom: 1px solid var(--line-strong); padding-bottom: var(--space-2); }
.aq-approval-merge:not(.is-one) .aq-approval-merge__heads { padding-right: 0; }
.aq-approval-merge__hk { font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); padding-left: 9%; }
.aq-approval-merge__hk--prep { display: grid; grid-template-columns: repeat(var(--lanes, 2), minmax(0, 1fr)); padding: 0; }
.aq-approval-merge__lane-h { text-align: center; color: var(--ink); }
.aq-approval-merge__lane-h.is-ours { color: var(--flow); }
.aq-approval-merge__hk--appr { text-align: right; padding: 0; }
.aq-approval-merge.is-one .aq-approval-merge__hk--appr { display: none; }
.aq-approval-merge__body { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) var(--bus, var(--space-32)); }
.aq-approval-merge:not(.is-one) .aq-approval-merge__body { grid-template-columns: minmax(0, 1fr); }
.aq-approval-merge__rows { list-style: none; margin: 0; padding: 0; }
.aq-approval-merge__row { position: relative; display: grid; grid-template-columns: 4% 40% 36% 20%; align-items: start; min-height: calc(var(--space-24) + var(--space-4)); border-bottom: 1px solid var(--line); }
.aq-approval-merge__row > .aq-index { grid-column: 1; grid-row: 1; padding-top: var(--space-6); line-height: 28px; }
.aq-approval-merge__t { grid-column: 2; grid-row: 1; margin: 0; padding: var(--space-6) var(--space-4) var(--space-6) 0; font: 300 24px/30px var(--font-sans); letter-spacing: -0.015em; color: var(--ink); text-wrap: balance; }
.aq-approval-merge__lanes { grid-column: 3; grid-row: 1; align-self: stretch; display: grid; grid-template-columns: repeat(var(--lanes, 2), minmax(0, 1fr)); }
.aq-approval-merge__track { position: relative; }
.aq-approval-merge__track::before { content: ""; position: absolute; left: 50%; top: 0; bottom: -1px; border-left: 1px solid var(--line-strong); }
.aq-approval-merge__track.is-ours::before { border-left-color: color-mix(in srgb, var(--flow) 50%, transparent); }
.aq-approval-merge__prep { grid-column: 3; grid-row: 1; position: relative; z-index: 1; margin: 0; display: grid; grid-template-columns: repeat(var(--lanes, 2), minmax(0, 1fr)); justify-items: center; text-align: center; padding-top: calc(var(--space-6) + var(--space-1)); }
.aq-approval-merge__prep > * { grid-column: var(--lane, 1); }
.aq-approval-merge__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.aq-approval-merge__node { width: var(--space-4); height: var(--space-4); border-radius: 50%; background: var(--surface); border: 2px solid var(--ink); transition: transform 200ms ease; }
.aq-section--alt .aq-approval-merge__node { background: var(--surface-sunken); }
.aq-approval-merge__prep.is-ours .aq-approval-merge__node { background: var(--flow); border-color: var(--flow); }
.aq-approval-merge__prep.is-shared .aq-approval-merge__node { border-style: dashed; }
.aq-approval-merge__who { margin-top: var(--space-2); padding-inline: var(--space-2); background: var(--surface); font: 500 13px/18px var(--font-mono); color: var(--ink); }
.aq-section--alt .aq-approval-merge__who, .aq-section--alt .aq-approval-merge__det { background: var(--surface-sunken); }
.aq-approval-merge__prep.is-ours .aq-approval-merge__who { color: var(--flow); }
.aq-approval-merge__det { padding: var(--space-1) var(--space-2) var(--space-4); background: var(--surface); font: 400 13px/18px var(--font-sans); color: var(--ink-muted); max-width: 18ch; text-wrap: balance; }
.aq-approval-merge__wire { position: absolute; top: calc(var(--space-6) + var(--space-1) + var(--space-2)); left: calc(44% + 36% * (var(--lane, 1) - 0.5) / var(--lanes, 2)); right: 0; border-top: 1.5px solid var(--line-strong); transform-origin: 0 50%; }
/* round C: only a row Aquemi prepares tints its wire (every row holds an is-ours lane track, so :has(.is-ours) tinted all) */
.aq-approval-merge__row:has(.aq-approval-merge__prep.is-ours) .aq-approval-merge__wire { border-top-color: color-mix(in srgb, var(--flow) 60%, var(--line-strong)); }
.aq-approval-merge__appr { grid-column: 4; grid-row: 1; position: relative; z-index: 1; margin: 0; justify-self: end; padding-top: var(--space-6); }
.aq-approval-merge__appr.is-merged { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
.aq-approval-merge__stamp { display: inline-block; padding: var(--space-1) var(--space-3); border: 1.5px solid var(--ink); background: var(--surface); font: 500 13px/18px var(--font-mono); color: var(--ink); }
.aq-approval-merge__row:hover .aq-approval-merge__node { transform: scale(1.35); }
.aq-approval-merge__row:hover .aq-approval-merge__wire { border-top-color: var(--flow); }
.aq-approval-merge__row:hover .aq-approval-merge__t { color: var(--ink); }
/* the bus and its one stamp */
.aq-approval-merge__bus { position: relative; }
.aq-approval-merge__busline { position: absolute; left: 0; top: calc(var(--space-6) + var(--space-3)); bottom: calc(var(--space-24) + var(--space-4) - var(--space-6) - var(--space-3)); border-left: 2px solid var(--flow); transform-origin: 50% 0; }
.aq-approval-merge__big { position: absolute; left: var(--space-6); top: 0; bottom: 0; margin-block: auto; height: fit-content; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-4) var(--space-6); border: 2px solid var(--ink); background: var(--surface-raised); }
.aq-approval-merge__big::before { content: ""; position: absolute; right: 100%; top: 50%; width: var(--space-6); border-top: 2px solid var(--flow); }
/* the traced route (hover): an ink wire over the row's wire, an ink stretch of bus from the row to the stamp */
.aq-approval-merge__lit { position: absolute; left: 0; right: 0; top: -2px; border-top: 2.5px solid var(--ink); transform: scaleX(0); transform-origin: 0 50%; }
.aq-approval-merge__buslit { position: absolute; left: -1px; top: 0; height: 0; border-left: 3px solid var(--ink); transform: scaleY(0); transform-origin: 50% 0; }
.aq-approval-merge__bigk { font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-approval-merge__bigv { font: 300 44px/44px var(--font-sans); letter-spacing: -0.03em; color: var(--ink); }

@container (max-width: 860px) {
  .aq-approval-merge__top { flex-direction: column; align-items: flex-start; gap: var(--space-4); }
  .aq-approval-merge-sec .aq-sec-head .aq-h1 { font: 300 36px/42px var(--font-sans); }
  .aq-approval-merge__hero { flex-direction: row; align-items: baseline; gap: var(--space-3); }
  .aq-approval-merge__fig { font-size: 88px; }
  .aq-approval-merge__heads, .aq-approval-merge__lanes, .aq-approval-merge__wire, .aq-approval-merge__bus { display: none; }
  .aq-approval-merge__body { display: block; }
  .aq-approval-merge__row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); min-height: 0; padding: var(--space-4) 0; }
  .aq-approval-merge__row > .aq-index { padding: 0; flex-basis: 100%; line-height: 16px; }
  .aq-approval-merge__t { flex-basis: 100%; padding: 0; font-size: 20px; line-height: 26px; }
  .aq-approval-merge__prep { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; padding: 0; text-align: left; }
  .aq-approval-merge__node { width: var(--space-3); height: var(--space-3); }
  .aq-approval-merge__who, .aq-approval-merge__det { margin: 0; padding: 0; max-width: none; background: none; }
  .aq-approval-merge__appr, .aq-approval-merge__appr.is-merged { position: static; width: auto; height: auto; overflow: visible; clip-path: none; padding: 0; margin-left: auto; }
}

/* Phones, one approver (pass 12, audit svc-upgrades.0, S10): the merge stays. One approval rail runs down the right
   edge; each request ends in a node on it (filled flow: Aquemi prepares; open ring: you or your consultant; dashed:
   shared), joined by a short wire from the request; the rail runs on under the last request into one "Approved by"
   stamp. No per-row approver chips (the stamp says it once; each row's approver stays in the markup for screen
   readers). The wire carries the node and the rail segment (clipped to its row), so the rail is continuous whatever
   the rows' heights. */
@container (max-width: 860px) {
  .aq-approval-merge.is-one { --rail: var(--space-8); }
  .aq-approval-merge.is-one .aq-approval-merge__row {
    display: grid; grid-template-columns: minmax(0, 1fr) var(--rail, var(--space-8)); column-gap: 0; row-gap: var(--space-2);
    overflow: clip; border-bottom: 1px solid var(--line);
  }
  .aq-approval-merge.is-one .aq-approval-merge__row > .aq-index { grid-column: 1; grid-row: 1; }
  .aq-approval-merge.is-one .aq-approval-merge__t { grid-column: 1; grid-row: 2; padding-right: var(--space-4); }
  .aq-approval-merge.is-one .aq-approval-merge__prep { grid-column: 1; grid-row: 3; padding-right: var(--space-3); }
  .aq-approval-merge.is-one .aq-approval-merge__prep .aq-approval-merge__node { display: none; }
  .aq-approval-merge.is-one .aq-approval-merge__appr.is-merged { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); margin: 0; }
  .aq-approval-merge.is-one .aq-approval-merge__who { font-size: 13px; }
  .aq-approval-merge.is-one .aq-approval-merge__det { font-size: 14px; line-height: 20px; color: var(--ink-muted); }
  /* the wire: from the request's party line across to the rail, the node at its end */
  .aq-approval-merge.is-one .aq-approval-merge__wire {
    display: block; position: relative; left: auto; right: auto; top: auto; grid-column: 2; grid-row: 3; align-self: start;
    margin-top: 9px; margin-left: calc(-1 * var(--space-3)); height: 0; border-top: 1.5px solid var(--line-strong);
  }
  .aq-approval-merge.is-one .aq-approval-merge__row:has(.aq-approval-merge__prep.is-ours) .aq-approval-merge__wire { border-top-color: color-mix(in srgb, var(--flow) 60%, var(--line-strong)); }
  .aq-approval-merge.is-one .aq-approval-merge__wire::before {
    content: ""; position: absolute; right: 5px; top: -100vh; bottom: -100vh; border-left: 2px solid var(--flow);
  }
  .aq-approval-merge.is-one .aq-approval-merge__row:first-child .aq-approval-merge__wire::before { top: 0; }
  .aq-approval-merge.is-one .aq-approval-merge__wire::after {
    content: ""; position: absolute; right: 0; top: -7px; width: 12px; height: 12px; box-sizing: border-box; border-radius: 50%;
    border: 2px solid var(--ink); background: var(--surface);
  }
  .aq-approval-merge.is-one .aq-approval-merge__row:has(.aq-approval-merge__prep.is-ours) .aq-approval-merge__wire::after { background: var(--flow); border-color: var(--flow); }
  .aq-approval-merge.is-one .aq-approval-merge__row:has(.aq-approval-merge__prep.is-shared) .aq-approval-merge__wire::after { border-style: dashed; }
  .aq-approval-merge.is-one .aq-approval-merge__lit { display: none; }
  /* the rail runs on into the one stamp */
  .aq-approval-merge.is-one .aq-approval-merge__bus { display: flex; justify-content: flex-end; position: relative; padding-top: var(--space-6); }
  .aq-approval-merge.is-one .aq-approval-merge__busline { position: absolute; left: auto; right: 5px; top: 0; bottom: auto; height: var(--space-6); border-left: 2px solid var(--flow); }
  .aq-approval-merge.is-one .aq-approval-merge__buslit, .aq-approval-merge.is-one .aq-approval-merge__big::before { display: none; }
  .aq-approval-merge.is-one .aq-approval-merge__big {
    position: relative; left: auto; top: auto; bottom: auto; margin: 0; flex-direction: row; align-items: baseline; gap: var(--space-3);
    padding: var(--space-3) var(--space-4); border: 2px solid var(--ink); border-top-color: var(--flow);
  }
  .aq-approval-merge.is-one .aq-approval-merge__bigk { font-size: 12px; }
  .aq-approval-merge.is-one .aq-approval-merge__bigv { font-size: 32px; line-height: 36px; }
}
/* a request that links (the design assessment): a 44 px hit box over its line on phones, no visual change */
@container (max-width: 860px) {
  .aq-approval-merge__t a { position: relative; }
  .aq-approval-merge__t a::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 44px; transform: translateY(-50%); }
}

/* Round C, phones: the actor chip and the role line share one 14 px line (the line wraps under the chip, not onto a
   row of its own); rows pad 16 px less in all, so the six requests run about 1,250 px. */
@container (max-width: 860px) {
  .aq-approval-merge__row { padding: var(--space-3) 0; }
  .aq-approval-merge__prep { display: block; }
  .aq-approval-merge__prep .aq-approval-merge__node { display: inline-block; vertical-align: -1px; margin-right: var(--space-2); }
  .aq-approval-merge__who, .aq-approval-merge.is-one .aq-approval-merge__who { display: inline; font-size: 14px; line-height: 20px; }
  .aq-approval-merge__det, .aq-approval-merge.is-one .aq-approval-merge__det { display: inline; margin-left: var(--space-2); font-size: 14px; line-height: 20px; }
  .aq-approval-merge.is-one .aq-approval-merge__row { grid-template-columns: var(--space-6) minmax(0, 1fr) var(--rail, var(--space-8)); row-gap: var(--space-1); padding-block: var(--space-3) var(--space-2); }
  /* the index sits left of the request, on its first line, not on a row of its own */
  .aq-approval-merge.is-one .aq-approval-merge__row > .aq-index { grid-column: 1; grid-row: 1; line-height: 26px; }
  .aq-approval-merge.is-one .aq-approval-merge__t { grid-column: 2; grid-row: 1; }
  .aq-approval-merge.is-one .aq-approval-merge__prep { grid-column: 2; grid-row: 2; }
  .aq-approval-merge.is-one .aq-approval-merge__wire { grid-column: 3; grid-row: 2; }
}

/* ---------- Band ---------- */
/* Ground modifiers: change the section ground for one section. Used on their own by StandardsGrid and DocList (sunken)
   and Closing (navy), and together with .aq-band for the statement band. */
.aq-band--sunken { background: var(--surface-sunken); }
.aq-band--limestone { background: var(--limestone); color: var(--on-limestone); }
.aq-band--limestone .aq-lead, .aq-band--limestone .aq-small { color: var(--on-limestone-muted); }
.aq-band--navy { background: var(--navy); color: var(--on-navy); position: relative; overflow: hidden; }
.aq-band--navy .aq-lead, .aq-band--navy .aq-small { color: var(--on-navy-muted); }
.aq-band--navy .aq-btn--primary { background: var(--limestone); color: var(--navy); }
.aq-band--navy .aq-btn--primary:hover { background: var(--on-navy); }
.aq-band--navy .aq-arc__outer { stroke: var(--on-navy-muted); opacity: 0.5; }
.aq-band--navy .aq-arc__inner { stroke: var(--limestone); }

/* Navy-to-navy seam (pass 12 C, V1): two navy bands in a row (news capa-ring -> colophon, contact-service routes ->
   riser-valves, cmp-documentation index-sheet -> stage-stacks) read as one long navy block. The second takes a faint
   Limestone hairline and 16 px more top padding, so the reader sees where one section ends. */
.aq-band--navy + .aq-band--navy { border-top: 1px solid color-mix(in srgb, var(--limestone) 18%, transparent); }
.aq-band--navy + .aq-band--navy:not(.aq-closing) { padding-top: calc(var(--space-16) + var(--space-4)); }

/* Dark theme: limestone bands turn warm dark (pass 12 C, provisional ruling RC1; owner to confirm).
   In light mode a limestone band is the warm light ground. In dark mode it kept its light value, so every limestone band
   was a bright strip between near-black sections. Now, under both dark selectors (the system setting and the explicit
   data-theme="dark"), a full-width .aq-band--limestone section re-declares the colour tokens as a warm dark stone set:
   --limestone becomes the stone token (the band ground), light --on-limestone and --on-limestone-muted, and warm surfaces, lines and
   inks for what the look draws inside it. Looks keep writing var(--limestone) and var(--on-limestone) and follow.
   - A band section pinned data-theme="light" (the old way to keep its ink dark on the light band) takes the warm dark
     too, and so does every pinned-light wrapper inside a band, unless it is paper.
   - Paper: an object marked data-paper (a sheet, a slip) stays paper. In dark mode it is dimmed (paper-dim ground,
     paper-dim-raised fill), wherever it sits. Pinned-light objects outside limestone bands are not touched.
   - Navy stays navy: a navy block, tab or stamp in a band reads as navy on the stone, as it does on limestone. A look
     that writes navy text straight on the band (or limestone text on a navy chip) must switch it to --on-limestone in
     dark mode; the build-c report lists those.
   To reverse: delete the two dark blocks below (and the data-paper rule). Light mode is unchanged.
   The band takes the stone tokens; every other colour token it inherits from the page (so a band or wrapper pinned
   data-theme="light" gets the dark values back), and a pinned-light wrapper inside the band inherits all of them. */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .aq-band--limestone {
    --limestone: var(--stone); --on-limestone: var(--on-stone); --on-limestone-muted: var(--on-stone-muted);
    --surface: var(--stone); --surface-raised: var(--stone-raised); --surface-sunken: var(--stone-sunken);
    --ink: var(--on-stone); --ink-muted: var(--on-stone-muted); --ink-subtle: var(--on-stone-subtle);
    --line: var(--stone-line); --line-strong: var(--stone-line-strong);
    color-scheme: dark;
    --ink-inverse: inherit; --action: inherit; --action-hover: inherit; --on-action: inherit;
    --flow: inherit; --flow-tint: inherit; --focus: inherit; --pass: inherit; --caution: inherit; --fail: inherit;
    --caution-tint: inherit; --on-navy: inherit; --on-navy-muted: inherit; --shadow-overlay: inherit; --navy: inherit;
  }
  :root:not([data-theme="light"]) .aq-band--limestone [data-theme="light"]:not([data-paper], [data-paper] *) {
    --navy: inherit; --ink-inverse: inherit; --action: inherit; --action-hover: inherit; --on-action: inherit;
    --flow: inherit; --flow-tint: inherit; --focus: inherit; --pass: inherit; --caution: inherit; --fail: inherit;
    --caution-tint: inherit; --on-navy: inherit; --on-navy-muted: inherit; --shadow-overlay: inherit;
    --limestone: inherit; --on-limestone: inherit; --on-limestone-muted: inherit; --surface: inherit; --surface-raised: inherit;
    --surface-sunken: inherit; --ink: inherit; --ink-muted: inherit; --ink-subtle: inherit; --line: inherit; --line-strong: inherit;
    color-scheme: dark;
  }
  :root:not([data-theme="light"]) [data-theme="light"][data-paper] { --limestone: var(--paper-dim); --surface-raised: var(--paper-dim-raised); }
}
[data-theme="dark"] .aq-band--limestone {
  --limestone: var(--stone); --on-limestone: var(--on-stone); --on-limestone-muted: var(--on-stone-muted);
  --surface: var(--stone); --surface-raised: var(--stone-raised); --surface-sunken: var(--stone-sunken);
  --ink: var(--on-stone); --ink-muted: var(--on-stone-muted); --ink-subtle: var(--on-stone-subtle);
  --line: var(--stone-line); --line-strong: var(--stone-line-strong);
  color-scheme: dark;
  --ink-inverse: inherit; --action: inherit; --action-hover: inherit; --on-action: inherit;
  --flow: inherit; --flow-tint: inherit; --focus: inherit; --pass: inherit; --caution: inherit; --fail: inherit;
  --caution-tint: inherit; --on-navy: inherit; --on-navy-muted: inherit; --shadow-overlay: inherit; --navy: inherit;
}
[data-theme="dark"] .aq-band--limestone [data-theme="light"]:not([data-paper], [data-paper] *) {
  --navy: inherit; --ink-inverse: inherit; --action: inherit; --action-hover: inherit; --on-action: inherit;
  --flow: inherit; --flow-tint: inherit; --focus: inherit; --pass: inherit; --caution: inherit; --fail: inherit;
  --caution-tint: inherit; --on-navy: inherit; --on-navy-muted: inherit; --shadow-overlay: inherit;
  --limestone: inherit; --on-limestone: inherit; --on-limestone-muted: inherit; --surface: inherit; --surface-raised: inherit;
  --surface-sunken: inherit; --ink: inherit; --ink-muted: inherit; --ink-subtle: inherit; --line: inherit; --line-strong: inherit;
  color-scheme: dark;
}
[data-theme="dark"] [data-theme="light"][data-paper] { --limestone: var(--paper-dim); --surface-raised: var(--paper-dim-raised); }

/* ---------- Statement band: one sentence set large on a quiet ground ---------- */
/* No frame: the band's ground is the separation. The statement in Geist Light (display scale), a supporting line,
   and a faint line drawing of pipework at the right, drawn in currentColor so it follows every ground and theme. */
.aq-band__frame { position: relative; isolation: isolate; padding-block: var(--space-8); }

