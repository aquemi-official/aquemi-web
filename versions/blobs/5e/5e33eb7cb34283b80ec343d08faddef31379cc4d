.aq-limit-gauges__pivot { fill: var(--surface-raised); stroke: var(--line-strong); stroke-width: 1; vector-effect: non-scaling-stroke; }
.aq-limit-gauges__limit { stroke: var(--ink); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
.aq-limit-gauges__ptr { fill: var(--ink); }
.aq-limit-gauges__second { stroke: var(--flow); stroke-width: 1; stroke-dasharray: 3 2; vector-effect: non-scaling-stroke; }
/* Limit label: beside the pointer on the left half of the arc; on the right half (is-right) in the dial's top right corner */
.aq-limit-gauges__mark { position: absolute; transform: translate(var(--space-2), -100%); padding: 0 var(--space-1); background: var(--surface-raised); color: var(--ink); font: 400 12px/16px var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
.aq-limit-gauges__mark-k { font-family: var(--font-sans); color: var(--ink-muted); }
.aq-limit-gauges__mark.is-right { transform: none; }
