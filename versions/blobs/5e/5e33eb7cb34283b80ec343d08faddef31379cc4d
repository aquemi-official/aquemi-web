  .aq-limit-gauges__m .aq-tag { line-height: 18px; padding: 0 var(--space-1); white-space: nowrap; }
  .aq-limit-gauges__item.is-readout .aq-limit-gauges__spec > div:first-child { padding: var(--space-2) 0; }
  .aq-limit-gauges__item.is-readout .aq-limit-gauges__spec > div:first-child dt { display: block; }
