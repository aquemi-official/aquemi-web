/* ---------- ReaderSplit: readers on the navy half, what they read on the limestone half, row against row across a seam ---------- */
.aq-reader-split-sec { --gap: var(--space-16); position: relative; overflow: hidden; background: var(--limestone); color: var(--on-limestone); }
.aq-reader-split__ground { position: absolute; left: 0; top: 0; bottom: 0; width: 50%; background: var(--navy); transform-origin: 0 50%; }
.aq-reader-split-sec > .aq-in { position: relative; }
.aq-reader-split { --gap: var(--space-16); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--gap, 64px); }
.aq-reader-split__head { grid-column: 1; color: var(--on-navy); padding-right: var(--space-8); }
.aq-reader-split__head .aq-h1 { color: var(--on-navy); }
.aq-reader-split__head .aq-lead { color: var(--on-navy-muted); }
.aq-reader-split__colh { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--gap, 64px); margin: 0 0 var(--space-3); padding-top: var(--space-12);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
.aq-reader-split__colh span:first-child { color: var(--on-navy-muted); }
.aq-reader-split__colh span + span { color: var(--on-limestone-muted); }
.aq-reader-split > .aq-fold, .aq-reader-split > .aq-reader-split__rows { grid-column: 1 / -1; }
.aq-reader-split-sec .aq-fold__btn { color: var(--on-limestone); border-bottom-color: color-mix(in srgb, var(--on-limestone) 25%, transparent); padding-left: calc(50% + var(--gap, 64px) / 2); }

.aq-reader-split__rows { position: relative; list-style: none; margin: 0; padding: 0; }
.aq-reader-split__rows::before { content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 1.5px; margin-left: -0.75px; background: var(--limestone); }
.aq-reader-split__row { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--gap, 64px); }
.aq-reader-split__who { display: flex; gap: var(--space-4); align-items: baseline; padding: var(--space-6) var(--space-8) var(--space-6) 0;
  border-top: 1px solid color-mix(in srgb, var(--on-navy-muted) 35%, transparent); color: var(--on-navy); }
.aq-reader-split__who .aq-index { color: var(--on-navy-muted); }
.aq-reader-split__t { margin: 0; font: 300 28px/34px var(--font-sans); letter-spacing: -0.02em; }
.aq-reader-split__what { display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-6) 0; border-top: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent); }
.aq-reader-split__read { margin: 0; font: 400 17px/27px var(--font-mono); letter-spacing: -0.01em; color: var(--on-limestone); }
/* Per-row column labels: read by assistive tech on every width, shown on phones (the column heads are aria-hidden) */
.aq-reader-split__lab { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.aq-reader-split__k { display: block; font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-reader-split__go { align-self: flex-start; display: flex; flex-direction: column; gap: var(--space-1); min-height: 44px; margin: 0; color: var(--on-limestone); text-decoration: none; font: 400 16px/22px var(--font-sans); }
a.aq-reader-split__go span + span::after { content: " →"; color: var(--flow); }
a.aq-reader-split__go:hover span + span { text-decoration: underline; text-decoration-color: var(--flow); text-underline-offset: 4px; }
a.aq-reader-split__go:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* The tie: a node on the seam at the row's first line, and a short tie across it that draws on hover */
.aq-reader-split__tie { position: absolute; left: calc(50% - var(--gap, 64px) / 2); width: var(--gap, 64px); top: calc(var(--space-6) + var(--space-4)); height: 1.5px; pointer-events: none; }
.aq-reader-split__tie::before { content: ""; position: absolute; inset: 0; background: var(--limestone); transform: scaleX(0.3); transition: transform 400ms cubic-bezier(0.2, 0, 0, 1); }
.aq-reader-split__node { position: absolute; left: 50%; top: 50%; width: var(--space-3); height: var(--space-3); margin: calc(var(--space-3) * -0.5) 0 0 calc(var(--space-3) * -0.5);
  background: var(--navy); border: 1.5px solid var(--limestone); transition: background-color 300ms; }
.aq-reader-split__row:hover .aq-reader-split__tie::before, .aq-reader-split__row:focus-within .aq-reader-split__tie::before { transform: scaleX(1); }
.aq-reader-split__row:hover .aq-reader-split__node, .aq-reader-split__row:focus-within .aq-reader-split__node { background: var(--limestone); }

@container (max-width: 1100px) {
  .aq-reader-split, .aq-reader-split-sec { --gap: var(--space-12); }
  .aq-reader-split__t { font-size: 24px; line-height: 30px; }
}

/* Tight readers (pass 12 C, buying#compare): when every reader is a short name (the renderer sets is-tight, 30
   characters or fewer), the navy half takes 4 of 12 columns, not half, and each name sits on the first line of its
   reading (same 27 px line). Seam, ground, tie, column heads and fold button follow the 4fr 8fr split. Desktop only. */
@container (min-width: 861px) {
  .aq-reader-split-sec.is-tight .aq-reader-split__ground { width: calc(50% - (min(100%, var(--content-max)) - 2 * var(--space-8) - var(--gap, 64px)) / 6); }
  .aq-reader-split-sec.is-tight .aq-reader-split, .aq-reader-split-sec.is-tight .aq-reader-split__colh,
  .aq-reader-split-sec.is-tight .aq-reader-split__row { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
  .aq-reader-split-sec.is-tight .aq-reader-split__rows::before { left: calc((100% - var(--gap, 64px)) / 3 + var(--gap, 64px) / 2); }
  .aq-reader-split-sec.is-tight .aq-reader-split__tie { left: calc((100% - var(--gap, 64px)) / 3); }
  .aq-reader-split-sec.is-tight .aq-fold__btn { padding-left: calc((100% - var(--gap, 64px)) / 3 + var(--gap, 64px)); }
  .aq-reader-split-sec.is-tight .aq-reader-split__t { font-size: 24px; line-height: 27px; }
}

/* Phone-only parts: the third column's key and the accordion head (PhoneKit) stay out of the desktop render */
.aq-reader-split__colk, .aq-reader-split__ph { display: none; }

/* Phones (pass 12, S11/S12): one column on limestone. The three column names show once as a key above the rows; each
   reader is a 48 px navy head (index, reader, chevron) stacked on a hairline, so the navy line of readers stays in view,
   and the reading opens under its head on tap (PhoneKit accordion, one open). Rows grow with their text (no locked
   height); reading 15 px, answer 15 px with a 44 px link. Without script every row shows open, led by its navy bar. */
@container (max-width: 860px) {
  .aq-reader-split__ground { display: none; }
  .aq-reader-split__head, .aq-reader-split__head .aq-h1 { color: var(--on-limestone); }
  .aq-reader-split__head .aq-lead { color: var(--on-limestone-muted); }
  .aq-reader-split { grid-template-columns: minmax(0, 1fr); }
  .aq-reader-split__head { padding: 0 0 var(--space-6); }
  /* the key: navy swatch = the reader, a rule = the reading, the flow tick = the answer */
  .aq-reader-split__colh { display: flex; flex-direction: column; gap: var(--space-1); margin: 0 0 var(--space-3); padding: 0;
    font: 500 12px/18px var(--font-mono); color: var(--on-limestone-muted); }
  .aq-reader-split__colh span { display: flex; align-items: center; gap: var(--space-2); color: var(--on-limestone-muted) !important; }
  .aq-reader-split__colh span::before { content: ""; flex: none; width: 14px; height: 10px; box-sizing: border-box; }
  .aq-reader-split__colh span:first-child::before { background: var(--navy); }
  .aq-reader-split__colh span:nth-child(2)::before { border: 1px solid color-mix(in srgb, var(--on-limestone) 40%, transparent); }
  .aq-reader-split__colh .aq-reader-split__colk { display: flex; }
  .aq-reader-split__colh .aq-reader-split__colk::before { width: 3px; margin: 0 5px; background: var(--flow); }
  .aq-reader-split__rows::before { display: none; }
  .aq-reader-split__row { grid-template-columns: minmax(0, 1fr); margin: 0 0 1px; }
  .aq-reader-split__who { flex-wrap: wrap; row-gap: var(--space-1); padding: var(--space-3) var(--space-4); background: var(--navy); border-top: 0; }
  .aq-reader-split__t { font-size: 19px; line-height: 25px; }
  .aq-reader-split__what { height: auto; gap: var(--space-3); padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent); border-top: 0; margin-bottom: var(--space-2); }
  .aq-reader-split__read { font-size: 15px; line-height: 23px; }
  .aq-reader-split__k { display: none; }
  .aq-reader-split__go { min-height: 44px; justify-content: center; padding-left: var(--space-3); border-left: 3px solid var(--flow); font-size: 15px; line-height: 21px; }
  .aq-reader-split__tie { display: none; }
  .aq-reader-split-sec .aq-fold__btn { padding-left: 0; }
  /* the accordion head (PhoneKit switches it on): a navy bar, index, reader, chevron */
  .aq-reader-split__ph { margin: 0; }
  [data-pk-on] .aq-reader-split__ph { display: block; }
  .aq-reader-split__rows[data-pk-on] .aq-reader-split__head-btn { gap: var(--space-3); align-items: center; min-height: 52px; padding: var(--space-2) 0 var(--space-2) var(--space-4);
    background: var(--navy); color: var(--on-navy); font: 400 17px/23px var(--font-sans); letter-spacing: -0.01em; }
  .aq-reader-split__head-btn .aq-index { flex: none; color: var(--on-navy-muted); }
  .aq-reader-split__head-btn .aq-phone-kit__chev { color: var(--on-navy-muted); }
  .aq-reader-split__head-btn[aria-expanded="true"] .aq-phone-kit__chev { color: var(--on-navy); }
  .aq-reader-split__rows[data-pk-on] .aq-reader-split__what { border-top: 0; }
}
.aq-reader-split__pt { min-width: 0; text-wrap: balance; }/* pass 12 (F9): no lone word after a hard hyphen ("hand- / off") */
.aq-reader-split__nb { white-space: nowrap; }

/* The split band (also defined in BatteryLimit, retired 2026-11-05): the section is the positioned host of its ground. */
.aq-band--split { position: relative; }
