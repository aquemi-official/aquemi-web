.aq-strata-run__edge { fill: var(--line); }
/* leaders and the monitoring bus */
.aq-strata-run__lead { fill: none; stroke: var(--line-strong); stroke-width: 1; transition: stroke 200ms ease; }
.aq-strata-run__dot { fill: var(--line-strong); transition: fill 200ms ease; }
.aq-strata-run__lead.is-hot { stroke: var(--flow); }
.aq-strata-run__dot.is-hot { fill: var(--flow); }
.aq-strata-run__bus { fill: none; stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 4 3; }
.aq-strata-run__node { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1; }
.aq-strata-run__bus-g.is-hot .aq-strata-run__bus, .aq-strata-run__bus-g.is-hot .aq-strata-run__node { stroke: var(--flow); }
.aq-strata-run__svg .aq-iso__part.is-hot .aq-iso__eq, .aq-strata-run__svg .aq-iso__part.is-hot .aq-iso__ln, .aq-strata-run__svg .aq-iso__part.is-hot .aq-iso__thin { stroke: var(--flow); }
.aq-strata-run__return .aq-iso__pipe-wall { stroke-dasharray: none; }

.aq-strata-run__base {
  display: flex; align-items: center; gap: var(--space-3); margin: var(--space-2) 0 0;
  font: 400 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
}
.aq-strata-run__base a { color: inherit; display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; border-bottom: 1px solid transparent; }
.aq-strata-run__base a::after { content: "→"; margin-left: var(--space-2); color: var(--flow); }
.aq-strata-run__base a:hover { color: var(--ink); }
.aq-strata-run__base a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-strata-run__bus-key { width: var(--space-12); height: 0; border-top: 1px dashed var(--line-strong); flex: none; }

.aq-strata-run__pp { display: none; }

/* Phones (pass 12, S10): the run turns vertical. Each stage's slab drawing stands full height (--th) in a row of its
   own, alternating left and right; one twin-wall pipe zigzags down: in at the slab's near corner, out at the far
   corner, across to the page edge and down past the stage's text to the next slab. The text sits under its slab.
   --ly / --ry (inline, from the renderer): the slab's left and right corner heights as fractions of the drawing. */
@container (max-width: 860px) {
  .aq-strata-run { --th: 140px; --pc: var(--space-6); }
  .aq-strata-run__fig { display: none; }
  .aq-strata-run__stages { grid-auto-flow: row; grid-template-columns: minmax(0, 1fr); }
  .aq-strata-run__stage { --ey: var(--ly, 0.6); --xy: var(--ry, 0.6); display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 0;
    border-left: 0; padding: 0 var(--pc, var(--space-6)) var(--space-6); clip-path: inset(0 -4px); }
  /* a pipe lane on both sides of every row, so the text keeps one left edge whichever side the pipe runs down */
  .aq-strata-run__stage:nth-child(even) { --ey: var(--ry, 0.6); --xy: var(--ly, 0.6); }
  /* row 1: the slab drawing on one side, its number and name in the free half beside it (above the pipe); row 2: the text */
  .aq-strata-run__stage > .aq-index, .aq-strata-run__t { grid-row: 1; grid-column: 1; align-self: start; justify-self: end; width: 46%; position: relative; z-index: 1; }
  .aq-strata-run .aq-strata-run__t { margin-top: calc(var(--space-4) + var(--space-1)); }
  .aq-strata-run__stage:nth-child(even) > .aq-index, .aq-strata-run__stage:nth-child(even) .aq-strata-run__t { justify-self: start; }
  /* beside a left-hand slab the name may run on into the right pipe lane (the pipe leaves that lane lower down) */
  .aq-strata-run__stage:nth-child(odd) > .aq-index, .aq-strata-run__stage:nth-child(odd) .aq-strata-run__t {
    width: calc(50% + var(--pc, var(--space-6)) - var(--space-2)); margin-right: calc(-1 * var(--pc, var(--space-6))); }
  .aq-strata-run__d { grid-row: 2; grid-column: 1; }
  .aq-strata-run__thumb { grid-row: 1; grid-column: 1; position: relative; display: flex; align-items: flex-start; height: var(--th, 120px);
    margin: 0 calc(-1 * var(--pc, var(--space-6))) var(--space-3); padding: 0 var(--pc, var(--space-6)); }
  .aq-strata-run__stage:nth-child(even) .aq-strata-run__thumb { flex-direction: row-reverse; }
  .aq-strata-run__mini { flex: none; height: 100%; width: auto; max-width: 50%; }
  .aq-strata-run__d { max-width: none; }
  .aq-strata-run__t a { display: inline-block; padding-block: 10px; margin-block: -10px; } /* a 44 px target, no extra height */
  .aq-strata-run__t a::after { display: inline; } /* the arrow keeps to the last word */
  .aq-strata-run__base { padding-left: 0; }

  /* the pipe: twin walls in line-strong, the water down the middle in flow */
  .aq-strata-run__pp { display: block; box-sizing: border-box; border: 0 solid var(--line-strong); }
  .aq-strata-run__pp--iv, .aq-strata-run__pp--ov { position: absolute; width: 10px; border-inline-width: 1px;
    background: linear-gradient(var(--flow), var(--flow)) 50% 0 / 2px 100% no-repeat; }
  .aq-strata-run__pp--ih, .aq-strata-run__pp--oh { height: 10px; border-block-width: 1px;
    background: linear-gradient(var(--flow), var(--flow)) 0 50% / 100% 2px no-repeat; }
  .aq-strata-run__pp--iv { left: calc(var(--pc, var(--space-6)) / 2 - 5px); top: 0; height: calc(var(--th, 120px) * var(--ey, 0.6) + 5px); }
  .aq-strata-run__pp--ih { position: absolute; left: calc(var(--pc, var(--space-6)) / 2 - 5px); top: calc(var(--th, 120px) * var(--ey, 0.6) - 5px);
    width: calc(var(--pc, var(--space-6)) / 2 + 9px); border-left-width: 0; }
  .aq-strata-run__pp--oh { flex: 1 1 auto; align-self: flex-start; margin: calc(var(--th, 120px) * var(--xy, 0.6) - 5px) calc(var(--pc, var(--space-6)) / -2 - 5px) 0 -4px; }
  .aq-strata-run__pp--ov { right: calc(var(--pc, var(--space-6)) / 2 - 5px); top: calc(var(--th, 120px) * var(--xy, 0.6) - 5px); height: 4000px; border-top-width: 1px; }
  .aq-strata-run__stage:nth-child(even) .aq-strata-run__pp--iv { left: auto; right: calc(var(--pc, var(--space-6)) / 2 - 5px); }
  .aq-strata-run__stage:nth-child(even) .aq-strata-run__pp--ih { left: auto; right: calc(var(--pc, var(--space-6)) / 2 - 5px); }
  .aq-strata-run__stage:nth-child(even) .aq-strata-run__pp--oh { margin: calc(var(--th, 120px) * var(--xy, 0.6) - 5px) -4px 0 calc(var(--pc, var(--space-6)) / -2 - 5px); }
  .aq-strata-run__stage:nth-child(even) .aq-strata-run__pp--ov { right: auto; left: calc(var(--pc, var(--space-6)) / 2 - 5px); }
}
/* Tablets (600-860 px): the run keeps a phone's measure (the zigzag stays tight, no bare pipe across the page) and the
   slabs stand taller */
@container (min-width: 600px) and (max-width: 860px) {
  .aq-strata-run { --th: 180px; max-width: 560px; }
}

/* the moving water (AQbeam) while the visitor points at a stage: flow on the light sheet */
.aq-strata-run { --beam: var(--flow); --beam-tail: var(--flow); --beam-w: 4.5; }

/* ---------- SystemRun: the package as one continuous water line, a navy blueprint of the four systems ---------- */
/* The drawing spans the content width (IsoKit, aq-iso--navy) with a bracket over each system; one column per system
   under it. Water on navy is flow lightened towards on-navy (the IsoKit navy rule), kept in --sr-flow. */
.aq-system-run { --sr-flow: color-mix(in srgb, var(--flow) 45%, var(--on-navy)); --sr-rule: color-mix(in srgb, var(--on-navy-muted) 35%, transparent);
  position: relative; display: flex; flex-direction: column; gap: var(--space-8); }
.aq-system-run__fig { position: relative; margin-inline: calc(-1 * var(--space-4)); }
.aq-system-run__svg { width: 100%; }

/* Brackets over each system: index and name on a hairline with end ticks */
.aq-system-run__brackets { position: absolute; inset: 0; pointer-events: none; }
.aq-system-run__bracket { position: absolute; top: 7%; display: flex; gap: var(--space-2); align-items: baseline; justify-content: center;
  padding-top: var(--space-3); border-top: 1px solid var(--sr-rule, var(--line));
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); white-space: nowrap;
  transition: color 300ms, border-color 300ms; }
.aq-system-run__bracket::before, .aq-system-run__bracket::after { content: ""; position: absolute; top: calc(-1 * var(--space-2)); width: 1px; height: var(--space-4); background: var(--sr-rule, var(--line)); }
.aq-system-run__bracket::before { left: 0; }
.aq-system-run__bracket::after { right: 0; }
.aq-system-run__bn { color: var(--on-navy); }
.aq-system-run__bracket.is-on { color: var(--on-navy); border-top-color: var(--sr-flow, var(--flow)); }
.aq-system-run__bracket.is-on .aq-system-run__bn { color: var(--sr-flow, var(--flow)); }

/* Ends of the run: where drinking water enters, where Purified Water leaves */
.aq-system-run__end { position: absolute; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); white-space: nowrap; }
.aq-system-run__end--in { transform: translate(0, calc(-100% - var(--space-3))); }
.aq-system-run__end--out { right: var(--space-4); bottom: 8%; color: var(--sr-flow, var(--flow)); }
.aq-system-run__end--in::after, .aq-system-run__end--out::after { content: "\00a0\2192"; }

/* Columns: one per system, a hairline on top that fills with water when the system lights */
.aq-system-run__stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--space-6); }
.aq-system-run__item { min-width: 0; display: flex; }
.aq-system-run__stage { position: relative; display: flex; flex-direction: column; gap: var(--space-3); width: 100%; min-height: 44px;
  padding-top: var(--space-6); border-top: 1px solid var(--sr-rule, var(--line)); color: var(--on-navy); text-decoration: none; }
.aq-system-run__mark { position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--sr-flow, var(--flow)); transform: scaleX(0); transform-origin: 0 50%; transition: transform 500ms cubic-bezier(0.2, 0, 0, 1); }
.aq-system-run__stage.is-on .aq-system-run__mark, .aq-system-run__stage:hover .aq-system-run__mark, .aq-system-run__stage:focus-visible .aq-system-run__mark { transform: scaleX(1); }
.aq-system-run__stage:focus-visible { outline: 2px solid var(--on-navy); outline-offset: var(--space-2); }
.aq-system-run__mini-wrap { display: none; }
.aq-system-run__code { margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; color: var(--on-navy-muted); }
.aq-system-run__t { margin: 0; font: 400 24px/30px var(--font-sans); letter-spacing: -0.015em; color: var(--on-navy); }
.aq-system-run__d { margin: 0; font: 400 15px/24px var(--font-sans); color: var(--on-navy-muted); }
.aq-system-run__foot { margin: auto 0 0; padding-top: var(--space-2); display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
.aq-system-run .aq-tag { color: var(--on-navy); border-color: var(--on-navy-muted); }
.aq-system-run__go { font: 500 14px/20px var(--font-sans); color: var(--sr-flow, var(--flow)); }
.aq-system-run__go::after { content: "\00a0\2192"; display: inline-block; transition: transform 200ms; }
.aq-system-run__stage:hover .aq-system-run__go::after { transform: translateX(var(--space-1)); }
.aq-system-run__stage:hover .aq-system-run__t { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; text-decoration-color: var(--sr-flow, var(--flow)); }

@container (max-width: 1100px) {
  .aq-system-run__bracket { font-size: 11px; letter-spacing: 0.04em; }
  .aq-system-run__t { font-size: 20px; line-height: 26px; }
  .aq-system-run__d { font-size: 14px; line-height: 22px; }
}

.aq-system-run__pend, .aq-system-run__tee { display: none; }

/* Phones: one drawing per system down one vertical pipe at the left (pass 12): a twin-wall rail runs from "Drinking
   water" to "Point of use" with the water down its middle (each system's stretch is its __mark), and a tee leaves the
   rail for each drawing at the drawing's own inlet pipe. Drawings are cropped tight (no dead band), full column width. */
@container (max-width: 860px) {
  .aq-system-run { --sr-rail: var(--space-3); --sr-in: var(--space-6); gap: 0; }
  .aq-system-run__fig { display: none; }
  .aq-system-run__stages { position: relative; grid-template-columns: minmax(0, 1fr); row-gap: 0; margin-left: var(--space-1); }
  .aq-system-run__stages::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: var(--sr-rail, var(--space-3)); box-sizing: border-box;
    border-inline: 1px solid var(--on-navy-muted); pointer-events: none; }
  .aq-system-run__stage { border-top: 0; gap: var(--space-2); padding: var(--space-4) 0 var(--space-6) calc(var(--sr-rail, var(--space-3)) + var(--sr-in, var(--space-6))); }
  .aq-system-run__mark { left: calc(var(--sr-rail, var(--space-3)) / 2 - 1px); right: auto; top: 0; bottom: 0; width: 2px; height: auto; transform: scaleY(1); transform-origin: 50% 0; }
  .aq-system-run__stage::before { content: none; }
  .aq-system-run__mini-wrap { display: block; position: relative; max-width: 420px; margin-bottom: var(--space-1); }
  .aq-system-run__mini { display: block; width: 100%; height: auto; max-height: none; }
  /* the tee: a short twin-wall branch from the rail to the drawing's inlet, a node where it leaves the rail */
  .aq-system-run__tee { display: block; position: absolute; left: calc(-1 * (var(--sr-rail, var(--space-3)) + var(--sr-in, var(--space-6))) + 1px);
    width: calc(var(--sr-rail, var(--space-3)) + var(--sr-in, var(--space-6)) - 1px + var(--tx, 0%)); height: var(--space-2); margin-top: calc(-1 * var(--space-1));
    box-sizing: border-box; border-block: 1px solid var(--on-navy-muted); background: linear-gradient(var(--sr-flow, var(--flow)), var(--sr-flow, var(--flow))) 0 50% / 100% 2px no-repeat; }
  .aq-system-run__tee::before { content: ""; position: absolute; left: calc(var(--sr-rail, var(--space-3)) / 2 - var(--space-2)); top: 50%; width: var(--space-4); height: var(--space-4);
    margin-top: calc(-1 * var(--space-2)); box-sizing: border-box; border-radius: var(--radius-pill); background: var(--navy); border: 2px solid var(--sr-flow, var(--flow)); }
  .aq-system-run__t { font-size: 22px; line-height: 28px; }
  .aq-system-run__d { font-size: 15px; line-height: 23px; }
  /* tag and link on one row; when both do not fit, the link takes the next row whole, its arrow kept to the last word */
  .aq-system-run__foot { flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-3); min-height: 44px; padding-top: 0; }
  .aq-system-run__foot .aq-tag { flex: none; }
  .aq-system-run__go { min-width: 0; }
  .aq-system-run__go::after { display: inline; }
  /* the run's two ends, on the rail */
  .aq-system-run__pend { display: block; position: relative; margin: 0 0 0 var(--space-1); padding-left: calc(var(--sr-rail, var(--space-3)) + var(--sr-in, var(--space-6)));
    font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
  .aq-system-run__pend--in { padding-bottom: var(--space-3); }
  .aq-system-run__pend--in::after { content: "\00a0\2193"; }
  .aq-system-run__pend--out { padding-top: var(--space-3); color: var(--sr-flow, var(--flow)); }
  .aq-system-run__pend--out::after { content: "\00a0\2192"; }
  .aq-system-run__pend::before { content: ""; position: absolute; left: 0; width: var(--sr-rail, var(--space-3)); box-sizing: border-box; border-inline: 1px solid var(--on-navy-muted);
    background: linear-gradient(var(--sr-flow, var(--flow)), var(--sr-flow, var(--flow))) 50% 0 / 2px 100% no-repeat; }
  .aq-system-run__pend--in::before { top: 50%; bottom: 0; border-top: 1px solid var(--on-navy-muted); }
  .aq-system-run__pend--out::before { top: 0; height: 50%; border-bottom: 1px solid var(--on-navy-muted); }
}
/* Phones (pass 12 C): each vignette capped at 248 px wide (the 300 px the audit named is the column width at 375,
   so it changed nothing) and a space-4 foot under each stage; the tee still lands on the drawing's inlet */
@container (max-width: 600px) {
  .aq-system-run__mini-wrap { max-width: 248px; }
  .aq-system-run__stage { padding-bottom: var(--space-4); }
}
/* Tablets (600-860 px): each system's drawing on the left beside its text, so the column has no empty navy beside
   every drawing (the tee still lands on the drawing's inlet) */
@container (min-width: 600px) and (max-width: 860px) {
  .aq-system-run__stage { display: grid; grid-template-columns: minmax(0, min(420px, 55%)) minmax(0, 1fr); grid-template-rows: repeat(4, min-content) 1fr;
    column-gap: var(--space-6); row-gap: var(--space-2); align-content: start; }
  .aq-system-run__mini-wrap { grid-column: 1; grid-row: 1 / -1; align-self: start; margin-bottom: 0; }
  .aq-system-run__code, .aq-system-run__t, .aq-system-run__d, .aq-system-run__foot { grid-column: 2; }
  .aq-system-run__foot { margin-top: 0; }
}

/* the drawing may run a step past the content width: the band clips it */
.aq-system-run-sec { overflow-x: clip; }

/* Animated beam (AQbeam, ported from Subframe Motion "Animated beam"; shared by SystemRun, BatteryLimit, PidRoutes):
   the moving highlight that traces a water line while the visitor points at it. A hard bright head, a fading tail. */
.aq-beam, .aq-iso .aq-beam { stroke-width: var(--beam-w, 4); stroke-linecap: round; fill: none; pointer-events: none; vector-effect: none; }
.aq-beam__stop { stop-color: var(--beam, var(--flow)); }
.aq-beam__stop--0, .aq-beam__stop--3 { stop-opacity: 0; }
.aq-beam__stop--2, .aq-beam__stop--3 { stop-color: var(--beam-tail, var(--beam, var(--flow))); }
.aq-system-run { --beam: var(--on-navy); --beam-tail: var(--sr-flow, var(--flow)); }
/* the column of the system the visitor is pointing at in the drawing */
.aq-system-run__stage.is-hot .aq-system-run__mark { transform: scaleX(1); }
.aq-system-run__stage.is-hot .aq-system-run__t { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; text-decoration-color: var(--sr-flow, var(--flow)); }
.aq-system-run__fig { cursor: crosshair; }

/* ---------- TestSheet: the protocol as a signed test sheet on a limestone table (look "test-sheet") ----------
   Section on the limestone band. Desktop: the heading on the table at the left (3 of 12), the sheet beside it. The
   sheet is surface-raised paper with two more sheets' edges showing under it (offset hairlines, no shadow); rows are
   ruled (line), the step number set large in mono, the sign-off cell at the right behind a vertical rule. Hold rows
   carry a signature (flow ink) on a line and the HOLD stamp (a navy-ruled box, set slightly askew like a struck stamp).
   The torn row sits below a perforation (a dashed rule over a strip of the table) as a separate slip. */
.aq-test-sheet { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--space-12); align-items: start; isolation: isolate; }
.aq-test-sheet > .aq-sec-head { position: sticky; top: var(--space-24); }
.aq-test-sheet__paper { position: relative; background: var(--surface-raised); color: var(--ink); border: 1px solid color-mix(in srgb, var(--on-limestone) 18%, transparent); }
.aq-test-sheet__paper::before, .aq-test-sheet__paper::after { content: ""; position: absolute; z-index: -1; border: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent); background: var(--surface); }
.aq-test-sheet__paper::before { inset: var(--space-2) calc(-1 * var(--space-2)) calc(-1 * var(--space-2)) var(--space-2); }
.aq-test-sheet__paper::after { inset: var(--space-4) calc(-1 * var(--space-4)) calc(-1 * var(--space-4)) var(--space-4); z-index: -2; }
.aq-test-sheet__strip { display: grid; grid-template-columns: var(--space-24) minmax(0, 1fr) minmax(0, 15rem); padding: var(--space-3) var(--space-6); border-bottom: 1.5px solid var(--ink);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-test-sheet__rows { list-style: none; margin: 0; padding: 0 var(--space-6); }
.aq-test-sheet__row { display: grid; grid-template-columns: var(--space-24) minmax(0, 1fr) minmax(0, 15rem); align-items: stretch; border-bottom: 1px solid var(--line); position: relative; }
.aq-test-sheet__n { padding: var(--space-6) 0; font: 300 40px/40px var(--font-mono); letter-spacing: -0.04em; color: var(--ink-subtle); }
.aq-test-sheet__row.is-hold .aq-test-sheet__n { color: var(--flow); }
.aq-test-sheet__body { padding: var(--space-6) var(--space-6) var(--space-6) 0; }
.aq-test-sheet__t { margin: 0; font: 500 18px/26px var(--font-sans); color: var(--ink); }
.aq-test-sheet__d { margin: var(--space-1) 0 0; font: 400 15px/24px var(--font-sans); color: var(--ink-muted); max-width: 60ch; }
.aq-test-sheet__sign { position: relative; display: flex; align-items: center; justify-content: center; padding: var(--space-4) var(--space-6); border-left: 1px solid var(--line); }
.aq-test-sheet__box { width: var(--space-8); height: var(--space-8); border: 1.5px solid var(--line-strong); display: inline-flex; }
.aq-test-sheet__box svg { width: 100%; height: 100%; fill: none; stroke: var(--flow); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
.aq-test-sheet__hold { position: relative; width: 100%; display: flex; flex-direction: column; gap: var(--space-1); }
.aq-test-sheet__hk { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-test-sheet__sig { display: block; width: 70%; max-width: 168px; height: auto; border-bottom: 1px solid var(--ink-muted); padding-bottom: var(--space-1); overflow: visible; }
.aq-test-sheet__sig path { fill: none; stroke: var(--flow); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.aq-test-sheet__sig .aq-test-sheet__ink { stroke: var(--flow); }
.aq-test-sheet__sig .aq-test-sheet__imp { stroke: var(--line-strong); stroke-width: 2; opacity: 0.22; transform: translate(0.7px, 1px); }
.aq-test-sheet__who { font: 400 14px/20px var(--font-sans); color: var(--ink); }
.aq-test-sheet__stamp { position: absolute; right: 0; top: var(--space-4); padding: var(--space-1) var(--space-2); border: 2px solid var(--flow); outline: 1px solid var(--flow); outline-offset: 2px;
  color: var(--flow); font: 500 14px/18px var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; transform: rotate(-8deg); opacity: 0.85; }
/* the torn slip: the last step happens on site */
.aq-test-sheet__row.is-torn { margin: var(--space-8) calc(-1 * var(--space-6)) 0; padding: 0 var(--space-6); border-top: 1.5px dashed var(--line-strong); }
.aq-test-sheet__row.is-torn::before { content: ""; position: absolute; left: -1px; right: -1px; top: calc(-1 * var(--space-8) - 1.5px); height: var(--space-8); background: var(--limestone); }
.aq-test-sheet__row.is-torn .aq-test-sheet__n { color: var(--ink); }
.aq-test-sheet__row.is-torn { transform-origin: 0 0; transition: transform 240ms cubic-bezier(0.19, 1, 0.22, 1); }
.aq-test-sheet__row.is-torn.is-attached::before { opacity: 0; }
.aq-test-sheet__row.is-torn.is-tearing { transition: none; }
@media (hover: hover) and (prefers-reduced-motion: no-preference) { .aq-test-sheet__row.is-torn:hover { transform: translateX(var(--space-1)) rotate(0.3deg); } }
.aq-test-sheet__foot { display: flex; justify-content: flex-end; margin: 0 var(--space-6); padding: var(--space-4) 0; }
.aq-test-sheet__foot span { padding: var(--space-1) var(--space-3); border: 1px solid var(--line); margin-left: -1px; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }

@container (max-width: 860px) {
  .aq-test-sheet { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .aq-test-sheet > .aq-sec-head { position: static; }
  .aq-test-sheet__paper::after { display: none; }
  .aq-test-sheet__paper::before { inset: var(--space-1) calc(-1 * var(--space-1)) calc(-1 * var(--space-1)) var(--space-1); }
  .aq-test-sheet__rows { padding: 0 var(--space-4); }
  .aq-test-sheet__strip { display: none; }
  .aq-test-sheet__row { grid-template-columns: var(--space-12) minmax(0, 1fr); }
  .aq-test-sheet__n { padding: var(--space-4) 0; font-size: 24px; line-height: 28px; }
  .aq-test-sheet__body { padding: var(--space-4) 0 var(--space-3); }
  .aq-test-sheet__t { font-size: 17px; line-height: 24px; }
  .aq-test-sheet__d { font-size: 14px; line-height: 22px; }
  .aq-test-sheet__sign { grid-column: 2; border-left: 0; justify-content: flex-start; padding: 0 0 var(--space-4); }
  .aq-test-sheet__row:not(.is-hold) .aq-test-sheet__sign { position: absolute; right: 0; top: var(--space-4); padding: 0; }
  .aq-test-sheet__row:not(.is-hold) .aq-test-sheet__body { padding-right: var(--space-12); }
  .aq-test-sheet__box { width: var(--space-6); height: var(--space-6); }
  .aq-test-sheet__row.is-torn { margin: var(--space-6) calc(-1 * var(--space-4)) 0; padding: 0 var(--space-4); }
  .aq-test-sheet__row.is-torn::before { top: calc(-1 * var(--space-6) - 1.5px); height: var(--space-6); }
  .aq-test-sheet__foot { margin: 0 var(--space-4); }
}

/* section hook (the look marks its section) */
.aq-test-sheet-sec { position: relative; }

/* ---------- TimeCard: working terms as the shop's time card, a limestone card with a punch column ---------- */
.aq-time-card-sec { }
.aq-time-card__stack { position: relative; max-width: calc(var(--content-max) * 0.78); margin-top: var(--space-8); }
.aq-time-card { position: relative; padding: var(--space-12) var(--space-8) var(--space-8);
  background: var(--limestone); color: var(--on-limestone); border: 1px solid color-mix(in srgb, var(--navy) 26%, transparent); }
/* the card beneath it in the rack, outlined and turned a little */
.aq-time-card__under { position: absolute; inset: 0; border: 1px solid var(--line-strong); transform: rotate(-1.2deg) translate(var(--space-3), var(--space-2)); }
.aq-time-card__hole { position: absolute; left: 50%; top: var(--space-4); width: var(--space-12); height: var(--space-3); margin-left: calc(var(--space-12) / -2);
  border-radius: var(--radius-sm); background: var(--surface); border: 1px solid color-mix(in srgb, var(--navy) 30%, transparent); }
.aq-section--alt .aq-time-card__hole { background: var(--surface-sunken); }
.aq-time-card__head, .aq-time-card__row { display: grid; grid-template-columns: var(--space-16) minmax(0, 7fr) minmax(0, 3fr); column-gap: var(--space-6); }
.aq-time-card__head { padding: var(--space-2) 0; border-top: 2px solid var(--navy); border-bottom: 1px solid var(--navy);
  font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-time-card__rows { list-style: none; margin: 0; padding: 0; }
