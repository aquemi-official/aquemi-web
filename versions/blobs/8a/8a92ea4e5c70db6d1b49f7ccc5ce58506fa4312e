/* ---------- CheckerRouter: a router as a Swiss checker of navy, limestone and paper tiles, one band per situation ---------- */
.aq-checker-router-sec .aq-sec-head .aq-h1 { font: 300 56px/60px var(--font-sans); letter-spacing: -0.03em; max-width: 20ch; }
.aq-checker-router { list-style: none; margin: var(--space-8) 0 0; padding: 0; display: grid; gap: 1px; }
.aq-checker-router__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr) minmax(0, 0.8fr) minmax(0, 1.3fr) minmax(0, 0.8fr) minmax(0, 1.1fr);
  gap: 1px; min-height: calc(var(--space-32) + var(--space-12)); }

/* One tile. Its tone is a class; the inverse (row in hand) swaps tones tile by tile after --d steps of 45 ms, no tween */
.aq-checker-router__tile { position: relative; display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; margin: 0; padding: var(--space-4);
  --bg: var(--limestone); --fg: var(--on-limestone); --mu: var(--on-limestone-muted);
  background: var(--bg, var(--limestone)); color: var(--fg, var(--on-limestone)); box-shadow: 0 0 0 1px var(--line-strong); transition: background-color 1ms steps(1, end) calc(var(--d, 0) * 45ms), color 1ms steps(1, end) calc(var(--d, 0) * 45ms); }
.aq-checker-router__tile.is-navy { --bg: var(--navy); --fg: var(--on-navy); --mu: var(--on-navy-muted); }
.aq-checker-router__tile.is-paper { --bg: var(--surface-raised); --fg: var(--ink); --mu: var(--ink-subtle); }
.aq-checker-router__row.is-on .aq-checker-router__tile.is-lime,
.aq-checker-router__row.is-on .aq-checker-router__tile.is-paper { --bg: var(--navy); --fg: var(--on-navy); --mu: var(--on-navy-muted); }
.aq-checker-router__row.is-on .aq-checker-router__tile.is-navy { --bg: var(--limestone); --fg: var(--on-limestone); --mu: var(--on-limestone-muted); }
.aq-checker-router__row:not(.is-on) .aq-checker-router__tile { transition-delay: calc(var(--d, 0) * 30ms); }

/* The numeral tile: Geist Light figures, the slash in flow */
.aq-checker-router__num { justify-content: flex-start; }
.aq-checker-router__n { font: 300 88px/80px var(--font-sans); letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
.aq-checker-router__n i { font-style: normal; margin-left: var(--space-1); color: color-mix(in srgb, var(--flow) 55%, var(--fg, var(--on-limestone))); }

.aq-checker-router__k { font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--mu, var(--on-limestone-muted)); }
.aq-checker-router__t { margin: 0; font: 300 21px/27px var(--font-sans); letter-spacing: -0.01em; text-wrap: balance; }
.aq-checker-router__d { margin: 0; font: 400 15px/22px var(--font-sans); }
.aq-checker-router__d a { color: inherit; }

/* The go tile: a link the size of the tile, the arrow runs on hover */
a.aq-checker-router__go { text-decoration: none; cursor: pointer; }
.aq-checker-router__to { font: 400 17px/24px var(--font-sans); }
.aq-checker-router__arrow { margin-top: auto; align-self: flex-end; width: var(--space-8); height: 1px; background: currentColor; position: relative; transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-checker-router__arrow::after { content: ""; position: absolute; right: 0; top: calc(var(--space-1) * -1); width: var(--space-2); height: var(--space-2);
  border-top: 1px solid currentColor; border-right: 1px solid currentColor; transform: translateY(1px) rotate(45deg); transform-origin: 100% 0; }
.aq-checker-router__row.is-on .aq-checker-router__arrow { transform: translateX(var(--space-1)); }
a.aq-checker-router__go:focus-visible { outline: 2px solid var(--focus); outline-offset: -4px; }
.aq-checker-router__row.is-on a.aq-checker-router__go:focus-visible { outline-color: var(--on-navy); }

/* Paper filler with a tiny drawing; the drawing follows the tile's ink */
.aq-checker-router__tile.has-fig { align-items: center; justify-content: center; padding: var(--space-3); }
.aq-checker-router__svg { width: 100%; height: 100%; max-height: calc(var(--space-32) + var(--space-4)); }

@media (prefers-reduced-motion: reduce) {
  .aq-checker-router__tile, .aq-checker-router__arrow { transition: none; }
}

/* Small laptops: fillers narrow, figures smaller */
@container (max-width: 1100px) {
  .aq-checker-router__row { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr) minmax(0, 0.5fr) minmax(0, 1.4fr) minmax(0, 0.5fr) minmax(0, 1.2fr); }
  .aq-checker-router__n { font-size: 64px; line-height: 60px; }
  .aq-checker-router__tile.has-fig .aq-checker-router__svg { display: none; }
}

/* Phones: each situation is a 2 x 2 block of tiles (numeral | situation, need | start), still a checker */
@container (max-width: 860px) {
  .aq-checker-router-sec .aq-sec-head .aq-h1 { font-size: 34px; line-height: 40px; }
  .aq-checker-router { margin-top: var(--space-6); }
  .aq-checker-router__row { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); min-height: 0; }
  .aq-checker-router__tile.is-fill, .aq-checker-router__tile.is-paper { display: none; }
  .aq-checker-router__n { font-size: 56px; line-height: 52px; }
  .aq-checker-router__t { font-size: 19px; line-height: 25px; }
  .aq-checker-router__need { grid-column: 1 / -1; }
  .aq-checker-router__go { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; align-items: center; min-height: var(--space-16); column-gap: var(--space-4); }
  .aq-checker-router__go .aq-checker-router__k { flex-basis: 100%; }
  .aq-checker-router__arrow { margin: 0 0 0 auto; align-self: center; }
  .aq-checker-router__row:nth-child(odd) .aq-checker-router__go { --bg: var(--navy); --fg: var(--on-navy); --mu: var(--on-navy-muted); }
  .aq-checker-router__row:nth-child(odd).is-on .aq-checker-router__go { --bg: var(--limestone); --fg: var(--on-limestone); --mu: var(--on-limestone-muted); }
}

/* ---------- Pass 12 phones: one card per situation ----------
   A navy numeral tile (40 px, inline at the left) beside the situation, what you need under both on limestone in one
   14 px line, and the navy start-with band across the foot as the 48 px tap target. The checker survives as
   navy / limestone / navy down each card; pointing or focusing still inverts the card (mosaic). The column terms of
   the situation and the need stay for screen readers. */
@container (max-width: 860px) {
  .aq-checker-router { gap: var(--space-3); }
  .aq-checker-router__row { grid-template-columns: auto minmax(0, 1fr); gap: 0; border: 1px solid var(--line-strong); }
  .aq-checker-router__row .aq-checker-router__tile { box-shadow: none; }
  .aq-checker-router__num { grid-column: 1; grid-row: 1; min-width: var(--space-16); padding: var(--space-3) var(--space-2) var(--space-3) var(--space-3); }
  .aq-checker-router__n { font-size: 40px; line-height: 40px; letter-spacing: -0.04em; }
  .aq-checker-router__n i { margin-left: 0; }
  .aq-checker-router__sit { grid-column: 2; grid-row: 1; gap: 0; justify-content: center; padding: var(--space-3) var(--space-4); }
  .aq-checker-router__need { grid-column: 1 / -1; grid-row: 2; gap: 0; padding: var(--space-3) var(--space-4); border-top: 1px solid color-mix(in srgb, var(--mu, var(--on-limestone-muted)) 30%, transparent); }
  .aq-checker-router__sit .aq-checker-router__k, .aq-checker-router__need .aq-checker-router__k {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .aq-checker-router__t { font-size: 18px; line-height: 24px; }
  .aq-checker-router__d { font-size: var(--aq-read-phone, 14px); line-height: 20px; color: var(--mu, var(--on-limestone-muted)); }
  .aq-checker-router__row .aq-checker-router__tile.aq-checker-router__go { grid-column: 1 / -1; grid-row: 3; flex-wrap: nowrap; min-height: 48px; padding: var(--space-2) var(--space-4);
    column-gap: var(--space-3); --bg: var(--navy); --fg: var(--on-navy); --mu: var(--on-navy-muted); }
  .aq-checker-router__row.is-on .aq-checker-router__tile.aq-checker-router__go { --bg: var(--limestone); --fg: var(--on-limestone); --mu: var(--on-limestone-muted); }
  .aq-checker-router__go .aq-checker-router__k { flex: none; flex-basis: auto; }
  .aq-checker-router__to { font-size: 15px; line-height: 20px; }
  .aq-checker-router__arrow { width: var(--space-6); }
}

/* Pass 12 verify: the checker comes back as a zigzag. Each card carries two tones (x: numeral and start band; y:
   situation and need); every other card swaps them, so down the column the numerals and bands run navy, limestone,
   navy... against the opposite middle. Pointing or focusing a card still inverts it (mosaic). From 600 px the cards
   sit two across, and the swap follows the 2 x 2 checker (cards 2 and 3 of every four). */
@container (max-width: 860px) {
  .aq-checker-router__row, .aq-checker-router__row:nth-child(even).is-on {
    --x-bg: var(--navy); --x-fg: var(--on-navy); --x-mu: var(--on-navy-muted);
    --y-bg: var(--limestone); --y-fg: var(--on-limestone); --y-mu: var(--on-limestone-muted); }
  .aq-checker-router__row:nth-child(even):not(.is-on), .aq-checker-router__row:nth-child(odd).is-on {
    --x-bg: var(--limestone); --x-fg: var(--on-limestone); --x-mu: var(--on-limestone-muted);
    --y-bg: var(--navy); --y-fg: var(--on-navy); --y-mu: var(--on-navy-muted); }
  .aq-checker-router .aq-checker-router__row .aq-checker-router__tile.aq-checker-router__num,
  .aq-checker-router .aq-checker-router__row .aq-checker-router__tile.aq-checker-router__go { --bg: var(--x-bg, var(--navy)); --fg: var(--x-fg, var(--on-navy)); --mu: var(--x-mu, var(--on-navy-muted)); }
  .aq-checker-router .aq-checker-router__row .aq-checker-router__tile.aq-checker-router__sit,
  .aq-checker-router .aq-checker-router__row .aq-checker-router__tile.aq-checker-router__need { --bg: var(--y-bg, var(--limestone)); --fg: var(--y-fg, var(--on-limestone)); --mu: var(--y-mu, var(--on-limestone-muted)); }
  .aq-checker-router__row.is-on a.aq-checker-router__go:focus-visible { outline-color: currentColor; }
}
@container (min-width: 600px) and (max-width: 860px) {
  .aq-checker-router { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: stretch; }
  .aq-checker-router__row { grid-template-rows: auto 1fr auto; }
  .aq-checker-router__row:is(:nth-child(4n+1), :nth-child(4n)):not(.is-on), .aq-checker-router__row:is(:nth-child(4n+2), :nth-child(4n+3)).is-on {
    --x-bg: var(--navy); --x-fg: var(--on-navy); --x-mu: var(--on-navy-muted);
    --y-bg: var(--limestone); --y-fg: var(--on-limestone); --y-mu: var(--on-limestone-muted); }
  .aq-checker-router__row:is(:nth-child(4n+2), :nth-child(4n+3)):not(.is-on), .aq-checker-router__row:is(:nth-child(4n+1), :nth-child(4n)).is-on {
    --x-bg: var(--limestone); --x-fg: var(--on-limestone); --x-mu: var(--on-limestone-muted);
    --y-bg: var(--navy); --y-fg: var(--on-navy); --y-mu: var(--on-navy-muted); }
}
