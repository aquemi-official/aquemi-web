/* ---------- OptionList: configuration options as rows of the shared list grammar ---------- */
/* Layout comes from .aq-rows in base.css (index | option | one line on desktop; index | option, line below on phones),
   with `line` hairlines between rows. Options never get a box, a grid ground or a decorative glyph. */
.aq-options { min-width: 0; }

/* Plain rows (no icons, OptionList and plain ProcessSteps): a fixed 280 px title column with the line straight after it
   (capped at the reading measure), so short titles never leave a 400 px gap before their line. */
ol.aq-rows.aq-options:not(:has(.aq-rows__lead)) .aq-rows__row, ol.aq-rows.aq-steps:not(:has(.aq-rows__lead)) .aq-rows__row { grid-template-columns: var(--space-12) calc(var(--space-32) * 2 + var(--space-6)) minmax(0, var(--text-max)); column-gap: var(--space-6); padding-block: var(--space-6); }
ol.aq-rows.aq-options:not(:has(.aq-rows__lead)) .aq-rows__t, ol.aq-rows.aq-steps:not(:has(.aq-rows__lead)) .aq-rows__t { font-size: 18px; line-height: 26px; }
ol.aq-rows.aq-options:not(:has(.aq-rows__lead)) .aq-rows__row > .aq-index, ol.aq-rows.aq-steps:not(:has(.aq-rows__lead)) .aq-rows__row > .aq-index { line-height: 26px; }

/* Decisions (as: "decisions"): the index with a "?" beside it in flow (a word, not a badge), an optional fork mark
   (line art) before a two-way decision, an optional "Decide by" eyebrow under the line. */
.aq-options--decide .aq-rows__row { align-items: baseline; }
.aq-options__q { display: flex; align-items: baseline; gap: var(--space-2); }
.aq-options__q > .aq-index { line-height: 26px; }
.aq-options__qt { font: 500 13px/26px var(--font-mono); color: var(--flow); }
.aq-options__fork { display: inline-block; width: var(--space-8); height: 20px; margin-right: var(--space-2); vertical-align: -4px; overflow: visible; }
.aq-options__fork path { fill: none; stroke: var(--flow); stroke-width: 1.5; }
.aq-options__fork circle { fill: var(--flow); }
.aq-options__by { display: block; margin-top: var(--space-2); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }

@container (max-width: 860px) {
  ol.aq-rows.aq-options:not(:has(.aq-rows__lead)) .aq-rows__row, ol.aq-rows.aq-steps:not(:has(.aq-rows__lead)) .aq-rows__row { grid-template-columns: var(--space-8) minmax(0, 1fr); column-gap: var(--space-3); padding-block: var(--space-4); }
  ol.aq-rows.aq-options:not(:has(.aq-rows__lead)) .aq-rows__t, ol.aq-rows.aq-steps:not(:has(.aq-rows__lead)) .aq-rows__t { font-size: 16px; line-height: 24px; }
  ol.aq-rows.aq-options:not(:has(.aq-rows__lead)) .aq-rows__row > .aq-index, ol.aq-rows.aq-steps:not(:has(.aq-rows__lead)) .aq-rows__row > .aq-index,
  .aq-options__q > .aq-index, .aq-options__qt { line-height: 24px; }
  .aq-options__q { grid-row: span 2; gap: var(--space-1); }
  .aq-options__fork { width: var(--space-6); height: 16px; }
}

/* ---------- OptionModules: options as modules around the base skid (options block, as: "modules") ----------
   Desktop: three columns, modules | base drawing in a Plate | modules, each module wired to the plate by a dashed
   hairline. A module is a `line` frame on surface with a hairline under its title. Phones: the plate on top, then one
   column of modules hanging off a dashed vertical spine. */
.aq-option-modules {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1fr);
  column-gap: var(--space-12); align-items: stretch; min-width: 0;
}
.aq-option-modules--bare { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
.aq-option-modules__list {
  list-style: none; margin: 0; padding: 0; min-width: 0;
  display: flex; flex-direction: column; justify-content: space-around; gap: var(--space-8);
}
.aq-option-modules__m { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
.aq-option-modules__cat { margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-option-modules__m--l .aq-option-modules__cat { text-align: right; }

/* The module: a hairline frame with the title over a hairline, the vignette at left and the line beside it. */
.aq-option-modules__box {
  position: relative; display: grid; grid-template-columns: calc(var(--space-24) + var(--space-3)) minmax(0, 1fr); align-items: center;
  justify-items: center;
  border: 1px solid var(--line); background: var(--surface);
}
.aq-option-modules__box--bare { grid-template-columns: minmax(0, 1fr); }
.aq-option-modules__t {
  grid-column: 1 / -1; justify-self: stretch; display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3);
  margin: 0; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--line);
  font: 500 16px/24px var(--font-sans); letter-spacing: -0.005em; color: var(--ink);
}
.aq-option-modules__plus { flex: none; font: 400 16px/24px var(--font-mono); color: var(--flow); }
/* Linked module (item link): the box is the link, as a row of the shared grammar is: the title ends in a flow arrow and
   turns flow on hover with the vignette, a focus ring round the frame. The frame and the + stay as they are. */
a.aq-option-modules__box { color: var(--ink); text-decoration: none; }
a.aq-option-modules__box .aq-option-modules__t > span:first-child::after { content: "\a0\2192"; content: "\a0\2192" / ""; color: var(--flow); }
a.aq-option-modules__box:hover .aq-option-modules__t { color: var(--flow); }
a.aq-option-modules__box:hover .aq-option-modules__vig { background-color: var(--flow); }
a.aq-option-modules__box:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-option-modules__vig { margin: var(--space-3) 0 var(--space-3) var(--space-3); }
.aq-option-modules__d { justify-self: stretch; margin: 0; padding: var(--space-3) var(--space-4); font: 400 14px/22px var(--font-sans); color: var(--ink-muted); }

/* Connector: a dashed hairline from the title to the plate edge, ending in a node on the plate. */
.aq-option-modules__wire {
  position: absolute; top: 0; height: calc(var(--space-12) + 1px); width: var(--space-12); overflow: visible; pointer-events: none;
}
.aq-option-modules__m--l .aq-option-modules__wire { left: 100%; }
.aq-option-modules__m--r .aq-option-modules__wire { right: 100%; }
.aq-option-modules__wire line { stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 4 3; }
.aq-option-modules__wire circle { fill: var(--flow); }

/* The base: the page's own equipment drawing in a Plate, as tall as the module columns. */
.aq-option-modules__base { display: flex; align-items: center; justify-content: center; min-width: 0; }
.aq-option-modules__fig { margin: 0; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-4); }
.aq-option-modules__art { width: 100%; max-width: calc(var(--space-32) * 3); aspect-ratio: 1; background-color: var(--ink-muted); }
/* The base is the page icon, drawn at 96 px: an icon, not a picture, so it stays icon-sized in the centre of the frame */
.aq-option-modules__art--spot.aq-spot { width: var(--space-24); height: var(--space-24); background-color: var(--ink-muted); }
.aq-option-modules__label { display: flex; flex-direction: column; align-items: center; gap: var(--space-1); text-align: center; }
.aq-option-modules__label span:first-child { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-option-modules__label span + span { font: 400 14px/22px var(--font-sans); color: var(--ink); }

/* Fold: on desktop every module stays on the drawing (the layout needs both columns); the fold works on phones. */
.aq-fold:not(.is-open) .aq-option-modules__m.aq-fold-x { display: flex; }
.aq-fold:has(> .aq-option-modules) > .aq-fold__btn { display: none; }

@container (max-width: 860px) {
  .aq-option-modules, .aq-option-modules--bare { display: flex; flex-direction: column; }
  .aq-option-modules__base { order: -1; padding: var(--space-4) var(--space-4) var(--space-4) var(--space-8); justify-content: flex-start; }
  .aq-option-modules__fig { flex-direction: row; gap: var(--space-4); }
  .aq-option-modules__art { width: var(--space-24); flex: none; }
  .aq-option-modules__label { align-items: flex-start; text-align: left; min-width: 0; overflow-wrap: break-word; }
  .aq-option-modules__art--spot.aq-spot { width: var(--space-24); max-width: var(--space-24); flex: none; }

  /* The spine: one dashed line from the plate down past every module. */
  .aq-option-modules__list {
    justify-content: flex-start; gap: var(--space-4);
    margin-left: var(--space-3); padding: var(--space-4) 0 0 var(--space-4); border-left: 1px dashed var(--line-strong);
  }
  /* The second list joins the first without a gap of its own while all its modules are folded away. */
  .aq-option-modules__list--r { padding-top: 0; }
  .aq-fold.is-open .aq-option-modules__list--r, .aq-option-modules__list--r:has(> li:not(.aq-fold-x)) { padding-top: var(--space-4); }
  .aq-option-modules__m--l .aq-option-modules__cat { text-align: left; }
  .aq-option-modules__m--l .aq-option-modules__wire, .aq-option-modules__m--r .aq-option-modules__wire {
    left: auto; right: 100%; width: calc(var(--space-4) + 1px); height: calc(var(--space-8) + var(--space-2));
  }
  .aq-option-modules__m--l .aq-option-modules__wire { transform: scaleX(-1); }
  .aq-option-modules__box { grid-template-columns: auto minmax(0, 1fr); }
  .aq-option-modules__box--bare { grid-template-columns: minmax(0, 1fr); }
  .aq-option-modules__t { padding: var(--space-2) var(--space-3); font-size: 15px; line-height: 24px; }
  .aq-option-modules__vig.aq-spot { width: var(--space-16); height: var(--space-16); }
  .aq-option-modules__vig.aq-spot--icon { width: var(--space-12); height: var(--space-12); }
  .aq-option-modules__vig { margin: var(--space-2) 0 var(--space-2) var(--space-3); }
  .aq-option-modules__d { padding: var(--space-2) var(--space-3); font-size: 13px; line-height: 20px; }

  .aq-fold:not(.is-open) .aq-option-modules__m.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-option-modules) > .aq-fold__btn { display: flex; }
}

/* ---------- OptionTaps: options as dashed parts on dashed tees off the standard train, one limestone drawing sheet ---------- */
/* The sheet: a navy hairline frame, the heading at display scale over the drawing, the notes in a narrow column right of
   a vertical rule, the title block at its foot. */
.aq-option-taps { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); border: 1px solid var(--on-limestone); outline: 1px solid var(--on-limestone); outline-offset: var(--space-2); margin: var(--space-2); }
.aq-option-taps__main { display: flex; flex-direction: column; gap: var(--space-6); padding: var(--space-12) var(--space-8) var(--space-8); min-width: 0; }
.aq-option-taps__main .aq-sec-head .aq-eyebrow { color: var(--on-limestone-muted); }
.aq-option-taps__main .aq-sec-head .aq-h1 { font: 300 120px/112px var(--font-sans); letter-spacing: -0.045em; color: var(--on-limestone); max-width: none; }
.aq-option-taps__side { display: flex; flex-direction: column; border-left: 1px solid var(--on-limestone); min-width: 0; }

/* the drawing: a camera that frames one part when a note is chosen */
/* pass 12 C: the drawing sits a fixed step under the intro (margin-top auto left a ~260 px dead band), and its
   viewBox is the train's own bounds, so at width 100% it fills the column */
.aq-option-taps__fig { position: relative; overflow: hidden; margin-top: var(--space-8); }
.aq-option-taps__cam { position: relative; transform-origin: 0 0; transition: transform 600ms cubic-bezier(0.2, 0, 0, 1); }
.aq-option-taps__svg { display: block; width: 100%; height: auto; }
/* optional: every line of the part and its tee dashed; lit (note hovered or chosen) in flow */
.aq-option-taps__svg .aq-option-taps__ghost .aq-iso__eq, .aq-option-taps__svg .aq-option-taps__ghost .aq-iso__ln, .aq-option-taps__svg .aq-option-taps__ghost .aq-iso__thin,
.aq-option-taps__svg .aq-option-taps__tee .aq-iso__pipe-wall,
.aq-option-taps__crop-svg .aq-option-taps__ghost .aq-iso__eq, .aq-option-taps__crop-svg .aq-option-taps__ghost .aq-iso__ln, .aq-option-taps__crop-svg .aq-option-taps__ghost .aq-iso__thin,
.aq-option-taps__crop-svg .aq-option-taps__tee .aq-iso__pipe-wall { stroke-dasharray: 4 3; }
.aq-option-taps__svg .aq-option-taps__ghost .aq-iso__acc, .aq-option-taps__svg .aq-option-taps__ghost .aq-iso__trace,
.aq-option-taps__crop-svg .aq-option-taps__ghost .aq-iso__acc, .aq-option-taps__crop-svg .aq-option-taps__ghost .aq-iso__trace { stroke-dasharray: 2 3; }
.aq-option-taps__svg [data-iso-id] { transition: opacity 300ms cubic-bezier(0.2, 0, 0, 1); }
.aq-option-taps.is-focus .aq-option-taps__svg [data-iso-id]:not(.is-lit) { opacity: 0.35; }
.aq-option-taps__label, .aq-option-taps__mark { position: absolute; transform: translate(-50%, -100%); white-space: nowrap; pointer-events: none; }
.aq-option-taps__label--end { transform: translate(-100%, -100%); }
.aq-option-taps__label { font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-option-taps__mark { display: grid; place-items: center; min-width: var(--space-8); height: var(--space-8); padding: 0 var(--space-1);
  border: 1px solid var(--on-limestone); background: var(--limestone); font: 500 13px/1 var(--font-mono); color: var(--on-limestone); transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-option-taps__mark.is-on { background: var(--navy); color: var(--on-navy); border-color: var(--navy); }

/* Notes: numbered like the pins, hairlines between */
.aq-option-taps__side .aq-fold { flex: 1; }
.aq-option-taps__cards { list-style: none; margin: 0; padding: var(--space-8) 0 0; display: flex; flex-direction: column; }
.aq-option-taps__card { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-4) var(--space-6); border-bottom: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent); color: var(--on-limestone); }
.aq-option-taps__no { margin: 0; }
.aq-option-taps__pin { display: inline-grid; place-items: center; min-width: var(--space-12); min-height: var(--space-12); margin: calc(-1 * var(--space-2)) 0 0 calc(-1 * var(--space-2)); padding: 0;
  border: 0; background: transparent; color: var(--on-limestone); font: 400 15px/1 var(--font-mono); cursor: pointer; }
.aq-option-taps__pin::before { content: ""; position: absolute; width: var(--space-8); height: var(--space-8); border: 1px solid var(--on-limestone); box-sizing: border-box; transition: background-color 150ms cubic-bezier(0.2, 0, 0, 1); z-index: -1; }
.aq-option-taps__pin { position: relative; z-index: 0; }
.aq-option-taps__pin:hover::before { background: color-mix(in srgb, var(--on-limestone) 10%, transparent); }
.aq-option-taps__pin[aria-pressed="true"] { color: var(--on-navy); }
.aq-option-taps__pin[aria-pressed="true"]::before { background: var(--navy); border-color: var(--navy); }
.aq-option-taps__pin:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-option-taps__t { margin: 0; font: 400 17px/23px var(--font-sans); }
.aq-option-taps__d { margin: 0; font: 400 14px/21px var(--font-sans); color: var(--on-limestone-muted); }
.aq-option-taps__card.is-on .aq-option-taps__t { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
.aq-option-taps__crop, .aq-option-taps__nop { display: none; }
.aq-fold:not(.is-open) .aq-option-taps__card.aq-fold-x { display: flex; }
.aq-fold:has(> .aq-option-taps__cards) > .aq-fold__btn { display: none; }
/* pass 12 C verify F6: on the sheet the notes fill the side column down to the title block, rules spaced evenly
   (the drawing column sets the height; the notes column had ~325 px of empty paper under its last row) */
@container (min-width: 861px) {
  .aq-option-taps__side > .aq-fold { flex: 1 0 auto; display: flex; flex-direction: column; }
  .aq-option-taps__cards, .aq-option-taps__card { flex: 1 0 auto; }
}

/* title block */
.aq-option-taps__block { display: grid; grid-template-columns: minmax(0, 1fr); margin-top: auto; border-top: 1px solid var(--on-limestone); }
.aq-option-taps__block span { padding: var(--space-2) var(--space-4); border-top: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent); font: 400 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-option-taps__block span:first-child { border-top: 0; color: var(--on-limestone); }

@container (max-width: 1100px) {
  .aq-option-taps__main .aq-sec-head .aq-h1 { font-size: 88px; line-height: 88px; }
  .aq-option-taps__label { display: none; }
  .aq-option-taps__card { padding: var(--space-3) var(--space-4); }
}
@container (max-width: 860px) {
  .aq-option-taps { grid-template-columns: minmax(0, 1fr); margin: var(--space-1); outline-offset: var(--space-1); }
  .aq-option-taps__main { padding: var(--space-8) var(--space-4) var(--space-4); }
  .aq-option-taps__main .aq-sec-head .aq-h1 { font-size: 56px; line-height: 56px; }
  .aq-option-taps__side { border-left: 0; border-top: 1px solid var(--on-limestone); }
  .aq-option-taps__label { display: none; }
  /* the whole-train overview would render under 300 px wide (labels and parts unreadable): each note carries its own
     crop of the train at its tap point instead (trunk, the standard part with its drawing label, the dashed option) */
  .aq-option-taps__fig { display: none; }
  .aq-option-taps__main { gap: var(--space-4); }
  .aq-option-taps__cards { padding-top: 0; }
  /* each note: its crop across the full column, then the number tag beside the title, then the note */
  .aq-option-taps__card { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-3); row-gap: var(--space-1);
    align-items: center; align-content: start; padding: var(--space-4); }
  .aq-option-taps__crop { grid-column: 1 / -1; grid-row: 1; }
  .aq-option-taps__no { grid-column: 1; grid-row: 2; }
  .aq-option-taps__t { grid-column: 2; grid-row: 2; }
  .aq-option-taps__d { grid-column: 1 / -1; grid-row: 3; }
  .aq-option-taps__pin { display: none; }
  .aq-option-taps__nop { display: grid; place-items: center; min-width: var(--space-8); height: var(--space-8); box-sizing: border-box; padding: 0 var(--space-1);
    border: 1px solid var(--on-limestone); background: var(--limestone); font: 500 14px/1 var(--font-mono); color: var(--on-limestone); }
  .aq-option-taps__crop { display: block; position: relative; width: 100%; height: auto; margin: 0 0 var(--space-3); }
  .aq-option-taps__crop-svg { display: block; width: 100%; height: 100%; overflow: hidden; }
  .aq-option-taps__clab { position: absolute; transform: translate(-50%, -100%); white-space: nowrap; pointer-events: none;
    font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--on-limestone-muted); background: var(--limestone); padding: 0 var(--space-1); }
  .aq-option-taps__clab--side { transform: translate(0, -50%); }
  .aq-option-taps__clab--left { transform: translate(-100%, -50%); }
  .aq-option-taps__t { font-size: 18px; line-height: 24px; }
  .aq-option-taps__d { font-size: 15px; line-height: 22px; }
  .aq-fold:not(.is-open) .aq-option-taps__card.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-option-taps__cards) > .aq-fold__btn { display: flex; }
}
/* Tablets (600-860 px, pass 12): the notes two a row, so each crop stays about 150 px tall instead of stretching */
@container (min-width: 600px) and (max-width: 860px) {
  .aq-option-taps__cards { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-6); }
  .aq-fold:not(.is-open) .aq-option-taps__card.aq-fold-x { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .aq-option-taps__cam, .aq-option-taps__svg [data-iso-id] { transition: none; }
}

/* ---------- ParameterCallouts ---------- */
/* Design parameters called out on the page's equipment drawing. Desktop: a 2:1 figure (viewBox 200 x 100 for the
   leaders): label columns 0-25 % and 75-100 %, the drawing a centred square between them on the plain section ground.
   Labels hang from a flow rule (the bottom label of a side stands on one); flow leaders run from the rule's inner end
   to a numbered pin on the drawing. Any rows that are not called out follow as a SpecTable. */
.aq-parameter-callouts { display: flex; flex-direction: column; gap: var(--space-8); }
.aq-parameter-callouts__fig { position: relative; aspect-ratio: 2 / 1; }
.aq-parameter-callouts__art { position: absolute; top: 0; bottom: 0; left: 25%; right: 25%; }
.aq-parameter-callouts__art .aq-illustration { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; aspect-ratio: auto; margin: 0; }
.aq-parameter-callouts__pins { position: absolute; inset: 0; }
.aq-parameter-callouts__pin { position: absolute; transform: translate(-50%, -50%); padding: 0 var(--space-1); border: 1px solid var(--flow); border-radius: var(--radius-sm); background: var(--surface); font: 400 12px/18px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink); }
.aq-parameter-callouts__leaders { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
.aq-parameter-callouts__leaders line { stroke: var(--flow); stroke-width: 1; vector-effect: non-scaling-stroke; }
.aq-parameter-callouts__list { list-style: none; margin: 0; padding: 0; }
.aq-parameter-callouts__item { position: absolute; width: 25%; display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-3); row-gap: var(--space-1); align-content: start; padding-top: var(--space-2); border-top: 1px solid var(--flow); }
.aq-parameter-callouts__item.is-l { left: 0; padding-right: var(--space-4); }
.aq-parameter-callouts__item.is-r { right: 0; padding-left: var(--space-4); }
.aq-parameter-callouts__item.is-up { border-top: 0; padding-top: 0; padding-bottom: var(--space-2); border-bottom: 1px solid var(--flow); }
.aq-parameter-callouts__item > .aq-index { grid-row: 1 / span 3; }
.aq-parameter-callouts__p { grid-column: 2; margin: 0; font: 500 14px/20px var(--font-sans); color: var(--ink); }
.aq-parameter-callouts__v { grid-column: 2; margin: 0; font: 400 16px/22px var(--font-mono); letter-spacing: -0.01em; font-variant-numeric: tabular-nums; color: var(--ink); overflow-wrap: break-word; }
.aq-parameter-callouts__v .aq-ph { font-size: inherit; }
.aq-parameter-callouts__m { grid-column: 2; margin: 0; font: 400 13px/18px var(--font-sans); color: var(--ink-muted); }

@container (max-width: 860px) {
  /* Phone: the drawing with its numbered pins on top, the numbered list below on hairlines */
  .aq-parameter-callouts { gap: var(--space-6); }
  .aq-parameter-callouts__fig { aspect-ratio: auto; }
  .aq-parameter-callouts__leaders { display: none; }
  /* the drawing runs edge to edge (into the section gutters) as a full-width square, pins at a readable size */
  .aq-parameter-callouts__art { position: relative; inset: auto; width: calc(100% + 2 * var(--space-4)); aspect-ratio: 1; margin-inline: calc(-1 * var(--space-4)); }
  .aq-parameter-callouts__pin, .aq-parameter-callouts__item > .aq-index { min-width: var(--space-8); padding: var(--space-1) var(--space-2); box-sizing: border-box; text-align: center; border: 1px solid var(--flow); border-radius: var(--radius-sm); background: var(--surface); font: 400 13px/16px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink); }
  .aq-parameter-callouts__list { margin-top: var(--space-4); border-bottom: 1px solid var(--line); }
  /* List rows as SpecTable phone rows: the parameter, then the value and " · " basis in one run */
  .aq-parameter-callouts__item, .aq-parameter-callouts__item.is-l, .aq-parameter-callouts__item.is-r, .aq-parameter-callouts__item.is-up { position: relative; display: block; width: auto; padding: var(--space-4) 0 var(--space-4) var(--space-12); border: 0; border-top: 1px solid var(--line); }
  .aq-parameter-callouts__item > .aq-index { position: absolute; left: 0; top: var(--space-4); }
  .aq-parameter-callouts__p { margin-bottom: var(--space-1); }
  .aq-parameter-callouts__v, .aq-parameter-callouts__m { display: inline; }
  .aq-parameter-callouts__m::before { content: "\a0\b7\a0"; content: "\a0\b7\a0" / ""; color: var(--ink-subtle); }
  .aq-parameter-callouts__p { font: 400 16px/24px var(--font-sans); }
  .aq-parameter-callouts__v { font-size: 14px; line-height: 22px; letter-spacing: 0; }
  .aq-parameter-callouts__m { font-size: 12px; line-height: 18px; }
}

/* ---------- PlanChecker: service plans as a checker of navy and limestone tiles (look "plan-checker") ----------
   Limestone band (data-theme light). One column per plan, columns alternate navy and a lighter limestone tile with a
   hairline edge; each column is a head tile (slash numeral 300 at up to 112 px, name, who it suits) and a terms tile
   whose rows line up across columns through subgrid. No table rules: tiles and gaps separate. Navy tiles remap the ink
   tokens to their on-navy values. Phones: a snap row of plan cards at 85 % under a strip of numeral tabs. */
.aq-plan-checker-sec .aq-sec-head .aq-h1 { font-weight: 300; letter-spacing: -0.03em; }
.aq-plan-checker__tabs { display: none; }
.aq-plan-checker__plans {
  list-style: none; margin: 0; padding: 0; display: grid; column-gap: var(--space-1);
  grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
  grid-template-rows: auto repeat(var(--rows, 3), auto) auto;
}
.aq-plan-checker__plan { grid-row: 1 / -1; display: grid; grid-template-rows: subgrid; min-width: 0; }
.aq-plan-checker .is-navy {
  background: var(--navy); color: var(--on-navy);
  --ink: var(--on-navy); --ink-muted: var(--on-navy-muted); --line-strong: color-mix(in srgb, var(--on-navy) 45%, transparent);
}
.aq-plan-checker .is-lime {
  background: color-mix(in srgb, var(--surface) 55%, var(--limestone)); color: var(--on-limestone);
  box-shadow: inset 1px 0 var(--line-strong), inset -1px 0 var(--line-strong);
}
.aq-plan-checker .is-navy .aq-ph { background: transparent; color: var(--on-navy); outline: 1px dashed var(--on-navy-muted); outline-offset: -1px; }

.aq-plan-checker__head { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6); margin-bottom: var(--space-1); min-height: 19rem; }
.aq-plan-checker__head.is-lime { box-shadow: inset 0 0 0 1px var(--line-strong); }
.aq-plan-checker__no { margin: 0 0 auto; font: 300 clamp(72px, 8.4vw, 112px)/0.9 var(--font-sans); letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
.aq-plan-checker__sl { opacity: 0.55; margin-left: 0.04em; }
.aq-plan-checker__mark { margin: 0; font: 500 12px/16px var(--font-mono); color: var(--flow); }
.aq-plan-checker__name { margin: var(--space-4) 0 0; font: 400 13px/20px var(--font-mono); }
.aq-plan-checker__suits { margin: 0; font: 300 20px/26px var(--font-sans); letter-spacing: -0.01em; }
.aq-plan-checker__sk { display: block; font: 400 12px/18px var(--font-mono); color: var(--on-limestone-muted); }
.is-navy .aq-plan-checker__sk { color: var(--on-navy-muted); }

.aq-plan-checker__term { padding: var(--space-3) var(--space-6); transition: background-color 160ms ease; }
.aq-plan-checker__term.is-first { padding-top: var(--space-6); }
.aq-plan-checker__term.is-first.is-lime { box-shadow: inset 1px 0 var(--line-strong), inset -1px 0 var(--line-strong), inset 0 1px var(--line-strong); }
.aq-plan-checker__v { margin: 0; font-size: 16px; line-height: 23px; overflow-wrap: anywhere; }
.aq-plan-checker__term.is-first .aq-plan-checker__v { font: 300 22px/28px var(--font-sans); letter-spacing: -0.01em; }
.aq-plan-checker__k { margin: var(--space-1) 0 0; font: 400 12px/17px var(--font-mono); color: var(--on-limestone-muted); }
.is-navy .aq-plan-checker__k { color: var(--on-navy-muted); }
.aq-plan-checker__term.is-lit.is-lime { background: var(--flow-tint); }
.aq-plan-checker__term.is-lit.is-navy { background: color-mix(in srgb, var(--on-navy) 12%, var(--navy)); }
.aq-plan-checker__act { padding: var(--space-4) var(--space-6) var(--space-6); }
.aq-plan-checker__act.is-lime { box-shadow: inset 1px 0 var(--line-strong), inset -1px 0 var(--line-strong), inset 0 -1px var(--line-strong); }
.aq-plan-checker__act .aq-btn { width: 100%; justify-content: center; text-align: center; }
.aq-plan-checker-sec .aq-fold__btn { margin-top: var(--space-6); }
.aq-fold:not(.is-open) .aq-plan-checker__term.aq-fold-x { display: none; }

/* Phones (pass 12, S11): the plans become a snap row of cards at 85 % width, the next one peeking; each card keeps
   its checker tiles (head, terms, button) in its own column. Over the row, a strip of numeral tabs (numerals only,
   still navy/limestone) jumps to a plan and follows the swipe (look JS, AQsnap). */
@container (max-width: 860px) {
  .aq-plan-checker__tabs { display: grid; grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); gap: var(--space-1); margin-bottom: var(--space-2); }
  .aq-plan-checker__tab {
    display: flex; align-items: center; justify-content: center; min-height: 48px; min-width: 0;
    padding: 0 var(--space-2); border: 0; border-radius: 0; font: inherit; cursor: pointer;
  }
  .aq-plan-checker__tabno { font: 300 24px/1 var(--font-sans); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  /* round C: every tab is a limestone tile; the selected one (the plan in view, aria-selected) is the one navy tile,
     so "on" reads once (the cards keep their own alternating checker) */
  .aq-plan-checker__tab {
    background: color-mix(in srgb, var(--surface) 55%, var(--limestone)); color: var(--on-limestone);
    box-shadow: inset 0 0 0 1px var(--line-strong); transition: background-color 160ms ease, color 160ms ease;
  }
  .aq-plan-checker__tab[aria-selected="true"] { background: var(--navy); color: var(--on-navy); box-shadow: none; }
  .aq-plan-checker__tab:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .aq-plan-checker__plans {
    display: flex; gap: var(--space-2); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
    scrollbar-width: none; padding-bottom: var(--space-1); }
  .aq-plan-checker__plans::-webkit-scrollbar { display: none; }
  .aq-plan-checker__plan { flex: 0 0 min(85%, 340px); display: flex; flex-direction: column; scroll-snap-align: start; }
  .aq-plan-checker__head { flex: 1 0 auto; min-height: 0; padding: var(--space-4); gap: var(--space-2); align-content: start;
    display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-3); align-items: center; }
  .aq-plan-checker__no { grid-row: 1 / span 2; margin: 0; font-size: var(--aq-num-phone, 44px); line-height: 1; }
  .aq-plan-checker__mark, .aq-plan-checker__name { grid-column: 2; margin: 0; font-size: 14px; }
  .aq-plan-checker__suits { grid-column: 1 / -1; margin-top: var(--space-2); font-size: 18px; line-height: 24px; }
  .aq-plan-checker__term { padding-inline: var(--space-4); }
  .aq-plan-checker__term.is-first { padding-top: var(--space-4); }
  .aq-plan-checker__term.is-first .aq-plan-checker__v { font-size: 18px; line-height: 25px; }
  .aq-plan-checker__v { font-size: 15px; line-height: 22px; }
  /* round C: the term lines (placeholders, mono) read at 14 px on a 1.5 line box; their labels stay 12 px */
  .aq-plan-checker__v .aq-ph, .aq-plan-checker__term.is-first .aq-plan-checker__v .aq-ph { font-size: 14px; line-height: 1.5; }
  .aq-plan-checker__term .aq-plan-checker__v { line-height: 1.5; }
  .aq-plan-checker__k .aq-ph { font-size: 12px; }
  .aq-plan-checker__k { font-size: 12px; line-height: 17px; }
  .aq-plan-checker__act { padding: var(--space-4); }
  .aq-plan-checker__act .aq-btn { min-height: 48px; }
  /* the base plan has no button: its last tile is a thin foot */
  .aq-plan-checker__plan.is-base .aq-plan-checker__act { padding: 0 0 var(--space-4); }
}

/* ---------- PlantStations: the points of use as numbered stations on an isometric plant room ---------- */
/* Desktop: the plan (IsoKit drawing with HTML tags over it) on the left, the numbered rows on the right. */
.aq-plant-stations { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--space-12); align-items: center; color: var(--ink); }
.aq-plant-stations__plan { position: relative; margin: 0; }
.aq-plant-stations__svg { display: block; width: 100%; height: auto; }
.aq-plant-stations__route { fill: none; stroke: var(--flow); stroke-width: 1.5; stroke-dasharray: 6 5; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke;
  transition: stroke-width 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-plant-stations__drop.is-hot { stroke-width: 3; stroke-dasharray: none; }

/* Tags: one per station, keyed to the row number; 13 px mono on a navy chip, a short stem down to the station */
.aq-plant-stations__tag { position: absolute; z-index: 1; transform: translate(-50%, calc(-100% - var(--space-2))); padding: var(--space-1) var(--space-2);
  background: var(--navy); color: var(--on-navy); font: 500 13px/16px var(--font-mono); letter-spacing: 0.02em; white-space: nowrap; pointer-events: none;
  transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-plant-stations__tag::after { content: ""; position: absolute; left: 50%; top: 100%; width: 1px; height: var(--space-2); background: var(--navy); transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-plant-stations__tag.is-hot { background: var(--flow); color: var(--surface); }
.aq-plant-stations__tag.is-hot::after { background: var(--flow); }

/* Rows: ruled, the number large in mono (the tag's key), the use, then where it goes */
.aq-plant-stations__rows { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
.aq-plant-stations__row { border-bottom: 1px solid var(--line-strong); }
.aq-plant-stations__in { display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr); align-items: baseline; padding: var(--space-4) 0; color: inherit; text-decoration: none; }
.aq-plant-stations__no { font: 400 24px/28px var(--font-mono); color: var(--ink-muted); transition: color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-plant-stations__row.is-hot .aq-plant-stations__no { color: var(--flow); }
.aq-plant-stations__txt { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
.aq-plant-stations__t { font: 500 18px/24px var(--font-sans); color: var(--ink); }
.aq-plant-stations__d { font: 400 15px/22px var(--font-sans); color: var(--ink-muted); }
a.aq-plant-stations__in:hover .aq-plant-stations__t { text-decoration: underline; text-underline-offset: 3px; }
a.aq-plant-stations__in:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* Phones: the plan trimmed to the room, then every row (each has a tag on the plan, so none folds) */
@container (max-width: 860px) {
  .aq-plant-stations { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); overflow-x: clip; }
  /* tablets: the whole room, capped and centred (the phone trim cut both back walls at 768) */
  .aq-plant-stations__plan { width: 100%; max-width: 640px; margin-inline: auto; }
  .aq-plant-stations__tag { font-size: 13px; line-height: 16px; padding: 2px var(--space-1); }
  .aq-plant-stations__in { grid-template-columns: var(--space-8) minmax(0, 1fr); padding: var(--space-3) 0; }
  .aq-plant-stations__no { font-size: 17px; line-height: 24px; }
  .aq-plant-stations__t { font-size: 17px; line-height: 24px; }
}

/* small phones: trimmed to the room, the plan runs wider than the column and its empty floor margins fall off the sides */
@container (max-width: 600px) {
  .aq-plant-stations__plan { width: 124%; max-width: none; margin-left: -12%; margin-right: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .aq-plant-stations__route, .aq-plant-stations__tag, .aq-plant-stations__tag::after, .aq-plant-stations__no { transition: none; }
}

/* ---------- PqCalendar: PQ phases beside one instrument readout (look "pq-calendar") ----------
   Section on the limestone band; the figure carries data-theme="light" so navy and flow keep their light values on
   limestone in both themes. Desktop: the phases as a ruled stack (5 of 12; mono "01 /" numerals, a key in the
   phase's fill), the readout panel beside it (7 of 12) on a lighter sheet with a navy foot rule: the giant light
   count, unit and sum, the sampling grid, then the year's tick scale (solid ticks for the daily phases, short ticks for
   the routine plan) with month numbers and the year tag. The region marker (flow tint, flow edges with handles)
   glides to the pointed phase's span: --g0/--g1 on the grid, --y0/--y1 on the scale. */
.aq-pq-calendar { --pq-p1: var(--navy); --pq-p2: var(--flow); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-12); align-items: start; color: var(--on-limestone); }
.aq-pq-calendar__phases { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--on-limestone); }
.aq-pq-calendar__ph { display: grid; grid-template-columns: var(--space-24) minmax(0, 1fr); column-gap: var(--space-4); padding: var(--space-6) var(--space-2) var(--space-6) 0; border-bottom: 1px solid color-mix(in srgb, var(--on-limestone) 35%, transparent); outline: none; cursor: default; transition: background-color 180ms; }
.aq-pq-calendar__ph:hover, .aq-pq-calendar__ph:focus-visible { background: color-mix(in srgb, var(--surface-raised) 45%, transparent); }
.aq-pq-calendar__ph:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
.aq-pq-calendar__n { font: 300 34px/1 var(--font-mono); letter-spacing: -0.04em; color: var(--on-limestone); padding-left: var(--space-2); }
.aq-pq-calendar__n i { font-style: normal; color: var(--on-limestone-muted); margin-left: 0.1em; }
.aq-pq-calendar__t { margin: 0; display: flex; align-items: center; gap: var(--space-2); font: 400 20px/26px var(--font-sans); color: var(--on-limestone); }
.aq-pq-calendar__key { width: var(--space-3); height: var(--space-3); flex: none; background: var(--pq-p1, var(--navy)); border-radius: 50%; }
.is-p2 > .aq-pq-calendar__txt .aq-pq-calendar__key { background: var(--pq-p2, var(--flow)); }
.is-rest > .aq-pq-calendar__txt .aq-pq-calendar__key { border-radius: 0; width: 2px; height: var(--space-4); background: var(--pq-p1, var(--navy)); }
.aq-pq-calendar__d { margin: var(--space-2) 0 0; font: 400 15px/23px var(--font-sans); color: var(--on-limestone-muted); }
.aq-pq-calendar__hold { margin: var(--space-3) 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font: 400 14px/20px var(--font-sans); color: var(--on-limestone); }
.aq-pq-calendar__hold span { padding: 0 var(--space-2); border: 1px solid var(--on-limestone); font: 500 12px/20px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }

.aq-pq-calendar__panel { display: flex; flex-direction: column; gap: var(--space-8); padding: var(--space-8) var(--space-8) var(--space-6); background: color-mix(in srgb, var(--surface-raised) 55%, transparent); border-bottom: 2px solid var(--navy); }
.aq-pq-calendar__total { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-4); }
.aq-pq-calendar__num { flex-basis: 100%; font: 300 168px/0.9 var(--font-sans); letter-spacing: -0.05em; color: var(--on-limestone); font-variant-numeric: tabular-nums; }
.aq-pq-calendar__unit { font: 400 13px/18px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--on-limestone); }
.aq-pq-calendar__eq { font: 400 13px/18px var(--font-mono); letter-spacing: 0.04em; color: var(--on-limestone-muted); }
.aq-pq-calendar__zoomed, .aq-pq-calendar__scale { position: relative; }
.aq-pq-calendar__grid { display: block; width: 100%; height: auto; overflow: visible; }
.aq-pq-calendar__dot.is-p1 { fill: var(--pq-p1, var(--navy)); }
.aq-pq-calendar__dot.is-p2 { fill: var(--pq-p2, var(--flow)); }
.aq-pq-calendar__hl { stroke: var(--on-limestone); stroke-width: 1.5; stroke-dasharray: 4 3; }
.aq-pq-calendar__year { display: block; width: 100%; height: var(--space-8); }
.aq-pq-calendar__wk.is-p1 { fill: var(--pq-p1, var(--navy)); }
.aq-pq-calendar__wk.is-p2 { fill: var(--pq-p2, var(--flow)); }
.aq-pq-calendar__wk.is-rest { fill: var(--on-limestone-muted); }
.aq-pq-calendar__strip { position: relative; margin-top: var(--space-4); }
.aq-pq-calendar__months { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); margin-top: var(--space-1); border-top: 1px solid var(--on-limestone); }
.aq-pq-calendar__months span { padding: var(--space-1) 0 0 var(--space-1); border-left: 1px solid color-mix(in srgb, var(--on-limestone) 35%, transparent); font: 400 12px/16px var(--font-mono); color: var(--on-limestone-muted); }
.aq-pq-calendar__ylab { position: absolute; right: 0; top: calc(-1 * var(--space-6)); padding: 0 var(--space-2); border: 1px solid var(--on-limestone); font: 500 12px/20px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone); background: var(--limestone); }

/* the region marker: not drawn until a phase is pointed at; then glides between spans */
.aq-pq-calendar__reg { position: absolute; top: calc(-1 * var(--space-1)); bottom: calc(-1 * var(--space-1)); left: var(--g0, 0%); width: var(--g1, 0%); background: color-mix(in srgb, var(--flow) 14%, transparent); border-left: 1px solid var(--flow); border-right: 1px solid var(--flow); display: none; pointer-events: none;
  transition: left 240ms cubic-bezier(0.2, 0, 0, 1), width 240ms cubic-bezier(0.2, 0, 0, 1); }
.aq-pq-calendar__reg i { position: absolute; top: 50%; width: var(--space-1); height: var(--space-4); margin-top: calc(-1 * var(--space-2)); background: var(--flow); }
.aq-pq-calendar__reg i:first-child { left: calc(-1 * var(--space-1) / 2); } .aq-pq-calendar__reg i:last-child { right: calc(-1 * var(--space-1) / 2); }
.aq-pq-calendar__scale .aq-pq-calendar__reg { left: var(--y0, 0%); width: var(--y1, 0%); }
.aq-pq-calendar[data-on] .aq-pq-calendar__scale .aq-pq-calendar__reg, .aq-pq-calendar[data-on="grid"] .aq-pq-calendar__zoomed .aq-pq-calendar__reg { display: block; }
@media (prefers-reduced-motion: reduce) { .aq-pq-calendar__reg { transition: none; } }

@container (max-width: 860px) {
  .aq-pq-calendar { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
  .aq-pq-calendar__ph { grid-template-columns: var(--space-16) minmax(0, 1fr); padding: var(--space-4) 0; }
  .aq-pq-calendar__n { font-size: 26px; padding-left: 0; }
  .aq-pq-calendar__t { font-size: 18px; line-height: 24px; }
  .aq-pq-calendar__d { font-size: 14px; line-height: 22px; }
  .aq-pq-calendar__panel { padding: var(--space-6) var(--space-4) var(--space-4); gap: var(--space-6); }
  .aq-pq-calendar__num { font-size: 104px; }
  .aq-pq-calendar__months span:nth-child(even) { color: transparent; }
}

/* section hook */
.aq-pq-calendar-sec { position: relative; }

/* ---------- ProcessDiagram: a treatment train as an interactive piping flow in a Plate ----------
   Single-weight line art: one row of stations (Spot vignette in a `line` frame, index, name) on a double-hairline flow
   pipe with arrows; each station is a toggle button. The pressed station's run and the runs before it tint flow-tint
   (water has reached here), and its detail opens under the row, below a `line` hairline, with a flow leader up to it.
   Phone: one vertical pipe through the vignettes; the pressed station's detail opens inline under it, beside the pipe.
   Without the page script (no is-live) every detail shows: under its column on desktop, inline on phones.
   Geometry: --fh vignette box height, --fw its width (phone), --g column gap; the pipe is --space-3 high, 1.5 px walls. */
.aq-diagram__plate { padding-top: var(--space-8); }
.aq-diagram { --fh: calc(var(--space-24) + var(--space-6)); --g: var(--space-6); --pw: var(--space-3); min-width: 0; }
.aq-diagram--base { border: 1px dashed var(--line-strong); padding: var(--space-6) var(--space-6) var(--space-4); }
.aq-diagram__line { display: grid; grid-template-columns: repeat(var(--n, 6), minmax(0, 1fr)); column-gap: var(--g, var(--space-6)); }

/* Pipe-end labels (WaterPath "City feed" / "Point of use"). Child spans only: a [placeholder] or µ inside a label is a
   span of its own and takes no arrow */
.aq-diagram__ends { display: flex; justify-content: space-between; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
/* the end labels are a <p>: the extra class beats the page reset (.aq-page p { margin: 0 }) */
.aq-diagram .aq-diagram__ends { margin: 0 0 var(--space-6); }
.aq-diagram__ends > span::after { color: var(--flow); }
.aq-diagram__ends > span:first-child::after { content: "\a0\2192"; }
.aq-diagram__ends > span:last-child::after { content: "\a0\2192"; }

/* Station: a reset button holding the run, the vignette box, the index and the name */
.aq-diagram__st {
  grid-row: 1; position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-3); min-width: 0;
  margin: 0; padding: 0 0 var(--space-2); border: 0; background: none; color: var(--ink); font: inherit; text-align: center; cursor: pointer;
}
.aq-diagram__st:focus-visible { outline: 2px solid var(--focus); outline-offset: var(--space-1); border-radius: var(--radius-sm); }
.aq-diagram__fig { position: relative; z-index: 1; display: grid; place-items: center; width: min(100%, var(--space-32)); height: var(--fh, var(--space-32)); border: 1px solid var(--line); background: var(--surface); }
.aq-diagram__fig .aq-diagram__spot { background-color: var(--ink-muted); }
.aq-diagram__n {
  position: absolute; z-index: 2; top: var(--space-1); left: calc(50% - min(50%, var(--space-16)) + var(--space-2));
  font: 400 12px/16px var(--font-mono); font-variant-numeric: tabular-nums; letter-spacing: 0.02em; color: var(--ink-subtle);
}
.aq-diagram__t { padding: 0 var(--space-1); font: 500 14px/20px var(--font-sans); letter-spacing: 0; color: var(--ink); overflow-wrap: anywhere; text-wrap: balance; }

/* The pipe run into each station: from the previous station's centre (first: from the edge), two hairline walls, arrow mid-run */
.aq-diagram__run { position: absolute; z-index: 0; top: calc(var(--fh, var(--space-32)) / 2 - var(--pw, var(--space-4)) / 2); right: 50%; width: calc(100% + var(--g, var(--space-6))); height: var(--pw, var(--space-4)); border-block: 1.5px solid var(--flow); overflow: hidden; }
.aq-diagram__st:first-child .aq-diagram__run { width: calc(50% + var(--space-8)); }
.aq-diagram__fill { position: absolute; inset: 0; background: var(--flow-tint); transform: scaleX(0); transform-origin: left center; }
.aq-diagram__run::after, .aq-diagram__st.is-last::after { content: ""; position: absolute; z-index: 1; top: 50%; left: 50%; transform: translate(-50%, -50%); border-block: 4px solid transparent; border-left: 6px solid var(--flow); }
/* The outlet after the last station, with its arrow */
.aq-diagram__st.is-last::before { content: ""; position: absolute; z-index: 0; top: calc(var(--fh, var(--space-32)) / 2 - var(--pw, var(--space-4)) / 2); left: 50%; width: calc(50% + var(--space-6)); height: var(--pw, var(--space-4)); border-block: 1.5px solid var(--flow); }
.aq-diagram__st.is-last::after { top: calc(var(--fh, var(--space-32)) / 2); left: auto; right: calc(-1 * var(--space-6)); transform: translateY(-50%); border-left-width: 8px; border-block-width: 5px; }

/* Pressed: its run and every run upstream tint (water has reached here); the box edge, index and name take flow */
.aq-diagram__st[aria-pressed="true"] .aq-diagram__fill, .aq-diagram__st:has(~ .aq-diagram__st[aria-pressed="true"]) .aq-diagram__fill { transform: none; }
.aq-diagram__st[aria-pressed="true"] .aq-diagram__fig { border-color: var(--flow); }
.aq-diagram__st[aria-pressed="true"] .aq-diagram__fig .aq-diagram__spot { background-color: var(--flow); }
.aq-diagram__st[aria-pressed="true"] .aq-diagram__n { color: var(--flow); }
.aq-diagram__st[aria-pressed="true"] .aq-diagram__t { color: var(--flow); }
.aq-diagram__st:not([aria-pressed="true"]):hover .aq-diagram__t { color: var(--flow); }
.aq-diagram__st:not([aria-pressed="true"]):hover .aq-diagram__fig .aq-diagram__spot { background-color: var(--ink); }
@media (prefers-reduced-motion: no-preference) { .aq-diagram__fig, .aq-diagram__t, .aq-diagram__spot { transition: color 200ms, background-color 200ms, border-color 200ms; } }

/* Detail: with the script, one panel under the row (the pressed station's) below a hairline, a leader up to its column */
.aq-diagram__d[hidden] { display: none; }
.aq-diagram__d { grid-row: 2; min-width: 0; }
.aq-diagram.is-live .aq-diagram__d {
  grid-column: 1 / -1; position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; column-gap: var(--space-8); align-items: start;
  margin-top: var(--space-8); padding: var(--space-6) 0 0; border-top: 1px solid var(--line);
}
.aq-diagram.is-live .aq-diagram__d::before {
  content: ""; position: absolute; bottom: 100%; height: calc(var(--space-8) - var(--space-1)); width: 0; border-left: 1px solid var(--flow);
  left: calc((100% - (var(--n, 6) - 1) * var(--g, var(--space-6))) / var(--n, 6) * (var(--i, 0) + 0.5) + var(--i, 0) * var(--g, var(--space-6)) - 1px);
}
.aq-diagram__dn { font: 300 32px/36px var(--font-mono); letter-spacing: -0.02em; color: var(--ink); font-variant-numeric: tabular-nums; }
.aq-diagram__dn small { font-size: 14px; color: var(--ink-subtle); letter-spacing: 0; }
.aq-diagram__db { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
.aq-diagram__dt { margin: 0; font: 500 20px/28px var(--font-sans); color: var(--ink); }
.aq-diagram__dd { margin: 0; max-width: var(--text-max); font: 400 16px/24px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
.aq-diagram__dx { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); margin: var(--space-1) 0 0; }
.aq-diagram__dx a { color: var(--ink); font: 500 15px/24px var(--font-sans); text-decoration: none; }
.aq-diagram__dx a::after { content: "\a0\2192"; color: var(--flow); }
.aq-diagram__dx a:hover { color: var(--flow); text-decoration: underline; }
.aq-diagram__io { display: flex; flex-direction: column; gap: var(--space-2); margin: 0; font: 400 14px/22px var(--font-sans); color: var(--ink); }
.aq-diagram__io b { display: inline-block; min-width: var(--space-8); margin-right: var(--space-2); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
/* Without the script: each column's line under its station, small; number, title and in/out left to the stations */
.aq-diagram:not(.is-live) .aq-diagram__d { padding: var(--space-2) var(--space-1) 0; text-align: center; }
.aq-diagram:not(.is-live) .aq-diagram__dn, .aq-diagram:not(.is-live) .aq-diagram__dt, .aq-diagram:not(.is-live) .aq-diagram__io { display: none; }
.aq-diagram:not(.is-live) .aq-diagram__dd { font-size: 14px; line-height: 20px; }
.aq-diagram:not(.is-live) .aq-diagram__dx { justify-content: center; }

/* What spans every stage: the dashed control boundary round the train, labelled at its foot */
.aq-diagram__base { display: flex; align-items: center; gap: var(--space-3); margin: var(--space-6) 0 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-diagram__base svg { flex: none; width: var(--space-6); height: var(--space-6); fill: none; stroke: var(--ink-muted); stroke-width: 1.5; }

/* Phone: one vertical pipe down through the vignettes; name beside each; the detail opens inline under its station */
/* Selecting a station further down: the water shows in full Flow in the runs it passes through (script, < 1 s) */
.aq-diagram__st.is-flowing .aq-diagram__fill { background: var(--flow); }
@media (prefers-reduced-motion: no-preference) {
  .aq-diagram__fig { transition: color 120ms, background-color 120ms, border-color 120ms, transform 200ms; }
  /* hover lifts the box a hair; press sets it down */
  .aq-diagram__st:not([aria-pressed="true"]):hover .aq-diagram__fig { transform: translateY(calc(-1 * var(--space-1))); }
  .aq-diagram__st:active .aq-diagram__fig { transform: scale(0.97); transition-duration: 80ms; }
}

@container (max-width: 860px) {
  .aq-diagram__plate { padding: var(--space-3); }
  .aq-diagram__plate .aq-plate__block { display: none; }
  .aq-diagram { --fh: calc(var(--space-12) + var(--space-2)); --fw: calc(var(--space-12) + var(--space-2)); --g: var(--space-1); --pw: var(--space-3); }
  /* compact vignettes: 56 px boxes, the drawing at 48 px (icons 36 px), glyph scaled to fit */
  .aq-diagram__fig .aq-spot, .aq-diagram__fig .aq-spot--s { width: var(--space-12); height: var(--space-12); }
  .aq-diagram__fig .aq-spot.aq-spot--icon { width: calc(var(--space-8) + var(--space-1)); height: calc(var(--space-8) + var(--space-1)); }
  .aq-diagram--base { padding: var(--space-4) var(--space-3) var(--space-3); }
  .aq-diagram__ends { display: none; }
  .aq-diagram__line { grid-template-columns: minmax(0, 1fr); row-gap: var(--g, var(--space-6)); padding-top: var(--space-3); }
  .aq-diagram__st { grid-row: auto; display: grid; grid-template-columns: var(--fw, var(--space-24)) minmax(0, 1fr); column-gap: var(--space-3); align-items: center; padding: 0; text-align: left; }
  .aq-diagram__fig { width: var(--fw, var(--space-24)); }
  .aq-diagram__n { top: 0; left: 0; padding: 0 var(--space-1); background: var(--surface); font-size: 12px; line-height: 16px; }
  .aq-diagram__t { padding: 0; font-size: 14px; line-height: 20px; text-wrap: pretty; }
  /* runs are vertical: the incoming half from above, the outgoing half below the box */
  .aq-diagram__run { top: calc(-1 * var(--g, var(--space-6))); bottom: 50%; right: auto; left: calc(var(--fw, var(--space-24)) / 2 - var(--pw, var(--space-4)) / 2); width: var(--pw, var(--space-4)); height: auto; border: 0; border-inline: 1.5px solid var(--flow); }
  .aq-diagram__st:first-child .aq-diagram__run { top: calc(-1 * var(--space-3)); width: var(--pw, var(--space-4)); }
  .aq-diagram__fill { transform: scaleY(0); transform-origin: center top; }
  .aq-diagram__run::after { display: none; }
  .aq-diagram__st::before, .aq-diagram__st.is-last::before { content: ""; position: absolute; z-index: 0; top: 50%; bottom: 0; left: calc(var(--fw, var(--space-24)) / 2 - var(--pw, var(--space-4)) / 2); width: var(--pw, var(--space-4)); height: auto; border: 0; border-inline: 1.5px solid var(--flow); }
  .aq-diagram__st.is-last::before { bottom: calc(-1 * var(--space-4)); }
  .aq-diagram__st.is-last::after { top: auto; bottom: calc(-1 * var(--space-4)); right: auto; left: calc(var(--fw, var(--space-24)) / 2); transform: translate(-50%, 100%); border: 0; border-inline: 5px solid transparent; border-top: 8px solid var(--flow); }
  .aq-diagram__line { padding-bottom: var(--space-6); }
  .aq-diagram__line > .aq-diagram__d:last-child::after { display: none; }
  /* the detail: tucked under the station's name, beside the box (it rises into the row by --fh less one name line);
     the pipe continues down past whatever runs below the box */
  .aq-diagram__st { align-items: start; }
  .aq-diagram__st .aq-diagram__t { padding-top: var(--space-1); }
  .aq-diagram__d, .aq-diagram.is-live .aq-diagram__d {
    grid-row: auto; grid-column: 1; position: relative; display: block; margin: calc(var(--space-6) + var(--space-1) - var(--fh, var(--space-24))) 0 0 calc(var(--fw, var(--space-24)) + var(--space-3)); padding: 0;
    border: 0; border-radius: 0; background: none; text-align: left;
  }
  .aq-diagram__d::after { content: ""; position: absolute; top: calc(var(--fh, var(--space-24)) - var(--space-6) - var(--space-1)); bottom: calc(-1 * var(--space-1)); left: calc(-1 * var(--space-3) - var(--fw, var(--space-24)) / 2 - var(--pw, var(--space-4)) / 2); width: var(--pw, var(--space-4)); border-inline: 1.5px solid var(--flow); }
  .aq-diagram.is-live .aq-diagram__d::before { display: none; }
  .aq-diagram__dn, .aq-diagram__dt { display: none; }
  .aq-diagram__db { gap: var(--space-1); }
  .aq-diagram__dd, .aq-diagram:not(.is-live) .aq-diagram__dd { font-size: 13px; line-height: 20px; }
  /* on the phone the neighbours sit right above and below: In/Out only where there is no line to show */
  .aq-diagram .aq-diagram__db:has(.aq-diagram__dd) + .aq-diagram__io { display: none; }
  .aq-diagram__dx { gap: var(--space-3); }
  .aq-diagram__io, .aq-diagram:not(.is-live) .aq-diagram__io { display: flex; flex-direction: row; flex-wrap: wrap; gap: var(--space-1) var(--space-4); margin-top: var(--space-2); }
  .aq-diagram__io:first-child { margin-top: 0; }
  .aq-diagram__base { margin-top: var(--space-4); }
}

/* ---------- ProcessSteps: a real sequence as rows of the shared list grammar ---------- */
/* Layout from .aq-rows (base.css): index | step name | what happens. The index already carries the order, so a plain
   list has no pipe, spine or stair: hairlines between steps are the only structure. */
.aq-steps { min-width: 0; }

/* ---------- Hold-point flow (.aq-steps--hold, inside a Plate) ----------
   Steps with at least one hold draw as a process flow in single-weight line art: numbered stations in a grid (--cols per
   row, set by steps.js), joined by 1.5 px line-strong pipes with small arrowheads, rows returning under each other
   through rounded elbows, and a closed flow valve (P&ID symbol) on the run into every hold station. Stations have no
   ground or frame: the number, the name and what happens sit on the section, and a hold adds one line, "Hold" in
   flow and who signs.
   Geometry: space-8 gutter beside the grid (the return pipe runs in it), space-12 gap between stations (the runs),
   pipe centre line at space-3 + 24px (the middle of the station number). Pipes, valves and arrows are aria-hidden. */
.aq-steps--hold {
  display: grid; grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); column-gap: var(--space-12); row-gap: 0;
  list-style: none; margin: 0; padding: 0 var(--space-8);
}
.aq-steps__st { position: relative; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-3); min-width: 0; }
.aq-steps__n { font: 300 32px/48px var(--font-mono); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--ink); }
.aq-steps__body { display: flex; flex-direction: column; gap: var(--space-2); }
.aq-steps__t { margin: 0; font: 500 16px/24px var(--font-sans); letter-spacing: -0.005em; color: var(--ink); text-wrap: balance; }
/* Station link (item link): the title is the link, as a row's: ink, ending in a flow arrow, flow on hover */
.aq-steps__go { color: inherit; text-decoration: none; }
.aq-steps__go::after { content: "\a0\2192"; content: "\a0\2192" / ""; color: var(--flow); }
.aq-steps__go:hover { color: var(--flow); }
.aq-steps__go:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-steps__d { margin: 0; font: 400 14px/22px var(--font-sans); color: var(--ink-muted); overflow-wrap: break-word; text-wrap: pretty; }

/* The hold: one line under the step's text, "Hold" in flow (a word) and who signs in ink-muted */
.aq-steps .aq-steps__hold { margin: var(--space-2) 0 0; }
.aq-steps__stamp { display: inline-flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-2); max-width: 100%; font: 400 14px/20px var(--font-sans); color: var(--ink-muted); }
.aq-steps__stamp-k { flex: none; font-weight: 500; color: var(--flow); }
.aq-steps__who { min-width: 0; text-wrap: balance; }

/* Run: the pipe from a station to the next, in the gap between them, with a small arrowhead into the next station */
.aq-steps__run { position: absolute; left: 100%; top: calc(var(--space-3) + 24px - 0.75px); width: var(--space-12); height: 1.5px; background: var(--line-strong); }
.aq-steps__run::after { content: ""; position: absolute; right: 0; top: 50%; transform: translateY(-50%); border-left: 6px solid var(--line-strong); border-block: 4px solid transparent; }
.aq-steps__valve { position: absolute; left: 50%; top: 50%; width: var(--space-6); height: var(--space-6); transform: translate(-60%, -50%); overflow: visible; }
.aq-steps__valve path:first-child { fill: var(--flow); stroke: var(--flow); stroke-width: 1.5; stroke-linejoin: round; }
.aq-steps__valve path + path { fill: none; stroke: var(--flow); stroke-width: 1.5; }
.aq-steps__st.is-eol > .aq-steps__run { display: none; }
/* The pipe leaves just after the station number, so it reads as one run between stations */
.aq-steps__st > .aq-steps__run { left: var(--space-24); width: calc(100% - var(--space-24) + var(--space-12)); }
.aq-steps__st.is-eol > .aq-steps__turn:not(.aq-steps__turn--in) { left: var(--space-24); width: calc(100% - var(--space-24) + var(--space-8) / 2 + 0.75px); }
/* Return: out of the row's last station into the right gutter, down, back along under the row, down the left gutter
   and into the next row's first station, in the same 1.5 px line with rounded elbows. */
.aq-steps__turn { position: absolute; left: 100%; top: calc(var(--space-3) + 24px - 0.75px); bottom: 0; width: calc(var(--space-8) / 2 + 0.75px); box-sizing: border-box; border-top: 1.5px solid var(--line-strong); border-right: 1.5px solid var(--line-strong); border-top-right-radius: var(--space-4); }
.aq-steps__turn--in { left: auto; right: 100%; top: 0; bottom: auto; height: calc(var(--space-3) + 24px + 0.75px); border: 0; border-left: 1.5px solid var(--line-strong); border-bottom: 1.5px solid var(--line-strong); border-radius: 0 0 0 var(--space-4); }
.aq-steps__turn--in::after { content: ""; position: absolute; right: -2px; bottom: calc(-0.75px - 4px); border-left: 6px solid var(--line-strong); border-block: 4px solid transparent; }
.aq-steps__ret { position: relative; grid-column: 1 / -1; height: var(--space-12); }
.aq-steps__ret::before { content: ""; position: absolute; top: 0; height: calc(50% + 0.75px); left: calc(var(--space-4) - var(--space-8) / 2); right: calc(var(--space-8) / -2 - 0.75px); box-sizing: border-box; border-right: 1.5px solid var(--line-strong); border-bottom: 1.5px solid var(--line-strong); border-bottom-right-radius: var(--space-4); }
.aq-steps__ret::after { content: ""; position: absolute; top: calc(50% - 0.75px); bottom: 0; left: calc(var(--space-8) / -2 - 0.75px); width: var(--space-6); box-sizing: border-box; border-left: 1.5px solid var(--line-strong); border-top: 1.5px solid var(--line-strong); border-top-left-radius: var(--space-4); }
.aq-steps__ret-arrow { display: none; }
.aq-steps__ret > .aq-steps__valve { left: 25%; }

/* Motion (ProcessSteps/motion.js): the drop of water that runs each pipe as it is laid; made and removed by the motion layer */
.aq-steps--hold { position: relative; }
.aq-steps__drop { position: absolute; left: 0; top: 0; z-index: 2; width: var(--space-2); height: var(--space-2); margin: calc(var(--space-2) / -2) 0 0 calc(var(--space-2) / -2); border-radius: var(--radius-pill); background: var(--flow); pointer-events: none; }

/* ---------- Row (as: "row"): a short sequence read across, as the site first drew it ----------
   A line-strong rule on top, then one column per step: flow number (eyebrow mono), name (h3), one sentence (small). */
.aq-steps-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
.aq-steps-row > li { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; padding: var(--space-6) var(--space-6) 0 0; }
.aq-steps-row__n { font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; color: var(--flow); font-variant-numeric: tabular-nums; }
.aq-steps-row__t { margin: 0; font: 500 20px/28px var(--font-sans); letter-spacing: -0.005em; color: var(--ink); }
.aq-steps-row__d { margin: 0; font: 400 14px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

@container (max-width: 860px) {
  /* Phone: one vertical 1.5 px pipe down the number column, stations along it, no frames */
  .aq-steps--hold { grid-template-columns: minmax(0, 1fr); padding: 0; }
  .aq-steps__st { display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr); align-items: start; column-gap: var(--space-3); padding: 0 0 var(--space-6); }
  .aq-steps__n { justify-self: center; position: relative; z-index: 1; padding-block: var(--space-1); background: var(--surface); font-size: 24px; line-height: 32px; }
  .aq-plate .aq-steps__n { background: var(--surface-raised); }
  .aq-steps__body { padding-top: var(--space-2); }
  .aq-steps__go { padding-block: calc(var(--space-2) + var(--space-1) / 2); }
  .aq-steps__run, .aq-steps__st.is-eol > .aq-steps__run, .aq-steps__st > .aq-steps__run { display: block; left: calc(var(--space-12) / 2 - 0.75px); top: var(--space-8); bottom: 0; width: 1.5px; height: auto; }
  .aq-steps__run::after { top: auto; right: auto; bottom: 0; left: 50%; transform: translateX(-50%); border-top: 6px solid var(--line-strong); border-left: 4px solid transparent; border-right: 4px solid transparent; border-bottom: 0; }
  .aq-steps__valve { transform: translate(-50%, -50%) rotate(90deg); }
  .aq-steps__turn, .aq-steps__ret { display: none; }
}

/* ---------- ProjectRun: ordered steps told as one run you scroll along ---------- */
/* Two states. Static (default: no script, reduced motion, phones): the steps stack down a vertical twin-wall pipe,
   a numbered node per step, the step's drawing beside its text. Live (motion adds is-live on wide screens): the
   steps scroll on the left at large size while a sticky stage on the right shows the current step's drawing, its
   number set huge, and a horizontal run whose water fills stop by stop. Drawings are Illustration masks in ink. */
.aq-project-run { --pipe: var(--space-3); --node: var(--space-12); position: relative; }
.aq-project-run__stage { display: none; }

/* Static: vertical run */
/* each step but the last carries the run down to the next node: twin wall, water (--w, 0 to 1, set by motion; full without it) */
.aq-project-run__step { --w: 1; position: relative; }
.aq-project-run__step:not(:last-child)::before, .aq-project-run__step:not(:last-child)::after { content: ""; position: absolute; top: calc(var(--node, var(--space-12)) / 2); height: calc(100% + var(--space-12)); }
.aq-project-run__step:not(:last-child)::before { left: calc(var(--node, var(--space-12)) / 2 - var(--pipe, var(--space-3)) / 2); width: var(--pipe, var(--space-3)); border-inline: 1px solid var(--line-strong); box-sizing: border-box; }
.aq-project-run__step:not(:last-child)::after { left: calc(var(--node, var(--space-12)) / 2 - 1px); width: 2px; background: var(--flow); transform: scaleY(var(--w, 1)); transform-origin: 50% 0; }
.aq-project-run__steps { list-style: none; margin: 0; padding: 0; position: relative; display: flex; flex-direction: column; gap: var(--space-12); }
.aq-project-run__step { display: grid; grid-template-columns: var(--node, var(--space-12)) minmax(0, 240px) minmax(0, 1fr); column-gap: var(--space-8); align-items: start; }
.aq-project-run__node { width: var(--node, var(--space-12)); height: var(--node, var(--space-12)); display: grid; place-items: center; border-radius: var(--radius-pill); box-sizing: border-box;
  border: 2px solid var(--flow); background: var(--surface); font: 500 13px/16px var(--font-mono); color: var(--ink); font-variant-numeric: tabular-nums; position: relative; z-index: 1; }
.aq-project-run__pic { aspect-ratio: 4 / 3; -webkit-mask-size: contain; mask-size: contain; }
.aq-project-run__text { display: flex; flex-direction: column; gap: var(--space-3); padding-top: var(--space-2); }
.aq-project-run__code { margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; color: var(--ink-subtle); }
.aq-project-run__t { margin: 0; font: 400 32px/38px var(--font-sans); letter-spacing: -0.02em; }
.aq-project-run__t a { color: var(--ink); text-decoration: none; }
.aq-project-run__t a::after { content: "\00a0\2192"; display: inline-block; color: var(--flow); transition: transform 200ms; }
.aq-project-run__t a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.16em; text-decoration-color: var(--flow); }
.aq-project-run__t a:hover::after { transform: translateX(var(--space-1)); }
.aq-project-run__t a:focus-visible { outline: 2px solid var(--focus); outline-offset: var(--space-1); }
.aq-project-run__d { margin: 0; font: 400 18px/28px var(--font-sans); color: var(--ink-muted); max-width: 46ch; }

/* Live: sticky stage on the right, steps scroll on the left */
.aq-project-run.is-live { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--space-16); }
.is-live .aq-project-run__node, .is-live .aq-project-run__pic, .is-live .aq-project-run__step::before, .is-live .aq-project-run__step::after { display: none; }
.is-live .aq-project-run__steps { grid-column: 1; grid-row: 1; gap: 0; padding-block: 8vh 24vh; }
.is-live .aq-project-run__step { display: flex; align-items: center; min-height: 64vh; }
.is-live .aq-project-run__text { opacity: 0.28; transition: opacity 500ms cubic-bezier(0.2, 0, 0, 1); }
.is-live .aq-project-run__step.is-on .aq-project-run__text { opacity: 1; }
.is-live .aq-project-run__t { font: 300 48px/52px var(--font-sans); letter-spacing: -0.025em; }
.is-live .aq-project-run__d { font-size: 20px; line-height: 30px; }
.is-live .aq-project-run__code { font-size: 13px; }

.is-live .aq-project-run__stage { display: flex; flex-direction: column; grid-column: 2; grid-row: 1; position: sticky; top: 12vh; height: 76vh; align-self: start;
  border: 1px solid var(--line); background: var(--surface-raised); padding: var(--space-8); box-sizing: border-box; }
.aq-project-run__num { position: absolute; left: var(--space-8); top: var(--space-6); margin: 0; display: flex; align-items: baseline; gap: var(--space-3); z-index: 1; }
.aq-project-run__cur { font: 300 140px/1 var(--font-sans); letter-spacing: -0.05em; color: var(--ink); font-variant-numeric: tabular-nums; }
.aq-project-run__of { font: 500 14px/16px var(--font-mono); letter-spacing: 0.08em; color: var(--ink-subtle); }
.aq-project-run__arts { position: relative; flex: 1; min-height: 0; margin: var(--space-16) 0 var(--space-6) var(--space-16); }
.aq-project-run__art { position: absolute; inset: 0; width: auto; aspect-ratio: auto; -webkit-mask-size: contain; mask-size: contain;
  clip-path: inset(0 0 100% 0); transition: clip-path 800ms cubic-bezier(0.65, 0, 0.35, 1); }
/* the current drawing prints up from the bottom while the last one lifts away */
.aq-project-run__art.is-on { clip-path: inset(0 0 0 0); }
.aq-project-run__art.is-on ~ .aq-project-run__art { clip-path: inset(100% 0 0 0); }

/* The run: a twin-wall pipe through one stop per step; the water fills to the current stop (--f, 0 to 1) */
.aq-project-run__run { --f: 0; position: relative; display: grid; grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr)); padding-top: var(--space-2); }
.aq-project-run__pipe { position: absolute; top: calc(var(--space-2) + var(--space-4) - var(--pipe, var(--space-3)) / 2); height: var(--pipe, var(--space-3)); left: calc(50% / var(--n, 5)); right: calc(50% / var(--n, 5));
  border-block: 1px solid var(--line-strong); box-sizing: border-box; }
.aq-project-run__water { position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; background: var(--flow); transform: scaleX(var(--f, 0)); transform-origin: 0 50%; }
.aq-project-run__drop { position: absolute; top: 50%; left: calc(var(--f, 0) * 100%); width: var(--space-3); height: var(--space-3); margin: calc(var(--space-3) / -2) 0 0 calc(var(--space-3) / -2);
  border-radius: var(--radius-pill); background: var(--flow); border: 2px solid var(--surface-raised); }
.aq-project-run__stop { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-3); }
.aq-project-run__dot { width: var(--space-8); height: var(--space-8); border-radius: var(--radius-pill); box-sizing: border-box; border: 2px solid var(--line-strong); background: var(--surface-raised);
  transition: border-color 300ms, background-color 300ms, transform 300ms cubic-bezier(0.2, 0, 0, 1); }
.aq-project-run__lab { font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-subtle); text-align: center; transition: color 300ms; }
.aq-project-run__stop.is-past .aq-project-run__dot { border-color: var(--flow); }
.aq-project-run__stop.is-on .aq-project-run__dot { border-color: var(--flow); background: var(--flow); transform: scale(1.15); }
.aq-project-run__stop.is-on .aq-project-run__lab, .aq-project-run__stop.is-past .aq-project-run__lab { color: var(--ink); }

@container (max-width: 1100px) {
  .aq-project-run.is-live { column-gap: var(--space-8); }
  .is-live .aq-project-run__t { font-size: 40px; line-height: 44px; }
  .aq-project-run__cur { font-size: 104px; }
  .aq-project-run__lab { font-size: 11px; letter-spacing: 0.02em; }
}

/* Phones: always static; the drawing sits over its text */
@container (max-width: 860px) {
  .aq-project-run { --node: var(--space-8); }
  .aq-project-run__step { grid-template-columns: var(--node, var(--space-12)) minmax(0, 1fr); column-gap: var(--space-4); }
  .aq-project-run__pic { grid-column: 2; grid-row: 1; max-width: 260px; width: 100%; }
  .aq-project-run__text { grid-column: 2; grid-row: 2; padding-top: var(--space-3); }
  .aq-project-run__node { grid-column: 1; grid-row: 1; font-size: 12px; }
  .aq-project-run__steps { gap: var(--space-12); }
  .aq-project-run__t { font-size: 26px; line-height: 32px; }
  .aq-project-run__d { font-size: 16px; line-height: 26px; }
}
/* Phones: a node the water has passed fills with the flow tint */
.aq-project-run__node.is-wet { background: var(--flow-tint); }
.aq-project-run__now { display: none; }

/* Phones with PhoneKit on (pass 12, S8): the stage comes back as a 132 px strip held under the header (a small copy of
   the desktop stage: drawing, number and stop name, the 6-stop run), and the steps run under it as short rows on the
   vertical run. Without script the static stack above stays. Scoped to [data-pk-on], so no desktop render changes. */
@container (max-width: 860px) {
  .aq-project-run[data-pk-on] { --node: 28px; --pipe: var(--space-2); }
  .aq-project-run[data-pk-on] .aq-project-run__stage {
    display: grid; grid-template-columns: 128px minmax(0, 1fr); grid-template-rows: 84px 28px; column-gap: var(--space-4); row-gap: var(--space-1);
    align-content: center; padding: var(--space-2) var(--space-3); margin-bottom: var(--space-6);
    border: 1px solid var(--line); border-bottom-color: var(--line-strong); background: var(--surface-raised);
  }
  .aq-project-run[data-pk-on] .aq-project-run__arts { grid-column: 1; grid-row: 1; margin: 0; }
  .aq-project-run[data-pk-on] .aq-project-run__num { position: static; grid-column: 2; grid-row: 1; align-self: center; display: grid;
    grid-template-columns: auto minmax(0, 1fr); align-items: baseline; column-gap: var(--space-2); row-gap: var(--space-1); }
  .aq-project-run[data-pk-on] .aq-project-run__cur { font-size: 40px; line-height: 40px; letter-spacing: -0.04em; }
  .aq-project-run[data-pk-on] .aq-project-run__of { font-size: 12px; }
  .aq-project-run[data-pk-on] .aq-project-run__now { display: block; grid-column: 1 / -1; font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .aq-project-run[data-pk-on] .aq-project-run__run { grid-column: 1 / -1; grid-row: 2; padding-top: var(--space-1); }
  .aq-project-run[data-pk-on] .aq-project-run__pipe { top: calc(var(--space-1) + var(--space-2) - var(--pipe, var(--space-2)) / 2); }
  .aq-project-run[data-pk-on] .aq-project-run__dot { width: var(--space-4); height: var(--space-4); }
  .aq-project-run[data-pk-on] .aq-project-run__lab { display: none; }
  .aq-project-run[data-pk-on] .aq-project-run__water { transition: transform 400ms cubic-bezier(0.2, 0, 0, 1); }
  .aq-project-run[data-pk-on] .aq-project-run__drop { transition: left 400ms cubic-bezier(0.2, 0, 0, 1); }

  /* the steps: short rows on the vertical run (the drawings live in the strip) */
  .aq-project-run[data-pk-on] .aq-project-run__pic, .aq-project-run[data-pk-on] .aq-project-run__code { display: none; }
  .aq-project-run[data-pk-on] .aq-project-run__steps { gap: calc(var(--space-4) + var(--space-1)); }
  .aq-project-run[data-pk-on] .aq-project-run__step { grid-template-columns: var(--node, 28px) minmax(0, 1fr); column-gap: var(--space-3); --w: 0; }
  .aq-project-run[data-pk-on] .aq-project-run__step.is-past { --w: 1; }
  .aq-project-run[data-pk-on] .aq-project-run__step:not(:last-child)::before, .aq-project-run[data-pk-on] .aq-project-run__step:not(:last-child)::after {
    top: calc(var(--node, 28px) / 2 - 1px); height: calc(100% + calc(var(--space-4) + var(--space-1))); }
  .aq-project-run[data-pk-on] .aq-project-run__step:not(:last-child)::after { transition: transform 400ms cubic-bezier(0.2, 0, 0, 1); }
  .aq-project-run[data-pk-on] .aq-project-run__node { grid-column: 1; grid-row: 1; margin-top: -1px; font-size: 12px; transition: background-color 240ms, color 240ms; }
  .aq-project-run[data-pk-on] .aq-project-run__step.is-on .aq-project-run__node { background: var(--flow); color: var(--surface); }
  .aq-project-run[data-pk-on] .aq-project-run__text { grid-column: 2; grid-row: 1; padding-top: 0; gap: var(--space-1); }
  .aq-project-run[data-pk-on] .aq-project-run__t { font: 400 20px/26px var(--font-sans); letter-spacing: -0.01em; }
  .aq-project-run[data-pk-on] .aq-project-run__t a { display: inline-flex; align-items: center; min-height: 44px; margin-block: -9px; } /* a 44 px target that takes no extra row height */
  .aq-project-run[data-pk-on] .aq-project-run__d { font-size: 15px; line-height: 22px; }
}
/* Tablets (600-860 px): the drawing runs the strip's full height on the left, number and run stacked beside it */
@container (min-width: 600px) and (max-width: 860px) {
  .aq-project-run[data-pk-on] .aq-project-run__stage { grid-template-columns: 200px minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) 28px; column-gap: var(--space-6); }
  .aq-project-run[data-pk-on] .aq-project-run__arts { grid-row: 1 / -1; }
  .aq-project-run[data-pk-on] .aq-project-run__run { grid-column: 2; }
}
@media (prefers-reduced-motion: reduce) {
  .aq-project-run[data-pk-on] .aq-project-run__art, .aq-project-run[data-pk-on] .aq-project-run__water, .aq-project-run[data-pk-on] .aq-project-run__drop,
  .aq-project-run[data-pk-on] .aq-project-run__dot, .aq-project-run[data-pk-on] .aq-project-run__node,
  .aq-project-run[data-pk-on] .aq-project-run__step::after { transition: none; }
}

/* ---------- ProofFolders: an evidence table as a drawer of manila folders (look "proof-folders"). Each row is the
   standard set on the ground plus its folder (limestone, data-theme="light" so the paper keeps light-theme contrast in
   the dark theme): a tab with the code, a typed slip, clipped proof sheets struck with a stamp, a navy index label.
   Folders overlap upward so each tab sits over the folder before it; the tab steps right row by row. ---------- */
.aq-proof-folders { position: relative; }
.aq-proof-folders__cols, .aq-proof-folders__row { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 3.1fr); column-gap: var(--space-6); }
.aq-proof-folders__cols { padding-bottom: var(--space-6); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-proof-folders__cols { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr) minmax(0, 1.1fr) minmax(0, 0.75fr); }
.aq-proof-folders__cols span:nth-child(n+2) { padding-left: var(--space-6); }
.aq-proof-folders__list { list-style: none; margin: 0; padding: var(--space-8) 0 0; }
.aq-proof-folders__row { position: relative; align-items: start; }
.aq-proof-folders__row + .aq-proof-folders__row { margin-top: calc(-1 * var(--space-3)); }

/* The standard, on the ground */
/* the index is the row's own first child (so a standards-map chip matches the standard's cell alone) */
.aq-proof-folders__row > .aq-index { position: absolute; left: 0; top: var(--space-6); }
.aq-proof-folders__std { display: flex; flex-direction: column; gap: var(--space-2); padding-top: var(--space-12); }
.aq-proof-folders__name { margin: 0; display: flex; flex-direction: column; gap: var(--space-1); }
.aq-proof-folders__code { font: 300 30px/36px var(--font-sans); letter-spacing: -0.02em; color: var(--ink); }
.aq-proof-folders__title { font: 400 15px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

/* The folder */
.aq-proof-folders__folder {
  position: relative; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1.1fr) minmax(0, 0.75fr); align-items: start;
  min-height: var(--space-32); padding: var(--space-6) 0 var(--space-8);
  background: var(--limestone); color: var(--on-limestone);
  border-top: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent);
  box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--on-limestone) 10%, transparent);
}
.aq-proof-folders__folder > div { padding: 0 var(--space-6); min-width: 0; }
.aq-proof-folders__tab {
  position: absolute; bottom: 100%; left: calc(var(--space-6) + var(--i, 0) * 13%); height: var(--space-8); padding: 0 var(--space-6) 0 var(--space-4);
  display: flex; align-items: center; background: var(--limestone); color: var(--on-limestone);
  border: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent); border-bottom: 0;
  clip-path: polygon(0 0, calc(100% - var(--space-3)) 0, 100% 100%, 0 100%);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; white-space: nowrap;
}
/* every second folder a shade deeper, so the files read apart */
.aq-proof-folders__row:nth-child(even) .aq-proof-folders__folder, .aq-proof-folders__row:nth-child(even) .aq-proof-folders__tab { background: color-mix(in srgb, var(--limestone) 93%, var(--on-limestone)); }
/* the slip: typed, set slightly off square */
.aq-proof-folders__slip {
  margin: 0; padding: var(--space-4) var(--space-4) var(--space-6); background: var(--surface-raised); color: var(--ink);
  border: 1px solid var(--line); font: 400 15px/23px var(--font-mono); letter-spacing: -0.01em; transform: rotate(-0.6deg); text-wrap: pretty;
}
.aq-proof-folders__row:nth-child(even) .aq-proof-folders__slip { transform: rotate(0.5deg); }
/* the proof: sheets fanned under a clip */
.aq-proof-folders__proof { position: relative; padding-top: var(--space-2) !important; padding-bottom: var(--space-8) !important; }
.aq-proof-folders__sheets { list-style: none; margin: 0; padding: 0; display: grid; }
.aq-proof-folders__sheet {
  grid-area: auto; position: relative; margin-top: calc(-1 * var(--space-1)); padding: var(--space-3) var(--space-4);
  background: var(--surface-raised); color: var(--ink); border: 1px solid var(--line);
  font: 400 14px/20px var(--font-sans); transform: rotate(calc(1.2deg - var(--j, 0) * 1.6deg)) translateX(calc(var(--j, 0) * var(--space-2)));
}
.aq-proof-folders__sheet:first-child { margin-top: 0; }
.aq-proof-folders__clip {
  position: absolute; z-index: 1; top: calc(-1 * var(--space-2)); left: calc(var(--space-6) + var(--space-8)); width: var(--space-3); height: var(--space-8);
  border: 1.5px solid var(--line-strong); border-radius: var(--radius-pill);
}
.aq-proof-folders__clip::after { content: ""; position: absolute; inset: var(--space-1) calc(var(--space-1) / 2) var(--space-2); border: 1.5px solid var(--line-strong); border-radius: var(--radius-pill); }
/* the stamp, struck over the sheets */
.aq-proof-folders__stamp {
  position: absolute; right: var(--space-2); bottom: 0; z-index: 2; display: flex; flex-direction: column; align-items: center;
  padding: var(--space-1) var(--space-3); border: 3px double var(--flow); color: var(--flow);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; transform: rotate(-7deg); opacity: 0.88; pointer-events: none;
  mix-blend-mode: multiply;
}
.aq-proof-folders__stamp span + span { font-size: 12px; line-height: 14px; letter-spacing: 0.16em; }
.aq-proof-folders__row:nth-child(even) .aq-proof-folders__stamp { transform: rotate(5deg); right: auto; left: 45%; }
/* the index label: navy, the row's link */
.aq-proof-folders__label { margin: 0; padding: var(--space-3) var(--space-4); background: var(--navy); color: var(--on-navy); font: 400 15px/22px var(--font-sans); }
.aq-proof-folders__label a { color: inherit; text-decoration: none; display: block; }
.aq-proof-folders__label a::after { content: "\a0\2192"; }
.aq-proof-folders__label a:hover { text-decoration: underline; text-underline-offset: 3px; }
.aq-proof-folders__label:has(a) { position: relative; min-height: var(--space-12); box-sizing: border-box; }
.aq-proof-folders__label a::before { content: ""; position: absolute; inset: 0; }
.aq-proof-folders__label:has(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-proof-folders__label a:focus-visible { outline: none; }
/* cell names: read by screen readers on desktop (the column heads are drawn), shown on phones */
.aq-proof-folders__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; margin: 0; }
.aq-proof-folders .aq-fold__btn { margin-top: var(--space-8); }
.aq-proof-folders__row.aq-standards-map-hit .aq-proof-folders__folder { outline: 2px solid var(--flow); outline-offset: 2px; }

.aq-proof-folders-sec .aq-sec-head { margin-bottom: var(--space-2); }
.aq-proof-folders__how, .aq-proof-folders__go { position: relative; z-index: 1; }

/* motion slides parts in from the side; never let them widen the page */
.aq-section.aq-proof-folders-sec { overflow-x: clip; }

/* the code strip over the phone row (hidden wider) */
.aq-proof-folders__tabs { display: none; }

/* Phones (pass 12, S11): a snap row of folders at 85 % (the next one peeking), all standards in the row; a strip of
   the codes (44 px tabs) over it jumps and follows (look JS, AQsnap). Half the padding; sheets inside the gutter. */
@container (max-width: 860px) {
  .aq-proof-folders__cols { display: none; }
  .aq-proof-folders__tabs { display: flex; gap: var(--space-1); margin: 0 0 var(--space-2); overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain; }
  .aq-proof-folders__tabs::-webkit-scrollbar { display: none; }
  /* round C: while the strip can still scroll on, its right edge fades over 24 px (the look sets is-more) */
  .aq-proof-folders__tabs.is-more { -webkit-mask-image: linear-gradient(90deg, var(--ink) calc(100% - var(--space-6)), transparent); mask-image: linear-gradient(90deg, var(--ink) calc(100% - var(--space-6)), transparent); }
  .aq-proof-folders__tb { flex: none; min-height: 44px; padding: 0 var(--space-3); border: 1px solid var(--line-strong); border-radius: 0; background: var(--surface-raised); color: var(--ink);
    font: 500 13px/16px var(--font-mono); letter-spacing: 0.04em; white-space: nowrap; cursor: pointer; }
  .aq-proof-folders__tb[aria-current="true"] { background: var(--limestone); color: var(--on-limestone); border-color: var(--flow); box-shadow: inset 0 -3px 0 var(--flow); }
  .aq-proof-folders__tb:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .aq-proof-folders__list { display: flex; gap: var(--space-3); padding-top: 0; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .aq-proof-folders__list::-webkit-scrollbar { display: none; }
  .aq-fold:not(.is-open) .aq-proof-folders__row.aq-fold-x, .aq-proof-folders__row { display: flex; }
  .aq-proof-folders__row { flex: 0 0 min(85%, 360px); flex-direction: column; scroll-snap-align: start; }
  .aq-proof-folders .aq-fold__btn { display: none; }
  .aq-proof-folders__row + .aq-proof-folders__row { margin-top: 0; }
  .aq-proof-folders__row > .aq-index { top: var(--space-1); }
  .aq-proof-folders__std { padding: 0 0 var(--space-8) var(--space-8); flex-direction: column; gap: 0; }
  .aq-proof-folders__code { font-size: 24px; line-height: 30px; }
  .aq-proof-folders__title { font-size: 14px; line-height: 20px; }
  .aq-proof-folders__folder { flex: 1; grid-template-columns: minmax(0, 1fr); align-content: start; row-gap: var(--space-4); padding: var(--space-3) 0 var(--space-4); min-height: 0; }
  .aq-proof-folders__folder > div { padding: 0 var(--space-3); }
  .aq-proof-folders__tab { left: calc(var(--space-3) + min(var(--i, 0), 4) * 9%); }
  .aq-proof-folders__k { position: static; width: auto; height: auto; overflow: visible; clip-path: none; margin: 0 0 var(--space-1); font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
  .aq-proof-folders__slip { padding: var(--space-3) var(--space-3) var(--space-4); font-size: 14px; line-height: 21px; }
  .aq-proof-folders__sheets { padding-right: var(--space-3); }
  .aq-proof-folders__sheet { padding: var(--space-2) var(--space-3); transform: rotate(calc(1deg - var(--j, 0) * 1.2deg)) translateX(calc(min(var(--j, 0), 3) * var(--space-1))); }
  .aq-proof-folders__proof { padding-bottom: var(--space-6) !important; }
  .aq-proof-folders__clip { left: auto; right: var(--space-6); }
  .aq-proof-folders__stamp, .aq-proof-folders__row:nth-child(even) .aq-proof-folders__stamp { bottom: 0; right: var(--space-4); left: auto; }
  .aq-proof-folders__label { padding: var(--space-2) var(--space-3); }
  .aq-proof-folders__label:has(a) { min-height: 48px; display: flex; align-items: center; }
}

/* ---------- Prose ---------- */
/* Plain: a few paragraphs within text-max (also used for captions). */
.aq-prose { max-width: var(--text-max); }
.aq-prose p + p { margin-top: var(--space-4); }

/* Sheet (the site's prose block): the first sentence as a large light lead in ink, then the paragraphs in body size in
   ink-muted. White space does the work: no grid, frame, rule, tags or leaders.
   ".aq-prose.aq-prose--sheet" selectors match SplitSection's ".aq-split-section__body .aq-prose p:first-child"
   specificity and win by coming later in bundle.css, so the lead and body keep their own type inside a split. */
.aq-prose--sheet { display: flex; flex-direction: column; gap: var(--space-4); }
.aq-prose.aq-prose--sheet > p { margin: 0; font: 400 16px/26px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; overflow-wrap: break-word; }
.aq-prose.aq-prose--sheet > p.aq-prose__lead {
  margin-bottom: var(--space-2); font: 300 28px/36px var(--font-sans); letter-spacing: -0.01em; color: var(--ink);
  text-wrap: balance;
}

@container (max-width: 860px) {
  .aq-prose.aq-prose--sheet > p.aq-prose__lead { font-size: 22px; line-height: 30px; }
}

/* ---------- ReaderSplit: readers on the navy half, what they read on the limestone half, row against row across a seam ---------- */
.aq-reader-split-sec { --gap: var(--space-16); position: relative; overflow: hidden; background: var(--limestone); color: var(--on-limestone); }
.aq-reader-split__ground { position: absolute; left: 0; top: 0; bottom: 0; width: 50%; background: var(--navy); transform-origin: 0 50%; }
.aq-reader-split-sec > .aq-in { position: relative; }
.aq-reader-split { --gap: var(--space-16); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--gap, 64px); }
.aq-reader-split__head { grid-column: 1; color: var(--on-navy); padding-right: var(--space-8); }
.aq-reader-split__head .aq-h1 { color: var(--on-navy); }
.aq-reader-split__head .aq-lead { color: var(--on-navy-muted); }
.aq-reader-split__colh { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--gap, 64px); margin: 0 0 var(--space-3); padding-top: var(--space-12);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
.aq-reader-split__colh span:first-child { color: var(--on-navy-muted); }
.aq-reader-split__colh span + span { color: var(--on-limestone-muted); }
.aq-reader-split > .aq-fold, .aq-reader-split > .aq-reader-split__rows { grid-column: 1 / -1; }
.aq-reader-split-sec .aq-fold__btn { color: var(--on-limestone); border-bottom-color: color-mix(in srgb, var(--on-limestone) 25%, transparent); padding-left: calc(50% + var(--gap, 64px) / 2); }

.aq-reader-split__rows { position: relative; list-style: none; margin: 0; padding: 0; }
.aq-reader-split__rows::before { content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 1.5px; margin-left: -0.75px; background: var(--limestone); }
.aq-reader-split__row { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--gap, 64px); }
.aq-reader-split__who { display: flex; gap: var(--space-4); align-items: baseline; padding: var(--space-6) var(--space-8) var(--space-6) 0;
  border-top: 1px solid color-mix(in srgb, var(--on-navy-muted) 35%, transparent); color: var(--on-navy); }
.aq-reader-split__who .aq-index { color: var(--on-navy-muted); }
.aq-reader-split__t { margin: 0; font: 300 28px/34px var(--font-sans); letter-spacing: -0.02em; }
.aq-reader-split__what { display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-6) 0; border-top: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent); }
.aq-reader-split__read { margin: 0; font: 400 17px/27px var(--font-mono); letter-spacing: -0.01em; color: var(--on-limestone); }
/* Per-row column labels: read by assistive tech on every width, shown on phones (the column heads are aria-hidden) */
.aq-reader-split__lab { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.aq-reader-split__k { display: block; font: 500 11px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-limestone-muted); }
.aq-reader-split__go { align-self: flex-start; display: flex; flex-direction: column; gap: var(--space-1); min-height: 44px; margin: 0; color: var(--on-limestone); text-decoration: none; font: 400 16px/22px var(--font-sans); }
a.aq-reader-split__go span + span::after { content: " →"; color: var(--flow); }
a.aq-reader-split__go:hover span + span { text-decoration: underline; text-decoration-color: var(--flow); text-underline-offset: 4px; }
a.aq-reader-split__go:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* The tie: a node on the seam at the row's first line, and a short tie across it that draws on hover */
.aq-reader-split__tie { position: absolute; left: calc(50% - var(--gap, 64px) / 2); width: var(--gap, 64px); top: calc(var(--space-6) + var(--space-4)); height: 1.5px; pointer-events: none; }
.aq-reader-split__tie::before { content: ""; position: absolute; inset: 0; background: var(--limestone); transform: scaleX(0.3); transition: transform 400ms cubic-bezier(0.2, 0, 0, 1); }
.aq-reader-split__node { position: absolute; left: 50%; top: 50%; width: var(--space-3); height: var(--space-3); margin: calc(var(--space-3) * -0.5) 0 0 calc(var(--space-3) * -0.5);
  background: var(--navy); border: 1.5px solid var(--limestone); transition: background-color 300ms; }
.aq-reader-split__row:hover .aq-reader-split__tie::before, .aq-reader-split__row:focus-within .aq-reader-split__tie::before { transform: scaleX(1); }
.aq-reader-split__row:hover .aq-reader-split__node, .aq-reader-split__row:focus-within .aq-reader-split__node { background: var(--limestone); }

@container (max-width: 1100px) {
  .aq-reader-split, .aq-reader-split-sec { --gap: var(--space-12); }
  .aq-reader-split__t { font-size: 24px; line-height: 30px; }
}

/* Tight readers (pass 12 C, buying#compare): when every reader is a short name (the renderer sets is-tight, 30
   characters or fewer), the navy half takes 4 of 12 columns, not half, and each name sits on the first line of its
   reading (same 27 px line). Seam, ground, tie, column heads and fold button follow the 4fr 8fr split. Desktop only. */
@container (min-width: 861px) {
  .aq-reader-split-sec.is-tight .aq-reader-split__ground { width: calc(50% - (min(100%, var(--content-max)) - 2 * var(--space-8) - var(--gap, 64px)) / 6); }
  .aq-reader-split-sec.is-tight .aq-reader-split, .aq-reader-split-sec.is-tight .aq-reader-split__colh,
  .aq-reader-split-sec.is-tight .aq-reader-split__row { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
  .aq-reader-split-sec.is-tight .aq-reader-split__rows::before { left: calc((100% - var(--gap, 64px)) / 3 + var(--gap, 64px) / 2); }
  .aq-reader-split-sec.is-tight .aq-reader-split__tie { left: calc((100% - var(--gap, 64px)) / 3); }
  .aq-reader-split-sec.is-tight .aq-fold__btn { padding-left: calc((100% - var(--gap, 64px)) / 3 + var(--gap, 64px)); }
  .aq-reader-split-sec.is-tight .aq-reader-split__t { font-size: 24px; line-height: 27px; }
}

/* Phone-only parts: the third column's key and the accordion head (PhoneKit) stay out of the desktop render */
.aq-reader-split__colk, .aq-reader-split__ph { display: none; }

/* Phones (pass 12, S11/S12): one column on limestone. The three column names show once as a key above the rows; each
   reader is a 48 px navy head (index, reader, chevron) stacked on a hairline, so the navy line of readers stays in view,
   and the reading opens under its head on tap (PhoneKit accordion, one open). Rows grow with their text (no locked
   height); reading 15 px, answer 15 px with a 44 px link. Without script every row shows open, led by its navy bar. */
@container (max-width: 860px) {
  .aq-reader-split__ground { display: none; }
  .aq-reader-split__head, .aq-reader-split__head .aq-h1 { color: var(--on-limestone); }
  .aq-reader-split__head .aq-lead { color: var(--on-limestone-muted); }
  .aq-reader-split { grid-template-columns: minmax(0, 1fr); }
  .aq-reader-split__head { padding: 0 0 var(--space-6); }
  /* the key: navy swatch = the reader, a rule = the reading, the flow tick = the answer */
  .aq-reader-split__colh { display: flex; flex-direction: column; gap: var(--space-1); margin: 0 0 var(--space-3); padding: 0;
    font: 500 12px/18px var(--font-mono); color: var(--on-limestone-muted); }
  .aq-reader-split__colh span { display: flex; align-items: center; gap: var(--space-2); color: var(--on-limestone-muted) !important; }
  .aq-reader-split__colh span::before { content: ""; flex: none; width: 14px; height: 10px; box-sizing: border-box; }
  .aq-reader-split__colh span:first-child::before { background: var(--navy); }
  .aq-reader-split__colh span:nth-child(2)::before { border: 1px solid color-mix(in srgb, var(--on-limestone) 40%, transparent); }
  .aq-reader-split__colh .aq-reader-split__colk { display: flex; }
  .aq-reader-split__colh .aq-reader-split__colk::before { width: 3px; margin: 0 5px; background: var(--flow); }
  .aq-reader-split__rows::before { display: none; }
  .aq-reader-split__row { grid-template-columns: minmax(0, 1fr); margin: 0 0 1px; }
  .aq-reader-split__who { flex-wrap: wrap; row-gap: var(--space-1); padding: var(--space-3) var(--space-4); background: var(--navy); border-top: 0; }
  .aq-reader-split__t { font-size: 19px; line-height: 25px; }
  .aq-reader-split__what { height: auto; gap: var(--space-3); padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--on-limestone) 22%, transparent); border-top: 0; margin-bottom: var(--space-2); }
  .aq-reader-split__read { font-size: 15px; line-height: 23px; }
  .aq-reader-split__k { display: none; }
  .aq-reader-split__go { min-height: 44px; justify-content: center; padding-left: var(--space-3); border-left: 3px solid var(--flow); font-size: 15px; line-height: 21px; }
  .aq-reader-split__tie { display: none; }
  .aq-reader-split-sec .aq-fold__btn { padding-left: 0; }
  /* the accordion head (PhoneKit switches it on): a navy bar, index, reader, chevron */
  .aq-reader-split__ph { margin: 0; }
  [data-pk-on] .aq-reader-split__ph { display: block; }
  .aq-reader-split__rows[data-pk-on] .aq-reader-split__head-btn { gap: var(--space-3); align-items: center; min-height: 52px; padding: var(--space-2) 0 var(--space-2) var(--space-4);
    background: var(--navy); color: var(--on-navy); font: 400 17px/23px var(--font-sans); letter-spacing: -0.01em; }
  .aq-reader-split__head-btn .aq-index { flex: none; color: var(--on-navy-muted); }
  .aq-reader-split__head-btn .aq-phone-kit__chev { color: var(--on-navy-muted); }
  .aq-reader-split__head-btn[aria-expanded="true"] .aq-phone-kit__chev { color: var(--on-navy); }
  .aq-reader-split__rows[data-pk-on] .aq-reader-split__what { border-top: 0; }
}
.aq-reader-split__pt { min-width: 0; text-wrap: balance; }/* pass 12 (F9): no lone word after a hard hyphen ("hand- / off") */
.aq-reader-split__nb { white-space: nowrap; }

/* The split band (also defined in BatteryLimit, retired 2026-11-05): the section is the positioned host of its ground. */
.aq-band--split { position: relative; }

/* ---------- Readout: the page's one highlighted figure ---------- */
/* The brand's "proof in numbers": one measurement set large in Geist Mono Light in flow, its unit beside it,
   the method on a limit tag (the StandardTag look), and a one-sentence caption. No frame: white space carries it.
   A limit (--limit) adds a 1 px flow rule under the reading. */
.aq-readout {
  display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  column-gap: var(--space-12); row-gap: var(--space-6); align-items: end;
}

/* Head: reading on the left, the method tag on the right; font-size here sets the figure */
.aq-readout__head { display: contents; }

.aq-readout__reading {
  grid-column: 1; grid-row: 1 / span 2; align-self: end;
  margin: 0; min-width: 0; padding-bottom: var(--space-4);
  display: flex; flex-wrap: wrap; align-items: baseline;
  font: 300 clamp(64px, 10cqi, 128px)/1 var(--font-mono); letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
  color: var(--flow);
}
.aq-readout--limit .aq-readout__reading { border-bottom: 1px solid var(--flow); }
.aq-readout__figure { min-width: 0; overflow-wrap: anywhere; }
.aq-readout__figure .aq-ph { letter-spacing: -0.02em; }
/* Comparator (<, ≤): smaller, in ink-muted */
.aq-readout__cmp { font-size: 0.45em; letter-spacing: 0; color: var(--ink-muted); }
/* Unit: on the baseline beside the figure */
.aq-readout__unit { margin-left: var(--space-2); font: 400 28px/34px var(--font-mono); letter-spacing: 0; color: var(--ink); }
/* Condition ("@ 25 °C"): small, on its own line under the figure; -1ch cancels the leading no-break space */
.aq-readout__cond {
  flex-basis: 100%; margin: var(--space-3) 0 0 -1ch;
  font: 400 14px/22px var(--font-mono); letter-spacing: 0; color: var(--ink-muted);
}

/* Method: the limit tag, as StandardTag draws it */
.aq-readout__ref { grid-column: 2; grid-row: 1; display: flex; min-width: 0; }
.aq-readout__tag {
  display: inline-flex; align-items: center; min-height: 28px; max-width: 100%; padding: var(--space-1) var(--space-3);
  border: 1px solid var(--line-strong); border-radius: var(--radius-pill);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em; color: var(--ink);
  overflow-wrap: anywhere;
}

.aq-readout__caption { grid-column: 2; grid-row: 2; margin: 0; min-width: 0; }

@container (max-width: 860px) {
  .aq-readout { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-4); }
  .aq-readout__reading { grid-column: 1; grid-row: auto; font-size: clamp(48px, 16cqi, 88px); }
  /* Unit drops under the figure */
  .aq-readout__unit { flex-basis: 100%; margin: var(--space-2) 0 0 -1ch; font-size: 24px; line-height: 30px; }
  .aq-readout__ref, .aq-readout__caption { grid-column: 1; grid-row: auto; }
}

/* ---------- RecordTrail: the quality system as one record trail (look "record-trail", pass 12 concept 240). Stations on
   a single 1.5 px rail, each dropping its record sheet on a cord; the rail turns down the right lane and back along the
   gutter between rows, and ends in a stack of sheets. Ink and line-strong for the line work, flow only for the pointed
   or arriving station and the glyph accents. ---------- */
.aq-record-trail-sec { position: relative; }
.aq-record-trail { --rt-gap: var(--space-8); --rt-row: var(--space-16); --rt-lane: var(--space-8); --rt-r: 12px; --rt-line: var(--line-strong); position: relative; }

/* key: what node, text and sheet stand for (the block's column names) */
.aq-record-trail .aq-record-trail__key { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-8); margin: 0 0 var(--space-8); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-record-trail__key span { display: inline-flex; align-items: center; gap: var(--space-2); }
.aq-record-trail__key i { display: block; flex: none; }
.aq-record-trail__kn i { width: 12px; height: 12px; border: 1.5px solid var(--ink); border-radius: 50%; background: var(--surface); }
.aq-record-trail__kc i { width: 16px; height: 9px; background: repeating-linear-gradient(to bottom, var(--ink-subtle) 0 1px, transparent 1px 4px); }
.aq-record-trail__ks i { width: 12px; height: 15px; border: 1px solid var(--rt-line, var(--line-strong)); background: linear-gradient(225deg, var(--surface-sunken) 3px, var(--rt-line, var(--line-strong)) 3px 4px, var(--surface-raised) 4px); }

/* the run: the list of stations plus a right lane for the turns and the stack */
.aq-record-trail__run { position: relative; padding-right: var(--rt-lane, var(--space-8)); }
.aq-record-trail__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--rt-gap, var(--space-8)); row-gap: var(--rt-row, var(--space-16)); list-style: none; margin: 0; padding: 0; }
.aq-record-trail__st { position: relative; display: flex; flex-direction: column; min-width: 0; padding-top: 20px; }

/* the rail: node to next node; a row's last station hands over to the turn */
.aq-record-trail__rail { position: absolute; top: 11.25px; left: 8px; right: calc(-1 * var(--rt-gap, var(--space-8)) - 8px); border-top: 1.5px solid var(--rt-line, var(--line-strong)); transform-origin: 0 50%; }
.aq-record-trail__st.is-row-end .aq-record-trail__rail { right: calc(-0.5 * var(--rt-lane, var(--space-8))); }
.aq-record-trail__st.is-last .aq-record-trail__rail { display: none; }
.aq-record-trail__node { position: absolute; top: 5px; left: 1px; z-index: 2; width: 14px; height: 14px; box-sizing: border-box; border: 1.5px solid var(--ink); border-radius: 50%; background: var(--surface); transition: border-color 160ms cubic-bezier(0.2, 0, 0, 1), background-color 160ms cubic-bezier(0.2, 0, 0, 1), transform 160ms cubic-bezier(0.2, 0, 0, 1); }

/* the turn: down the right lane, back along the gutter, down into the next row's first node */
.aq-record-trail__turn { position: absolute; top: 11.25px; left: calc(8px - 300% - 3 * var(--rt-gap, var(--space-8))); right: calc(-0.5 * var(--rt-lane, var(--space-8))); bottom: calc(-0.5 * var(--rt-row, var(--space-16))); pointer-events: none; }
.aq-record-trail__tr { position: absolute; top: 0; right: 0; bottom: 0; width: calc(var(--rt-lane, var(--space-8)) + var(--rt-r, 12px)); border: 1.5px solid var(--rt-line, var(--line-strong)); border-left: 0; border-radius: 0 var(--rt-r, 12px) var(--rt-r, 12px) 0; }
.aq-record-trail__tl { position: absolute; top: calc(100% - 1.5px); left: -0.75px; right: calc(var(--rt-lane, var(--space-8)) + var(--rt-r, 12px)); height: calc(0.5 * var(--rt-row, var(--space-16)) + 2px); border-top: 1.5px solid var(--rt-line, var(--line-strong)); border-left: 1.5px solid var(--rt-line, var(--line-strong)); border-top-left-radius: var(--rt-r, 12px); }
/* the end: from the last station across and down the lane to the stack */
.aq-record-trail__end { position: absolute; top: 11.25px; left: 8px; right: calc(-0.5 * var(--rt-lane, var(--space-8)) - var(--rt-rest, 0) * (100% + var(--rt-gap, var(--space-8)))); bottom: calc(-1 * var(--space-8) - 32px); border-top: 1.5px solid var(--rt-line, var(--line-strong)); border-right: 1.5px solid var(--rt-line, var(--line-strong)); border-top-right-radius: var(--rt-r, 12px); pointer-events: none; }

/* the hanging part: name and what it controls on the cord */
.aq-record-trail__hang { position: relative; flex: 1 0 auto; margin-left: 7.25px; padding: var(--space-3) 0 var(--space-6) calc(var(--space-6) - 7.25px); border-left: 1.5px solid var(--rt-line, var(--line-strong)); transition: border-color 160ms cubic-bezier(0.2, 0, 0, 1); }
.aq-record-trail__hang::after { content: ""; position: absolute; left: -6px; bottom: -6px; z-index: 2; width: 10.5px; height: 8px; border: 1.5px solid var(--rt-line, var(--line-strong)); border-radius: 2px; background: var(--surface); }
.aq-record-trail__name { margin: 0 0 var(--space-3); font: 400 19px/26px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); text-wrap: pretty; }
.aq-record-trail__n { display: block; margin-bottom: var(--space-1); font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; color: var(--ink-muted); }
.aq-record-trail__ctl { margin: 0; font: 400 15px/24px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

/* the record sheet: paper with a folded corner, its records ruled with a glyph each */
.aq-record-trail__sheet { position: relative; padding: var(--space-3) var(--space-4) var(--space-2); background: linear-gradient(225deg, var(--surface-sunken) 9px, var(--rt-line, var(--line-strong)) 9px 10px, var(--surface-raised) 10px); border: 1px solid var(--rt-line, var(--line-strong)); clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 0 100%); transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 160ms cubic-bezier(0.2, 0, 0, 1); }
.aq-record-trail__sheet ul { list-style: none; margin: 0; padding: 0; }
.aq-record-trail__sheet li { display: grid; grid-template-columns: minmax(0, 1fr) 28px; column-gap: var(--space-3); align-items: start; padding: var(--space-2) 0; font: 400 14px/20px var(--font-sans); color: var(--ink); }
.aq-record-trail__sheet li + li { border-top: 1px solid var(--line); }
.aq-record-trail__sk { margin: 0; }
.aq-record-trail__g { width: 28px; height: 22px; overflow: visible; }
.aq-record-trail__g path { fill: none; stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
.aq-record-trail__ink { stroke: var(--ink-subtle); }
.aq-record-trail__acc { stroke: var(--flow); }
/* column names: read by screen readers, the key shows them once */
.aq-record-trail__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

/* the stack the trail ends in */
.aq-record-trail__stack { position: relative; display: flex; justify-content: flex-end; align-items: center; gap: var(--space-4); height: 64px; margin-top: var(--space-8); }
.aq-record-trail__stack::after { content: ""; position: absolute; top: 32px; right: calc(-0.5 * var(--rt-lane, var(--space-8))); width: calc(0.5 * var(--rt-lane, var(--space-8)) + 6px); border-top: 1.5px solid var(--rt-line, var(--line-strong)); }
.aq-record-trail__pile { width: 120px; height: 64px; overflow: visible; }
.aq-record-trail__ps { fill: var(--surface-raised); stroke: var(--rt-line, var(--line-strong)); stroke-width: 1; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
.aq-record-trail__pr { fill: none; stroke: var(--flow); stroke-width: 1.25; stroke-linecap: round; vector-effect: non-scaling-stroke; }
.aq-record-trail__count { font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; color: var(--ink-muted); white-space: nowrap; }

/* pointed or arriving station */
.aq-record-trail__st:hover .aq-record-trail__node, .aq-record-trail__st:focus-within .aq-record-trail__node, .aq-record-trail__st.is-lit .aq-record-trail__node { border-color: var(--flow); background: var(--flow-tint); transform: scale(1.15); }
.aq-record-trail__st:hover .aq-record-trail__hang, .aq-record-trail__st:focus-within .aq-record-trail__hang { border-left-color: var(--flow); }
.aq-record-trail__st:hover .aq-record-trail__sheet, .aq-record-trail__st:focus-within .aq-record-trail__sheet { transform: translateY(-3px); border-color: var(--flow); }

/* Fold: desktop shows every station; the fold works on phones only */
.aq-fold:not(.is-open) .aq-record-trail__st.aq-fold-x { display: flex; }
.aq-fold:has(> .aq-record-trail__list) > .aq-fold__btn { display: none; }

/* desktop entrance: a station's cord and clip wait for the rail to arrive (motion.js sets is-pending, then is-run per station) */
.aq-record-trail.is-pending .aq-record-trail__st:not(.is-run) .aq-record-trail__hang { border-left-color: transparent; }
.aq-record-trail.is-pending .aq-record-trail__st:not(.is-run) .aq-record-trail__hang::after { opacity: 0; }
.aq-record-trail__hang::after { transition: opacity 160ms cubic-bezier(0.2, 0, 0, 1); }

@media (prefers-reduced-motion: reduce) { .aq-record-trail__node, .aq-record-trail__hang, .aq-record-trail__sheet { transition: none; } }

/* between 861 and 1100: three stations would crowd; the trail keeps four columns but tighter type */
@container (max-width: 1100px) and (min-width: 861px) {
  .aq-record-trail { --rt-gap: var(--space-6); }
  .aq-record-trail__name { font-size: 17px; line-height: 24px; }
}

@container (max-width: 860px) {
  .aq-record-trail { --rt-row: 0px; }
  .aq-record-trail .aq-record-trail__key { gap: var(--space-2) var(--space-4); margin-bottom: var(--space-8); }
  .aq-record-trail__run { padding-right: 0; }
  .aq-record-trail__list { grid-template-columns: minmax(0, 1fr); }
  .aq-record-trail__st { padding: 0 0 var(--space-8) var(--space-8); }
  .aq-record-trail__node { top: 6px; }
  .aq-record-trail__rail { top: 20px; bottom: -6px; left: 7.25px; right: auto; width: 0; border-top: 0; border-left: 1.5px solid var(--rt-line, var(--line-strong)); transform-origin: 50% 0; }
  .aq-record-trail__st.is-row-end .aq-record-trail__rail { right: auto; }
  .aq-record-trail__turn { display: none; }
  .aq-record-trail__end { top: 20px; left: 7.25px; right: auto; width: var(--space-4); bottom: -32px; border-top: 0; border-right: 0; border-left: 1.5px solid var(--rt-line, var(--line-strong)); border-bottom: 1.5px solid var(--rt-line, var(--line-strong)); border-radius: 0 0 0 var(--rt-r, 12px); }
  .aq-record-trail__hang { margin-left: 0; padding: 0 0 var(--space-4); border-left: 0; }
  .aq-record-trail__hang::after { display: none; }
  .aq-record-trail__name { margin-bottom: var(--space-2); font-size: 18px; line-height: 26px; }
  .aq-record-trail__n { display: inline; margin: 0 var(--space-2) 0 0; }
  .aq-record-trail__ctl { font-size: 15px; line-height: 23px; }
  .aq-record-trail__sheet { padding: var(--space-2) var(--space-3) var(--space-1); }
  .aq-record-trail__sheet li { font-size: var(--aq-read-phone); }
  .aq-record-trail__stack { justify-content: flex-start; flex-direction: row-reverse; margin: 0 0 0 var(--space-8); }
  .aq-record-trail__stack::after { display: none; }
  .aq-record-trail__st:hover .aq-record-trail__sheet { transform: none; }
  .aq-fold:not(.is-open) .aq-record-trail__st.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-record-trail__list) > .aq-fold__btn { display: flex; margin-left: var(--space-8); width: calc(100% - var(--space-8)); box-sizing: border-box; }
  /* the rail's end curl closes the trail on phones; the stack would sit after the fold button */
  .aq-record-trail__stack { display: none; }
  .aq-record-trail__end { bottom: var(--space-2); }
}

/* tablet (600 to 860): the sheet hangs beside its station, as in the concept's phone strip */
@container (min-width: 600px) and (max-width: 860px) {
  .aq-record-trail__st { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-6); align-items: start; }
  .aq-record-trail__sheet { margin-top: var(--space-1); }
}

/* ---------- RelatedLinks: the pages to read next, hung off one pipe ---------- */
/* Pass 9. Desktop: one pipe runs along the top of the row (twin line-strong walls, the water line in flow in its bore)
   and each page hangs off it by a drop and a node, as a tile (surface-raised, 1 px line): the index and the section
   label, the target page's picture (its equipment drawing, else its icon drawn large; ink-muted) and its title with a
   flow arrow. Hover or focus lights the tile's drop, node, border, picture and title in flow, lifts the picture and
   slides the arrow on. Phones: one column of rows off a rail down the left, the picture small at the right.
   --aq-pipe, --aq-water (on the list) and --aq-drop, --aq-node (on each li) let RelatedLinks/motion.js lay the pipe
   and run the water; all default to 1. */
/* Card art ink (pass 12 C): ink-muted in light mode; in dark mode the art sits on a dark card, so it takes on-navy-muted,
   the light line every dark band draws in (it was ink-muted at about 1.5:1 to the card in some scopes, and faint). */
.aq-related-links { --aq-rel-ink: var(--ink-muted); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .aq-related-links { --aq-rel-ink: var(--on-navy-muted); } }
[data-theme="dark"] .aq-related-links { --aq-rel-ink: var(--on-navy-muted); }
.aq-related-links {
  --cols: 4;
  position: relative; display: grid; grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); column-gap: var(--space-6); row-gap: var(--space-8);
  margin: 0; padding: var(--space-12) 0 0; list-style: none;
  grid-auto-rows: 1fr; /* every row of tiles the same height, so the drops and titles line up across rows */
}
/* Pass 12 (S2): one row for up to five (five across, no empty sixth slot), six as two rows of three, seven or more four
   to a row; two or three fill the row */
.aq-related-links:not(:has(> :nth-child(4))) { --cols: 3; }
.aq-related-links:has(> :nth-child(5)):not(:has(> :nth-child(6))) { --cols: 5; }
.aq-related-links:has(> :nth-child(6)):not(:has(> :nth-child(7))) { --cols: 3; }
.aq-related-links:not(:has(> :nth-child(3))) { --cols: 2; }
/* the pipe and its water */
.aq-related-links::before, .aq-related-links::after { content: ""; position: absolute; left: 0; right: 0; transform-origin: 0 50%; pointer-events: none; }
.aq-related-links::before { top: 0; height: var(--space-2); box-sizing: border-box; border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); transform: scaleX(var(--aq-pipe, 1)); }
.aq-related-links::after { top: calc(var(--space-1) - 0.75px); height: 1.5px; background: var(--flow); transform: scaleX(var(--aq-water, 1)); }
.aq-related-links > li { position: relative; min-width: 0; display: flex; }
/* the drop from the pipe into the tile, and the node where it leaves the pipe */
.aq-related-links > li::before { content: ""; position: absolute; left: var(--space-8); top: calc(var(--space-2) - var(--space-12)); height: calc(var(--space-12) - var(--space-2)); width: 1px; background: var(--line-strong); transform-origin: 50% 0; transform: scaleY(var(--aq-drop, 1)); transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-related-links > li::after { content: ""; position: absolute; left: calc(var(--space-8) - 4px); top: calc(var(--space-1) - var(--space-12) - 4px); width: 9px; height: 9px; box-sizing: border-box; border: 1px solid var(--line-strong); border-radius: 50%; background: var(--surface); transform: scale(var(--aq-node, 1)); transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), border-color 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-related-links > li:has(> a:is(:hover, :focus-visible))::before { background: var(--flow); }
.aq-related-links > li:has(> a:is(:hover, :focus-visible))::after { background: var(--flow); border-color: var(--flow); }

.aq-related-links__card {
  flex: 1; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr) auto;
  grid-template-areas: "n g" "v v" "t t"; grid-template-rows: auto minmax(0, 1fr) auto;
  align-items: start; align-content: stretch; row-gap: var(--space-4);
  min-height: 44px; padding: var(--space-4) var(--space-6) var(--space-6);
  background: var(--surface-raised); border: 1px solid var(--line);
  color: var(--ink); text-decoration: none;
  transition: border-color 200ms cubic-bezier(0.2, 0, 0, 1);
}
:where(.aq-page) a.aq-related-links__card { color: var(--ink); }
.aq-related-links__n { grid-area: n; font: 400 13px/16px var(--font-mono); letter-spacing: 0.02em; font-variant-numeric: tabular-nums; color: var(--ink-subtle); }
.aq-related-links__group { grid-area: g; justify-self: end; font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-related-links__group > span { display: none; }
/* the picture: a fixed window (pass 12: 152 px, so a tile is about 300 px tall at any column width), the drawing or the
   large icon centred in it */
.aq-related-links__vis { grid-area: v; position: relative; display: grid; place-items: center; height: calc(var(--space-32) + var(--space-6)); margin-inline: calc(-1 * var(--space-2)); overflow: hidden; }
/* An IsoKit scene (pages without an equipment drawing, related.js REL_ISO): the same ink-muted line as the drawings,
   fitted into the window; it lights in flow with the tile */
.aq-related-links__vis.is-iso { padding: var(--space-2) var(--space-4); }
.aq-related-links__vis > .aq-related-links__iso { width: 100%; height: 100%; max-height: 100%; overflow: hidden; }
.aq-related-links__iso :is(.aq-iso__eq, .aq-iso__ln, .aq-iso__thin, .aq-iso__hid, .aq-iso__pipe-wall, .aq-iso__pipe-line) { stroke: var(--aq-rel-ink, var(--ink-muted)); transition: stroke 200ms cubic-bezier(0.2, 0, 0, 1); }
/* lighter than the kit's default, to sit with the raster drawings' fine line (one hand in a row); paper stays the
   tile's white */
.aq-related-links__iso :is(.aq-iso__eq, .aq-iso__ln, .aq-iso__acc, .aq-iso__trace) { stroke-width: 1; }
.aq-related-links__iso :is(.aq-iso__thin, .aq-iso__hid) { stroke-width: .75; }
.aq-related-links__iso .aq-iso__eq--sheet { fill: var(--surface-raised); }
.aq-related-links__card:is(:hover, :focus-visible) .aq-related-links__iso :is(.aq-iso__eq, .aq-iso__ln, .aq-iso__thin, .aq-iso__hid, .aq-iso__pipe-wall, .aq-iso__pipe-line) { stroke: var(--flow); }
/* A page with no picture at all keeps its title at the bottom of the tile, under the label, never at the top of an
   empty card */
.aq-related-links__card.is-bare { grid-template-areas: "n g" "t t"; grid-template-rows: auto 1fr; }
.aq-related-links__card.is-bare .aq-related-links__title { align-self: end; padding-top: var(--space-16); }
.aq-related-links__art { position: absolute; inset: 0; width: 100%; height: 100%; aspect-ratio: auto; max-width: none; margin: 0; background-color: var(--aq-rel-now, var(--aq-rel-ink, var(--ink-muted))); }
.aq-related-links__vis .aq-related-links__spot { width: 46%; height: auto; aspect-ratio: 1; background-color: var(--aq-rel-ink, var(--ink-muted)); }
/* Pass 12 C: one stroke for every card. The equipment drawings (svc-fabrication, svc-service and the other ART pages) are
   fine raster line masks, paler than the IsoKit scenes' 1 px vector line beside them; a hairline drop-shadow in the same
   colour, on the picture window (so after the mask), brings them up to that weight. */
.aq-related-links__vis.is-art { filter: drop-shadow(0 0 0.35px var(--aq-rel-now, var(--aq-rel-ink, var(--ink-muted)))) drop-shadow(0 0 0.35px var(--aq-rel-now, var(--aq-rel-ink, var(--ink-muted)))); }
.aq-related-links__art, .aq-related-links__vis .aq-related-links__spot { transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), transform 320ms cubic-bezier(0.2, 0, 0, 1); }
.aq-related-links__title { grid-area: t; align-self: end; font: 400 24px/30px var(--font-sans); letter-spacing: -0.015em; overflow-wrap: break-word; text-wrap: balance; transition: color 200ms; }
/* Arrow: a real span (aq-related-links__arrow) so it can move; it nudges along on hover and focus */
.aq-related-links__arrow { display: inline-block; margin-left: 0.3em; color: var(--flow); transition: transform 220ms cubic-bezier(0.2, 0, 0, 1); }
.aq-related-links__card:is(:hover, :focus-visible) { border-color: var(--flow); }
.aq-related-links__card:is(:hover, :focus-visible) .aq-related-links__arrow { transform: translateX(var(--space-2)); }
.aq-related-links__card:is(:hover, :focus-visible) .aq-related-links__title { color: var(--flow); }
.aq-related-links__iso { transition: transform 320ms cubic-bezier(0.2, 0, 0, 1); }
.aq-related-links__card:is(:hover, :focus-visible) .aq-related-links__iso { transform: translateY(calc(-1 * var(--space-1))); }
.aq-related-links__card:is(:hover, :focus-visible) :is(.aq-related-links__art, .aq-related-links__spot) { background-color: var(--flow); transform: translateY(calc(-1 * var(--space-1))); }
.aq-related-links__card:is(:hover, :focus-visible) .aq-related-links__vis.is-art { --aq-rel-now: var(--flow); }
.aq-related-links__card:active .aq-related-links__title { transform: translateY(1px); }
.aq-related-links__card:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
/* Spotlight (RelatedLinks/motion.js, spotlight-card): a soft flow light under the content at --aq-sx/--aq-sy, and the
   stretch of the border nearest it lit in flow. Off at rest; on while a fine pointer is over the tile (is-lit), from the
   centre on keyboard focus. Opacity only in CSS; the position is driven by the pointer. */
.aq-related-links__card { position: relative; isolation: isolate; }
.aq-related-links__card::before, .aq-related-links__card::after {
  content: ""; position: absolute; pointer-events: none; opacity: 0;
  transition: opacity 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-related-links__card::before {
  inset: 0; z-index: -1;
  background: radial-gradient(circle 220px at var(--aq-sx, 50%) var(--aq-sy, 50%), color-mix(in srgb, var(--flow) 14%, transparent), transparent 70%);
}
.aq-related-links__card::after {
  inset: -1px; border: 1px solid transparent;
  background: radial-gradient(circle 140px at calc(var(--aq-sx, 50%) + 1px) calc(var(--aq-sy, 50%) + 1px), var(--flow), transparent 75%) border-box;
  -webkit-mask: linear-gradient(black, black) padding-box, linear-gradient(black, black) border-box; -webkit-mask-composite: xor;
  mask: linear-gradient(black, black) padding-box exclude, linear-gradient(black, black) border-box;
}
.aq-related-links__card.is-lit::before, .aq-related-links__card.is-lit::after { opacity: 1; transition-duration: 200ms; }
.aq-related-links__card:not(.is-lit)::before, .aq-related-links__card:not(.is-lit)::after { transition-duration: 140ms; }
.aq-related-links__card:focus-visible::before { opacity: 0.8; }
@media (hover: none) { .aq-related-links__card::before, .aq-related-links__card::after { display: none; } }
@media (prefers-reduced-motion: reduce) { .aq-related-links__card.is-lit::before, .aq-related-links__card.is-lit::after { opacity: 0; } }
@media (prefers-reduced-motion: reduce) {
  .aq-related-links__arrow, .aq-related-links__art, .aq-related-links__spot, .aq-related-links__iso, .aq-related-links__iso *, .aq-related-links__title, .aq-related-links__card, .aq-related-links > li::before, .aq-related-links > li::after { transition: none; }
}
/* Five across: a narrower tile, so the title steps down to 20/26 */
.aq-related-links:has(> :nth-child(5)):not(:has(> :nth-child(6))) .aq-related-links__title { font-size: 20px; line-height: 26px; }
/* Between the phone and a full desktop row, five go 3 + 2 on a six-column grid (the last two wider): no empty slot */
@container (min-width: 861px) and (max-width: 1100px) {
  .aq-related-links:has(> :nth-child(5)):not(:has(> :nth-child(6))) { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .aq-related-links:has(> :nth-child(5)):not(:has(> :nth-child(6))) > li { grid-column: span 2; }
  .aq-related-links:has(> :nth-child(5)):not(:has(> :nth-child(6))) > li:nth-child(n+4) { grid-column: span 3; }
  /* the wider second row would hang its drops from mid-tile: the pipe feeds the first row only */
  .aq-related-links:has(> :nth-child(5)):not(:has(> :nth-child(6))) > li:nth-child(n+4)::before,
  .aq-related-links:has(> :nth-child(5)):not(:has(> :nth-child(6))) > li:nth-child(n+4)::after { display: none; }
}

@container (max-width: 860px) {
  /* Phones: one column of rows off a rail down the left; label and title at the left, the picture small at the right */
  .aq-related-links { --cols: 1; row-gap: var(--space-3); padding: 0 0 0 var(--space-6); grid-auto-rows: auto; }
  .aq-related-links:not(:has(> :nth-child(4))), .aq-related-links:has(> :nth-child(5)):not(:has(> :nth-child(7))),
  .aq-related-links:not(:has(> :nth-child(3))) { --cols: 1; }
  .aq-related-links::before { top: 0; bottom: 0; left: 0; right: auto; width: var(--space-2); height: auto; border: 0; border-left: 1px solid var(--line-strong); border-right: 1px solid var(--line-strong); transform-origin: 50% 0; transform: scaleY(var(--aq-pipe, 1)); }
  .aq-related-links::after { top: 0; bottom: 0; left: calc(var(--space-1) - 0.75px); right: auto; width: 1.5px; height: auto; transform-origin: 50% 0; transform: scaleY(var(--aq-water, 1)); }
  .aq-related-links > li::before { left: calc(var(--space-2) - var(--space-6)); top: 50%; width: calc(var(--space-6) - var(--space-2)); height: 1px; transform-origin: 0 50%; transform: scaleX(var(--aq-drop, 1)); }
  .aq-related-links > li::after { left: calc(var(--space-1) - var(--space-6) - 4px); top: calc(50% - 4px); }
  .aq-related-links__card {
