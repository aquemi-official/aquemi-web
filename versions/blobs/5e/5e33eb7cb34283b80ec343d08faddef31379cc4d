.aq-limit-gauges__dial--open { max-width: 220px; margin-bottom: var(--space-1); }
.aq-limit-gauges__dial--open .aq-limit-gauges__track { stroke: var(--ink-muted); stroke-dasharray: 4 3; }
.aq-limit-gauges__dial--open .aq-limit-gauges__ticks line, .aq-limit-gauges__dial--open .aq-limit-gauges__ticks line.is-major { stroke: var(--ink-subtle); }
