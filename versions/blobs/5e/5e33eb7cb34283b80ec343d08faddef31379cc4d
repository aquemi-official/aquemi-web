@container (max-width: 860px) {
  /* Switcher: one segmented bar of plan buttons */
  .aq-plan-tiers[data-show] .aq-plan-tiers__switch { display: flex; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); overflow: hidden; }
  .aq-plan-tiers__tab {
