/* ---------- ClauseCrosswalk: requirements wired to two regulations' clauses (look "clause-crosswalk") ---------- */
/* Editorial: requirement names large and light down the middle, each regulation a spine at the outer edge with its
   name set big and vertical and its clauses as mono chips. Five tracks: spine | wires | rows | wires | spine. The rows
   share equal heights (grid-auto-rows 1fr) and the chips spread with space-around, so row i sits at (i + 0.5) / N and
   chip j at (j + 0.5) / M of the same height: the wires (a stretched svg, non-scaling strokes) need no measuring.
   Phones: spines and wires go; each row shows its clause chips under how. */
.aq-clause-crosswalk { display: grid; grid-template-columns: auto minmax(var(--space-12), 1fr) minmax(0, 7fr) minmax(var(--space-12), 1fr) auto; grid-template-rows: auto 1fr; column-gap: 0; }
.aq-clause-crosswalk__heads { grid-row: 1; grid-column: 3; display: grid; grid-template-columns: var(--space-12) minmax(0, 0.9fr) minmax(0, 1.1fr); column-gap: var(--space-6); padding: 0 var(--space-4) var(--space-3); border-bottom: 1px solid var(--line-strong); font: 500 12px/16px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.aq-clause-crosswalk__heads span:first-child { grid-column: 2; }
.aq-clause-crosswalk__spine, .aq-clause-crosswalk__wires, .aq-clause-crosswalk__mid { grid-row: 2; }
.aq-clause-crosswalk__spine { display: flex; align-items: stretch; gap: var(--space-3); }
.aq-clause-crosswalk__spine--a { grid-column: 1; }
.aq-clause-crosswalk__spine--b { grid-column: 5; flex-direction: row-reverse; }
.aq-clause-crosswalk__reg { margin: 0; writing-mode: vertical-rl; transform: rotate(180deg); font: 300 40px/44px var(--font-sans); letter-spacing: -0.02em; color: var(--ink); white-space: nowrap; text-align: end; }
.aq-clause-crosswalk__spine--b .aq-clause-crosswalk__reg { transform: none; text-align: start; }
.aq-clause-crosswalk__nodes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; justify-content: space-around; }
.aq-clause-crosswalk__node {
  height: var(--space-6); display: flex; align-items: center; padding: 0 var(--space-2); border: 1px solid var(--line-strong); background: var(--surface-raised);
  font: 400 12px/16px var(--font-mono); color: var(--ink); white-space: nowrap; cursor: default; transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
}
.aq-clause-crosswalk__spine--a .aq-clause-crosswalk__node { justify-content: flex-end; }
.aq-clause-crosswalk__wires { grid-column: 2; display: block; width: 100%; height: 100%; overflow: visible; }
.aq-clause-crosswalk__wires--b { grid-column: 4; }
.aq-clause-crosswalk__wire { fill: none; stroke: var(--line-strong); stroke-width: 1; vector-effect: non-scaling-stroke; transition: stroke 200ms ease, opacity 200ms ease; }
.aq-clause-crosswalk__mid { grid-column: 3; min-width: 0; }
.aq-clause-crosswalk__rows { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-rows: 1fr; height: 100%; }
.aq-clause-crosswalk__row {
  display: grid; grid-template-columns: var(--space-12) minmax(0, 0.9fr) minmax(0, 1.1fr); column-gap: var(--space-6); align-items: center;
  padding: var(--space-4); border-bottom: 1px solid var(--line); position: relative; transition: background-color 200ms ease;
}
.aq-clause-crosswalk__row .aq-index { font: 400 12px/16px var(--font-mono); color: var(--ink-subtle); }
.aq-clause-crosswalk__t { margin: 0; font: 300 28px/32px var(--font-sans); letter-spacing: -0.02em; color: var(--ink); text-wrap: balance; }
.aq-clause-crosswalk__how { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }
.aq-clause-crosswalk__refs { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.aq-clause-crosswalk__ref { display: block; }
.aq-clause-crosswalk__rk { font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-subtle); }
.aq-clause-crosswalk__chip { display: inline-block; padding: 0 var(--space-2); border: 1px solid var(--line-strong); font: 400 12px/20px var(--font-mono); color: var(--ink); }
/* the fold: desktop shows every requirement (the wires need all rows); phones fold */
.aq-fold:not(.is-open) .aq-clause-crosswalk__row.aq-fold-x { display: grid; }
.aq-fold:has(> .aq-clause-crosswalk) > .aq-fold__btn { display: none; }
/* hover */
.aq-clause-crosswalk.has-hot .aq-clause-crosswalk__wire { opacity: 0.25; }
.aq-clause-crosswalk.has-hot .aq-clause-crosswalk__wire.is-hot { opacity: 1; stroke: var(--flow); stroke-width: 1.5; }
.aq-clause-crosswalk__row.is-hot { background: var(--flow-tint); }
.aq-clause-crosswalk__node.is-hot { border-color: var(--flow); background: var(--flow); color: var(--surface); }

@container (max-width: 860px) {
  .aq-clause-crosswalk { display: block; }
  .aq-clause-crosswalk__spine, .aq-clause-crosswalk__wires, .aq-clause-crosswalk__heads { display: none; }
  .aq-clause-crosswalk__rows { display: block; }
  .aq-clause-crosswalk__row, .aq-fold:not(.is-open) .aq-clause-crosswalk__row.aq-fold-x { display: grid; grid-template-columns: var(--space-8) minmax(0, 1fr); row-gap: var(--space-2); padding: var(--space-4) 0; }
  .aq-fold:not(.is-open) .aq-clause-crosswalk__row.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-clause-crosswalk) > .aq-fold__btn { display: flex; }
  .aq-clause-crosswalk__t { font-size: 24px; line-height: 28px; }
  .aq-clause-crosswalk__how, .aq-clause-crosswalk__refs { grid-column: 2; }
  .aq-clause-crosswalk__refs { position: static; width: auto; height: auto; clip-path: none; white-space: normal; display: flex; flex-direction: column; gap: var(--space-2); }
  .aq-clause-crosswalk__ref { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-2); }
  .aq-clause-crosswalk__rk { flex-basis: 100%; }
}
@container (max-width: 860px) {
  .aq-clause-crosswalk__refs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-4); }
}
.aq-clause-crosswalk-sec { position: relative; }

/* pass 12 phone (audit S10, sys-monitoring.3): the crosswalk survives as a mini crosswalk per row. The rail names head
   the list once (__pheads); in each row regulation A's chips stack on a left rail and B's on a right rail, short
   curves (__mini, stretched like the desktop wires) run from every chip to the requirement set in a box between
   them, and how runs full width under. The rails' own labels stay for screen readers. Desktop never shows these. */
.aq-clause-crosswalk__pheads, .aq-clause-crosswalk__mini { display: none; }
@container (max-width: 860px) {
  .aq-clause-crosswalk__pheads {
    display: flex; justify-content: space-between; gap: var(--space-4); padding: 0 0 var(--space-2); border-bottom: 1px solid var(--line-strong);
    font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted);
  }
  .aq-clause-crosswalk__pheads span:last-child { text-align: right; }
  .aq-clause-crosswalk__row, .aq-fold:not(.is-open) .aq-clause-crosswalk__row.aq-fold-x {
    grid-template-columns: max-content 22px minmax(0, 1fr) 22px max-content; grid-template-areas: "a wa t wb b" "how how how how how";
    row-gap: var(--space-3); column-gap: 0; align-items: stretch; padding: var(--space-5, 20px) 0;
  }
  .aq-fold:not(.is-open) .aq-clause-crosswalk__row.aq-fold-x { display: none; }
  .aq-clause-crosswalk__row .aq-index { display: none; }
  .aq-clause-crosswalk__t {
    grid-area: t; align-self: center; padding: var(--space-2) var(--space-3); border: 1px solid var(--line-strong); background: var(--surface-raised);
    font-size: 19px; line-height: 23px; text-align: center; text-wrap: balance;
  }
  .aq-clause-crosswalk__how { grid-area: how; grid-column: 1 / -1; }
  .aq-clause-crosswalk__refs { display: contents; }
  .aq-clause-crosswalk__ref, .aq-clause-crosswalk__ref--a, .aq-clause-crosswalk__ref--b { display: flex; flex-direction: column; justify-content: space-around; align-items: stretch; gap: var(--space-2); }
  .aq-clause-crosswalk__ref--a { grid-area: a; }
  .aq-clause-crosswalk__ref--b { grid-area: b; }
  .aq-clause-crosswalk__rk { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .aq-clause-crosswalk__chip { font-size: 13px; line-height: 26px; background: var(--surface-raised); white-space: nowrap; text-align: center; }
  .aq-clause-crosswalk__mini { display: block; width: 100%; height: 100%; overflow: visible; }
  .aq-clause-crosswalk__mini--a { grid-area: wa; }
  .aq-clause-crosswalk__mini--b { grid-area: wb; }
  .aq-clause-crosswalk__mini path { fill: none; stroke: var(--line-strong); stroke-width: 1; vector-effect: non-scaling-stroke; transition: stroke 200ms ease; }
  .aq-clause-crosswalk__row.is-hot { background: transparent; }
  .aq-clause-crosswalk__row.is-hot .aq-clause-crosswalk__t { border-color: var(--flow); background: var(--flow-tint); }
  .aq-clause-crosswalk__row.is-hot .aq-clause-crosswalk__mini path { stroke: var(--flow); }
  .aq-clause-crosswalk__row.is-hot .aq-clause-crosswalk__chip { border-color: var(--flow); }
}
/* verify V8: a rail with one chip draws a straight connector; a 1 px non-scaling stroke at a half-pixel y rendered it
   speckled (it read as dashed beside the curves), so straight ones snap to the pixel grid. */
@container (max-width: 860px) { .aq-clause-crosswalk__mini path.is-straight { shape-rendering: crispEdges; } }
