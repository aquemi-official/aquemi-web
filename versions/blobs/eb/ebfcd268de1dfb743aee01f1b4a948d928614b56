/* ---------- ConfigCards: typical configurations as design-basis cards, each the same package piped to its use ---------- */
.aq-config-cards-sec { position: relative; }
.aq-config-cards { margin-top: var(--space-8); }
.aq-config-cards__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
.aq-config-cards__card { position: relative; display: flex; flex-direction: column; min-width: 0; background: var(--surface-raised); border: 1px solid var(--line-strong);
  transition: border-color 200ms cubic-bezier(0.2, 0, 0, 1); }

/* Drawing: the package at the left of every card, piped to its use; the number tag on the drawing's lower right */
.aq-config-cards__fig { position: relative; padding: var(--space-6) var(--space-4) var(--space-4); border-bottom: 1px solid var(--line); overflow: hidden; }
.aq-config-cards__fig svg { display: block; width: 100%; height: auto; }
.aq-config-cards__no { position: absolute; right: 0; bottom: 0; min-width: var(--space-8); padding: var(--space-1) var(--space-2); background: var(--ink); color: var(--ink-inverse);
  font: 500 13px/20px var(--font-mono); letter-spacing: 0.04em; text-align: center; }

/* Text: title (the link), capacity chip and design-basis tag, ruled spec lines */
.aq-config-cards__body { position: relative; display: flex; flex-direction: column; gap: var(--space-3); flex: 1; padding: var(--space-4) var(--space-6) var(--space-6) var(--space-6); }
.aq-config-cards__t { margin: 0; padding-right: var(--space-8); font: 400 20px/26px var(--font-sans); letter-spacing: -0.015em; color: var(--ink); }
.aq-config-cards__a { color: inherit; text-decoration: none; }
.aq-config-cards__a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
.aq-config-cards__a:focus-visible { outline: none; }
.aq-config-cards__card:has(.aq-config-cards__a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
.aq-config-cards__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin: 0; }
.aq-config-cards__cap { font: 400 14px/20px var(--font-mono); }
.aq-config-cards__tag { padding: 0 var(--space-2); border: 1px solid var(--line-strong); font: 500 11px/20px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); white-space: nowrap; }
.aq-config-cards__spec { margin: 0; display: flex; flex-direction: column; }
.aq-config-cards__row { display: grid; grid-template-columns: var(--space-16) minmax(0, 1fr); column-gap: var(--space-3); padding-block: var(--space-2); border-top: 1px solid var(--line); }
.aq-config-cards__row dt { font: 500 11px/22px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
.aq-config-cards__row dd { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--ink-muted); }
.aq-config-cards__go { position: absolute; right: var(--space-6); top: var(--space-4); display: block; width: var(--space-6); height: var(--space-6); color: var(--flow); }
.aq-config-cards__go::before { content: ""; position: absolute; left: 0; right: 1px; top: 50%; height: 1.5px; background: currentColor; transform: scaleX(0.55); transform-origin: 100% 50%;
  transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-config-cards__go::after { content: ""; position: absolute; right: 1px; top: 50%; width: var(--space-2); height: var(--space-2); border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor;
  transform: translateY(-50%) rotate(45deg); }

/* Hover: the card's frame and title go flow, the arrow runs out */
.aq-config-cards__card:has(.aq-config-cards__a:hover) { border-color: var(--flow); }
.aq-config-cards__card:has(.aq-config-cards__a:hover) .aq-config-cards__t { color: var(--flow); }
.aq-config-cards__card:has(.aq-config-cards__a:hover) .aq-config-cards__go::before { transform: scaleX(1); }

/* Shutter (motion.js inserts it; never present without script or under reduced motion) */
.aq-config-cards__shutter { position: absolute; inset: 0; z-index: 1; display: flex; pointer-events: none; }
.aq-config-cards__shutter i { flex: 1; background: var(--navy); transform-origin: 50% 0; }

/* Rail controls: phones only */
.aq-config-cards__ctl { display: none; }

@container (max-width: 1100px) {
  .aq-config-cards__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

/* Phones: a scroll-snap rail, one card at 85 % with the next peeking, Previous / Next, a count, Show all */
@container (max-width: 860px) {
  .aq-config-cards { margin-top: var(--space-6); }
  .aq-config-cards__list { display: flex; gap: var(--space-3); margin-inline: calc(var(--space-4) * -1); padding: 0 var(--space-4) var(--space-2); overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--space-4); scrollbar-width: none; }
  .aq-config-cards__list::-webkit-scrollbar { display: none; }
  .aq-config-cards__card { flex: 0 0 85%; scroll-snap-align: start; }
  .aq-config-cards__fig { padding: var(--space-4) var(--space-2) var(--space-3); }
  .aq-config-cards__body { padding: var(--space-4); gap: var(--space-2); }
  .aq-config-cards__t { font-size: 19px; line-height: 25px; }
  .aq-config-cards__go { right: var(--space-4); top: var(--space-4); }
  .aq-config-cards__cap { font-size: var(--aq-read-phone); }
  .aq-config-cards__row { grid-template-columns: var(--space-12) minmax(0, 1fr); column-gap: var(--space-2); }
  .aq-config-cards__row dd { font-size: var(--aq-read-phone); line-height: 21px; }
  .aq-config-cards__ctl { display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-3); }
  .aq-config-cards__hint { font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
  .aq-config-cards__count { margin-right: auto; font: 400 14px/20px var(--font-mono); color: var(--ink); font-variant-numeric: tabular-nums; }
  .aq-config-cards__btn { position: relative; width: var(--aq-hit); height: var(--aq-hit); padding: 0; border: 1px solid var(--line-strong); background: var(--surface-raised); color: var(--ink); cursor: pointer; }
  .aq-config-cards__btn::after { content: ""; position: absolute; left: 50%; top: 50%; width: var(--space-2); height: var(--space-2); border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor;
    transform: translate(-65%, -50%) rotate(45deg); }
  .aq-config-cards__prev::after { transform: translate(-35%, -50%) rotate(-135deg); }
  .aq-config-cards__btn:disabled { color: var(--ink-subtle); border-color: var(--line); cursor: default; }
  .aq-config-cards__btn:focus-visible, .aq-config-cards__all:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .aq-config-cards__all { min-height: var(--aq-hit); padding: 0 var(--space-3); border: 0; background: none; color: var(--flow); font: 500 14px/20px var(--font-sans); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  /* Show all: the cards stacked, the arrows and the count put away */
  .aq-config-cards.is-all .aq-config-cards__list { flex-direction: column; overflow: visible; margin-inline: 0; padding: 0; scroll-snap-type: none; }
  .aq-config-cards.is-all .aq-config-cards__card { flex: none; }
  .aq-config-cards.is-all .aq-config-cards__hint, .aq-config-cards.is-all .aq-config-cards__count, .aq-config-cards.is-all .aq-config-cards__btn { display: none; }
  .aq-config-cards.is-all .aq-config-cards__ctl { justify-content: flex-start; }
}

/* Tablets: the same rail, two cards with the third peeking, so the drawing stays at the phone's scale */
@container (min-width: 601px) and (max-width: 860px) {
  .aq-config-cards__card { flex-basis: 46%; }
}

@media (prefers-reduced-motion: reduce) {
  .aq-config-cards__card, .aq-config-cards__go::before { transition: none; }
}
