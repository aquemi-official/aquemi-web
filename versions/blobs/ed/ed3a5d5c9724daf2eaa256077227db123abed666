/* ---------- UseMatrix: an industry-by-use table drawn as one water main ---------- */
/* One grid template for the heads and every row. The pipe is drawn by the head cells: each draws its stretch of the
   twin-wall trunk (two line-strong hairlines over the ground, water in flow down the middle) from its left edge across
   the column gap to the next cell; the last stops at its own drop. Each use column's drop tees down out of the trunk
   to the column's name, and the column's squares stand on the same line below. Squares: navy where a grade is set,
   open where the cell is a dash. */
.aq-use-matrix { --pipe: var(--space-3); --sq: var(--space-4); --cg: var(--space-6); --fall: var(--space-12);
  --cols: minmax(0, 1.3fr) repeat(var(--c, 5), minmax(0, 1fr)); position: relative; }
.aq-use-matrix__heads { position: relative; display: grid; grid-template-columns: var(--cols, 1fr); column-gap: var(--cg, var(--space-6)); align-items: end;
  padding-top: var(--fall, var(--space-12)); padding-bottom: var(--space-3); border-bottom: 1px solid var(--line-strong); }
.aq-use-matrix__h0, .aq-use-matrix__h { position: relative; margin: 0; font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
.aq-use-matrix__h { padding-left: calc(var(--sq, var(--space-4)) + var(--space-2)); transition: color 200ms; }
/* the trunk, one stretch per head cell */
.aq-use-matrix__h0::before, .aq-use-matrix__h::before { content: ""; position: absolute; top: calc(-1 * var(--fall, var(--space-12))); left: 0; width: calc(100% + var(--cg, var(--space-6)));
  height: var(--pipe, var(--space-3)); border-block: 1px solid var(--line-strong); background: linear-gradient(var(--flow), var(--flow)) 0 50% / 100% 2px no-repeat var(--surface-sunken); box-sizing: border-box; }
/* the trunk starts at the first drop (the industry column has no tee), capped there */
.aq-use-matrix__h0::before { display: none; }
.aq-use-matrix__h0 + .aq-use-matrix__h::before { border-left: 3px double var(--line-strong); }
/* the trunk runs across every use column (all --c of them, whatever the count) and turns down at the table's right edge
   as the loop's return, so the last column is framed like the others (pass 12 round C; it used to stop at its drop) */
.aq-use-matrix__h:last-child::before { width: 100%; border-right: 1px solid var(--line-strong); }
.aq-use-matrix__h:last-child::after { content: ""; position: absolute; right: 0; top: calc(-1 * var(--fall, var(--space-12)) + var(--pipe, var(--space-3)) / 2 - 1px);
  bottom: calc(-1 * var(--space-3)); width: var(--pipe, var(--space-3)); border-inline: 1px solid var(--line-strong); box-sizing: border-box; z-index: 1;
  /* the water turns the corner: a level stub from the left wall to the centre, then the fall */
  background: linear-gradient(var(--flow), var(--flow)) 0 0 / calc(50% + 1px) 2px no-repeat,
    linear-gradient(var(--flow), var(--flow)) 50% 0 / 2px 100% no-repeat var(--surface-sunken); }
/* the tee: the drop's twin wall starts at the trunk's water line (its ground hides the trunk's lower wall) and falls to the name */
.aq-use-matrix__drop { position: absolute; left: calc((var(--sq, var(--space-4)) - var(--pipe, var(--space-3))) / 2); top: calc(-1 * var(--fall, var(--space-12)) + var(--pipe, var(--space-3)) / 2 - 1px);
  bottom: calc(-1 * var(--space-3)); width: var(--pipe, var(--space-3)); border-inline: 1px solid var(--line-strong); background: var(--surface-sunken); box-sizing: border-box; z-index: 1; }
.aq-use-matrix__drop .aq-use-matrix__water { position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: var(--flow); transform-origin: 50% 0; }
.aq-use-matrix__hn { display: none; }
.aq-use-matrix__h.is-col { color: var(--ink); }
.aq-use-matrix__h.is-col .aq-use-matrix__drop { border-color: var(--flow); }
.aq-use-matrix__key { display: none; }

.aq-use-matrix__list { list-style: none; margin: 0; padding: 0; }
.aq-use-matrix__row { display: grid; grid-template-columns: var(--cols, 1fr); column-gap: var(--cg, var(--space-6)); row-gap: var(--space-2); align-items: start;
  padding-block: var(--space-4); border-bottom: 1px solid var(--line); }
.aq-use-matrix__name { margin: 0; font: 400 18px/24px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
.aq-use-matrix__name a { color: inherit; text-decoration: none; }
.aq-use-matrix__name a::after { content: "\00a0\2192"; color: var(--flow); display: inline-block; transition: transform 200ms; }
.aq-use-matrix__name a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; text-decoration-color: var(--flow); }
.aq-use-matrix__name a:hover::after { transform: translateX(var(--space-1)); }
.aq-use-matrix__name a:focus-visible { outline: 2px solid var(--focus); outline-offset: var(--space-1); }
.aq-use-matrix__cells { display: contents; }
.aq-use-matrix__cell { position: relative; display: flex; align-items: flex-start; gap: var(--space-2); min-width: 0; }
.aq-use-matrix__sq { flex: none; width: var(--sq, var(--space-4)); height: var(--sq, var(--space-4)); margin-top: 2px; box-sizing: border-box;
  transition: background-color 200ms, border-color 200ms, transform 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-use-matrix__cell.is-set .aq-use-matrix__sq { background: var(--navy); }
.aq-use-matrix__cell.is-blank .aq-use-matrix__sq { border: 1px solid var(--line-strong); background: var(--surface); }
.aq-use-matrix__cell.is-col.is-set .aq-use-matrix__sq { background: var(--flow); transform: scale(1.12); }
.aq-use-matrix__cell.is-col.is-blank .aq-use-matrix__sq { border-color: var(--flow); }
.aq-use-matrix__v { margin: 0; min-width: 0; font: 400 14px/20px var(--font-sans); color: var(--ink-muted); overflow-wrap: break-word; hyphens: manual; }
.aq-use-matrix__cell.is-set .aq-use-matrix__v { color: var(--ink); }
.aq-use-matrix__k, .aq-use-matrix__sr { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
.aq-use-matrix__dash { color: var(--ink-subtle); }
.aq-use-matrix__src { display: inline-block; margin: 2px 0; padding: 0 var(--space-1); border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
  font: 400 11px/16px var(--font-mono); letter-spacing: 0.02em; color: var(--ink-muted); vertical-align: 1px; }
.aq-use-matrix__go { display: none; }

@container (max-width: 1100px) {
  .aq-use-matrix { --cg: var(--space-4); --cols: minmax(0, 1.1fr) repeat(var(--c, 5), minmax(0, 1fr)); }
  .aq-use-matrix__name { font-size: 16px; line-height: 22px; }
  .aq-use-matrix__h { font-size: 11px; }
}

/* Phones: a riser down the left, one tap row per industry branching off it with its row in miniature; the uses are
   named once in the key above; the open row lists its uses as chips with their text */
@container (max-width: 860px) {
  .aq-use-matrix__heads { display: none; }
  .aq-use-matrix__key { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-1) var(--space-4); list-style: none; margin: 0 0 var(--space-4); padding: 0;
    font: 400 12px/18px var(--font-mono); color: var(--ink-muted); }
  .aq-use-matrix__key li { display: flex; align-items: center; gap: var(--space-2); }
  .aq-use-matrix__ks, .aq-use-matrix__ms { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; box-sizing: border-box;
    border: 1px solid var(--line-strong); font: 500 11px/1 var(--font-mono); color: var(--ink-muted); background: var(--surface); }
  .aq-use-matrix__ms.is-set { background: var(--navy); border-color: var(--navy); color: var(--on-navy); }
  .aq-use-matrix__list { position: relative; padding-left: calc(var(--pipe, var(--space-3)) + var(--space-4)); }
  /* the riser: a twin-wall pipe down the left edge */
  .aq-use-matrix__list::before { content: ""; position: absolute; left: 0; top: 0; bottom: var(--space-6); width: var(--pipe, var(--space-3)); box-sizing: border-box;
    border-inline: 1px solid var(--line-strong); background: linear-gradient(var(--flow), var(--flow)) 50% 0 / 2px 100% no-repeat var(--surface-sunken); }
  .aq-use-matrix__row { display: block; position: relative; padding-block: 0; border-bottom: 0; border-top: 1px solid var(--line-strong); }
  .aq-use-matrix__row:last-child { border-bottom: 1px solid var(--line-strong); }
  /* the branch: from the riser into the row's tap line */
  .aq-use-matrix__row::before { content: ""; position: absolute; left: calc(-1 * var(--space-4)); top: 23px; width: var(--space-4); height: 2px; background: var(--flow); }
  .aq-use-matrix__tap { gap: var(--space-2); }
  .aq-use-matrix__tt { flex: 1 1 auto; min-width: 0; font: 400 16px/22px var(--font-sans); color: var(--ink); }
  .aq-use-matrix__strip { flex: none; display: flex; gap: 3px; }
  .aq-use-matrix__tap .aq-phone-kit__chev { width: 32px; margin-right: calc(-1 * var(--space-2)); }
  .aq-use-matrix__name { padding-block: var(--space-3); font-size: 17px; line-height: 23px; }
  .aq-use-matrix__cells { display: grid; gap: var(--space-2); padding: var(--space-1) 0 var(--space-4); }
  .aq-use-matrix__sq { display: none; }
  .aq-use-matrix__v { font-size: var(--aq-read-phone, 14px); line-height: 21px; }
  .aq-use-matrix__k { position: static; width: auto; height: auto; overflow: visible; clip: auto; clip-path: none; white-space: nowrap;
    display: inline-block; margin-right: var(--space-1); padding: 0 var(--space-2); border-radius: var(--radius-sm); box-sizing: border-box;
    font: 500 11px/20px var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase; vertical-align: 1px; }
  .aq-use-matrix__cell.is-set .aq-use-matrix__k { background: var(--navy); color: var(--on-navy); }
  .aq-use-matrix__cell.is-blank .aq-use-matrix__k { border: 1px solid var(--line-strong); line-height: 18px; color: var(--ink-muted); }
  .aq-use-matrix__go { display: flex; margin-top: var(--space-1); padding-inline: 0; border-top: 1px solid var(--line); color: var(--ink); }
}

/* the drops and squares fill in (motion.js); with no motion they are simply there */
.aq-use-matrix-sec { overflow-x: clip; }

/* Dark: navy squares sink into the dark ground, so a set square turns flow (9:1 on the alt ground) and the open ones
   keep their outline; the filled/open code stays the right way round */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .aq-use-matrix__cell.is-set .aq-use-matrix__sq,
  :root:not([data-theme="light"]) .aq-use-matrix__ms.is-set { background: var(--flow); border-color: var(--flow); color: var(--ink-inverse); }
  :root:not([data-theme="light"]) .aq-use-matrix__cell.is-col.is-set .aq-use-matrix__sq { background: var(--ink); }
}
[data-theme="dark"] .aq-use-matrix__cell.is-set .aq-use-matrix__sq,
[data-theme="dark"] .aq-use-matrix__ms.is-set { background: var(--flow); border-color: var(--flow); color: var(--ink-inverse); }
[data-theme="dark"] .aq-use-matrix__cell.is-col.is-set .aq-use-matrix__sq { background: var(--ink); }
