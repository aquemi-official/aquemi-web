  .aq-limit-gauges__num { font-size: 18px; line-height: 22px; letter-spacing: -0.03em; }
  .aq-limit-gauges__cap { padding-top: 0; white-space: normal; }
  .aq-limit-gauges__foot { padding-top: var(--space-1); }
  .aq-limit-gauges__spec dt { display: none; }
