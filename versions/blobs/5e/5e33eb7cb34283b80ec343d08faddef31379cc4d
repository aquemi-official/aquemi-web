/* ---------- Pass 12 phones: PhoneKit holds the sheet as a 180 px strip under the header ----------
   The sheet wrapper steps aside (display: contents) so the strip sticks for the whole rail. The drawing runs the full
   width and PhoneKit pans it to the part the active stage draws; the joint's tag stays pinned top left. */
@container (max-width: 860px) {
  .aq-joint-steps[data-pk-on] .aq-joint-steps__sheet { display: contents; }
  .aq-joint-steps[data-pk-on] .aq-joint-steps__fig { margin-bottom: var(--space-4); border-width: 0 0 1px; }
  .aq-joint-steps[data-pk-on] .aq-joint-steps__fig .aq-iso { width: 100%; height: auto; }
