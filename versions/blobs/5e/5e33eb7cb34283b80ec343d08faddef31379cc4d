.aq-hero-scene:has(li[data-k="3"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-iso__part[data-iso-id="k3"] :is(.aq-iso__eq, .aq-iso__ln, .aq-iso__thin, .aq-iso__hid),
.aq-hero-scene:has(li[data-k="4"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-iso__part[data-iso-id="k4"] :is(.aq-iso__eq, .aq-iso__ln, .aq-iso__thin, .aq-iso__hid),
.aq-hero-scene:has(li[data-k="5"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-iso__part[data-iso-id="k5"] :is(.aq-iso__eq, .aq-iso__ln, .aq-iso__thin, .aq-iso__hid),
.aq-hero-scene:has(li[data-k="6"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-iso__part[data-iso-id="k6"] :is(.aq-iso__eq, .aq-iso__ln, .aq-iso__thin, .aq-iso__hid),
.aq-hero-scene:has(li[data-k="7"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-iso__part[data-iso-id="k7"] :is(.aq-iso__eq, .aq-iso__ln, .aq-iso__thin, .aq-iso__hid),
.aq-hero-scene:has(li[data-k="8"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-iso__part[data-iso-id="k8"] :is(.aq-iso__eq, .aq-iso__ln, .aq-iso__thin, .aq-iso__hid) { stroke: var(--flow); }
.aq-hero-scene:has(li[data-k="1"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-hero-scene__tag[data-k="1"],
.aq-hero-scene:has(li[data-k="2"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-hero-scene__tag[data-k="2"],
.aq-hero-scene:has(li[data-k="3"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-hero-scene__tag[data-k="3"],
.aq-hero-scene:has(li[data-k="4"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-hero-scene__tag[data-k="4"],
.aq-hero-scene:has(li[data-k="5"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-hero-scene__tag[data-k="5"],
.aq-hero-scene:has(li[data-k="6"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-hero-scene__tag[data-k="6"],
.aq-hero-scene:has(li[data-k="7"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-hero-scene__tag[data-k="7"],
.aq-hero-scene:has(li[data-k="8"] :is(a:hover, a:focus-visible, span.aq-hero-scene__row:is(:hover, :focus-visible))) .aq-hero-scene__tag[data-k="8"] { background: var(--flow); color: var(--on-action); }

/* Per scene: the line-up's four rows in one column (the system index), the room's key beside a narrower drawing */
.aq-hero-scene--lineup .aq-hero-scene__key ol { --hs-cols: 2; }
.aq-hero-scene--room .aq-hero-scene__draw { width: min(100%, calc(var(--space-32) * 4)); justify-self: center; }
.aq-hero-scene--room .aq-hero-scene__key ol { --hs-cols: 3; column-gap: var(--space-6); }
.aq-hero-scene--fan .aq-hero-scene__key ol { --hs-cols: 2; }

@container (max-width: 860px) {
  /* Phones: the drawing at the full gutter width under the actions, tags at 13 px, the key one row per line at
     reading size (15 px, 44 px rows); the room key in two columns (short names) */
  .aq-hero-scene { row-gap: var(--space-4); }
  .aq-hero-scene__tag { font-size: 13px; }
  .aq-hero-scene__key ol, .aq-hero-scene--lineup .aq-hero-scene__key ol, .aq-hero-scene--fan .aq-hero-scene__key ol { --hs-cols: 1; }
  .aq-hero-scene--room .aq-hero-scene__key ol { --hs-cols: 2; column-gap: var(--space-4); }
  .aq-hero-scene--room .aq-hero-scene__draw { width: min(100%, calc(var(--space-32) * 4)); }
}
@container (max-width: 480px) {
  /* phones: the wide drawings (line-up, ring, fan) run to the screen edges, so the parts are as large as they can be */
  .aq-hero-scene:is(.aq-hero-scene--lineup, .aq-hero-scene--ring, .aq-hero-scene--fan, .aq-hero-scene--bay, .aq-hero-scene--map, .aq-hero-scene--reply) .aq-hero-scene__draw { width: calc(100% + 2 * var(--space-4)); margin-inline: calc(-1 * var(--space-4)); }
}

/* ---------- Pass 12 round C (c03-heroes): four more scenes and phone fixes ----------
   shop-bay (about, careers), site-map (contact-locations), reply-flow (contact-proposal), compliance-matrix (compliance).
   The span key rows (site-room, shop-bay, site-map, reply-flow) take focus (tabindex 0): focus lights the part. */
span.aq-hero-scene__row { cursor: default; }
.aq-hero-scene__key--c2 ol { --hs-cols: 2; }
.aq-hero-scene__key--c3 ol { --hs-cols: 3; column-gap: var(--space-6); }
.aq-hero-scene .aq-iso .aq-hero-scene__bay { stroke: var(--line-strong); stroke-dasharray: 6 4; }
.aq-hero-scene .aq-iso .aq-hero-scene__sheet { fill: var(--limestone); stroke: var(--line-strong); }
.aq-hero-scene .aq-iso .aq-hero-scene__contour { stroke: color-mix(in srgb, var(--line-strong) 70%, var(--limestone)); }
.aq-hero-scene .aq-iso .aq-hero-scene__ring { stroke: var(--ink-subtle); stroke-dasharray: 5 4; }
[data-theme="dark"] .aq-hero-scene .aq-iso .aq-hero-scene__sheet { fill: color-mix(in srgb, var(--limestone) 10%, var(--surface)); }
[data-theme="dark"] .aq-hero-scene .aq-iso .aq-hero-scene__contour { stroke: var(--line-strong); }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .aq-hero-scene .aq-iso .aq-hero-scene__sheet { fill: color-mix(in srgb, var(--limestone) 10%, var(--surface)); }
  :root:not([data-theme="light"]) .aq-hero-scene .aq-iso .aq-hero-scene__contour { stroke: var(--line-strong); }
}
.aq-hero-scene--reply .aq-hero-scene__draw { width: min(100%, calc(var(--space-32) * 5)); justify-self: center; }
.aq-hero-scene--bay .aq-hero-scene__draw, .aq-hero-scene--map .aq-hero-scene__draw { width: min(100%, calc(var(--space-32) * 4 + var(--space-24))); justify-self: center; }

/* compliance-matrix: a ruled sheet on surface-raised (title, five heads, four numbered rows: the clause and proof cells
   hold their placeholders, one flow tick per row), the small PP package tucked under its lower-right corner */
.aq-hero-scene--matrix { position: relative; display: block; padding-bottom: calc(var(--space-24) + var(--space-6)); }
.aq-hero-scene__mx { position: relative; z-index: 1; width: 84%; box-sizing: border-box; padding: var(--space-6); background: var(--surface-raised); border: 1px solid var(--line-strong); color: var(--ink); }
.aq-hero-scene__mx-h { margin: 0 0 var(--space-4); font: 400 22px/28px var(--font-sans); letter-spacing: -0.01em; }
.aq-hero-scene__mx-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) repeat(3, minmax(56px, 0.6fr)) minmax(0, 1.4fr); border-top: 1px solid var(--line-strong); }
.aq-hero-scene__mx-grid > span { display: flex; align-items: center; min-width: 0; min-height: var(--space-12); box-sizing: border-box; padding: var(--space-2) var(--space-2); border-bottom: 1px solid var(--line); font: 400 15px/20px var(--font-sans); }
.aq-hero-scene__mx-grid > span:nth-child(5n+1) { padding-left: 0; }
.aq-hero-scene__mx-grid > .aq-hero-scene__mx-th { font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); border-bottom-color: var(--line-strong); }
.aq-hero-scene__mx-th.is-mark, .aq-hero-scene__mx-m { justify-content: center; text-align: center; border-left: 1px solid var(--line); }
.aq-hero-scene__mx-c { gap: var(--space-3); }
.aq-hero-scene__mx-c b { flex: none; font: 400 12px/1 var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink-subtle); }
.aq-hero-scene__mx-d { border-left: 1px solid var(--line); }
.aq-hero-scene__tick { width: var(--space-6); height: var(--space-6); fill: none; stroke: var(--flow); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.aq-hero-scene__mx-m.is-on { background: color-mix(in srgb, var(--flow-tint) 70%, transparent); }
.aq-hero-scene__inset { position: absolute; z-index: 2; right: 0; bottom: 0; width: 38%; }
.aq-hero-scene__inset .aq-hero-scene__draw { width: 100%; }
/* the Proof head takes its column's rule and inset, so "Differs" and "Proof" read as two heads */
.aq-hero-scene__mx-grid > .aq-hero-scene__mx-th:nth-child(5) { border-left: 1px solid var(--line); padding-left: var(--space-2); }
@container (min-width: 861px) {
  /* desktop: the package sits clear under the sheet's lower right (the 38 % inset is about 36 % of the scene tall), so
     it never covers row 04's proof chip */
  .aq-hero-scene--matrix { padding-bottom: calc(36% - var(--space-6)); }
}
@container (min-width: 861px) and (max-width: 1160px) {
  /* narrow desktop: the sheet takes the full column, row numbers drop, tick columns fixed at 48 px with the phone's
     12 px sans heads (the mono caps "DIFFERS" overran 48 px), so the clause chip stays in its cell and the proof chip on
     one line */
  .aq-hero-scene__mx { width: 100%; }
  .aq-hero-scene__mx-c b { display: none; }
  .aq-hero-scene__mx-grid { grid-template-columns: minmax(0, 1fr) repeat(3, 48px) minmax(0, 1.3fr); }
  .aq-hero-scene__mx-grid > .aq-hero-scene__mx-th { font: 500 12px/14px var(--font-sans); letter-spacing: 0; text-transform: none; }
  .aq-hero-scene__mx-grid > .aq-hero-scene__mx-th.is-mark { padding-inline: 0; }
  .aq-hero-scene__mx-d .aq-ph { white-space: nowrap; }
}

/* edition-timeline (compliance, pass 13): a ruled sheet like the matrix's; numbered stations on one flow line, and a
   dashed flow branch (the new edition) that leaves at the fork station and rejoins at the join station, its label on
   the branch. --n stations, --f fork, --j join (set by HeroScene.js). Station centres sit at (k - 0.5) / n of the rail. */
.aq-hero-scene--edition { display: block; }
.aq-hero-scene__ed { box-sizing: border-box; padding: var(--space-6); background: var(--surface-raised); border: 1px solid var(--line-strong); color: var(--ink); }
.aq-hero-scene__ed-h { margin: 0 0 var(--space-4); padding-bottom: var(--space-4); border-bottom: 1px solid var(--line-strong); font: 400 22px/28px var(--font-sans); letter-spacing: -0.01em; }
.aq-hero-scene__ed-body { position: relative; padding-top: var(--space-12); }
.aq-hero-scene__ed-rail { position: relative; display: grid; grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
/* the project line, first station to last, through the dots' centres */
.aq-hero-scene__ed-rail::before { content: ""; position: absolute; top: calc(var(--space-2) - 1px); left: calc(50% / var(--n, 4)); right: calc(50% / var(--n, 4)); height: 2px; background: var(--flow); }
.aq-hero-scene__ed-step { position: relative; display: grid; justify-items: center; align-content: start; row-gap: var(--space-1); padding: 0 var(--space-2); text-align: center; }
.aq-hero-scene__ed-dot { position: relative; z-index: 1; box-sizing: border-box; width: var(--space-4); height: var(--space-4); margin-bottom: var(--space-2); border: 2px solid var(--flow); border-radius: 50%; background: var(--surface-raised); }
.aq-hero-scene__ed-step:is(.is-fork, .is-join) .aq-hero-scene__ed-dot { background: var(--flow); }
.aq-hero-scene__ed-n { font: 400 12px/16px var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink-subtle); }
.aq-hero-scene__ed-t { font: 500 15px/20px var(--font-sans); color: var(--ink); text-wrap: balance; }
.aq-hero-scene__ed-d { font: 400 14px/20px var(--font-sans); color: var(--ink-muted); text-wrap: balance; }
/* the new edition: a dashed arch from the fork dot to the join dot, above the line */
.aq-hero-scene__ed-branch {
  position: absolute; top: var(--space-4); height: calc(var(--space-8) + var(--space-2));
  left: calc((var(--f, 2) - 0.5) / var(--n, 4) * 100%); right: calc((var(--n, 4) - var(--j, 4) + 0.5) / var(--n, 4) * 100%);
  box-sizing: border-box; border: 2px dashed var(--flow); border-bottom: 0; border-radius: var(--radius-sm) var(--radius-sm) 0 0;
}
.aq-hero-scene__ed-tag {
  position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%); padding: 0 var(--space-2); white-space: nowrap;
  background: var(--surface-raised); color: var(--flow); font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase;
}
@container (max-width: 600px) {
  /* phones: the line runs down the left, stations as rows (dot, number and words), the branch a dashed bracket on the
     right from the fork row to the join row, its label turned along it */
  .aq-hero-scene__ed { padding: var(--space-4); }
  .aq-hero-scene__ed-h { margin-bottom: var(--space-2); padding-bottom: var(--space-2); font-size: 17px; line-height: 24px; }
  .aq-hero-scene__ed-body { padding: 0 var(--space-8) 0 0; }
  .aq-hero-scene__ed-rail { grid-template-columns: none; grid-auto-rows: minmax(var(--space-16), auto); }
  .aq-hero-scene__ed-rail::before { top: calc(50% / var(--n, 4)); bottom: calc(50% / var(--n, 4)); left: calc(var(--space-2) - 1px); right: auto; width: 2px; height: auto; }
  .aq-hero-scene__ed-step { grid-template-columns: var(--space-4) auto minmax(0, 1fr); grid-template-rows: auto auto; justify-items: start; align-content: center; column-gap: var(--space-2); row-gap: 0; padding: var(--space-1) 0; text-align: left; }
  .aq-hero-scene__ed-dot { grid-row: 1 / span 2; align-self: center; margin: 0; }
  .aq-hero-scene__ed-n { grid-row: 1; align-self: baseline; padding-top: 2px; }
  .aq-hero-scene__ed-t { grid-column: 3; grid-row: 1; font-size: 14px; line-height: 20px; }
  .aq-hero-scene__ed-d { grid-column: 3; grid-row: 2; font-size: 14px; line-height: 20px; }
  .aq-hero-scene__ed-branch {
    top: calc((var(--f, 2) - 0.5) / var(--n, 4) * 100%); bottom: calc((var(--n, 4) - var(--j, 4) + 0.5) / var(--n, 4) * 100%); height: auto;
    left: auto; right: 0; width: var(--space-6); border: 2px dashed var(--flow); border-left: 0; border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .aq-hero-scene__ed-tag { top: 50%; left: 100%; transform: translate(-50%, -50%) rotate(90deg); font-size: 11px; }
}

/* Phones (round C) */
@container (max-width: 860px) {
  /* use-fan (Applications): the five industries are the next block's rows; the hero shows the drawing only */
  .aq-hero-scene--fan .aq-hero-scene__key { display: none; }
  .aq-hero-scene--bay .aq-hero-scene__key ol, .aq-hero-scene--map .aq-hero-scene__key ol, .aq-hero-scene--reply .aq-hero-scene__key ol { --hs-cols: 1; }
  .aq-hero-scene--reply .aq-hero-scene__draw { width: 100%; }
  /* the matrix at the full gutter; the package as a 112 px inset at the sheet's top right, beside the title (under the
     corner it would cover the last row's proof). Its compact rows are phone only (600 below). */
  .aq-hero-scene--matrix { padding: var(--space-12) 0 0; }
  .aq-hero-scene__mx { width: 100%; }
  .aq-hero-scene__inset { top: 0; bottom: auto; right: calc(-1 * var(--space-1)); width: calc(var(--space-32) - var(--space-4)); }
  /* shop-bay: at most 600 px wide in the 481-860 band */
  .aq-hero-scene--bay .aq-hero-scene__draw { justify-self: center; }
}
@container (min-width: 601px) and (max-width: 860px) {
  /* shop-bay at tablet width: the full-width drawing keeps a 2-column key */
  .aq-hero-scene--bay .aq-hero-scene__key ol { --hs-cols: 2; }
}
@container (max-width: 600px) {
  /* compliance-matrix on phones: 343 px at 375, 14 px rows on one line each, 36 px tick columns, 12 px sans heads */
  .aq-hero-scene__mx { padding: var(--space-2) var(--space-2) var(--space-1); }
  .aq-hero-scene__mx-h { margin: 0 0 var(--space-2); font-size: 17px; line-height: 24px; }
  .aq-hero-scene__mx-grid { grid-template-columns: auto repeat(3, 36px) minmax(0, 1fr); }
  .aq-hero-scene__mx-grid > span { min-height: calc(var(--space-8) - var(--space-1) / 2); padding: var(--space-1); font-size: 14px; line-height: 18px; }
  .aq-hero-scene__mx-grid > .aq-hero-scene__mx-th { font: 500 12px/14px var(--font-sans); letter-spacing: 0; text-transform: none; }
  .aq-hero-scene__mx-grid > .aq-hero-scene__mx-th.is-mark { padding-inline: 0; }
  .aq-hero-scene__mx-c { gap: var(--space-1); }
  .aq-hero-scene__mx-c b { display: none; }
  .aq-hero-scene__mx-grid > .aq-hero-scene__mx-d { padding-left: var(--space-2); white-space: nowrap; }
  .aq-hero-scene__tick { width: var(--space-4); height: var(--space-4); }
  /* service-ring: the drawing seen through a window cut to its stations (--hs-c*: HeroScene.js hsCrop), so the
     stations draw larger; tags 15 px */
  .aq-hero-scene__clip { overflow: hidden; }
  .aq-hero-scene--ring .aq-hero-scene__clip .aq-hero-scene__draw {
    width: calc(100% / (1 - var(--hs-cl, 0) - var(--hs-cr, 0)));
    margin: calc(-100% * var(--hs-ct, 0) * var(--hs-ar, 0.6) / (1 - var(--hs-cl, 0) - var(--hs-cr, 0))) 0 calc(-100% * var(--hs-cb, 0) * var(--hs-ar, 0.6) / (1 - var(--hs-cl, 0) - var(--hs-cr, 0))) calc(-100% * var(--hs-cl, 0) / (1 - var(--hs-cl, 0) - var(--hs-cr, 0)));
  }
  .aq-hero-scene--ring .aq-hero-scene__tag { min-width: var(--space-8); height: var(--space-6); font-size: 15px; }
}
@container (max-width: 480px) {
  .aq-hero-scene--ring .aq-hero-scene__clip { width: calc(100% + 2 * var(--space-4)); margin-inline: calc(-1 * var(--space-4)); }
  .aq-hero-scene--ring .aq-hero-scene__clip .aq-hero-scene__draw {
    width: calc(100% / (1 - var(--hs-cl, 0) - var(--hs-cr, 0)));
    margin: calc(-100% * var(--hs-ct, 0) * var(--hs-ar, 0.6) / (1 - var(--hs-cl, 0) - var(--hs-cr, 0))) 0 calc(-100% * var(--hs-cb, 0) * var(--hs-ar, 0.6) / (1 - var(--hs-cl, 0) - var(--hs-cr, 0))) calc(-100% * var(--hs-cl, 0) / (1 - var(--hs-cl, 0) - var(--hs-cr, 0)));
  }
}

/* ---------- HirePath: how we hire as one drawing sheet, the test joint as the plate and the steps on a slim vertical rail ---------- */
.aq-hire-path-sec { }
.aq-hire-path { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr); column-gap: var(--space-12); padding: var(--space-12);
  border: 1px solid var(--line-strong); }
.aq-hire-path__main { min-width: 0; display: flex; flex-direction: column; gap: var(--space-8); }
.aq-hire-path__main .aq-sec-head { margin: 0; }
.aq-hire-path__fig { margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
.aq-hire-path__plate { position: relative; aspect-ratio: 8 / 5; background: var(--navy); overflow: hidden; }
.aq-hire-path__svg { display: block; width: 100%; height: 100%; }
/* duotone planes: a limestone pipe on the navy, its lit band and its shade band */
.aq-hire-path__ground { fill: var(--navy); }
.aq-hire-path__pb { fill: color-mix(in srgb, var(--limestone) 84%, var(--navy)); }
.aq-hire-path__ph { fill: var(--limestone); }
.aq-hire-path__ps { fill: color-mix(in srgb, var(--limestone) 58%, var(--navy)); }
.aq-hire-path__po { fill: none; stroke: color-mix(in srgb, var(--limestone) 40%, var(--navy)); stroke-width: 1.5px; }
.aq-hire-path__jz { fill: none; stroke: var(--navy); stroke-width: 1.5px; stroke-dasharray: 5 4; }
.aq-hire-path__jl { fill: none; stroke: var(--navy); stroke-width: 1px; }
.aq-hire-path__dl { fill: none; stroke: var(--on-navy); stroke-width: 1.2px; stroke-linecap: round; }
.aq-hire-path__lbl text { fill: var(--on-navy); font: 400 16px var(--font-mono); letter-spacing: 0.04em; }
.aq-hire-path .aq-hire-path__cap { margin: 0; font: 400 14px/21px var(--font-mono); color: var(--ink-muted); } /* round C: 14 px (was 12) */
:where(.aq-hire-path__cap) .aq-ph { font-size: 13px; } /* round C verify nit: the placeholder chip at S4's 13 px, not the 12 px base */

/* the rail: one slim line down the steps, a gate tick at each */
.aq-hire-path__side { position: relative; min-width: 0; padding-top: var(--space-2); }
.aq-hire-path__steps { position: relative; list-style: none; margin: 0; padding: 0 0 0 var(--space-8); display: flex; flex-direction: column; gap: var(--space-8); }
.aq-hire-path__steps::before { content: ""; position: absolute; left: var(--space-2); top: var(--space-3); bottom: var(--space-2); width: 2px; background: var(--flow); }
.aq-hire-path__step { position: relative; min-width: 0; display: flex; flex-direction: column; gap: var(--space-1); }
.aq-hire-path__gate { position: absolute; left: calc(var(--space-8) * -1 + var(--space-1)); top: var(--space-2); width: var(--space-3); height: var(--space-3);
  background: var(--flow); border: 2px solid var(--flow); transition: background-color 200ms, border-color 200ms; }
.aq-hire-path .aq-hire-path__n { margin: 0; font: 400 24px/32px var(--font-mono); color: var(--flow); font-variant-numeric: tabular-nums; transition: color 200ms; }
.aq-hire-path__t { margin: 0; font: 400 20px/28px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
.aq-hire-path__d { margin: 0; font: 400 15px/24px var(--font-sans); color: var(--ink-muted); }
.aq-hire-path .aq-hire-path__icons { margin: var(--space-2) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
.aq-hire-path__ic { display: grid; place-items: center; width: var(--space-8); height: var(--space-8); border: 1px solid var(--line); color: var(--ink-muted); background: var(--surface-raised); }
.aq-hire-path__ic .aq-icon { width: var(--space-4); height: var(--space-4); }
/* the playhead: shown only while motion walks it */
.aq-hire-path__head { position: absolute; left: calc(var(--space-2) - var(--space-2) + 1px); top: 0; width: var(--space-4); height: 2px; background: var(--ink); display: none; }
.aq-hire-path__head::after { content: ""; position: absolute; left: 100%; top: calc(var(--space-1) * -1 + 1px); border: var(--space-1) solid transparent; border-left-color: var(--ink); }
.aq-hire-path.is-walk .aq-hire-path__head, .aq-hire-path.is-seek .aq-hire-path__head { display: block; }
/* before the walk (motion only): the rail is dry and the gates empty until the head passes */
.aq-hire-path.is-walk .aq-hire-path__steps::before { background: var(--line-strong); }
.aq-hire-path.is-walk .aq-hire-path__step:not(.is-on) .aq-hire-path__gate { background: transparent; border-color: var(--line-strong); }
.aq-hire-path.is-walk .aq-hire-path__step:not(.is-on) .aq-hire-path__n { color: var(--ink-muted); }
.aq-hire-path__step:hover .aq-hire-path__gate { background: var(--ink); border-color: var(--ink); }

@container (max-width: 1100px) {
  .aq-hire-path { padding: var(--space-8); column-gap: var(--space-8); grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
}
/* Phones: the plate full width under the title, the rail below it */
@container (max-width: 860px) {
  .aq-hire-path { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-8); padding: var(--space-6) var(--space-4); }
  .aq-hire-path__main { gap: var(--space-6); }
  /* the whole sheet stays in view; drawing labels drawn larger so they read at 12 px or more */
  .aq-hire-path__lbl text { font-size: 24px; }
  .aq-hire-path .aq-hire-path__n { font-size: 20px; line-height: 28px; }
  .aq-hire-path__t { font-size: 18px; line-height: 26px; }
}

/* ---------- IndexSheet: the package's index as one printed sheet (look "index-sheet"). A limestone sheet
   (data-theme="light", so it stays paper in the dark theme) on the navy band: the title set very large, a ruled,
   numbered two-column index with every section's documents in view, and a folded leaf at the right carrying one
   isometric line drawing. Rules are line-strong hairlines; flow marks only the key section and the water. ---------- */
.aq-index-sheet-sec { position: relative; }
.aq-index-sheet { position: relative; }
.aq-index-sheet__strip {
  display: flex; justify-content: space-between; gap: var(--space-4); margin: 0 0 var(--space-4); padding-bottom: var(--space-3);
  border-bottom: 1px solid color-mix(in srgb, var(--on-navy-muted) 40%, transparent);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; color: var(--on-navy-muted);
}
.aq-index-sheet__sheet { position: relative; padding: var(--space-16) var(--space-12) var(--space-12); background: var(--limestone); color: var(--on-limestone); }
.aq-index-sheet__sheet .aq-sec-head { max-width: none; }
.aq-index-sheet__sheet .aq-sec-head .aq-h1 { margin: 0; max-width: 15ch; font: 300 84px/86px var(--font-sans); letter-spacing: -0.04em; color: var(--on-limestone); text-wrap: balance; }
.aq-index-sheet__sheet .aq-sec-head .aq-lead { margin-top: var(--space-6); color: var(--on-limestone-muted); }

.aq-index-sheet__main { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); column-gap: var(--space-12); margin-top: var(--space-12); align-items: stretch; }
.aq-index-sheet__index { min-width: 0; }

/* the ruled index: two columns, a hairline over every section, a rule between the columns */
.aq-index-sheet__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-bottom: 1px solid var(--line-strong); }
.aq-index-sheet__cell { position: relative; display: grid; grid-template-columns: var(--space-12) minmax(0, 1fr); column-gap: var(--space-3); padding: var(--space-4) var(--space-6) var(--space-6) 0; min-width: 0; }
.aq-index-sheet__cell:nth-child(even) { padding-left: var(--space-6); padding-right: 0; border-left: 1px solid var(--line-strong); }
.aq-index-sheet__rule { position: absolute; left: 0; right: 0; top: 0; border-top: 1px solid var(--line-strong); transform-origin: 0 50%; }
.aq-index-sheet__cell.is-key .aq-index-sheet__rule { border-top: 2px solid var(--flow); }
.aq-index-sheet__n { font: 300 26px/30px var(--font-mono); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--on-limestone-muted); }
.aq-index-sheet__cell.is-key .aq-index-sheet__n { color: var(--flow); }
.aq-index-sheet__body { min-width: 0; }
.aq-index-sheet__t { margin: var(--space-1) 0 var(--space-2); font: 500 14px/20px var(--font-mono); letter-spacing: 0.01em; color: var(--on-limestone); }
.aq-index-sheet__t a { color: inherit; }
.aq-index-sheet__d { margin: 0; font: 400 14px/21px var(--font-sans); color: var(--on-limestone-muted); text-wrap: pretty; }
.aq-index-sheet__cell:hover .aq-index-sheet__n { color: var(--flow); }
.aq-index-sheet__n { transition: color 160ms cubic-bezier(0.2, 0, 0, 1); }

/* the folded leaf: a crease down its hinge edge, its back a blank face of the same paper (seen only while it unfolds) */
.aq-index-sheet__wing { position: relative; transform-style: preserve-3d; transform-origin: 0 50%; padding-left: var(--space-8); border-left: 1px dashed var(--line-strong); }
.aq-index-sheet__face { position: sticky; top: var(--space-24); backface-visibility: hidden; }
.aq-index-sheet__back {
  position: absolute; inset: 0; background: color-mix(in srgb, var(--limestone) 90%, var(--on-limestone)); border: 1px solid var(--line-strong);
  transform: rotateY(180deg); backface-visibility: hidden; pointer-events: none;
}
.aq-index-sheet__fig { margin: 0; }
.aq-index-sheet__svg { display: block; width: 100%; height: auto; max-height: calc(var(--space-32) * 5); }

/* Fold: desktop shows the whole index; the fold works on phones only */
.aq-fold:not(.is-open) .aq-index-sheet__cell.aq-fold-x { display: grid; }
.aq-fold:has(> .aq-index-sheet__grid) > .aq-fold__btn { display: none; }

@media (prefers-reduced-motion: reduce) { .aq-index-sheet__n { transition: none; } }

/* round C, wide desktop (over 1100 px): the folded leaf stands beside the title and intro (top right, where the sheet
   was empty), and the index runs the sheet's full width three across: about 1,300 px tall at 1280, from 1,800. The
   leaf's drawing stays sticky where it is a column (1100 px and under it is stacked above the index anyway). */
@container (min-width: 1101px) {
  .aq-index-sheet__sheet { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 17rem); column-gap: var(--space-8); align-items: start; }
  .aq-index-sheet__sheet > .aq-sec-head { grid-column: 1; grid-row: 1; }
  .aq-index-sheet__main { display: contents; }
  .aq-index-sheet__wing { grid-column: 2; grid-row: 1; align-self: stretch; display: flex; align-items: center; padding-left: var(--space-8); }
  .aq-index-sheet__face { position: relative; top: auto; width: 100%; }
  .aq-index-sheet__index { grid-column: 1 / -1; grid-row: 2; margin-top: var(--space-12); }
  .aq-index-sheet__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .aq-index-sheet__cell, .aq-index-sheet__cell:nth-child(even) { padding: var(--space-4) var(--space-6) var(--space-6); border-left: 1px solid var(--line-strong); }
  .aq-index-sheet__cell:nth-child(3n+1) { padding-left: 0; border-left: 0; }
  .aq-index-sheet__cell:nth-child(3n) { padding-right: 0; }
  /* a last section alone on its row runs the full width (two columns of text, no empty two-thirds row) */
  .aq-index-sheet__cell:last-child:nth-child(3n+1) { grid-column: 1 / -1; }
  .aq-index-sheet__cell:last-child:nth-child(3n+1) .aq-index-sheet__d { max-width: 64ch; }
}

@container (max-width: 1100px) {
  .aq-index-sheet__sheet .aq-sec-head .aq-h1 { font-size: 64px; line-height: 68px; }
  .aq-index-sheet__main { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-8); }
  .aq-index-sheet__wing { order: -1; padding: 0 0 var(--space-8); border-left: 0; border-bottom: 1px dashed var(--line-strong); transform-origin: 50% 0; }
  .aq-index-sheet__face { position: relative; top: auto; max-width: calc(var(--space-32) * 3); margin: 0 auto; }
}
@container (max-width: 860px) {
  .aq-index-sheet__sheet { padding: var(--space-8) var(--space-4) var(--space-6); }
  .aq-index-sheet__sheet .aq-sec-head .aq-h1 { font-size: 40px; line-height: 44px; letter-spacing: -0.03em; }
  .aq-index-sheet__main { margin-top: var(--space-6); row-gap: var(--space-4); }
  .aq-index-sheet__wing { padding-bottom: var(--space-4); }
  .aq-index-sheet__face { max-width: calc(var(--space-32) * 1.6); }
  .aq-index-sheet__grid { grid-template-columns: minmax(0, 1fr); }
  .aq-index-sheet__cell, .aq-index-sheet__cell:nth-child(even) { grid-template-columns: var(--space-8) minmax(0, 1fr); padding: var(--space-3) 0 var(--space-4); border-left: 0; }
  .aq-index-sheet__n { font-size: 18px; line-height: 22px; }
  .aq-fold:not(.is-open) .aq-index-sheet__cell.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-index-sheet__grid) > .aq-fold__btn { display: flex; margin-top: var(--space-2); }
}

/* ---------- IndustryDrops: one PW header main, a drop per served industry, each ending in a point-of-use vignette ---------- */
.aq-industry-drops {
  position: relative; display: grid; grid-template-columns: minmax(10rem, 19rem) minmax(0, 1fr); column-gap: var(--space-8);
  align-items: start;
}
/* the measured main and drops (look-industry-drops.js): wall, bore and water strokes on one path, walls first */
.aq-industry-drops__main { position: absolute; left: 0; top: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 0; }
.aq-industry-drops__main path { fill: none; stroke-linejoin: round; }
.aq-industry-drops__wall { stroke: var(--line-strong); stroke-width: 7; }
.aq-industry-drops__bore { stroke: var(--surface); stroke-width: 4; }
.aq-industry-drops__water { stroke: var(--flow); stroke-width: 1.5; }
.aq-industry-drops__head { stroke: var(--flow); stroke-width: 1.5; stroke-linecap: round; }
.aq-industry-drops__wall.is-on { stroke: var(--flow); transition: stroke 160ms cubic-bezier(0.2, 0, 0, 1); }
.aq-industry-drops__wall.aq-industry-drops__drop { transition: stroke 240ms cubic-bezier(0.2, 0, 0, 1); }

/* the package (aria-hidden): its supply and return tips are where the main starts and ends */
.aq-industry-drops__pkg { position: relative; z-index: 1; align-self: center; }
.aq-industry-drops__pkg svg { display: block; width: 100%; height: auto; }
.aq-industry-drops__out, .aq-industry-drops__ret, .aq-industry-drops__tap { position: absolute; width: 0; height: 0; pointer-events: none; }

/* the outlets: rows of three, each item hung from the header by its drop */
.aq-industry-drops__list {
  position: relative; z-index: 1; list-style: none; margin: 0 var(--space-4) 0 0; padding: 0;
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-8); row-gap: var(--space-6);
}
.aq-industry-drops__item { position: relative; padding-top: var(--space-12); }
.aq-industry-drops__body { position: relative; }
.aq-industry-drops__fig { position: relative; width: 12rem; max-width: 100%; aspect-ratio: 150 / 106; margin-bottom: var(--space-4); }
.aq-industry-drops__fig svg { display: block; width: 100%; height: 100%; }
.aq-industry-drops__no {
  display: inline-block; padding: 2px var(--space-2); background: var(--navy); color: var(--on-navy);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em;
}
.aq-industry-drops__t { margin: var(--space-3) 0 var(--space-2); font: 500 20px/26px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); text-wrap: balance; }
.aq-industry-drops__go { color: inherit; text-decoration: none; }
/* the whole outlet is the link on desktop */
.aq-industry-drops__go::before { content: ""; position: absolute; inset: calc(-1 * var(--space-12)) calc(-1 * var(--space-3)) calc(-1 * var(--space-3)); }
.aq-industry-drops__go::after { content: "\2192"; margin-left: 0.3em; color: var(--flow); display: inline-block; transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-industry-drops__go:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
.aq-industry-drops__go:hover::after, .aq-industry-drops__item.is-on .aq-industry-drops__go::after { transform: translateX(var(--space-1)); }
.aq-industry-drops__go:focus-visible { outline: none; }
.aq-industry-drops__go:focus-visible::before { outline: 2px solid var(--focus); outline-offset: 0; }
/* desktop: the title link itself is a 44 px target (26 px line + 9 px above and below), the line layout unchanged */
@container (min-width: 861px) {
  .aq-industry-drops__go { padding-block: 9px; margin-block: -9px; }
}
.aq-industry-drops__d { margin: 0 0 var(--space-3); max-width: 34ch; font: 400 15px/24px var(--font-sans); color: var(--ink-muted); }
.aq-industry-drops__tag {
  display: inline-block; padding: 2px var(--space-2); border: 1px solid var(--line-strong); color: var(--ink);
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.04em; white-space: nowrap;
}
.aq-industry-drops__item.is-on .aq-industry-drops__fig .aq-iso__eq,
.aq-industry-drops__item.is-on .aq-industry-drops__fig .aq-iso__pipe-wall { stroke: var(--flow); }

/* phone-only chips are PhoneKit heads: hidden until PhoneKit switches the list on */
.aq-industry-drops__chip { display: none; }

@container (max-width: 1100px) {
  .aq-industry-drops { grid-template-columns: minmax(8rem, 11rem) minmax(0, 1fr); column-gap: var(--space-8); }
  .aq-industry-drops__list { column-gap: var(--space-6); }
  .aq-industry-drops__t { font-size: 18px; line-height: 24px; }
}

/* Phone: the main runs down the left edge; the outlets are a 2-column grid of tiles teed off it (PhoneKit chips) and the
   open tile's card runs full width under them. Without PhoneKit every card shows, stacked beside the main. */
@container (max-width: 860px) {
  .aq-industry-drops { display: block; padding-left: calc(var(--space-8) + var(--space-3)); }
  .aq-industry-drops__main, .aq-industry-drops__pkg { display: none; }
  /* a U-loop: supply down the outside rail, return up the inside one; the tiles tee off the return */
  .aq-industry-drops::before {
    content: ""; position: absolute; left: var(--space-2); top: 0; bottom: var(--space-6); width: calc(4px + var(--space-3));
    border: 1.5px solid var(--line-strong); border-top: 0; border-radius: 0 0 var(--space-2) var(--space-2);
    background: linear-gradient(90deg, transparent 1.25px, var(--flow) 1.25px, var(--flow) 2.75px, transparent 2.75px,
      transparent calc(100% - 2.75px), var(--flow) calc(100% - 2.75px), var(--flow) calc(100% - 1.25px), transparent calc(100% - 1.25px));
  }
  /* the inlet at the top of the main: a flow arrowhead pointing down */
  .aq-industry-drops::after {
    content: ""; position: absolute; left: calc(var(--space-2) + 1px); top: calc(-1 * var(--space-2)); width: 7px; height: 7px;
    border-right: 1.5px solid var(--flow); border-bottom: 1.5px solid var(--flow); transform: rotate(45deg);
  }
  .aq-industry-drops__list { display: block; margin-right: 0; }
  .aq-industry-drops__item { padding-top: 0; margin-bottom: var(--space-4); }
  .aq-industry-drops__fig, .aq-industry-drops__body > .aq-industry-drops__no { display: none; }
  .aq-industry-drops__t { margin-top: 0; font-size: 17px; line-height: 24px; }
  .aq-industry-drops__go::before { content: none; }
  .aq-industry-drops__d { max-width: none; font-size: 15px; line-height: 23px; }

  /* PhoneKit on: chips */
  .aq-industry-drops__list[data-pk-on] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__item { margin: 0; }
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__chip {
    position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-1);
    padding: var(--space-2) var(--space-3) var(--space-3); border: 1px solid var(--line-strong); border-radius: 0;
    background: var(--surface); color: var(--ink); font: 500 14px/18px var(--font-sans);
  }
  .aq-industry-drops__list[data-pk-picker][data-pk-on] .aq-industry-drops__chip[aria-expanded="true"] {
    border-color: var(--flow); background: var(--surface); color: var(--ink); box-shadow: inset 0 0 0 1px var(--flow);
  }
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__chip[aria-expanded="true"] .aq-industry-drops__no { background: var(--flow); color: var(--surface); }
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__chip[aria-expanded="true"] .aq-iso { color: var(--flow); }
  .aq-industry-drops__mini { display: block; width: 100%; height: 76px; color: var(--ink-muted); }
  .aq-industry-drops__mini svg { display: block; width: 100%; height: 100%; }
  .aq-industry-drops__ct { text-wrap: balance; }
  /* the tee: the main feeds each row through its left tile, a short spool carries on across the gap */
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__item:nth-child(odd) > .aq-industry-drops__chip::before,
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__item:nth-child(even) > .aq-industry-drops__chip::before {
    content: ""; position: absolute; top: var(--space-6); height: 4px; box-sizing: content-box;
    border-top: 1.5px solid var(--line-strong); border-bottom: 1.5px solid var(--line-strong);
    background: linear-gradient(transparent 1.25px, var(--flow) 1.25px, var(--flow) 2.75px, transparent 2.75px);
  }
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__item:nth-child(odd) > .aq-industry-drops__chip::before {
    left: calc(-1 * var(--space-6) - 1px); width: var(--space-6);
  }
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__item:nth-child(even) > .aq-industry-drops__chip::before {
    left: calc(-1 * var(--space-2) - 1px); width: var(--space-2);
  }
  /* the open card */
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__body {
    padding: 0 var(--space-4) var(--space-4); border: 1px solid var(--flow); background: var(--surface-raised);
  }
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__t { margin: 0 calc(-1 * var(--space-4)) var(--space-2); }
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__go {
    display: flex; align-items: center; gap: var(--space-3); min-height: 48px; padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--line); box-sizing: border-box;
  }
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__go::after { margin-left: auto; }
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__go:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
}

/* Tablet (container 600-860 px): three tiles a row; each row is teed from the main through its first tile */
@container (min-width: 600px) and (max-width: 860px) {
  .aq-industry-drops__list[data-pk-on] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__item:nth-child(odd) > .aq-industry-drops__chip::before,
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__item:nth-child(even) > .aq-industry-drops__chip::before { left: calc(-1 * var(--space-2) - 1px); width: var(--space-2); }
  .aq-industry-drops__list[data-pk-on] .aq-industry-drops__item:nth-child(3n+1) > .aq-industry-drops__chip::before { left: calc(-1 * var(--space-6) - 1px); width: var(--space-6); }
}

@media (prefers-reduced-motion: reduce) {
  .aq-industry-drops__wall.is-on, .aq-industry-drops__wall.aq-industry-drops__drop, .aq-industry-drops__go::after { transition: none; }
}

/* ---------- IssuedSet: the documents you receive as an issued set of sheets dealt onto a desk (look "issued-set").
   The desk is a surface-sunken panel; each sheet is light paper (data-theme="light") at a slight turn (--i picks it),
   with its code, a miniature of the document, name, text, an optional round stamp of the step that uses it and a
   small title block. Hovering a sheet straightens and lifts it. ---------- */
.aq-issued-set { position: relative; }
.aq-issued-set__desk {
  list-style: none; margin: 0; padding: var(--space-16) var(--space-12) var(--space-16);
  display: grid; grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); column-gap: var(--space-6); row-gap: var(--space-12);
  background: var(--surface-sunken); border: 1px solid var(--line);
}
.aq-issued-set__sheet {
  --r: -1.6deg; --y: 0;
  position: relative; display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; min-height: 100%; box-sizing: border-box;
  padding: var(--space-4) var(--space-4) var(--space-12); background: var(--surface-raised); color: var(--ink);
  border: 1px solid var(--line); outline: 1px solid color-mix(in srgb, var(--line-strong) 30%, transparent); outline-offset: calc(-1 * var(--space-2));
  transform: translateY(var(--y, 0px)) rotate(var(--r, 0deg)); transition: transform 300ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-issued-set__sheet:nth-child(4n+2) { --r: 1.2deg; --y: var(--space-6); }
.aq-issued-set__sheet:nth-child(4n+3) { --r: -0.8deg; --y: calc(-1 * var(--space-2)); }
.aq-issued-set__sheet:nth-child(4n+4) { --r: 1.8deg; --y: var(--space-4); }
.aq-issued-set__sheet:hover, .aq-issued-set__sheet:focus-within { transform: translateY(calc(var(--y, 0px) - var(--space-2))) rotate(0deg); z-index: 1; }

/* header: the code large, the sheet number */
.aq-issued-set__hd { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); padding: var(--space-2) var(--space-2) var(--space-3); border-bottom: 1px solid var(--line); }
.aq-issued-set__code { font: 300 34px/38px var(--font-mono); letter-spacing: -0.03em; color: var(--ink); white-space: nowrap; }
.aq-issued-set__sheet.is-key .aq-issued-set__code { color: var(--flow); }
.aq-issued-set__no { font: 400 12px/16px var(--font-mono); color: var(--ink-subtle); letter-spacing: 0.06em; white-space: nowrap; }

/* the miniature */
.aq-issued-set__fig { position: relative; }
.aq-issued-set__mini { display: block; width: 100%; height: auto; margin: var(--space-2) 0; padding: var(--space-2); box-sizing: border-box; background: var(--surface); border: 1px solid var(--line); }
.aq-issued-set__mini * { vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
.aq-issued-set__ln { fill: none; stroke: var(--line-strong); stroke-width: 1.5; }
.aq-issued-set__thin { fill: none; stroke: var(--line-strong); stroke-width: 1; }
.aq-issued-set__grid { fill: none; stroke: var(--line); stroke-width: 1; }
.aq-issued-set__txt { fill: none; stroke: color-mix(in srgb, var(--ink) 18%, transparent); stroke-width: 4; stroke-linecap: butt; }
.aq-issued-set__flow { fill: none; stroke: var(--flow); stroke-width: 1.5; }
.aq-issued-set__box { fill: none; stroke: var(--line-strong); stroke-width: 1; }

.aq-issued-set__t { margin: 0; padding: 0 var(--space-2); font: 500 17px/24px var(--font-sans); letter-spacing: -0.005em; text-wrap: balance; }
.aq-issued-set__t a { color: inherit; }
.aq-issued-set__d { margin: 0; padding: 0 var(--space-2); font: 400 15px/23px var(--font-sans); color: var(--ink-muted); text-wrap: pretty; }

/* the stamp: the qualification step that uses this document */
.aq-issued-set__use {
  position: absolute; right: calc(-1 * var(--space-2)); bottom: calc(-1 * var(--space-4)); width: var(--space-16); height: var(--space-16); display: grid; place-items: center;
  border-radius: 50%; border: 3px double var(--flow); color: var(--flow); font: 500 18px/1 var(--font-mono); letter-spacing: 0.06em;
  transform: rotate(-14deg); opacity: 0.9; mix-blend-mode: multiply; pointer-events: none;
}
.aq-issued-set__sheet:nth-child(even) .aq-issued-set__use { transform: rotate(9deg); }
/* title block */
.aq-issued-set__tb { position: absolute; left: var(--space-4); bottom: var(--space-4); display: flex; border: 1px solid var(--line); font: 400 12px/16px var(--font-mono); color: var(--ink-subtle); }
.aq-issued-set__tb span { padding: 0 var(--space-2); }
.aq-issued-set__tb span + span { border-left: 1px solid var(--line); }
.aq-issued-set__more { margin: var(--space-8) 0 0; }
/* desktop: the text link's hit box grows to 44 px without moving anything (phones get min-height from Button) */
@container (min-width: 861px) { .aq-issued-set__more .aq-btn--link { padding-block: var(--space-3); margin-block: calc(-1 * var(--space-3)); } }
.aq-section.aq-issued-set-sec { overflow-x: clip; }

@container (max-width: 1100px) {
  .aq-issued-set__desk { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: var(--space-12) var(--space-8); }
  .aq-issued-set__sheet:nth-child(odd) { --y: 0; }
  .aq-issued-set__sheet:nth-child(even) { --y: var(--space-4); }
}
/* the dots under the phone deck (hidden wider) */
.aq-issued-set__dots { display: none; }

/* Phones (pass 12, S11): a snap deck on the desk, sheets 78 % wide with the next one peeking; turn and stamp kept,
   the miniature shorter; dots under the deck (look JS, AQsnap). */
@container (max-width: 860px) {
  .aq-issued-set__desk { display: flex; gap: var(--space-4); margin-inline: calc(-1 * var(--space-4)); padding: var(--space-8) var(--space-4) var(--space-8); border-inline: 0;
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: var(--space-4); scrollbar-width: none; }
  .aq-issued-set__desk::-webkit-scrollbar { display: none; }
  .aq-fold:not(.is-open) .aq-issued-set__sheet.aq-fold-x, .aq-issued-set__sheet { display: flex; }
  .aq-fold:has(> .aq-issued-set__desk) > .aq-fold__btn { display: none; }
  .aq-issued-set__sheet { flex: 0 0 min(78%, 320px); min-height: 0; scroll-snap-align: start; gap: var(--space-2); padding: var(--space-3) var(--space-3) var(--space-12); }
  .aq-issued-set__sheet, .aq-issued-set__sheet:nth-child(n) { --y: 0; --r: -1.2deg; }
  .aq-issued-set__sheet:nth-child(even) { --r: 1deg; }
  .aq-issued-set__code { font-size: 28px; line-height: 32px; }
  .aq-issued-set__hd { padding: var(--space-1) var(--space-1) var(--space-2); }
  .aq-issued-set__mini { margin: var(--space-1) 0; aspect-ratio: 240 / 110; object-fit: cover; }
  .aq-issued-set__use { width: var(--space-12); height: var(--space-12); font-size: 15px; right: calc(-1 * var(--space-1)); bottom: calc(-1 * var(--space-3)); }
  .aq-issued-set__t { padding: 0 var(--space-1); font-size: 16px; line-height: 22px; }
  .aq-issued-set__d { padding: 0 var(--space-1); font-size: 14px; line-height: 21px; }
  .aq-issued-set__tb { left: var(--space-3); bottom: var(--space-3); }
  .aq-issued-set__dots { display: flex; justify-content: center; margin-top: var(--space-1); }
  .aq-issued-set__dot { position: relative; width: 44px; height: 44px; padding: 0; border: 0; background: none; color: var(--ink-muted); cursor: pointer; }
  .aq-issued-set__dot::before { content: ""; position: absolute; left: 50%; top: 50%; width: 8px; height: 8px; margin: -4px 0 0 -4px; box-sizing: border-box; border: 1.5px solid currentColor; border-radius: 50%;
    transition: width 200ms cubic-bezier(0.2, 0, 0, 1), margin 200ms cubic-bezier(0.2, 0, 0, 1), background-color 200ms; }
  .aq-issued-set__dot[aria-current="true"]::before { width: 20px; margin-left: -10px; border-radius: 4px; border-color: var(--flow); background: var(--flow); }
  .aq-issued-set__dot:focus-visible { outline: 2px solid var(--focus); outline-offset: -6px; }
  .aq-issued-set__more { margin-top: var(--space-2); }
}
@media (prefers-reduced-motion: reduce) { .aq-issued-set__dot::before { transition: none; } }

/* ---------- JointSpine: a log whose rows hang off a pipe (look "joint-spine"). A twin-wall pipe drops in from the
   section top beside the title, bends (the 240 x 72 svg, drawn 1:1) and runs down a 240-wide rail as the log's spine;
   each row's joint sits on the spine level with the row's first line. Walls are 1.5 px line-strong (the ink) over a
   faint line copy (the impression), the water a flow centre line. ---------- */
.aq-section.aq-joint-spine-sec { overflow: clip; }
.aq-joint-spine { --js-g: var(--surface); --js-rail: 240px; --js-x: 160px; --js-jy: calc(var(--space-6) + 12px); position: relative; }
.aq-section--alt .aq-joint-spine { --js-g: var(--surface-sunken); }

/* pipe pieces: a 13-wide channel, walls as borders */
.aq-joint-spine__pipe { position: absolute; top: 0; bottom: 0; left: calc(var(--js-x, 160px) - 6.5px); width: 13px; box-sizing: border-box; border-left: 1.5px solid var(--line); border-right: 1.5px solid var(--line); pointer-events: none; }
.aq-joint-spine__ink { position: absolute; top: 0; bottom: 0; left: -1.5px; right: -1.5px; border-left: 1.5px solid var(--line-strong); border-right: 1.5px solid var(--line-strong); transform-origin: 50% 0; }
.aq-joint-spine__ink::after { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; transform: translateX(-50%); background: var(--flow); opacity: 0.55; }

/* the lead: the drop beside the title, the bend, the legend level with the bend's run */
.aq-joint-spine__lead { position: relative; }
.aq-joint-spine__lead .aq-sec-head { padding-left: var(--space-16); }
.aq-joint-spine__drop { top: -100vh; bottom: 72px; left: 7.5px; }
.aq-joint-spine__bend { position: absolute; left: 0; bottom: 0; width: 240px; height: 72px; overflow: visible; }
.aq-joint-spine__bend path { fill: none; stroke-linecap: butt; stroke-linejoin: round; }
.aq-joint-spine__w { stroke: var(--line-strong); stroke-width: 13; }
.aq-joint-spine__w--imp { stroke: var(--line); }
.aq-joint-spine__g { stroke: var(--js-g, var(--surface)); stroke-width: 10; }
.aq-joint-spine__h2o { stroke: var(--flow); stroke-width: 2; opacity: 0.55; }
.aq-joint-spine__legend {
  display: grid; grid-template-columns: var(--js-rail, 240px) minmax(0, 1fr) minmax(0, 1.25fr) minmax(0, 1fr); align-items: end;
  min-height: 72px; margin: var(--space-8) 0 0; box-sizing: border-box;
  font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-subtle);
}
.aq-joint-spine__legend span { padding: 0 var(--space-6) var(--space-3) 0; border-bottom: 1px solid var(--ink); }
.aq-joint-spine__legend span:first-child { grid-column: 2; }

/* the log */
.aq-joint-spine__log { list-style: none; margin: 0; padding: 0; }
.aq-joint-spine__row { position: relative; display: grid; grid-template-columns: var(--js-rail, 240px) minmax(0, 1fr) minmax(0, 1.25fr) minmax(0, 1fr); }
.aq-joint-spine__row > h3, .aq-joint-spine__row > p, .aq-joint-spine__fh > h3, .aq-joint-spine__fh > p {
  margin: 0; padding: var(--space-6) var(--space-6) var(--space-6) 0; border-bottom: 1px solid var(--line); min-width: 0; text-wrap: pretty;
  transition: background 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-joint-spine__row > h3, .aq-joint-spine__fh > h3 { grid-column: 2; font: 500 17px/24px var(--font-sans); letter-spacing: -0.005em; color: var(--ink); text-wrap: balance; }
.aq-joint-spine__p { font: 400 15px/24px var(--font-sans); color: var(--ink-muted); }
.aq-joint-spine__r { font: 400 15px/24px var(--font-sans); color: var(--ink); }
.aq-joint-spine__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

/* the joint: a tick across the pipe and a dot on its centre line, the number beside it */
.aq-joint-spine__joint { position: absolute; left: 50%; top: var(--js-jy, 36px); width: 31px; height: 1.5px; transform: translate(-50%, -50%); background: var(--line-strong); transition: background 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-joint-spine__joint::after {
  content: ""; position: absolute; left: 50%; top: 50%; width: 9px; height: 9px; border-radius: 50%; transform: translate(-50%, -50%);
  background: var(--line-strong); box-shadow: 0 0 0 2px var(--js-g, var(--surface)); transition: background 200ms cubic-bezier(0.2, 0, 0, 1), transform 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-joint-spine__no {
  position: absolute; top: var(--js-jy, 36px); right: calc(100% + var(--space-6)); transform: translateY(-50%);
  font: 500 13px/1 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-muted); white-space: nowrap; transition: color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.aq-joint-spine__row.is-r .aq-joint-spine__no { right: auto; left: calc(100% + var(--space-6)); }
.aq-joint-spine__row:hover > h3, .aq-joint-spine__row:hover > p, .aq-joint-spine__row:hover .aq-joint-spine__fh > * { background: var(--flow-tint); }
.aq-joint-spine__row:hover .aq-joint-spine__joint, .aq-joint-spine__row:hover .aq-joint-spine__joint::after { background: var(--flow); }
.aq-joint-spine__row:hover .aq-joint-spine__joint::after { transform: translate(-50%, -50%) scale(1.45); }
.aq-joint-spine__row:hover .aq-joint-spine__no { color: var(--flow); }

/* the pipe runs on past the last row and out of the section */
.aq-joint-spine__tail { top: 100%; bottom: auto; height: 100vh; }

/* Fold: desktop shows the whole log; phones fold */
.aq-fold:not(.is-open) .aq-joint-spine__row.aq-fold-x { display: grid; }
.aq-fold:has(> .aq-joint-spine__log) > .aq-fold__btn { display: none; }

/* Phones (pass 12, S12): no drop or bend; a 48 px rail with the spine at the left and the numbers beside the joints.
   The column names show once as a key above the log (the per-row labels stay for screen readers); with .is-chips the
   second column (a status or a placeholder) is a chip beside the field name and the third column one 15 px line. */
@container (max-width: 860px) {
  .aq-joint-spine { --js-rail: 48px; --js-x: 30px; --js-jy: calc(var(--space-3) + 12px); }
  .aq-joint-spine__drop, .aq-joint-spine__bend { display: none; }
  .aq-joint-spine__lead { padding-bottom: var(--space-4); }
  .aq-joint-spine__lead .aq-sec-head { padding-left: 0; }
  .aq-joint-spine__legend { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-1); min-height: 0; margin: var(--space-6) 0 0; padding-left: var(--js-rail, 48px); font-size: 12px; letter-spacing: 0.04em; }
  .aq-joint-spine__legend span { padding: 0; border: 0; }
  .aq-joint-spine__legend span:last-child { align-self: stretch; padding-bottom: var(--space-3); border-bottom: 1px solid var(--ink); }
  .aq-joint-spine__row { grid-template-columns: var(--js-rail, 48px) minmax(0, 1fr); border-top: 1px solid var(--line); padding: var(--space-3) 0 var(--space-4); row-gap: var(--space-1); }
  .aq-joint-spine__row:first-child { border-top: 0; }
  .aq-joint-spine__fh { display: block; grid-column: 2; min-width: 0; }
  .aq-joint-spine__fh > h3, .aq-joint-spine__fh > p, .aq-joint-spine__row > p { grid-column: 2; padding: 0; border: 0; margin: 0; }
  .aq-joint-spine__fh > h3 { font: 500 17px/24px var(--font-sans); letter-spacing: -0.005em; color: var(--ink); text-wrap: balance; }
  .aq-joint-spine__fh > p { margin-top: var(--space-1); }
  .aq-joint-spine__p, .aq-joint-spine__r { font-size: 15px; line-height: 22px; }
  .aq-joint-spine__no, .aq-joint-spine__row.is-r .aq-joint-spine__no { left: auto; right: calc(100% + 6px); font-size: 12px; }
  .aq-joint-spine__joint { width: 17px; }
  .aq-joint-spine__row:hover .aq-joint-spine__fh > h3, .aq-joint-spine__row:hover .aq-joint-spine__fh > p { background: none; }
  /* status chips on the title row */
  .aq-joint-spine.is-chips .aq-joint-spine__fh { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-2); }
  .aq-joint-spine.is-chips .aq-joint-spine__fh > h3 { flex: 0 1 auto; }
  .aq-joint-spine.is-chips .aq-joint-spine__fh > p { margin: 0; padding: 1px var(--space-2); border: 1px solid var(--line-strong); border-radius: var(--radius-sm, 4px);
    font: 500 var(--aq-chip-phone, 13px)/20px var(--font-mono); letter-spacing: 0; color: var(--ink); background: var(--surface); }
  .aq-fold:not(.is-open) .aq-joint-spine__row.aq-fold-x { display: none; }
  .aq-fold:has(> .aq-joint-spine__log) > .aq-fold__btn { display: flex; margin-left: var(--js-rail, 240px); max-width: calc(100% - var(--js-rail, 240px)); box-sizing: border-box; }
}

/* the title set large and light, beside the drop */
.aq-joint-spine__lead .aq-sec-head .aq-h1 { font: 300 56px/60px var(--font-sans); letter-spacing: -0.03em; }
@container (max-width: 860px) {
  .aq-joint-spine__lead .aq-sec-head .aq-h1 { font: 300 36px/42px var(--font-sans); }
}
.aq-joint-spine__f { min-width: 0; }
/* the field and its second column: one wrapper that the desktop grid sees through */
.aq-joint-spine__fh { display: contents; }
.aq-joint-spine__bink { pointer-events: none; }

/* Phone key (pass 12, F4): the legend is a <p>, so .aq-page p { margin: 0 } outranks its own margin; this restores the
   gap under the lead. Each key line leads with the mark of the row part it names: a bold dash for the field, an
   outlined box for the chip (.is-chips) or a muted rule for the second line, a thin ink rule for the description. */
@container (max-width: 860px) {
  .aq-joint-spine .aq-joint-spine__legend { margin-top: var(--space-6); }
  .aq-joint-spine__legend span { display: flex; align-items: center; gap: var(--space-2); }
  .aq-joint-spine__legend span::before { content: ""; flex: none; box-sizing: border-box; width: 14px; }
  .aq-joint-spine__legend span:nth-child(1)::before { height: 3px; background: var(--ink); }
  .aq-joint-spine__legend span:nth-child(2)::before { height: 2px; background: var(--ink-muted); }
  .aq-joint-spine.is-chips .aq-joint-spine__legend span:nth-child(2)::before { height: 10px; background: none; border: 1px solid var(--line-strong); border-radius: 2px; }
  .aq-joint-spine__legend span:nth-child(3)::before { height: 1px; background: var(--ink); }
  /* without chips the two body lines differ in weight as well as tone: the second column in 500 muted, the description
     in 400 ink */
  .aq-joint-spine:not(.is-chips) .aq-joint-spine__p { font-weight: 500; }
  /* pass 12 C (replaces F6): the chip at the right of the field name, on its first line; the name takes the rest of
     the row (at least 12rem), so a chip too long to fit beside it (a placeholder) drops under the name, at the left */
  .aq-joint-spine.is-chips .aq-joint-spine__fh { flex-wrap: wrap; align-items: first baseline; column-gap: var(--space-3); }
  .aq-joint-spine.is-chips .aq-joint-spine__fh > h3 { flex: 1 1 12rem; min-width: 0; }
  .aq-joint-spine.is-chips .aq-joint-spine__fh > p { flex: 0 1 auto; min-width: 0; font-size: 14px; }
  /* no key row: the per-row labels stay for screen readers, the description needs no key */
  .aq-joint-spine .aq-joint-spine__legend { display: none; }
}

/* ---------- JointSteps: a fabrication sequence told on one joint (look "joint-steps"). Navy title column (bleeding to
   the section's left and top/bottom edges), a drawing sheet with the joint (IsoKit on the light sheet; sticky on wide
   screens), the steps on a numbered rail. The figure's data-st names the stage shown; that stage's group of lines
   turns flow. ---------- */
.aq-section.aq-joint-steps-sec { overflow: clip; }
.aq-joint-steps {
  --jst-ease: cubic-bezier(0.2, 0, 0, 1);
  display: grid; grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.45fr) minmax(0, 1fr); column-gap: var(--space-8); align-items: stretch;
}
.aq-joint-steps__title { position: relative; z-index: 0; padding: var(--space-4) var(--space-8) var(--space-8) 0; color: var(--on-navy); }
.aq-joint-steps__title::before { content: ""; position: absolute; z-index: -1; top: -50vh; bottom: -50vh; right: 0; left: -100vw; background: var(--navy); }
.aq-joint-steps__title .aq-sec-head { position: sticky; top: var(--space-24); }
.aq-joint-steps__title .aq-h1 { font: 300 52px/56px var(--font-sans); letter-spacing: -0.03em; color: var(--on-navy); }
.aq-joint-steps__title .aq-lead { color: var(--on-navy-muted); }

/* the sheet */
.aq-joint-steps__sheet { min-width: 0; }
.aq-joint-steps__fig { position: sticky; top: var(--space-16); border: 1px solid var(--line); background: var(--surface-raised); }
.aq-joint-steps__fig .aq-iso { display: block; width: 100%; height: auto; }
.aq-joint-steps__st * { transition: stroke 260ms var(--jst-ease, ease-out), fill 260ms var(--jst-ease, ease-out), stroke-width 260ms var(--jst-ease, ease-out); }
.aq-joint-steps__print { fill: none; stroke: var(--ink-muted); stroke-width: 4; stroke-dasharray: 6 3 2 3 10 4; }
.aq-joint-steps__zone { fill: none; stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 4 3; }
.aq-joint-steps__svg .aq-iso__flow { opacity: 0.4; transition: opacity 260ms var(--jst-ease, ease-out), stroke-width 260ms var(--jst-ease, ease-out); }
.aq-joint-steps__fig[data-st="plan"] [data-st="plan"] *, .aq-joint-steps__fig[data-st="join"] [data-st="join"] *,
.aq-joint-steps__fig[data-st="qualify"] [data-st="qualify"] .aq-iso__pipe-wall, .aq-joint-steps__fig[data-st="qualify"] [data-st="qualify"] .aq-iso__eq, .aq-joint-steps__fig[data-st="qualify"] [data-st="qualify"] .aq-iso__hid,
.aq-joint-steps__fig[data-st="test"] [data-st="test"] .aq-iso__eq, .aq-joint-steps__fig[data-st="test"] [data-st="test"] .aq-iso__ln, .aq-joint-steps__fig[data-st="test"] [data-st="test"] .aq-iso__thin, .aq-joint-steps__fig[data-st="test"] [data-st="test"] .aq-iso__pipe-wall { stroke: var(--flow); }
.aq-joint-steps__fig[data-st="plan"] [data-st="plan"] .aq-iso__label, .aq-joint-steps__fig[data-st="plan"] .aq-iso__sheet-t { fill: var(--flow); stroke: none; }
.aq-joint-steps__fig[data-st="receive"] .aq-joint-steps__print { stroke: var(--flow); }
.aq-joint-steps__fig[data-st="join"] .aq-joint-steps__zone { stroke-width: 1.5; }
.aq-joint-steps__fig[data-st="clean"] .aq-iso__flow { opacity: 1; stroke-width: 6; }
.aq-joint-steps__fig[data-st="test"] [data-iso-id="len"] .aq-iso__pipe-wall { stroke: var(--flow); }
/* the joint's tag: number and method, real text over the drawing */
.aq-joint-steps__tag {
  position: absolute; transform: translate(-100%, -50%); display: flex; align-items: baseline; gap: var(--space-2); max-width: 46%;
  padding: var(--space-1) var(--space-2); background: var(--surface-raised); border: 1px solid var(--line-strong);
  font: 400 13px/18px var(--font-sans); color: var(--ink); transition: border-color 260ms var(--jst-ease, ease-out);
}
.aq-joint-steps__tag--right { transform: translate(0, -50%); }
.aq-joint-steps__tag b { font: 500 13px/18px var(--font-mono); letter-spacing: 0.06em; }
.aq-joint-steps__fig[data-st="join"] .aq-joint-steps__tag, .aq-joint-steps__fig[data-st="plan"] .aq-joint-steps__tag { border-color: var(--flow); }

/* the rail */
.aq-joint-steps__rail { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
.aq-joint-steps__step { display: grid; grid-template-columns: var(--space-16) minmax(0, 1fr); column-gap: var(--space-4); padding: var(--space-6) 0 var(--space-8) var(--space-6); border-bottom: 1px solid var(--line); position: relative; outline-offset: -2px; }
.aq-joint-steps__step::before { content: ""; position: absolute; left: -1px; top: 0; bottom: 0; width: 2px; background: var(--flow); transform: scaleY(0); transform-origin: 50% 0; transition: transform 260ms var(--jst-ease, ease-out); }
