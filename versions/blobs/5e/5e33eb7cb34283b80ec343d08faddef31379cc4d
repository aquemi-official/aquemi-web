@container (max-width: 860px) {
  .aq-band--navy + .aq-band--navy:not(.aq-closing) { padding-top: calc(var(--space-12) + var(--space-4)); }
  .aq-band__frame { padding-block: 0; }
  .aq-band__text { max-width: none; gap: var(--space-4); }
  .aq-band__h { font-size: 38px; line-height: 44px; }
  .aq-band__lead { font-size: 16px; line-height: 24px; }
  /* The drawing is dropped on phones: the statement needs the full width */
  .aq-band__motif { display: none; }
}

/* ---------- BidRoute: one route through numbered stations, one per row, the rows as cards under their stations ---------- */
/* Desktop: the route runs the full width (a twin-wall pipe, the water its centre line) with one pictogram per row; a
   drop leaves each station and turns into its card's number. Cards sit in as many columns as rows. Up to 1100 px and
   on phones: the route becomes a riser down the left, each row beside its number with its own pictogram. */
.aq-bid-route { margin-top: var(--space-6); }
