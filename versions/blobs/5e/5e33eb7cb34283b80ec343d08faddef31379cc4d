    grid-template-columns: minmax(0, 1fr) var(--space-16); grid-template-areas: "g v" "t v"; align-items: center;
  }
  .aq-related-links__n { display: none; }
  .aq-related-links__group { justify-self: start; }
  .aq-related-links__group > span { display: inline; }
  .aq-related-links__vis { margin: 0; width: var(--space-16); height: var(--space-16); aspect-ratio: 1; }
  .aq-related-links__vis.is-iso { padding: var(--space-1); }
  .aq-related-links__card { grid-template-rows: auto auto; }
  .aq-related-links__card.is-bare { grid-template-columns: minmax(0, 1fr); grid-template-areas: "g" "t"; }
  .aq-related-links__card.is-bare .aq-related-links__title { padding-top: 0; }
  .aq-related-links:has(> :nth-child(5)):not(:has(> :nth-child(6))) .aq-related-links__title { font-size: 19px; line-height: 26px; }
  .aq-related-links__vis .aq-related-links__spot { width: 70%; }
  /* in the 64 px window the raster drawings fade to grey and the scenes stay crisp: meet in the middle */
  .aq-related-links__iso { opacity: .8; }
  .aq-related-links__vis.is-art { --aq-rel-now: var(--ink); }
  .aq-related-links__card:is(:hover, :focus-visible) .aq-related-links__vis.is-art { --aq-rel-now: var(--flow); }
  .aq-related-links__title { font-size: 19px; line-height: 26px; }
