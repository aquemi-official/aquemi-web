/* verify F4: the sheet follows the open row's third (the route spans every row, so align-self moves it) */
.aq-manifold-router--compact.is-mid .aq-manifold-router__route { align-self: center; }
.aq-manifold-router--compact.is-low .aq-manifold-router__route { align-self: end; }
.aq-manifold-router--compact .aq-manifold-router__st:not(:last-child)::after { max-height: var(--space-24); }

/* ---------- MembraneAtlas: feed conditions as a numbered table, each row headed by a navy numeral tile ---------- */
/* Four columns: the navy tile (huge light slash numeral over a soft micrograph), then condition, effect and design.
