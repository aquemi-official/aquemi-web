  background-position: 0 100%; background-repeat: no-repeat; transition: background-size 200ms cubic-bezier(0.2, 0, 0, 1); }
.aq-note-sheet__st a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
.aq-note-sheet__st a:hover, .aq-note-sheet__st a:focus-visible { background-size: 100% 1px; }
.aq-note-sheet__st a:focus-visible { outline: none; }
.aq-note-sheet__st a:focus-visible::after { outline: 2px solid var(--focus); outline-offset: -4px; }
.aq-note-sheet__go { margin: 0; font: 400 15px/22px var(--font-sans); color: var(--ink-muted); }
.aq-note-sheet__go::after { content: "\2192"; margin-left: var(--space-2); color: var(--flow); }
