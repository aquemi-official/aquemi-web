  .aq-limit-gauges__rule { grid-template-columns: var(--space-8) minmax(0, 1fr); column-gap: var(--space-2); row-gap: var(--space-3); padding: var(--space-4) 0; }
  .aq-limit-gauges__rule .aq-limit-gauges__p { font-size: 16px; line-height: 24px; }
